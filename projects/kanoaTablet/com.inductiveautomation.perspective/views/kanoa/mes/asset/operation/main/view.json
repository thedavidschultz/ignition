  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.filter.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: value or -1}), 0)",
            "type": "script"
