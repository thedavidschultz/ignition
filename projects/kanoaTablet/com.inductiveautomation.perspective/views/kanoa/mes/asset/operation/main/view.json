          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updateAssetOpsNav() msg rcvd with %s\"%payload)\n\n\tviewPath \u003d \"kanoa/mes/asset/operation/defaultNav\"\n\tviewPayload \u003d None\n\t\n\tif payload is not None:\n\t\tif payload.has_key(\u0027viewPath\u0027):\n\t\t\tviewPath \u003d payload[\u0027viewPath\u0027]\n\t\t\tviewTitle \u003d payload[\u0027viewPath\u0027]\n\t\tif payload.has_key(\u0027payload\u0027):\n\t\t\tviewPayload \u003d payload[\u0027payload\u0027]\n\t\tif payload.has_key(\u0027viewTitle\u0027):\n\t\t\tviewTitle \u003d payload[\u0027viewTitle\u0027]\n\t\t\n\tself.view.custom.viewPanels.body.viewParams \u003d viewPayload\n\tself.view.custom.viewPanels.body.viewPath \u003d viewPath\n\tself.view.custom.viewPanels.body.viewTitle \u003d viewTitle\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
