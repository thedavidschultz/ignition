    },
    "custom.filter": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilter \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], {}, value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\t\n\tif filter[\u0027dateRange\u0027][\u0027startDate\u0027] is None:\n\t\tselectedDateRange \u003d \u0027Today\u0027\n\t\tstartDate,endDate \u003d system.kanoa.date.getDateRange({\u0027selectedDateRange\u0027:selectedDateRange,\u0027clientTimeZone\u0027:self.session.props.device.timezone.id,\u0027assetPath\u0027:filter[\u0027assetPath\u0027]})\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n\t\tfilter[\u0027dateRange\u0027][\u0027startDate\u0027] \u003d startDate\n\t\tfilter[\u0027dateRange\u0027][\u0027endDate\u0027] \u003d endDate\n\t\tfilter[\u0027dateRange\u0027][\u0027selectedDateRange\u0027] \u003d selectedDateRange\n\t\t\n\treturn filter",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.viewPanels": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tinfoPanelPath \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], \u0027_assetOpsInfoPanelViewPath\u0027) or \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027 if value[\u0027assetId\u0027] and value[\u0027oeeEnabled\u0027] else None\n\tbodyPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], \u0027_assetOpsViewPath\u0027) or \u0027kanoa/mes/asset/operation/opsPanel/assetOperationPanel\u0027 if value[\u0027assetId\u0027] and value[\u0027oeeEnabled\u0027] else None\n\t\n\treturn {\n\t\t\t\u0027body\u0027: {\"viewParams\": {\"value\": {\"assetId\": value[\u0027assetId\u0027]}}, \"viewPath\": bodyPanelViewPath, \"viewTitle\": \"Main Menu\"},\n\t\t\t\u0027infoPanel\u0027: {\"viewParams\": {\"value\": {\"assetId\": value[\u0027assetId\u0027]}}, \"viewPath\": infoPanelPath}\n\t\t\t}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    }
  },
