{"onPageStartup":"\n\tlog = system.util.getLogger(\"kanoaStartup\")\n\tlog.info(\"\tSession Event Page Startup called for pageId=%s path=%s\" % (page.props.pageId, page.props.path))\n\t\n\tdefaultSessionProperties = {\n\t\t\t\t\t\t\t\t\t'navigation': \n\t\t\t\t\t\t\t\t\t\t{'history': [{'path': page.props.path, 'name': 'Home', 'type': 'page', 'params': None}], 'currentIndex': 0},\n\t\t\t\t\t\t\t\t\t'selectors':\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t'assetPath':None,\n\t\t\t\t\t\t\t\t\t'dateRange': {'startDate': None, 'endDate': None, 'selectedRange':'Today'},\n\t\t\t\t\t\t\t\t\t'woInfo': {\"product\": None, \"scheduleId\": None, \"woId\": None}},\n\t\t\t\t\t\t\t\t\t'enterpriseView': {\"expand\": True, \"openState\": False, \"selectedRange\": \"Today\"}\n\t\t\t\t\t\t\t\t}\n\t\n\tpageId = page.props.pageId\n\n\t# In Designer, viewPath may appear as pageId; in client it's usually a UUID\n\tif '/' in pageId or pageId == 'session-props':\n\t\tpageId = 'designer'\n\n\t# Ensure custom structure exists\n\tif 'kanoa' not in page.session.custom:\n\t\tpage.session.custom['kanoa'] = {}\n\n\tif pageId not in page.session.custom.kanoa:\n\t\tlog.info(\"Creating session properties for navigation, selectors\")\n\t\tpage.session.custom.kanoa[pageId] = defaultSessionProperties\n\t\treturn\n\n\ttry:\n\t\tnavigation = page.session.custom.kanoa[pageId].navigation\n\t\tinitialPage = navigation.history[navigation.currentIndex]\n\n\t\trawParams = initialPage.get('params', None)\n\t\tparams = system.util.jsonDecode(rawParams) if rawParams else {}\n\n\t\tpath = initialPage.get('path', '/')\n\t\tif path == '/':\n\t\t\tsystem.perspective.navigate(page=path, params=params)\n\t\telse:\n\t\t\tsystem.perspective.navigate(view=path, params=params)\n\n\texcept Exception as e:\n\t\tlog.warn(\"Page exists but navigation restore failed (%s). Recreating defaults.\" % e)\n\t\tpage.session.custom.kanoa[pageId] = defaultSessionProperties\n\t\n\treturn","onBarcodeDataReceived":"\t","onBluetoothReceived":"\t","onAccelerometerDataReceived":"\t","onNdefDataReceived":"\t"}