  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t\n\tstoredAssetPath \u003d system.kanoa.utilities.getStoredAssetPath(self)\n\tassetType \u003d system.kanoa.utilities.getFieldValue(\u0027assetTypeName\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: storedAssetPath}))\n\tif assetType \u003d\u003d \u0027line\u0027:\n\t\tparentPath \u003d \u0027\\\\\u0027.join(storedAssetPath.split(\u0027\\\\\u0027)[:-1])\n\t\tsystem.kanoa.utilities.storeAssetPath(self, parentPath)\n\tself.custom.currentAssetPath \u003d system.kanoa.utilities.getStoredAssetPath(self)\n\tself.view.refreshBinding(\u0027custom.assets\u0027)\n\treturn"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {},
  "propConfig": {
    "custom.assets": {
      "binding": {
        "config": {
          "path": "view.custom.security.userId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tstoredAssetPath \u003d system.kanoa.utilities.getStoredAssetPath(self) or \u0027\u0027\n\tif storedAssetPath \u003d\u003d \u0027\u0027:\n\t\tdata \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetTypeName\u0027: \u0027enterprise\u0027, \u0027userId\u0027: value}))\n\telse:\n\t\tsystem.perspective.print(\u0027assetPath is not None\u0027)\n\t\tparentId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: storedAssetPath}))\n\t\tdata \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027parentId\u0027: parentId, \u0027userId\u0027: value}))\n\treturn data",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentAssetPath": {
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "path": "session.props.auth.user"
        },
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value)\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    }
  },
