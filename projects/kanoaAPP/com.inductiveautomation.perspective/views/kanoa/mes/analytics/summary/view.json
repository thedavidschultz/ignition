        },
        {
          "name": "initialize",
          "params": [],
          "script": "\t\n\t#Called by some onStartup event in this view\n\tself.custom.selectedGroups \u003d None\n\tself.clearData()\n\t\n\treturn"
        },
        {
          "name": "getData",
          "params": [],
          "script": "\n\tfilters \u003d self.view.custom.filter\n\tif filters[\u0027assetId\u0027] is None and filters[\u0027assetGroupId\u0027] is None:\n\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027No assets found\u0027})\n\t\treturn []\n\t\n\tparamsDict \u003d {\u0027oeeEnabled\u0027: True, \u0027enabled\u0027: True}\n\tif filters[\u0027assetId\u0027]:\n\t\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027:filters[\u0027assetId\u0027]}))\n\t\tparamsDict[\u0027assetPath\u0027] \u003d assetPath + \u0027%\u0027\n\t\t\n\tif filters[\u0027assetGroupId\u0027] is not None: paramsDict[\u0027assetGroupIdList\u0027] \u003d [filters[\u0027assetGroupId\u0027]]\n\t\n\tself.view.custom.assets \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets(paramsDict))\n\t\n\tif len(self.view.custom.assets) \u003e 0:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Getting summary for %s assets\u0027%len(self.view.custom.assets)})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027No assets found\u0027})\n\t\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
