{
  "custom": {}, 
  "params": {
    "rows": [
      {
        "editable": false, 
        "pattern": "{:,.1f}", 
        "label": "Scheduled Run Time", 
        "number": 0, 
        "unit": "minutes"
      }, 
      {
        "pattern": "{:,.1f}", 
        "label": "Planned Run Time", 
        "number": 0, 
        "unit": "minutes"
      }, 
      {
        "pattern": "{:,.1f}", 
        "label": "Actual Run Time", 
        "number": 0, 
        "unit": "minutes"
      }
    ], 
    "title": "test"
  }, 
  "props": {
    "defaultSize": {
      "width": 1000, 
      "height": 400
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "borderColor": "--kcGray-30", 
        "borderTopLeftRadius": "5px", 
        "borderBottomLeftRadius": "5px", 
        "borderWidth": "1px", 
        "gap": 5, 
        "borderBottomRightRadius": "5px", 
        "borderTopRightRadius": "5px", 
        "borderStyle": "solid"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "backgroundColor": "--kcPrimaryContainer", 
            "textAlign": "center", 
            "paddingBottom": "5px", 
            "paddingTop": "5px", 
            "fontWeight": "bold"
          }, 
          "textStyle": {
            "classes": "kanoa/font/titleSmall"
          }
        }, 
        "meta": {
          "domId": "title", 
          "name": "title"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn True if value else False", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.title"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.title"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.flex-repeater", 
        "props": {
          "elementPosition": {
            "grow": 0, 
            "shrink": 0, 
            "basis": "auto"
          }, 
          "useDefaultViewWidth": false, 
          "path": "kanoa/mes/analytics/reliability/tableRow", 
          "style": {
            "gap": 5, 
            "marginBottom": "5px"
          }, 
          "useDefaultViewHeight": false, 
          "direction": "column"
        }, 
        "meta": {
          "domId": "rptRows", 
          "name": "rptRows"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.rows"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.rows": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.title": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}