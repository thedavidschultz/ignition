                {
                  "code": "\t\n\tif value is None: return []\n\tassetPath \u003d value[\u0027assetPath\u0027] if (value[\u0027assetPath\u0027] or None) is not None else \u0027xxx\u0027\n\tparamsDict \u003d {\u0027assetPath\u0027: assetPath, \u0027oeeEnabled\u0027: True, \u0027enabled\u0027: True}\n\tshowLevels \u003d value[\u0027displayOptions\u0027][\u0027showLevels\u0027]\n\tif showLevels \u003d\u003d -1: \n\t\tparamsDict[\u0027assetPath\u0027] \u003d assetPath + \u0027%\u0027\n\t\tassets \u003d system.kanoa.asset.getAssets(paramsDict)\n\telif showLevels \u003d\u003d 1: \n\t\tparentAsset \u003d system.kanoa.asset.getAssets(paramsDict)\n\t\tparentId \u003d self.view.custom.filter.assetId\n\t\tchildAssets \u003d system.kanoa.asset.getAssets({\u0027parentId\u0027: parentId})\n\t\tassets \u003d system.dataset.appendDataset(parentAsset, childAssets)\n\t\tassets \u003d system.dataset.toPyDataSet(assets)\n\telse:\n\t\tassets \u003d system.kanoa.asset.getAssets(paramsDict)\n\t\t\n\treturn [{\u0027values\u0027: {\n\t\t\"assetId\": row[\u0027assetId\u0027], \n\t\t\"startDate\": value[\u0027dateRange\u0027][\u0027startDate\u0027],\n\t\t\"endDate\": value[\u0027dateRange\u0027][\u0027endDate\u0027],\n\t\t\"displayOptions\": value[\u0027displayOptions\u0027],\n\t\t\"interval\": self.view.params.value.interval}\n\t} for row in assets]",
                  "type": "script"
