  "propConfig": {
    "custom.cellData": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetId"
        },
        "transforms": [
          {
            "code": "\t\t\n\t## add validation to check that asset is of asset type \u0027line\u0027\n\tcellData \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027parentId\u0027: value or -1}))\n\treturn [row for row in cellData]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentCellIndex": {
      "binding": {
        "config": {
          "expression": "now({view.params.value.options.durationSecs} | \u00273000\u0027)"
        },
        "transforms": [
          {
            "code": "\t\t\n\tif self.custom.currentCellIndex is None: self.custom.currentCellIndex \u003d 0\n\t\n\tnumCells \u003d len(self.custom.cellData)\n\tif self.custom.currentCellIndex \u003e\u003d numCells - 1:\n\t\tself.custom.currentCellIndex \u003d 0\n\telse:\n\t\tself.custom.currentCellIndex +\u003d 1\n\treturn self.custom.currentCellIndex",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.currentCellPath": {
      "binding": {
        "config": {
          "path": "view.custom.currentCellIndex"
        },
        "transforms": [
          {
            "code": "\tif len(self.custom.cellData):\n\t\treturn self.custom.cellData[value][\u0027assetPath\u0027]\n\treturn \u0027\u0027",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentShift": {
      "binding": {
        "config": {
          "path": "view.params.value.assetPath"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.shift.getCurrentShift({\u0027assetPath\u0027: value})",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.oeeData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tstartDate \u003d value[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d value[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tassetId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027] or -1}))\n\t\n\tnumHours \u003d system.date.hoursBetween(startDate, endDate)\n\tself.custom.data.interval \u003d \u0027Hour\u0027 if numHours \u003c\u003d 60 else \u0027Day\u0027\n\treturn system.kanoa.event.getOEEDataByInterval(assetId, startDate, endDate, self.custom.data.interval)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.oeeSummary": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tstartDate \u003d value[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d value[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tassetId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027] or \u0027None\u0027}))\t\t\n\treturn system.kanoa.event.getOEESummary({\u0027assetId\u0027:assetId or -1, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate})\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showOEEMetricSelector\u0027): filters[\u0027showOEEMetricSelector\u0027] \u003d False\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d False\n\tif not filters.has_key(\u0027oeeMetric\u0027): filters[\u0027oeeMetric\u0027] \u003d False\n\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.previousShift": {
      "binding": {
        "config": {
          "path": "view.params.values.assetId"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.shift.getPreviousShift({\u0027assetId\u0027: value})",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 445,
      "width": 615
    }
  },
