{
  "custom": {
    "oeeData": {
      "colors": {
        "availability": "#444444",
        "oee": "#444444",
        "performance": "#444444",
        "quality": "#444444"
      },
      "oee": {
        "a": 0.5217391304347826,
        "oee": 0.1762632197414806,
        "p": 1,
        "q": 0.9
      }
    }
  },
  "params": {
    "value": {
      "availability": {
        "color": "#444444",
        "fontColor": "",
        "value": 0.5217391304347826
      },
      "oee": {
        "color": "#444444",
        "fontColor": "",
        "value": 0.1762632197414806
      },
      "performance": {
        "color": "#444444",
        "fontColor": "",
        "value": 1
      },
      "quality": {
        "color": "#444444",
        "fontColor": "",
        "value": 0.9
      }
    }
  },
  "propConfig": {
    "custom.oeeData": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "transforms": [
          {
            "code": "\n\tcolors \u003d {\u0027colorGood\u0027: \"--kcGood\", \u0027colorWarn\u0027: \"--kcOK\", \u0027colorBad\u0027: \"--kcBad\"}\n\t\n\ta \u003d value[\u0027availability\u0027][\u0027value\u0027] or 0.0\n\tp \u003d value[\u0027performance\u0027][\u0027value\u0027]  or 0.0\n\tq \u003d value[\u0027quality\u0027][\u0027value\u0027]  or 0.0\n\toee \u003d value[\u0027oee\u0027][\u0027value\u0027]  or 0.0\n\n\taColor \u003d value[\u0027availability\u0027][\u0027color\u0027]\n\tpColor \u003d value[\u0027performance\u0027][\u0027color\u0027]\n\tqColor \u003d value[\u0027quality\u0027][\u0027color\u0027]\n\toeeColor \u003d value[\u0027oee\u0027][\u0027color\u0027]\n\t\n\tcolors \u003d {\u0027availability\u0027: aColor, \u0027performance\u0027: pColor, \u0027quality\u0027: qColor, \u0027oee\u0027: oeeColor}\n\toeeDict \u003d {\u0027a\u0027: a, \u0027p\u0027: p, \u0027q\u0027: q, \u0027oee\u0027: oee}\n\treturn {\u0027oee\u0027: oeeDict, \u0027colors\u0027: colors}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 53,
      "width": 350
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "lblOEE"
        },
        "position": {
          "basis": "100px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.custom.oeeData.colors.oee"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "this.props.style.backgroundColor"
              },
              "transforms": [
                {
                  "code": "\treturn \"#ffffff\" if value \u003d\u003d \"--kcBad\" or value \u003d\u003d \"--kcGood\" else \"#000000\"",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.oeeData.oee.oee"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn \"OEE {:g}%\".format(round((value or 0)*100.0,0))",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomLeftRadius": 20,
            "borderBottomRightRadius": 20,
            "borderTopLeftRadius": 20,
            "borderTopRightRadius": 20,
            "marginLeft": 2,
