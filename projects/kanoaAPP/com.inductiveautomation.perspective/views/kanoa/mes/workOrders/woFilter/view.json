  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t\n\tself.getChild(\"root\").custom.mesTagProvider \u003d system.kanoa.config.getTagProvider(\u0027MES\u0027)\n\t\n\treturn"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "filterStates": [
      "Scheduled",
      "Released",
      "Closed",
      "In Progress",
      "Hold",
      "Completed"
    ]
  },
  "propConfig": {
    "custom.workOrderStates": {
      "binding": {
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.order.getProductionOrderStates({\u0027enabled\u0027:True})",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.filterStates": {
      "binding": {
        "config": {
          "struct": {
            "closed": "{/root/tglClosed.props.selected}",
            "completed": "{/root/tglCompleted.props.selected}",
            "hold": "{/root/tglHold.props.selected}",
            "inProgress": "{/root/tglInProgress.props.selected}",
            "released": "{/root/tglReleased.props.selected}",
            "scheduled": "{/root/tglScheduled.props.selected}"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "code": "\tfilterStates \u003d []\n\tif value[\u0027scheduled\u0027]:\tfilterStates.append(\u0027Scheduled\u0027)\n\tif value[\u0027released\u0027]: filterStates.append(\u0027Released\u0027)\n\tif value[\u0027closed\u0027]: filterStates.append(\u0027Closed\u0027)\t\t\n\tif value[\u0027inProgress\u0027]: filterStates.append(\u0027In Progress\u0027)\t\t\n\tif value[\u0027hold\u0027]: filterStates.append(\u0027Hold\u0027)\n\tif value[\u0027completed\u0027]:\tfilterStates.append(\u0027Completed\u0027)\n\t\n\treturn filterStates",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "paramDirection": "output",
      "persistent": true
    }
  },
