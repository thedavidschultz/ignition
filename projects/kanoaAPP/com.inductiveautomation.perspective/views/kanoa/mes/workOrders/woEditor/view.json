          "script": "\n\tinfo \u003d dict(self.view.custom.info)\n\tsystem.perspective.print(\"saveData() called with %s\"%info)\n\n\tif info[\u0027note\u0027] \u003d\u003d \u0027\u0027: info[\u0027note\u0027] \u003d None\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\ttry:\t#units dropdown allows custom options to be created. If it is not an int, then user has just created this unit\n\t\tint(info[\u0027itemUnitId\u0027])\n\texcept:\n\t\tinfo[\u0027itemUnitId\u0027] \u003d system.kanoa.item.addItemUnit(info[\u0027itemUnitId\u0027], userId)\n\t\n\tif len(self.view.params.workOrders) \u003d\u003d 0:\t#Ths is a new WorkOrder\n\t\tif system.kanoa.utilities.getFieldValue(\u0027workOrderId\u0027, system.kanoa.order.getProductionOrders({\u0027workOrderName\u0027: info[\u0027workOrderName\u0027]})) is not None:\n\t\t\tsystem.perspective.print(\"A work order of this name already exists\")\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027A work order of this name already exists\u0027})\n\t\t\treturn\n\t\n\t\tworkOrderId \u003d system.kanoa.order.addProductionOrder(info, userId)\t\n\t\tsystem.perspective.print(\"addProductionOrder() returned %s\"%workOrderId)\n\t\tself.view.params.workOrders.append(workOrderId)\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Work order created\u0027})\n\telif len(self.view.params.workOrders) \u003d\u003d 1:\t#We are editing a single workOrder\n\t\tretVal \u003d system.kanoa.order.updateProductionOrder(info, userId)\n\t\tsystem.perspective.print(\"updateProductionOrder() returned %s\"%retVal)\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Work order updated\u0027})\n\telse:\t#This is a bulk workOrder update\n\t\tfor k,v in info.items():\n\t\t\tif k in (\u0027dueDate\u0027, \u0027itemId\u0027, \u0027modeId\u0027, \u0027reqdQty\u0027, \u0027itemUnitId\u0027, \u0027workOrderStatusId\u0027, \u0027note\u0027):\n\t\t\t\tfor workOrderId in self.view.params.workOrders:\n\t\t\t\t\tif (v or None) is not None:\n\t\t\t\t\t\tretVal \u003d system.kanoa.order.updateProductionOrderField(workOrderId, k, v, userId)\n\t\t\t\t\t\tsystem.perspective.print(\"updateProductionOrderField() returned %s\"%retVal)\n\t\t\t\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Work order updated\u0027})\n\n\timport time\n\ttime.sleep(1)\t#give a chance for the user to see the success popup\n\n\tsystem.perspective.sendMessage(\u0027workOrderUpdate\u0027, {\u0027dueDate\u0027: info[\u0027dueDate\u0027]})\n\treturn\t"
        }
