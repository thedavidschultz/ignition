{
  "custom": {},
  "params": {
    "value": null
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 37,
      "width": 83
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "Image",
          "name": "Image"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "this.props.source"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value !\u003d \u0027No image\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.source": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn value if (value or None) is not None else \"/system/images/Logos/mes.png\"\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "fit": {
            "height": 30,
            "mode": "contain",
            "width": 30
          },
          "style": {
            "margin": "5px"
          }
        },
        "type": "ia.display.image"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}