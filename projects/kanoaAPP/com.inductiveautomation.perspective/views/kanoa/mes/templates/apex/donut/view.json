{
  "custom": {}, 
  "params": {
    "data": {
      "labels": [
        "Running", 
        "Blocked", 
        "Safety", 
        "Machine Fault", 
        "Starved", 
        "Not enough personnel", 
        "Electrical", 
        "Mechanical", 
        "Quality Hold", 
        "Faulted", 
        "Out of infeed material", 
        "Idle"
      ], 
      "series": [
        3352051, 
        244895, 
        204575, 
        176677, 
        24901, 
        14001, 
        7200, 
        5233, 
        4600, 
        893, 
        200, 
        134
      ]
    }
  }, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "center", 
      "style": {
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "kyvislabs.display.apexchart", 
        "props": {
          "type": "donut", 
          "options": {
            "plotOptions": {
              "radialBar": {
                "hollow": {
                  "background": "#fff"
                }, 
                "dataLabels": {
                  "total": {}, 
                  "name": {}, 
                  "value": {}
                }, 
                "barLabels": {
                  "margin": 5, 
                  "enabled": false, 
                  "useSeriesColors": true, 
                  "fontSize": "16px", 
                  "fontWeight": 600
                }
              }, 
              "treemap": {
                "dataLabels": {
                  "format": "scale"
                }
              }, 
              "pie": {
                "donut": {
                  "labels": {
                    "total": {}, 
                    "name": {}, 
                    "value": {}
                  }
                }
              }, 
              "bar": {
                "hideZeroBarsWhenGrouped": false, 
                "borderRadiusApplication": "end", 
                "isDumbbell": false, 
                "isFunnel3d": true, 
                "dataLabels": {
                  "total": {
                    "enabled": false, 
                    "offsetX": 0, 
                    "offsetY": 0, 
                    "style": {
                      "color": "#373d3f", 
                      "fontSize": "12px", 
                      "fontWeight": 600
                    }
                  }
                }, 
                "borderRadius": 10, 
                "borderRadiusWhenStacked": "last", 
                "isFunnel": false
              }, 
              "bubble": {
                "zScaling": true
              }
            }, 
            "legend": {
              "itemMargin": {
                "vertical": 0
              }, 
              "offsetY": 0, 
              "fontSize": 14, 
              "position": "right"
            }, 
            "stroke": {
              "fill": {
                "type": "solid"
              }, 
              "colors": [
                null
              ], 
              "width": 1
            }, 
            "colors": [], 
            "responsive": [
              {
                "breakpoint": 480, 
                "options": {
                  "legend": {
                    "position": "bottom"
                  }, 
                  "chart": {
                    "width": 200
                  }
                }
              }
            ], 
            "theme": {}, 
            "chart": {
              "type": "donut", 
              "background": "transparent", 
              "width": 380, 
              "events": {
                "dataPointSelection": false, 
                "beforeResetZoom": false, 
                "markerClick": false, 
                "mouseMove": false, 
                "beforeMount": false, 
                "dataPointMouseLeave": false, 
                "scrolled": false, 
                "click": false, 
                "dataPointMouseEnter": false, 
                "mounted": false, 
                "mouseLeave": false, 
                "zoomed": false, 
                "animationEnd": false, 
                "brushScrolled": false, 
                "legendClick": false, 
                "selection": false, 
                "beforeZoom": false, 
                "updated": false
              }
            }
          }
        }, 
        "meta": {
          "domId": "apexchart", 
          "name": "apexchart"
        }, 
        "position": {
          "grow": 1, 
          "basis": "338px"
        }, 
        "propConfig": {
          "props.options.stroke.colors[0]": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn kanoaScripts.colors.getCSSColor('--kcOutline', value)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "session.props.theme"
              }
            }
          }, 
          "props.options.chart.foreColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn kanoaScripts.colors.getCSSColor('--kcOnSurface', value)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "session.props.theme"
              }
            }
          }, 
          "props.series": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.data.series"
              }
            }
          }, 
          "props.options.theme.mode": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value: return 'dark'\n\telse: return 'light'", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "session.props.theme"
              }
            }
          }, 
          "props.options.labels": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.data.labels"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.data": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}