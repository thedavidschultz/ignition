{
  "custom": {}, 
  "params": {
    "data": {
      "actionText": "Action Text", 
      "actionPath": "kanoa/mes/analytics/reliability/reliabilityKPIs", 
      "imagePath": "", 
      "subHeadline": "Subheadline", 
      "supportingText": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor", 
      "headline": "Headline"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 333, 
      "height": 444
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": "--kcSurface", 
        "borderColor": "--kcOutline", 
        "borderTopLeftRadius": 12, 
        "borderBottomLeftRadius": 12, 
        "borderWidth": 1, 
        "borderBottomRightRadius": 12, 
        "borderTopRightRadius": 12, 
        "borderStyle": "solid"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "backgroundColor": "#DADCE0"
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.image", 
            "props": {
              "fit": {
                "mode": "cover"
              }
            }, 
            "meta": {
              "domId": "imgMedia", 
              "name": "imgMedia"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.source": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.data.imagePath"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxMedia", 
          "name": "flxMedia"
        }, 
        "position": {
          "basis": "222px"
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value['imagePath'] == \"\": return False\n\treturn True", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.data"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "paddingRight": 16, 
            "paddingBottom": 16, 
            "paddingTop": 16, 
            "paddingLeft": 16
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.container.flex", 
            "props": {
              "style": {
                "overflow": "visible", 
                "marginBottom": 32
              }, 
              "direction": "column"
            }, 
            "children": [
              {
                "type": "ia.display.label", 
                "props": {
                  "textStyle": {
                    "color": "--kcOnSurface", 
                    "fontFamily": "Roboto", 
                    "fontSize": "16px", 
                    "lineHeight": "24px", 
                    "marginBottom": 8, 
                    "fontWeight": "700"
                  }
                }, 
                "meta": {
                  "domId": "lblHeadline", 
                  "name": "lblHeadline"
                }, 
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property", 
                      "config": {
                        "path": "view.params.data.headline"
                      }
                    }
                  }
                }
              }, 
              {
                "type": "ia.display.label", 
                "props": {
                  "textStyle": {
                    "color": "--kcOnSurface", 
                    "fontFamily": "Roboto", 
                    "fontSize": "14px", 
                    "lineHeight": "20px"
                  }
                }, 
                "meta": {
                  "domId": "lblSubHeadline", 
                  "name": "lblSubHeadline"
                }, 
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property", 
                      "config": {
                        "path": "view.params.data.subHeadline"
                      }
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxHeadline", 
              "name": "flxHeadline"
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "marginBottom": 32
              }, 
              "textStyle": {
                "color": "--kcOnSurface", 
                "fontFamily": "Roboto", 
                "fontSize": "14px", 
                "lineHeight": "20px"
              }
            }, 
            "meta": {
              "domId": "lblSupportingText", 
              "name": "lblSupportingText"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.data.supportingText"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.container.flex", 
            "props": {
              "alignItems": "flex-end", 
              "justify": "flex-end", 
              "style": {
                "paddingBottom": 4, 
                "paddingTop": 4
              }, 
              "direction": "column"
            }, 
            "children": [
              {
                "type": "ia.input.button", 
                "props": {
                  "style": {
                    "backgroundColor": "--kcPrimary", 
                    "borderTopLeftRadius": "50px", 
                    "borderBottomLeftRadius": "50px", 
                    "borderBottomRightRadius": "50px", 
                    "borderTopRightRadius": "50px"
                  }, 
                  "textStyle": {
                    "color": "--kcOnPrimary", 
                    "paddingRight": 24, 
                    "fontFamily": "roboto", 
                    "paddingBottom": 8, 
                    "fontSize": "14px", 
                    "lineHeight": 2, 
                    "paddingTop": 8, 
                    "paddingLeft": 24, 
                    "fontWeight": "normal"
                  }
                }, 
                "meta": {
                  "domId": "btnAction", 
                  "name": "btnAction"
                }, 
                "position": {
                  "grow": 1
                }, 
                "events": {
                  "dom": {
                    "onClick": {
                      "type": "script", 
                      "scope": "G", 
                      "config": {
                        "script": "\t\t\tparams= {\n\t\t\t\t\t\t\"path\": self.view.params.data.actionPath,\n\t\t\t\t\t\t\"name\": self.view.params.data.headline,\n\t\t\t\t\t\t\"type\": \"view\",\n\t\t\t\t\t\t\"params\": {}\n\t\t\t\t\t}\n\t\t\n\t\t\tsystem.perspective.sendMessage(\"updateNavigation\", payload=params, scope='page')"
                      }
                    }
                  }
                }, 
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property", 
                      "config": {
                        "path": "view.params.data.actionText"
                      }
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxActions", 
              "name": "flxActions"
            }
          }
        ], 
        "meta": {
          "domId": "flxTextContent", 
          "name": "flxTextContent"
        }, 
        "position": {
          "basis": "222px"
        }
      }
    ], 
    "meta": {
      "domId": "flxContentCard", 
      "name": "flxContentCard"
    }
  }, 
  "propConfig": {
    "params.data": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}