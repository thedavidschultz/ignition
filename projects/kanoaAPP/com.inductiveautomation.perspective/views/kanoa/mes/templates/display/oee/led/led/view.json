{
  "custom": {
    "color": "#FF0000",
    "name": "P",
    "tooltip": "P: 0%",
    "value": 0
  },
  "params": {
    "color": "",
    "label": "",
    "name": "P",
    "ranges": [
      {
        "color": "#FF0000",
        "max": 0.3
      },
      {
        "color": "#EFB110",
        "max": 0.6
      },
      {
        "color": "#0099EC",
        "max": 1
      }
    ],
    "selectable": false,
    "selected": false,
    "value": ""
  },
  "propConfig": {
    "custom.color": {
      "binding": {
        "config": {
          "struct": {
            "color": "{view.params.color}",
            "ranges": "{view.params.ranges}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tcolor \u003d value.color or None\n\t\n\tif color is not None: return color\n\t\n\tranges \u003d sorted(value.ranges, key \u003d lambda a: a.max)\n\tvalue \u003d value.value\n\t\n\tfor range in ranges:\n\t\tif value \u003c\u003d range.max: return range.color\n\t\n\treturn value",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.name": {
      "binding": {
        "config": {
          "struct": {
            "label": "{view.params.label}",
            "name": "{view.params.name}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.name if value.name !\u003d \u0027\u0027 else value.label",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.ranges": {
      "persistent": true
    },
    "custom.selected": {
      "persistent": true
    },
    "custom.textColor": {
      "persistent": true
    },
    "custom.tooltip": {
      "binding": {
        "config": {
          "struct": {
            "name": "{view.custom.name}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tname \u003d value.name\n\tvalue \u003d int(value.value * 100)\n\t\n\treturn \u0027%s: %d%%\u0027 % (name, value)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.val": {
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value or 0",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fontColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ranges": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selectable": {
      "onChange": {
        "enabled": null,
        "script": "\tif not currentValue.value:\n\t\tself.params.selected \u003d False"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "onChange": {
        "enabled": null,
        "script": "\tif self.params.selectable:\n\t\tif origin \u003d\u003d \u0027Browser\u0027:\n\t\t\tsystem.perspective.sendMessage(\u0027status led selected\u0027, {\u0027name\u0027: self.custom.name if currentValue.value else \u0027\u0027 })\n\telse:\n\t\tself.params.selected \u003d False"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 30
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "lblValue",
          "name": "lblValue",
          "selectable": false
        },
        "position": {
          "height": 0.9,
          "width": 1,
          "y": 0.2
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.custom.color"
              },
              "enabled": false,
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn system.kanoa.utilities.getContrastingColor(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "color": "#FFFFFF",
            "fontWeight": "bold",
            "textAlign": "center"
          },
          "textStyle": {
            "fontSize": "8px",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "icoWarn",
          "name": "icoWarn",
          "tooltip": {
            "enabled": true,
            "location": "bottom"
          }
        },
        "position": {
          "height": 0.5,
          "width": 0.5,
          "x": 0.25
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.custom.name"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\tif value \u003d\u003d \u0027Performance\u0027: return \u0027Performance is \u003e 100%. This indicates that the standard rate may not be set correctly for the item running on this asset\u0027\n\treturn \u0027This kpi \u003e 100%. This tends to indicate an issue with the underlying data\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn (value or 0) \u003e 1",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "color": "--kcGray-0",
          "path": "material/warning"
        },
        "type": "ia.display.icon"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tif self.view.params.selectable:\n\t\tsystem.perspective.sendMessage(\u0027status led selected\u0027, {\u0027name\u0027: self.view.custom.name})"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "delay": 0,
        "enabled": true,
        "location": "top",
        "tail": false
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "bidirectional": true,
            "path": "view.custom.tooltip"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.custom.color"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn value or \u0027#444444\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.borderColor": {
        "binding": {
          "config": {
            "path": "view.params.selected"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027#444\u0027 if value else \u0027transparent\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.color": {
        "binding": {
          "config": {
            "path": "view.custom.color"
          },
          "transforms": [
            {
              "code": "\treturn system.kanoa.utilities.getContrastingColor(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "mode": "percent",
      "style": {
        "borderRadius": "50%",
        "borderStyle": "solid",
        "borderWidth": 3,
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "status led selected",
          "pageScope": true,
          "script": "\t\n\tself.view.params.selected \u003d self.view.params.name \u003d\u003d payload[\u0027name\u0027]\n\t",
          "sessionScope": false,
          "viewScope": true
        }
      ]
    },
    "type": "ia.container.coord"
  }
}