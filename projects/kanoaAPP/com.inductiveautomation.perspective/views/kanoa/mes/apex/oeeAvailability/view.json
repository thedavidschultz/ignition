                  },
                  "transforms": [
                    {
                      "code": "\n\tseries \u003d []\n\truntime \u003d 0\n\tunplanned \u003d 0\n\tplanned \u003d 0\n\tfor row in value:\n\t\truntime +\u003d row[\u0027runtimeSecs\u0027] or 0\n\t\tunplanned +\u003d row[\u0027unplannedDowntimeSecs\u0027] or 0\n\t\tplanned +\u003d row[\u0027plannedDowntimeSecs\u0027] or 0\n\t\n\treturn [round(runtime/60.0,1), round(unplanned/60.0,1), round(planned/60.0,1)]",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
