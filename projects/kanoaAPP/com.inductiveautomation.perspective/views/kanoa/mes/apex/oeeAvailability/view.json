        ],
        "$ts": 1749193200000
      },
      "startDate": {
        "$": [
          "ts",
          192,
          1749149290769
        ],
        "$ts": 1749106800000
      }
    },
    "oeeThresholds": {
      "a": 0.8,
      "aTolerance": 0.1,
      "oee": 0.6,
      "oeeTolerance": 0.1,
      "p": 0.8,
      "pTolerance": 0.1,
      "q": 0.8,
      "qTolerance": 0.1
    }
  },
  "params": {
    "data": {
      "assetId": null,
      "endDate": {
        "$": [
          "ts",
          192,
          1749149290769
        ],
        "$ts": 1749193200000
      },
      "startDate": {
        "$": [
          "ts",
          192,
          1749149290769
        ],
        "$ts": 1749106800000
      }
    }
  },
  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.oeeData": {
      "binding": {
        "config": {
          "path": "view.custom.filter"
        },
        "transforms": [
          {
            "code": "\t\n\tnumHours \u003d system.date.hoursBetween(value[\u0027startDate\u0027], value[\u0027endDate\u0027])\n\tself.custom.data.interval \u003d \u0027Hour\u0027 if numHours \u003c\u003d 60 else \u0027Day\u0027\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getOEEDataByInterval(value.assetId, value.startDate, value.endDate, self.custom.data.interval))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.oeeSummary": {
      "binding": {
        "config": {
          "path": "view.custom.filter"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.event.getOEESummary({\u0027assetId\u0027:value.assetId or -1, \u0027startDate\u0027: value.startDate, \u0027endDate\u0027: value.endDate}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.stateDataSummary": {
      "binding": {
        "config": {
          "path": "view.custom.filter"
        },
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetId\u0027] is None: return []\n\tparamsDict \u003d {\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027endDate\u0027], \u0027showDowntimeOnly\u0027: False, \u0027showChanged\u0027: None, \u0027durationSecs\u0027: 0}\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEventsSummary(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filter": {
      "binding": {
        "config": {
          "path": "view.params.data"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.oeeThresholds": {
      "binding": {
        "config": {
          "path": "view.custom.filter.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.asset.getAssetOEEThresholds({\u0027assetId\u0027: value})",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 679,
      "width": 821
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "apexBarAvailability",
          "name": "apexBarAvailability"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "props.options.plotOptions.bar.colors": {
            "binding": {
              "config": {
                "path": "view.custom.oeeThresholds"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\ttarget \u003d value[\u0027a\u0027]\n\ttgtThreshold \u003d value[\u0027targetThreshold\u0027]\n\tif target is None: return 0\n\t\n\tminTarget \u003d (target - tgtThreshold) * 100.0\n\tmaxTarget \u003d target * 100.0\n\t\t\n\ttheme \u003d self.session.props.theme\n\treturn {\"ranges\": [\n\t\t\t\t\t\t{\"from\": 0, \"to\": minTarget, \"color\": kanoaScripts.colors.getCSSColor(\u0027--kcBad\u0027, theme)+\u0027ff\u0027}, \n\t\t\t\t\t\t{\"from\": minTarget, \"to\": maxTarget, \"color\": kanoaScripts.colors.getCSSColor(\u0027--kcOK\u0027, theme)+\u0027ff\u0027}, \n\t\t\t\t\t \t{\"from\": maxTarget, \"to\": 100.0, \"color\": kanoaScripts.colors.getCSSColor(\u0027--kcGood\u0027, theme)+\u0027ff\u0027}\n\t\t\t\t\t\t]\n\t\t\t}",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.theme.mode": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "transforms": [
                {
                  "code": "\tif \u0027dark\u0027 in value: return \u0027dark\u0027\n\telse: return \u0027light\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.series": {
            "binding": {
              "config": {
                "path": "view.custom.data.oeeData"
              },
              "transforms": [
                {
                  "code": "\n\taData \u003d []\n\tdateFormat \u003d \"MM/dd HH:mm\" if self.view.custom.data.interval \u003d\u003d \u0027Hour\u0027 else \"MM/dd\"\n\tgatewayOffSetMins \u003d system.kanoa.date.getGatewayTimeZoneOffsetMins()\n\tclientOffsetMins \u003d int(self.session.props.device.timezone.utcOffset * 60)\n\toffsetMins \u003d clientOffsetMins - gatewayOffSetMins\n\n\tfor row in value:\n\t\ttStamp \u003d system.date.format(system.date.addMinutes(row[\u0027hourTimeStamp\u0027], offsetMins), dateFormat)\t\n\t\taData.append({\"x\": tStamp, \"y\": (row[\u0027availability\u0027] or 0) * 100.0})\n\t\t\n\treturn [{\"name\": \"Availability\", \"data\": aData}]\n\t\n\t# need to return an array with 3 objects\n\t# each object includes a \"name\" with the series label\n\t# each object includes a data array; which is an array of dictionaires\n\t# each dictionary in the data array should have a t_stamp and a realistic0 value for plotting",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "options": {
            "chart": {
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": false,
                "legendClick": false,
                "markerClick": false,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "zoomed": false
              },
              "height": 350,
              "stacked": true,
              "toolbar": {
                "show": false
              },
              "type": "bar"
            },
            "dataLabels": {
              "enabled": false
            },
            "legend": {
              "floating": true,
              "horizontalAlign": "right",
              "offsetX": -5,
              "offsetY": -25,
              "position": "top"
            },
            "markers": {
              "size": 1
            },
            "plotOptions": {
              "bar": {
                "borderRadius": 2
              }
            },
            "stroke": {
              "curve": "smooth"
            },
            "theme": {},
            "title": {
              "align": "left",
              "text": "OEE Availability"
            },
            "yaxis": {
              "labels": {
                "formatter": "function (value) {return value.toFixed(1);}"
              },
              "max": 100,
              "min": 0,
              "title": {
                "text": "OEE Availability %"
              }
            }
          },
          "style": {
            "classes": "kanoa/container"
          },
          "type": "bar"
        },
        "type": "kyvislabs.display.apexchart"
      },
