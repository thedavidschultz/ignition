        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.image.icon.path": {
            "binding": {
              "config": {
                "path": "view.custom.modeInfo.iconPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "struct": {
                  "enabled": "{view.params.enabled}",
                  "value": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value[\u0027enabled\u0027]: return value[\u0027value\u0027][\u0027itemStateColor\u0027] or \u0027#FFFFFF\u0027\n\treturn \u0027#D5D5D5\u0027",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.borderStyle": {
            "binding": {
              "config": {
                "path": "this.props.style.backgroundColor"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\treturn \u0027solid\u0027 if value \u003d\u003d \u0027#FFFFFF\u0027 else \u0027none\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "this.props.style.backgroundColor"
              },
              "transforms": [
                {
                  "code": "\treturn system.kanoa.utilities.getContrastingColor(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\treturn value[\u0027itemStateName\u0027] or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {}
          },
          "style": {
            "borderColor": "#D5D5D5",
            "borderWidth": "1px",
            "classes": "kanoa/button/filled"
