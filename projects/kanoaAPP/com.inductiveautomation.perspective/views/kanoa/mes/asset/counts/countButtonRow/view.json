          "script": "\n#\tsystem.perspective.print(\u0027itemStateCountSelected msg rcvd with %s\u0027%payload)\n\tself.view.custom.selectedCountEvent \u003d payload[\u0027value\u0027]\n\n\treturn",
          "sessionScope": false,
