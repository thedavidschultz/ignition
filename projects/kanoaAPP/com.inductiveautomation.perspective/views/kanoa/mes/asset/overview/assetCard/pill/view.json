{
  "custom": {}, 
  "params": {
    "value": {
      "color": "--kcRed-50", 
      "label": "oee: 5%", 
      "bgColor": "--kcGray-0", 
      "value": 0.7
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 22, 
      "height": 118
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "alignContent": "center", 
      "justify": "flex-end", 
      "style": {
        "borderColor": "--kcGray-30", 
        "classes": "kanoa/border", 
        "borderRadius": 50
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "borderRadius": 9, 
            "width": "100%"
          }
        }, 
        "meta": {
          "tooltip": {
            "location": "center", 
            "text": "oee: 5%"
          }, 
          "domId": "labelBar", 
          "name": "labelBar"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.color"
              }
            }
          }, 
          "props.style.height": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or 0.02", 
                  "type": "script"
                }, 
                {
                  "type": "format", 
                  "formatValue": "percent", 
                  "formatType": "numeric"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.value"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "tooltip": {
        "enabled": true, 
        "location": "top"
      }, 
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "path": "view.params.value.bgColor"
          }
        }
      }, 
      "meta.tooltip.text": {
        "binding": {
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "path": "view.params.value.label"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}