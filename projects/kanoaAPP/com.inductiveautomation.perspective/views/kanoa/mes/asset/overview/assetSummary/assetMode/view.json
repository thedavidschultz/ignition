{
  "custom": {}, 
  "params": {
    "value": {
      "color": null, 
      "eqPath": "Kanoa Testing\\Ops Test Site\\Ops Test Area\\JZ Test Area", 
      "source": null, 
      "mode": null, 
      "name": "JZ Test Area"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 297, 
      "height": 53
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5, 
        "backgroundColor": "--kcSurface", 
        "classes": "kanoa/border kanoa/clickable"
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "color": "", 
            "classes": "kanoa/font/bodyMedium"
          }
        }, 
        "meta": {
          "domId": "lblName", 
          "name": "lblName"
        }, 
        "position": {
          "grow": 1, 
          "basis": "178px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.name"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.icon", 
        "props": {
          "style": {
            "classes": "", 
            "borderTopLeftRadius": 100, 
            "marginRight": "5px", 
            "borderBottomLeftRadius": 100, 
            "borderBottomRightRadius": 100, 
            "borderTopRightRadius": 100
          }
        }, 
        "meta": {
          "domId": "Icon", 
          "name": "Icon"
        }, 
        "position": {
          "basis": "30px"
        }, 
        "propConfig": {
          "props.style.color": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.color"
              }
            }
          }, 
          "props.path": {
            "binding": {
              "transforms": [
                {
                  "code": "\n\tif value == 'Schedule': icon = 'material/calendar_today'\n\telif value == 'PLC': icon = 'kanoa/cell'\n\telif value in ('Operator', 'Operator Run'): icon = 'material/engineering'\n\telse: icon = ''\n\t\n\treturn icon", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.source"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "paddingRight": 10, 
            "borderTopLeftRadius": 20, 
            "paddingBottom": 10, 
            "borderBottomLeftRadius": 20, 
            "borderBottomRightRadius": 20, 
            "borderTopRightRadius": 20, 
            "paddingTop": 10, 
            "paddingLeft": 10
          }, 
          "textStyle": {
            "textAlign": "center", 
            "classes": "kanoa/font/bodyMedium"
          }
        }, 
        "meta": {
          "domId": "lblMsg", 
          "name": "lblMsg"
        }, 
        "position": {
          "basis": "150px"
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.color"
              }
            }
          }, 
          "props.style.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\tif value is None: return ''\n\treturn system.kanoa.utilities.getContrastingColor(value)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.value.color"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or 'Unknown'", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.mode"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "events": {
      "dom": {
        "onClick": {
          "type": "script", 
          "scope": "G", 
          "config": {
            "script": "\t\n\tsystem.kanoa.utilities.storeAssetPath(self, self.view.params.value.eqPath)\n\tparams= {\"path\": \"kanoa/mes/asset/operation/main\", \"name\": \"Asset Operation\", \"type\": \"view\", \"params\": {}}\n\tsystem.perspective.sendMessage(\"updateNavigation\", payload=params, scope='page')\n\t\n\treturn"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}