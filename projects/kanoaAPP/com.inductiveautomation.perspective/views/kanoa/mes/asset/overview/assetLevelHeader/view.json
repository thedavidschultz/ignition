      "level": 0
    }
  },
  "propConfig": {
    "custom.clearView": {
      "onChange": {
        "enabled": null,
        "script": "\n\tif currentValue.value:\n\t\tself.params.value.assetInfo.oeeEnabled \u003d False\n\t\tself.params.value.assets \u003d []\n\t\tself.params.value.childAssets \u003d []\n\t\tself.params.value.assetName \u003d \u0027\u0027\n\t\tself.params.value.assetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: -1}), 0)\n\t\t\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tself.custom.clearView \u003d False\n\t\t\n\treturn"
      },
      "persistent": true
    },
    "custom.expand": {
      "binding": {
        "config": {
          "path": "view.params.value.expand"
        },
        "overlayOptOut": true,
        "type": "property"
      },
      "persistent": true
    },
    "custom.showInfolevel": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn \u0027status\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\t\n\tif self.view.params.value.assetInfo.assetPath:\n\t\tpayload \u003d {\u0027showInfoLevel\u0027: currentValue.value, \u0027assetPath\u0027: self.view.params.value.assetInfo.assetPath}\n\t\tsystem.perspective.sendMessage(\"showAssetInfo\", payload)\n\t\t\n\treturn\t\t"
      },
      "persistent": true
    },
    "custom.size": {
      "binding": {
        "config": {
          "path": "view.params.value.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetPath\u0027] is None: return 24\n\tlevel \u003d len(value[\u0027assetPath\u0027].split(\"\\\\\"))\n\tlevel \u003d 24 - level*3\n\tif level \u003c 10: level \u003d 10\n\treturn level",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 76,
      "width": 1561
    }
  },
