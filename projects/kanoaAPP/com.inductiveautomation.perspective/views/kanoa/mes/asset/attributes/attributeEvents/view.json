      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "insertEvent",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"insertEvent() msg received with %s\"%payload)\n\t\n\tattributeEventId \u003d system.kanoa.attribute.addAttributeEvent(payload, self.view.custom.security.userId)\n\tif attributeEventId:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Attribute event added\u0027})\t\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Attribute event was not added\u0027})\t\n\t\t\n\tself.view.refreshBinding(\"custom.data\")\t\n\t\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "updateEvent",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updateEvent() msg received with %s\"%payload)\n\tif system.kanoa.attribute.updateAttributeEvent(payload, self.view.custom.security.userId) \u003e 0:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Attribute event updated\u0027})\t\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Attribute event was not updated\u0027})\t\n\tself.view.refreshBinding(\"custom.data\")\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "deleteEvent",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"deleteEvent() msg received with %s\"%payload)\n\tif system.kanoa.attribute.deleteAttributeEvent(payload[\u0027attributeEventId\u0027], self.view.custom.security.userId) \u003e 0:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Attribute event deleted\u0027})\t\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Attribute event was not deleted\u0027})\t\t\n\tself.view.refreshBinding(\"custom.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "refreshEvents",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"refreshEvents() msg received with %s\"%payload)\n\tself.view.refreshBinding(\"custom.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
