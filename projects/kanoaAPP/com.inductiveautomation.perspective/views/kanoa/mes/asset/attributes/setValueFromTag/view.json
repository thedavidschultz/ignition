  "props": {
    "defaultSize": {
      "width": 298, 
      "height": 72
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "classes": "kanoa/font/labelLarge"
          }
        }, 
        "meta": {
          "domId": "Label", 
          "name": "Label"
        }, 
        "position": {
          "basis": "50px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.attributeLabel"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "alignItems": "center", 
          "style": {
            "gap": 10
          }
        }, 
        "children": [
          {
            "type": "ia.container.flex", 
            "props": {
              "style": {
                "padding": ""
              }, 
              "direction": "column"
            }, 
            "children": [
              {
                "type": "ia.display.label", 
                "props": {
                  "text": "Last Attr. Value", 
                  "textStyle": {
                    "classes": "kanoa/font/labelMedium"
                  }
                }, 
                "meta": {
                  "domId": "lblLabel", 
                  "name": "lblLabel"
                }, 
                "position": {
                  "shrink": 0
                }
              }, 
              {
                "type": "ia.display.label", 
                "props": {
                  "textStyle": {
                    "classes": "kanoa/font/bodyMedium"
                  }
                }, 
                "meta": {
                  "domId": "lblValue", 
                  "name": "lblValue"
                }, 
                "position": {
                  "shrink": 0
                }, 
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property", 
                      "config": {
                        "path": "view.custom.lastEvent.value"
                      }
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxLastValue", 
              "name": "flxLastValue"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.container.flex", 
            "props": {
              "direction": "column"
            }, 
            "children": [
              {
                "type": "ia.display.label", 
                "props": {
                  "text": "Tag Value", 
                  "textStyle": {
                    "classes": "kanoa/font/labelMedium"
                  }
                }, 
                "meta": {
                  "domId": "lblLabel-1", 
                  "name": "lblLabel"
                }, 
                "position": {
                  "shrink": 0
                }
              }, 
              {
                "type": "ia.display.label", 
                "props": {
                  "textStyle": {
                    "classes": "kanoa/font/bodyMedium"
                  }
                }, 
                "meta": {
                  "domId": "lblValue-1", 
                  "name": "lblValue"
                }, 
                "position": {
                  "shrink": 0
                }, 
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property", 
                      "config": {
                        "path": "view.custom.tagValue"
                      }
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxTagValue", 
              "name": "flxTagValue"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "height": "32px"
              }, 
              "text": "Update Attr. Value", 
              "textStyle": {
                "classes": "kanoa/font/labelMedium"
              }
            }, 
            "meta": {
              "domId": "Button", 
              "name": "Button"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0
            }, 
            "events": {
              "dom": {
                "onClick": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\tparams = {\n\t\t'attributeAssetLinkId': self.view.custom.attributeAssetLinkInfo.attributeAssetLinkId, \n\t\t'value': self.view.custom.tagValue, \n\t\t'tStamp': system.date.now()\n\t}\n\tsystem.kanoa.attribute.addAttributeEvent(params, self.view.custom.security.userId)\n\t\n\timport time\n\ttime.sleep(1)\n\t\n\tself.view.refreshBinding(\"custom.lastEvent\")"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxContent", 
          "name": "flxContent"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\t\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "session.props.auth"
        }
      }, 
      "persistent": true
    }, 
    "custom.tagValue": {
      "binding": {
        "type": "tag", 
        "config": {
          "references": {
            "sourceTagPath": "{view.custom.attributeAssetLinkInfo.sourceTagPath}"
          }, 
          "fallbackDelay": 2.5, 
          "mode": "indirect", 
          "tagPath": "{sourceTagPath}"
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.lastEvent": {
      "binding": {
        "transforms": [
          {
            "code": "\tattributeId = system.kanoa.utilities.getFieldValue('attributeId', system.kanoa.attribute.getAttributes({'attributeName': value['attributeName']}))\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.attribute.getPreviousAttributeEvent(value['assetId'], attributeId, system.date.now()), 0)", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }, 
    "custom.attributeAssetLinkInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\tattributeId = system.kanoa.utilities.getFieldValue('attributeId', system.kanoa.attribute.getAttributes({'attributeName': value['attributeName']}))\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.attribute.getAttributeAssetLinks({'assetId': value['assetId'], 'attributeId': attributeId}), 0)", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }
  }
}