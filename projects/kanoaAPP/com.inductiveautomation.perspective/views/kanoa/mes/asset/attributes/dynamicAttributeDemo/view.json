{
  "custom": {
    "security": {
      "userId": 5
    }
  }, 
  "params": {
    "value": {
      "assetId": 901
    }
  }, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "classes": "kanoa/container"
      }
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "padding": 5, 
            "gap": 5
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Dynamic Attribute Data Entry Tests", 
              "textStyle": {
                "classes": "kanoa/font/titleMedium"
              }
            }, 
            "meta": {
              "domId": "lblTitle", 
              "name": "lblTitle"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "text": "This screen is designed to demonstrate the Kanoa-provided screens for users to conveniently enter data as a Dynamic Attribute.", 
              "textStyle": {
                "classes": "kanoa/font/bodyMedium"
              }
            }, 
            "meta": {
              "domId": "lblDescription", 
              "name": "lblDescription"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "marginTop": 10
              }, 
              "text": "Drop Down", 
              "textStyle": {
                "classes": "kanoa/font/titleSmall"
              }
            }, 
            "meta": {
              "domId": "lblSubTitle1", 
              "name": "lblSubTitle1"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "text": "The dropdownSelector component takes Dynamic Attribute identifier parameters and the options for a drop-down list to create a Dynamic Attribute event.", 
              "textStyle": {
                "classes": "kanoa/font/bodyMedium"
              }
            }, 
            "meta": {
              "domId": "lblSubDesc1", 
              "name": "lblSubDesc1"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.view", 
            "props": {
              "params": {
                "value": {
                  "attributeName": "Pattern", 
                  "attributeLabel": "Pattern", 
                  "dropdownList": [
                    {
                      "label": "4x4 Square", 
                      "value": "4x4 Square"
                    }, 
                    {
                      "label": "4x8 Rectangle", 
                      "value": "4x8 Rectangle"
                    }, 
                    {
                      "label": "3x3 Circle", 
                      "value": "3x3 Circle"
                    }, 
                    {
                      "label": "6x6 Circle", 
                      "value": "6x6 Circle"
                    }, 
                    {
                      "label": "Custom", 
                      "value": "Custom"
                    }
                  ]
                }
              }, 
              "path": "kanoa/mes/asset/attributes/dropdownSelector"
            }, 
            "meta": {
              "domId": "evDADropdown", 
              "name": "evDADropdown"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.params.value.userId": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.custom.security.userId"
                  }
                }
              }, 
              "props.params.value.assetId": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.assetId"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "marginTop": 10
              }, 
              "text": "Text Entry", 
              "textStyle": {
                "classes": "kanoa/font/titleSmall"
              }
            }, 
            "meta": {
              "domId": "lblSubTitle2", 
              "name": "lblSubTitle2"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "text": "The textEntry component takes Dynamic Attribute identifier parameters and uses any text entered into the field to to create a Dynamic Attribute event.", 
              "textStyle": {
                "classes": "kanoa/font/bodyMedium"
              }
            }, 
            "meta": {
              "domId": "lblSubDesc2", 
              "name": "lblSubDesc2"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.view", 
            "props": {
              "params": {
                "value": {
                  "attributeName": "Shift Lead"
                }
              }, 
              "path": "kanoa/mes/asset/attributes/textEntry"
            }, 
            "meta": {
              "domId": "evDAText", 
              "name": "evDAText"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.params.value.userId": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.custom.security.userId"
                  }
                }
              }, 
              "props.params.value.assetId": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.assetId"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxTestView", 
          "name": "flxTestView"
        }, 
        "position": {
          "grow": 1, 
          "basis": "200px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Embedded Dynamic Attribute Event Table for Testing", 
              "textStyle": {
                "classes": "kanoa/font/titleMedium"
              }
            }, 
            "meta": {
              "domId": "lblTitle-1", 
              "name": "lblTitle"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.view", 
            "props": {
              "path": "kanoa/mes/asset/attributes/attributeEvents"
            }, 
            "meta": {
              "domId": "evDAEventViewer", 
              "name": "evDAEventViewer"
            }, 
            "position": {
              "grow": 2, 
              "basis": "320px"
            }
          }
        ], 
        "meta": {
          "domId": "flxDAEventView", 
          "name": "flxDAEventView"
        }, 
        "position": {
          "grow": 2, 
          "shrink": 0, 
          "basis": "200px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\tuserId = system.kanoa.security.getIDPUserId(value)\n\treturn {'userId': userId}", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "session.props.auth.user"
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}