        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tstateInfo \u003d value[\u0027stateInfo\u0027]\n\t\n\tif stateInfo[\u0027assetStateId\u0027] is None: return \u0027Asset not set\u0027\n\tif stateInfo[\u0027stateName\u0027] is None: return \u0027State not set\u0027\n\tif stateInfo[\u0027stateCode\u0027] is None: return \u0027No state code configured for this state\u0027\n\tif stateInfo[\u0027startDate\u0027] is None or stateInfo[\u0027endDate\u0027] is None: return \u0027Times not set\u0027\n\tif stateInfo[\u0027startDate\u0027] \u003c self.params.values.startDate: return \u0027start is outside of range\u0027\n\tif stateInfo[\u0027endDate\u0027] \u003e self.params.values.endDate: return \u0027End is outside of range\u0027\n\tif stateInfo[\u0027startDate\u0027] \u003e\u003d stateInfo[\u0027endDate\u0027]: return \u0027Invalid date range selected\u0027\n\tif (stateInfo[\u0027note\u0027] or None) is None: return \u0027No comment provided\u0027\n\treturn \u0027\u0027\n#\tstateEvents \u003d self.custom.stateEvents\n#\tfor row in stateEvents:\n#\t\tif stateInfo[\u0027startDate\u0027] \u003e row[\u0027startDate\u0027] and stateInfo[\u0027endDate\u0027] \u003c row[\u0027endDate\u0027]:\treturn \u0027\u0027\n#\t\n#\treturn \u0027state dates not ok\u0027",
            "type": "script"
          }
        ],
