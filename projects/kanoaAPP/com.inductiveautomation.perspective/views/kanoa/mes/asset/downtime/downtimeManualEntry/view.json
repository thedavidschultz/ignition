          {
            "code": "\t\n\treturn {\"assetId\": value[\u0027assetId\u0027], \"assetStateId\": value[\u0027assetId\u0027], \"stateCode\": None, \"stateName\": None, \"stateTypeColor\": None, \"startDate\": None, \u0027endDate\u0027: None, \u0027note\u0027: \u0027\u0027}",
