    "scripts": {
      "customMethods": [
        {
          "name": "addStateEvent",
          "params": [],
          "script": "\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tlastStateEventInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.event.getPreviousStateEvent(stateInfo[\u0027assetId\u0027], stateInfo[\u0027endDate\u0027]),0)\n\n\t#Number of things have to happen here\n\t#1. We delete all state events that occurred between the start and upto the end date (but not including)\n\tsystem.kanoa.event.deleteStateEvents({\u0027assetId\u0027: stateInfo[\u0027assetId\u0027], \u0027startDate\u0027: stateInfo[\u0027startDate\u0027], \u0027endDate\u0027: stateInfo[\u0027endDate\u0027]}, userId)\n\n\t#2. We add or update the stateEvent at the start time\n\tstateInfo[\u0027tStamp\u0027] \u003d stateInfo[\u0027startDate\u0027]\n\tsystem.perspective.print(\"adding new state event %s\"%(stateInfo))\n\tsystem.kanoa.event.addStateEvent(stateInfo, userId)\n\t\n\t#2. We change the tStamp of the last event that falls within the start and end of this new stateEvent to be the end date\n\tif lastStateEventInfo[\u0027stateEventId\u0027]:\n\t\tlastStateEventInfo[\u0027stateEventId\u0027] \u003d None\n\t\tlastStateEventInfo[\u0027tStamp\u0027] \u003d stateInfo[\u0027endDate\u0027]\n\t\t\n\tsystem.perspective.print(\"adding last state event %s\"%(lastStateEventInfo))\n\tsystem.kanoa.event.addStateEvent(lastStateEventInfo, userId)\n\t\n\tsystem.perspective.sendMessage(\"DTUpdated\", {})\n\tself.view.refreshBinding(\"custom.stateEvents\")\n\tself.view.custom.validationCheck \u003d \u0027State has been added\u0027\n\tself.getChild(\"flxStateNew\").getChild(\"stateRibbonNew\").props.params.values \u003d []\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetStateSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"assetStateSelected() msg rcvd with %s\"%payload)\n\t\n\tif len(payload[\u0027selection\u0027]) \u003e 0: \n\t\tself.view.custom.stateInfo[\u0027stateName\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027]\n\t\tself.view.custom.stateInfo[\u0027stateCode\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027stateCode\u0027]\n\t\tself.view.custom.stateInfo[\u0027stateTypeColor\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027stateTypeColor\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "userResponseAddState",
          "pageScope": true,
          "script": "\n\tself.addStateEvent()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
