  "events": {
    "system": {
      "onShutdown": {
        "config": {
          "script": "\t\n\tself.params.value.assetId \u003d None\n\tself.params.value.idList \u003d []\n\t\n\treturn"
        },
        "scope": "G",
        "type": "script"
