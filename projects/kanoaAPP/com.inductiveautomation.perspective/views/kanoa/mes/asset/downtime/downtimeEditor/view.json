    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetStateSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"assetStateSelected() msg rcvd with %s\"%payload)\n\t\n\tselection \u003d payload[\u0027selection\u0027]\n\tif len(selection) \u003e 0:\n\t\tself.view.custom.stateEventInfo[\u0027stateName\u0027] \u003d selection[0][\u0027value\u0027][\u0027stateName\u0027]\n\t\tself.view.custom.stateEventInfo[\u0027statePath\u0027] \u003d selection[0][\u0027value\u0027][\u0027statePath\u0027]\n\t\tself.view.custom.stateEventInfo[\u0027stateCode\u0027] \u003d selection[0][\u0027value\u0027][\u0027stateCode\u0027]\n\t\tself.view.custom.stateEventInfo[\u0027stateTypeColor\u0027] \u003d selection[0][\u0027value\u0027][\u0027stateTypeColor\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
