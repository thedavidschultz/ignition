                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tif value is None: return self.props.options\n\t\n\tassetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: value}),0)\n\tassets \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: assetInfo[\u0027assetPath\u0027] + \u0027\\\\%\u0027, \u0027enabled\u0027:True}))\n\tassets.insert(0, assetInfo)\n\treturn [{\u0027value\u0027: asset[\u0027assetId\u0027], \u0027label\u0027:asset[\u0027assetName\u0027] + \u0027 (\u0027 + asset[\u0027assetTypeName\u0027] + \u0027)\u0027} for asset in assets]",
                      "type": "script"
