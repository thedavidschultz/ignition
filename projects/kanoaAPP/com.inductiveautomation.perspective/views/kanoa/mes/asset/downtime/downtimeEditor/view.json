          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n#\tself.view.getChild(\"root\").updateDTEvent()\n\n\torigStateEventInfo \u003d dict(self.view.custom.origStateEventInfo)\n\tstateEventInfo \u003d dict(self.view.custom.stateEventInfo)\n\tstateEventInfo[\u0027origStateCode\u0027] \u003d origStateEventInfo[\u0027stateCode\u0027] if stateEventInfo[\u0027stateCode\u0027] !\u003d origStateEventInfo[\u0027stateCode\u0027] else None\n\tstateEventInfo[\u0027origAssetId\u0027] \u003d origStateEventInfo[\u0027assetStateId\u0027] if stateEventInfo[\u0027assetStateId\u0027] !\u003d origStateEventInfo[\u0027assetStateId\u0027] else None\n\tstateEventInfo[\u0027startDate\u0027] \u003d system.kanoa.utilities.convertSQLTimeStamp(self.view.params.value.startDate)\n\tstateEventInfo[\u0027endDate\u0027] \u003d system.kanoa.utilities.convertSQLTimeStamp(self.view.params.value.endDate)\n\n\tsystem.perspective.sendMessage(\"stateEventUpdate\", {\u0027stateEventInfo\u0027: stateEventInfo})\n\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
