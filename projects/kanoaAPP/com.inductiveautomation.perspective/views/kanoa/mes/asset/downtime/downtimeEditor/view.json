  "propConfig": {
    "custom.metaInfo": {
      "binding": {
        "config": {
          "path": "view.custom.stateEventInfo"
        },
        "enabled": false,
        "transforms": [
          {
            "code": "\t\n\tif not value[\u0027stateEventId\u0027]: return {\u0027partReqd\u0027:None}\n\tdata \u003d system.kanoa.event.getStateEventInfo(value[\u0027stateEventId\u0027], None)\n\tif data.rowCount \u003d\u003d 0: return {\u0027partReqd\u0027:None}\n\tdata \u003d system.dataset.toPyDataSet(system.dataset.filterColumns(data, [\u0027stateEventInfoName\u0027, \u0027value\u0027]))\n\tinfoDict \u003d {}\n\t\n\tfor row in data: \n\t\tvalue \u003d bool(int(row[\u0027value\u0027])) if row[\u0027stateEventInfoName\u0027] \u003d\u003d \u0027partReqd\u0027 else row[\u0027value\u0027]\n\t\tinfoDict.update({row[\u0027stateEventInfoName\u0027]:value})\n\treturn infoDict",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.origStateEventInfo": {
      "persistent": true
    },
    "custom.stateEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.idList"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tstateEventId \u003d -1 if len(value) \u003d\u003d 0 else value[0]\n\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.event.getStateEventById(stateEventId), 0)\n\tself.custom.origStateEventInfo \u003d info\n\treturn info",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.dtData": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.eqPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.idList": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 334,
      "width": 502
    }
  },
