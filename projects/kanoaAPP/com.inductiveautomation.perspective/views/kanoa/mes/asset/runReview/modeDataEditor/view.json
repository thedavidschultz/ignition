                  "transforms": [
                    {
                      "code": "\n\tstartDate \u003d value or system.date.now()\t\n\ttzOffsetMins \u003d system.kanoa.date.getClientOffsetMinsFromGateway(self.session.props.device.timezone.id, startDate)\n\tstartDate \u003d system.kanoa.utilities.convertSQLTimeStamp(system.date.addMinutes(startDate, -tzOffsetMins))\n\treturn \tsystem.date.format(startDate)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\t\n\tsystem.perspective.print(\"txtDate change %s\"%origin)\n\t\n\tif origin \u003d\u003d \u0027Browser\u0027:\n\t\n\t\torigModeInfo \u003d self.view.custom.origModeInfo\n\t\n\t\ttStamp \u003d system.kanoa.utilities.convertSQLTimeStamp(system.date.parse(self.props.text))\n\t\tif tStamp \u003e system.date.now():\n\t\t\tself.props.text \u003d previousValue.value\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Start cannot be in the future\u0027})\n\t\t\treturn\n\t\t\t\n\t\ttzOffsetMins \u003d system.kanoa.date.getClientOffsetMinsFromGateway(self.session.props.device.timezone.id, tStamp)\n\t\ttStamp \u003d system.kanoa.utilities.convertSQLTimeStamp(system.date.addMinutes(system.date.parse(self.props.text), tzOffsetMins))\n\t\torigStartDate \u003d system.kanoa.utilities.convertSQLTimeStamp(origModeInfo[\u0027startDate\u0027])\n\t\torigEndDate \u003d system.kanoa.utilities.convertSQLTimeStamp(origModeInfo[\u0027endDate\u0027]) if origModeInfo[\u0027endDate\u0027] else None\n\t\tprevStartDate \u003d system.kanoa.utilities.getFieldValue(\u0027startDate\u0027, system.kanoa.event.getPreviousModeEvent(origModeInfo[\u0027assetId\u0027], system.date.addSeconds(origModeInfo[\u0027startDate\u0027], -60)))\n\t\t\n\t\tif prevStartDate:\n\t\t\tif tStamp \u003c prevStartDate:\n\t\t\t\tsystem.perspective.print(\"tStamp %s is less than %s\"%(tStamp, prevStartDate))\n\t\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Start cannot before the start of the previous event.\u0027})\n\t\t\t\ttStamp \u003d origModeInfo[\u0027startDate\u0027]\n\t\t\telif origEndDate and tStamp \u003e origEndDate:\n\t\t\t\tsystem.perspective.print(\"tStamp %s is greater than %s\"%(tStamp, origEndDate))\n\t\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Start cannot be after the start of the next event.\u0027})\n\t\t\t\ttStamp \u003d origModeInfo[\u0027startDate\u0027]\n\t\t\n\t\tself.view.custom.modeInfo[\u0027startDate\u0027] \u003d tStamp\n\t\n\treturn"
                }
              }
            },
