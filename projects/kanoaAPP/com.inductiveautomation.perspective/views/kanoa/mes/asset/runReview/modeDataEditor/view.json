    "scripts": {
      "customMethods": [
        {
          "name": "updateModeEvent",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"updateModeEvent() called\")\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tmodeInfo \u003d self.view.custom.modeInfo\n\t\n\t#Filter only the keys we want to pass to the function\n\tkeys \u003d {\u0027modeEventId\u0027, \u0027assetId\u0027, \u0027modeCode\u0027, \u0027workOrderId\u0027, \u0027itemId\u0027, \u0027standardRate\u0027, \u0027comment\u0027, \u0027modeSourceId\u0027}\n\tproductionEventInfo \u003d {k: modeInfo[k] for k in keys if k in modeInfo}\n\tproductionEventInfo[\u0027tStamp\u0027] \u003d modeInfo[\u0027startDate\u0027]\n\t\t\n\tretVal, msg \u003d system.kanoa.event.updateProductionEvent(productionEventInfo, userId)\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027:msg})\n\n\tif msg:\n\t\timport time\n\t\ttime.sleep(4)\n\n\tsystem.perspective.sendMessage(\"refreshProductionData\", {})\n\tself.view.refreshBinding(\"custom.modeInfo\")\n\tself.view.custom.validationCheck \u003d \u0027Mode has been updated\u0027\n\t\n\t#Refresh the asset tags in case the item was changed\n\ttagPath \u003d system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027: modeInfo[\u0027assetId\u0027]})\n\tsystem.tag.write(tagPath + \"/Line/OEE/refresh\", True)\n\t\n\treturn msg"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "userResponseUpdateMode",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"userResponseUpdateMode() msg rcvd with %s\"%payload)\n\tif payload.has_key(\u0027userInput\u0027) and payload[\u0027userInput\u0027] \u003d\u003d \u0027OK\u0027: self.updateModeEvent()\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "itemSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"itemSelected() msg rcvd with %s\"%payload)\n\t\n\tif len(payload[\u0027selection\u0027]) \u003e 0:\n\t\tv \u003d payload[\u0027selection\u0027][0][\u0027value\u0027]\n#\t\tself.view.custom.modeInfo.workOrderId \u003d None\n\t\tself.view.custom.modeInfo.itemId \u003d v[\u0027itemId\u0027]\n\t\tself.view.custom.modeInfo.itemName \u003d v[\u0027itemName\u0027]\n\t\tself.view.custom.modeInfo.itemPath \u003d v[\u0027path\u0027]\n\telse:\n\t\tself.view.custom.modeInfo.workOrderId \u003d None\n\t\tself.view.custom.modeInfo.itemId \u003d None\n\t\tself.view.custom.modeInfo.itemName \u003d None\n\t\tself.view.custom.modeInfo.itemPath \u003d None\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
