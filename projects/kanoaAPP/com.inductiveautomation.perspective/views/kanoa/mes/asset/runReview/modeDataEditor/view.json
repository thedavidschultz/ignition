  "propConfig": {
    "custom.modeInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "transforms": [
          {
            "code": "\t\n\tinfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.event.getModeEvents({\u0027modeEventId\u0027: value[\u0027modeEventId\u0027] or -1}), 0)\n\tif info[\u0027comment\u0027] is None: info[\u0027comment\u0027] \u003d \u0027\u0027\n\tinfo[\u0027itemPath\u0027] \u003d \"%s\\\\%s\"%(info[\u0027itemClassPath\u0027], info[\u0027itemName\u0027]) if info[\u0027itemClassPath\u0027] else info[\u0027itemName\u0027]\n\t\n\tself.custom.origModeInfo \u003d dict(info)\n\t\n\treturn info",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.modes": {
      "binding": {
        "config": {
          "path": "view.custom.modeInfo.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value is None: return []\t\n\treturn [{\u0027value\u0027: row[\u0027modeCode\u0027], \u0027label\u0027:row[\u0027modeName\u0027]} for row in system.kanoa.asset.getAssetModes({\u0027assetId\u0027: value or -1, \u0027enabled\u0027:True})]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.order": {
      "binding": {
        "config": {
          "path": "view.custom.modeInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tmodeEventInfo \u003d value\n\tif modeEventInfo[\u0027modeEventId\u0027] is None: return []\n\titemSourceId \u003d system.kanoa.utilities.getFieldValue(\u0027itemSourceId\u0027, system.kanoa.item.getItemSource({\u0027itemSourceName\u0027: \u0027output\u0027}))\n\titemIdList \u003d [row[\u0027itemId\u0027] for row in system.kanoa.item.getAssetItems({\u0027assetPath\u0027: modeEventInfo[\u0027assetPath\u0027], \u0027itemSourceId\u0027: itemSourceId, \u0027enabled\u0027: True})]\n\twoData \u003d system.dataset.toPyDataSet(system.dataset.sort(system.kanoa.order.getProductionOrders({\u0027itemIdList\u0027: itemIdList, \u0027ignoreActualQty\u0027: True}), \u0027workOrderName\u0027))\n\treturn [{\"value\": row[\u0027workOrderId\u0027], \"label\": row[\u0027workOrderName\u0027]} for row in woData]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.origModeInfo": {
      "persistent": true
    },
    "custom.validationCheck": {
      "binding": {
        "config": {
          "struct": {
            "modeInfo": "{view.custom.modeInfo}",
            "origModeInfo": "{view.custom.origModeInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tmodeInfo \u003d value[\u0027modeInfo\u0027]\n\t\n\tif value[\u0027modeInfo\u0027][\u0027modeCode\u0027] \u003d\u003d value[\u0027origModeInfo\u0027][\u0027modeCode\u0027] and value[\u0027modeInfo\u0027][\u0027workOrderId\u0027] \u003d\u003d value[\u0027origModeInfo\u0027][\u0027workOrderId\u0027] and value[\u0027modeInfo\u0027][\u0027itemId\u0027] \u003d\u003d value[\u0027origModeInfo\u0027][\u0027itemId\u0027] and value[\u0027modeInfo\u0027][\u0027comment\u0027] \u003d\u003d value[\u0027origModeInfo\u0027][\u0027comment\u0027] and value[\u0027modeInfo\u0027][\u0027startDate\u0027] \u003d\u003d value[\u0027origModeInfo\u0027][\u0027startDate\u0027]:\n\t\treturn \u0027No Changes\u0027\n\t\n\tif modeInfo[\u0027modeCode\u0027] is None: return \u0027Mode has not been set\u0027\n\tif (modeInfo[\u0027comment\u0027] or None) is None: return \u0027Please add a comment as to the change\u0027\n\t\t\n\treturn \u0027\u0027",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
