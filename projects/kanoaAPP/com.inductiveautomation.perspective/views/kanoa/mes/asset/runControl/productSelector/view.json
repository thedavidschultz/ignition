      },
      {
        "meta": {
          "domId": "FlexRepeater",
          "name": "flxRptProducts"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "filter": "{view.custom.filter}",
                  "items": "{view.custom.itemData}"
                },
                "waitOnAll": false
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\titems \u003d value[\u0027items\u0027]\n\tfilter \u003d value.filter.lower() if value.filter is not None else None\n\t\n\tif filter:\n\t\tdeleteRows \u003d [i for i, item in enumerate(items) if filter not in (item[\u0027itemName\u0027].lower()) and filter not in ((item[\u0027itemDescription\u0027]) or \u0027\u0027).lower()]\t\t\t\n\t\titems \u003d system.dataset.toPyDataSet(system.dataset.deleteRows(items, deleteRows))\n\t\n\tinstances \u003d []\n\tfor item in items:\n\t\tif item[\u0027standardRate\u0027] is None or item[\u0027itemPeriodName\u0027] is None:\n\t\t\tinfo \u003d \"Item rate not configured\"\n\t\telse:\n\t\t\tinfo \u003d \"%s %s per %s\"%(item[\u0027standardRate\u0027] or \u0027\u0027, item[\u0027infeedUnits\u0027] or \u0027\u0027, item[\u0027itemPeriodName\u0027] or \u0027\u0027)\n\t\tinstances.append({\u0027value\u0027: {\"itemId\":item[\u0027itemId\u0027], \"itemName\": item[\u0027itemName\u0027],  \"itemColor\": item[\u0027itemColor\u0027] or item[\u0027itemclassColor\u0027], \"itemDesc\": item[\u0027itemDescription\u0027], \"info\": info}})\n\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "elementPosition": {
            "basis": "auto",
            "grow": 0,
            "shrink": 0
          },
