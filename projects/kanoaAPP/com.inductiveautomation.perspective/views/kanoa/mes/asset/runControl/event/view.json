    "custom": {
      "pulse": {
        "defaultColor": "#FFFF00"
      },
      "selected": false
    },
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\t\n\tif self.view.params.values.enableSelector:\n\t\tsystem.perspective.sendMessage(\u0027itemSelection\u0027, {\u0027workOrderId\u0027: self.view.params.values.workOrderId, \u0027itemId\u0027: self.view.params.values.itemId, \u0027scheduleId\u0027: self.view.params.values.scheduleId})\n\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "enabled": true
      }
    },
    "propConfig": {
      "custom.foreColor": {
        "binding": {
          "config": {
            "path": "view.params.values.color"
          },
          "transforms": [
            {
              "code": "\t\n\treturn system.kanoa.utilities.getContrastingColor(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "custom.pulse.enabled": {
        "binding": {
          "config": {
            "path": "view.custom.tagInfo"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t\n\treturn value[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027 and self.view.params.values.scheduleBlockId \u003d\u003d value[\u0027scheduleBlockId\u0027]",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "custom.pulse.endDate": {
        "binding": {
          "config": {
            "path": "view.params.values.endDate"
          },
          "type": "property"
        }
      },
      "custom.pulse.startDate": {
        "binding": {
          "config": {
            "path": "view.params.values"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn system.date.addMinutes(value[\u0027startDate\u0027], -value[\u0027tzOffset\u0027])",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "custom.pulse.timer": {
        "binding": {
          "config": {
            "expression": "now(2000)"
          },
          "type": "expr"
        },
        "onChange": {
          "enabled": null,
          "script": "\n\tvalues \u003d self.view.params.values\n\tstyle \u003d self.props.style\n\tpulse \u003d self.custom.pulse\n\n\tif pulse.has_key(\u0027enabled\u0027) and pulse.enabled:\n\t\tif pulse[\u0027startDate\u0027] is None or pulse[\u0027endDate\u0027] is None or currentValue.value is None: return\n\t\tif currentValue.value \u003e pulse[\u0027startDate\u0027] and currentValue.value \u003c pulse[\u0027endDate\u0027]:\n\t\t\tstyle[\u0027backgroundColor\u0027] \u003d values[\u0027color\u0027] if style[\u0027backgroundColor\u0027] \u003d\u003d pulse[\u0027defaultColor\u0027] else pulse[\u0027defaultColor\u0027]\n\t\n\treturn"
        }
      },
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "this.custom.pulse.enabled"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027When pulsing, indicates that this scheduled operation is currently active\u0027 if value else \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "this.custom.pulse"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t\n\tif not value[\u0027enabled\u0027]: return \u0027--kcPrimaryColor\u0027\n\treturn \u0027--kcPrimaryColor\u0027 if self.props.style.backgroundColor \u003d\u003d \u0027--kcTertiary\u0027 else \u0027--kcTertiary\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.outlineStyle": {
        "binding": {
          "config": {
            "path": "view.custom.itemSelection"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t\n\treturn \u0027solid\u0027 if value and value.has_key(\u0027scheduleId\u0027) and value[\u0027scheduleId\u0027] \u003d\u003d self.view.params.values.scheduleId else \u0027none\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "flex-start",
      "alignItems": "flex-start",
      "style": {
        "borderRadius": "15px",
        "classes": "kanoa/border kanoa/font/default",
        "gap": "5px",
        "margin": "5px",
        "outlineColor": "#555555",
        "overflow": "hidden",
        "padding": "5px",
        "transition": "background-color 2.0s linear"
      },
      "wrap": "wrap"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "itemSelection",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\u0027itemSelection msg rcvd with %s\u0027%payload)\n\tself.view.custom.itemSelection \u003d payload\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
