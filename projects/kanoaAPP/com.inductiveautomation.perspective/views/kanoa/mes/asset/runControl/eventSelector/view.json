    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.linePath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value or None\n\tassetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027:assetPath or \u0027None\u0027}), 0)\n\tif assetPath:\n\t\ttimezones \u003d system.kanoa.date.getAssetTimeZoneInfo(assetPath)\n\t\ttimezone \u003d timezones[assetPath][\u0027timeZone\u0027] if timezones.has_key(assetPath) else \u0027UTC\u0027\n\telse:\n\t\ttimezone \u003d \u0027UTC\u0027\n\t\n\tassetInfo[\u0027timeZone\u0027] \u003d timezone\n\t\n\treturn assetInfo\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
