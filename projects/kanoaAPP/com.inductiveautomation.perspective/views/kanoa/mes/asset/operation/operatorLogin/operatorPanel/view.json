    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetId\u0027: value or -1}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.operators": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n#\tsystem.perspective.print(\"operator binding change with %s\"%value)\n\t\n\tif value is None: return []\n\tif value[\u0027assetId\u0027] is None: return []\n\t\n\tparamsDict \u003d {\u0027attributeName\u0027: \u0027Operator%\u0027, \u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027endDate\u0027]}\n\tsystem.perspective.print(\"calling getAttributeEvents() with %s\"%paramsDict)\n\tdata \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.attribute.getAttributeEvents(paramsDict))\n\tdata \u003d [item for item in data if item[\u0027value\u0027] is not None]\n\t\n\tfor item in data:\n\t\tendDate \u003d item[\u0027endDate\u0027] or system.date.now()\n\t\tstartDate \u003d item[\u0027startDate\u0027] if item[\u0027startDate\u0027] \u003e value[\u0027startDate\u0027] else value[\u0027startDate\u0027]\n\t\tendDate \u003d endDate if endDate \u003c (value[\u0027endDate\u0027]) else value[\u0027endDate\u0027]\n\t\titem[\u0027durationSecs\u0027] \u003d system.date.secondsBetween(startDate, endDate)\t\n\t\titem[\u0027rangeStart\u0027] \u003d value[\u0027startDate\u0027]\n\t\titem[\u0027rangeEnd\u0027] \u003d value[\u0027endDate\u0027]\n\t\n\treturn data",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userInput": {
      "persistent": true
    },
    "custom.userInput.inputValue": {
