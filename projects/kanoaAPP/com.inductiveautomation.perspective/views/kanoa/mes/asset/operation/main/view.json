    "scripts": {
      "customMethods": [
        {
          "name": "setAssetPanels",
          "params": [],
          "script": "\n\tassetId \u003d self.view.custom.assetInfo[\u0027assetId\u0027]\n\tassetPanels \u003d self.view.custom.assetPanels\n\n\tself.view.custom.viewPanels \u003d  {\n\t\t\t\u0027body\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027bodyPanelViewPath\u0027], \"viewTitle\": \"Main Menu\"},\n\t\t\t\u0027infoPanel\u0027: {\"viewParams\": {\"value\": {\"assetId\": assetId}}, \"viewPath\": assetPanels[\u0027infoPanelPath\u0027]}\n\t\t\t}\n\t\n\treturn"
        },
        {
          "name": "getAssetPanels",
          "params": [
            "assetInfo"
          ],
          "script": "\n\tif assetInfo[\u0027assetId\u0027] is None: return {\u0027infoPanelPath\u0027: \u0027kanoa/core/dbp/blankView\u0027, \u0027bodyPanelViewPath\u0027: \u0027kanoa/core/dbp/blankView\u0027}\n\t\n\tinfoPanelPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsInfoPanelViewPath\u0027) or \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027\n\tbodyPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(assetInfo[\u0027assetPath\u0027], \u0027_assetOpsViewPath\u0027) or \u0027kanoa/mes/asset/operation/opsPanel/assetOperationPanel\u0027\n\t\n\treturn {\u0027infoPanelPath\u0027: infoPanelPath, \u0027bodyPanelViewPath\u0027: bodyPanelViewPath}"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateAssetOpsNav",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updateAssetOpsNav() msg rcvd with %s\"%payload)\n\n\tviewPath \u003d \"kanoa/mes/asset/operation/defaultNav\"\n\tviewPayload \u003d None\n\t\n\tif payload is not None:\n\t\tif payload.has_key(\u0027viewPath\u0027):\n\t\t\tviewPath \u003d payload[\u0027viewPath\u0027]\n\t\t\tviewTitle \u003d payload[\u0027viewPath\u0027]\n\t\tif payload.has_key(\u0027payload\u0027): viewPayload \u003d payload[\u0027payload\u0027]\n\t\tif payload.has_key(\u0027viewTitle\u0027): viewTitle \u003d payload[\u0027viewTitle\u0027]\n\t\t\n\tself.view.custom.viewPanels.body.viewParams \u003d viewPayload\n\tself.view.custom.viewPanels.body.viewPath \u003d viewPath\n\tself.view.custom.viewPanels.body.viewTitle \u003d viewTitle\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "navItemsUpdated",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"navItemsUpdated() msg rcvd with %s\"%payload)\n\tself.view.refreshBinding(\"custom.viewPanels\")\n\t\n\treturn",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
