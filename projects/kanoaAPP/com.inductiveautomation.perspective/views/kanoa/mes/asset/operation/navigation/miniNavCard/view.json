{
  "custom": {},
  "params": {
    "value": {
      "iconPath": "material/analytics",
      "subTitle": "Real-time OEE analytics",
      "title": "Live Dashboards",
      "viewParams": {
        "value": {
          "assetId": 899,
          "assetPath": "Kanoa Box Co"
        }
      },
      "viewPath": "kanoa/mes/asset/operation/runMonitor"
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 65,
      "width": 360
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblTitle",
              "name": "lblTitle"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/titleMedium"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblSubtitle",
              "name": "lblSubtitle"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value.subTitle"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall",
                "overflowWrap": "break-word"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxLabel",
          "name": "flxLabel"
        },
        "position": {
          "basis": "280px",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "justify": "space-around",
          "style": {
            "gap": 5,
            "margin": "16px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "icon",
              "name": "icon"
            },
            "position": {
              "basis": "30px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.value.iconPath"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "color": "--kcOnPrimaryContainer",
                "padding": "10px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "domId": "flxIcon",
          "name": "flxIcon"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "background": "--kcPrimaryContainer"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\t\n\tparams \u003d self.view.params.value\n\tsystem.perspective.sendMessage(\u0027updateAssetOpsNav\u0027, {\u0027viewTitle\u0027: params[\u0027title\u0027], \u0027viewPath\u0027: params[\u0027viewPath\u0027], \u0027payload\u0027: params[\u0027viewParams\u0027]})\n\tsystem.perspective.print(\"sendMessage updateAssetOpsNav called with %s\"%{\u0027viewTitle\u0027: params[\u0027title\u0027], \u0027viewPath\u0027: params[\u0027viewPath\u0027], \u0027payload\u0027: params[\u0027viewParams\u0027]})\n\t\n\treturn"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {}
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn str(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "justify": "space-between",
      "style": {
        "classes": "kanoa/clickable kanoa/container",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}