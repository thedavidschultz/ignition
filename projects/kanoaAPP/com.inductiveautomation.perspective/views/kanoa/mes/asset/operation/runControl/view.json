          }
        ],
        "type": "property"
      }
    },
    "custom.asset.customAttributes": {
      "binding": {
        "config": {
          "path": "view.custom.asset.assetInfo.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetToDict(system.kanoa.asset.getAssetAttributes({\u0027assetId\u0027: value}), \u0027assetAttrName\u0027, \u0027assetAttrValue\u0027)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.asset.tagInfo": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.custom.asset.assetInfo.tagPath}"
          },
          "tagPath": "{1}/Line"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value.OEE",
            "type": "script"
          }
        ],
        "type": "tag"
      }
    },
    "custom.filter": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.itemSelection": {
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selectedTab": {
      "binding": {
        "config": {
          "path": "view.custom.tabInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027currentTabIndex\u0027] is None: return None\n\treturn value[\u0027tabs\u0027][value[\u0027currentTabIndex\u0027]][\u0027viewParams\u0027][\u0027label\u0027]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\t#If a user selects a new tab, we should clear what was sected on the previous tab\n\tself.custom.itemSelection \u003d {\"itemId\": None, \"scheduleId\": None, \"workOrderId\": None}\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.tabInfo": {
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "assetPath": "{view.custom.asset.assetInfo.assetPath}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value[\u0027assetPath\u0027]\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if assetPath else False\n\t\t\n\t\telif assetPath and security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027enabled\u0027]:\n\t\t\tif len(security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027assets\u0027]) \u003d\u003d 0:\n\t\t\t\tcanEdit \u003d True\n\t\t\telse:\n\t\t\t\tfor path in security[\u0027userCRUD\u0027][\u0027operateAssets\u0027][\u0027assets\u0027]:\n\t\t\t\t\tif path in assetPath: \n\t\t\t\t\t\tcanEdit \u003d True\n\t\t\t\t\t\tbreak\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tvalue \u003d self.params.value\n\tif value.has_key(\u0027assetPath\u0027) and value[\u0027assetPath\u0027]:\tsystem.kanoa.utilities.storeAssetPath(self, value[\u0027assetPath\u0027])\n\t\n\treturn"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
