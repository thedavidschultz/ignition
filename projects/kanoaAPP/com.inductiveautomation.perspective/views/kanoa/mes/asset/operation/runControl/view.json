          "params": [],
          "script": "\n\ttagPath \u003d self.view.custom.asset.assetInfo[\u0027tagPath\u0027]\n\tcount \u003d 0\n\timport time\n\twhile count \u003c 10:\n\t\tcount +\u003d 1\t\n\t\tif system.tag.read(\"[Kanoa]kanoa/timers/updateAssetOEETimer/update\").value \u003d\u003d False: break\n#\t\tsystem.perspective.print(\"Waiting to update asset\")\n\t\ttime.sleep(0.5)\n\t\t\n\tsystem.tag.writeBlocking([tagPath + \u0027/Line/OEE/refresh\u0027], [True]) #Let\u0027s refresh this assetTagInfo\n\t\n\treturn"
        }
