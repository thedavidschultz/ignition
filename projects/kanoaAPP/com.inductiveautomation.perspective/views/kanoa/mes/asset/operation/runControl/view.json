                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\tselector \u003d value[\u0027selectedTab\u0027]\n\tif selector is None or selector \u003d\u003d \u0027Mode\u0027: return False #system.perspective.print(\u0027selector is %s. Not showing button.\u0027%selector)\n\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False #system.perspective.print(\u0027No permssions\u0027)\n\n\ttagOEEInfo \u003d self.view.custom.asset.tagInfo\n\tif tagOEEInfo is None:\treturn False #\tsystem.perspective.print(\u0027No tag info\u0027)\n\t\n\tif value[\u0027itemSelection\u0027] is None: return False # system.perspective.print(\u0027No item selection\u0027)\n\t\t\n\tif selector \u003d\u003d \u0027Product\u0027:\n\t\tif value[\u0027itemSelection\u0027][\u0027itemId\u0027] is None: return False # \tsystem.perspective.print(\u0027No item selected\u0027)\n\t\tif tagInfo[\u0027itemId\u0027] \u003d\u003d value[\u0027itemSelection\u0027][\u0027itemId\u0027]: return False # system.perspective.print(\u0027Item already selected\u0027)\n\t\t\t\n\tif selector \u003d\u003d \u0027Orders\u0027:\n\t\tif value[\u0027itemSelection\u0027][\u0027workOrderId\u0027] is None: return False # \tsystem.perspective.print(\u0027No order selected\u0027)\n\t\t\t\n\t\tworkOrderName \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderName\u0027, system.kanoa.order.getProductionOrders({\u0027workOrderId\u0027: value[\u0027itemSelection\u0027][\u0027workOrderId\u0027], \u0027ignoreActualQty\u0027: True}))\n\t\tif workOrderName is None or tagOEEInfo[\u0027workOrderName\u0027] \u003d\u003d workOrderName: return False # system.perspective.print(\u0027Order is already selected\u0027)\n\t\t\n\tif selector \u003d\u003d \u0027Scheduled\u0027:\n\t\tif value[\u0027itemSelection\u0027][\u0027scheduleId\u0027] is None: return False # system.perspective.print(\u0027No schedule selected\u0027)\n\t\t\t\n\t\tscheduleBlockId \u003d system.kanoa.utilities.getFieldValue(\u0027scheduleBlockId\u0027, system.kanoa.schedule.getScheduleBlocks({\u0027scheduleBlockId\u0027: value[\u0027itemSelection\u0027][\u0027scheduleId\u0027]}))\n\t\tif scheduleBlockId is None: return False # system.perspective.print(\u0027schedule block not found\u0027)\n\t\tif  tagOEEInfo[\u0027modeName\u0027] \u003d\u003d \u0027Production\u0027 and tagOEEInfo[\u0027scheduleBlockId\u0027] \u003d\u003d scheduleBlockId: return False # system.perspective.print(\u0027Schedule is already running\u0027)\n\n\treturn True",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
