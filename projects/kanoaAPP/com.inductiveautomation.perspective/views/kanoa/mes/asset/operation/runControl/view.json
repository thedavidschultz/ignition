    "custom.asset.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.filter.assetPath"
        },
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: value}),0)",
