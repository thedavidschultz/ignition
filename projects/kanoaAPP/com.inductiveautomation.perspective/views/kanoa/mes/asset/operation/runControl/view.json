          },
          {
            "meta": {
              "domId": "lblAsset",
              "name": "lblAsset"
            },
            "position": {
              "display": false
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filter.assetPath"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\n\tai \u003d self.view.custom.asset.assetInfo\n\tsi \u003d {\u0027modeName\u0027: \u0027Idle\u0027, \u0027workOrderId\u0027: None, \u0027itemId\u0027: None}\t\n\tmodeCode \u003d system.kanoa.utilities.getFieldValue(\u0027modeCode\u0027, system.kanoa.asset.getAssetModes({\u0027assetId\u0027: ai[\u0027assetId\u0027], \u0027modeName\u0027: si[\u0027modeName\u0027]}))\t\t\n\tmodeSourceId \u003d system.kanoa.asset.getModeSourceId(\u0027Schedule\u0027)\t\t\n\t\n\tsystem.tag.writeBlocking([ai[\u0027tagPath\u0027] + \u0027/Line/OEE/scheduleBlockId\u0027], [None]) #Clear the scheduleBlockId\n\t\n\tassetOperationInfo \u003d {\u0027assetId\u0027: ai[\u0027assetId\u0027], \u0027modeCode\u0027: modeCode, \u0027workOrderId\u0027: si[\u0027workOrderId\u0027], \u0027itemId\u0027: si[\u0027itemId\u0027], \u0027standardRate\u0027: None, \u0027modeSourceId\u0027: modeSourceId, \u0027tStamp\u0027: system.date.now(), \u0027includeChildren\u0027: True, \u0027checkAssetSchedule\u0027: True}\n\tmodeEventId, msg \u003d system.kanoa.event.assetOperationChange(assetOperationInfo, self.view.custom.security.userId)\n\tif msg or modeEventId is None: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Could not change asset mode. %s\u0027%msg})\n\n\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Checking Schedule...\u0027})\t\n\tself.view.getChild(\"root\").updateLineOEE()\t\n\t\n\treturn"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "domId": "btnEnd",
                  "name": "btnEnd",
                  "tooltip": {
                    "delay": 0,
                    "location": "top",
                    "tail": false,
                    "text": "End"
                  }
                },
                "position": {
                  "basis": "175px",
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "struct": {
                          "action": "{view.custom.userAction}",
                          "selectedTab": "{view.custom.selectedTab}",
                          "tagOEEInfo": "{view.custom.asset.tagInfo}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\t\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False\n\tif value[\u0027tagOEEInfo\u0027] is None or value[\u0027tagOEEInfo\u0027][\u0027modeName\u0027] \u003d\u003d \u0027Idle\u0027: return False\n\tif value[\u0027tagOEEInfo\u0027][\u0027modeSourceName\u0027] !\u003d \u0027Operator\u0027: True\n\t\n\treturn True",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "struct": {
                          "action": "{view.custom.userAction}",
                          "tagOEEInfo": "{view.custom.asset.tagInfo}"
                        },
                        "waitOnAll": true
                      },
                      "enabled": false,
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\tif not value[\u0027action\u0027][\u0027canUpdate\u0027]: return False\n\tif value[\u0027tagOEEInfo\u0027] is not None and value[\u0027tagOEEInfo\u0027][\u0027modeName\u0027] not in (\u0027Idle\u0027): return True\n\t\n\treturn False",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "struct": {
                          "selector": "{view.custom.selectedTab}",
                          "tagOEEInfo": "{view.custom.asset.tagInfo}"
                        },
                        "waitOnAll": false
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\tif value[\u0027tagOEEInfo\u0027] is None: return \u0027End\u0027\n#\tif value[\u0027selector\u0027] \u003d\u003d \u0027Mode\u0027 and value[\u0027tagOEEInfo\u0027][\u0027modeSourceName\u0027] \u003d\u003d \u0027Operator\u0027: return\n\treturn \"End %s\"%(value[\u0027tagOEEInfo\u0027][\u0027modeName\u0027] or \u0027\u0027)",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "image": {
                    "icon": {
                      "color": "--kcOnError",
                      "path": "material/stop"
                    }
                  },
                  "style": {
                    "backgroundColor": "--kcRed-60",
                    "classes": "kanoa/button/filled",
                    "height": "48px"
                  },
                  "textStyle": {
                    "classes": "kanoa/font/labelLarge"
                  }
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t\n\t#The user selection is stored in session custom properties\n\t#If scheduleId is not None, we will get wo/pc info from the scheduled event\n\t#Else if woId is not None, we\u0027ll get wo and pc from the wo\n\t#Else we will just do a product run \n\n\titemSelection \u003d self.view.custom.itemSelection\n\tassetId \u003d self.view.custom.asset.assetInfo.assetId\n\trunTypeSelector \u003d self.view.custom.selectedTab\n\t\t\n\tif runTypeSelector \u003d\u003d \u0027Product\u0027:\n\t\tworkOrderId \u003d None\n\t\titemId \u003d itemSelection[\u0027itemId\u0027]\n\t\tmodeName \u003d \u0027Production\u0027\n\t\tsystem.tag.writeBlocking([system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027:assetId}) + \u0027/Line/OEE/scheduleBlockId\u0027], [None]) #Clear the scheduleBlockId. We should put this in the assetOperationChange, but for now, we\u0027ll call it from here\n\telif runTypeSelector \u003d\u003d \u0027Orders\u0027: \n\t\tif itemSelection[\u0027workOrderId\u0027] is None: return\n\t\tworkOrderId \u003d itemSelection[\u0027workOrderId\u0027]\n\t\titemId \u003d itemSelection[\u0027itemId\u0027]\n\t\tmodeName \u003d \u0027Production\u0027\n\t\tsystem.tag.writeBlocking([system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027:assetId}) + \u0027/Line/OEE/scheduleBlockId\u0027], [None]) #Clear the scheduleBlockId. We should put this in the assetOperationChange, but for now, we\u0027ll call it from here\n\telif runTypeSelector \u003d\u003d \u0027Scheduled\u0027:\t\n\t\tif itemSelection[\u0027scheduleId\u0027] is None: return\n\t\tscheduleInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.schedule.getScheduleBlocks({\u0027scheduleBlockId\u0027: itemSelection[\u0027scheduleId\u0027]}),0)\n\t\tworkOrderId \u003d scheduleInfo[\u0027workOrderId\u0027]\n\t\titemId \u003d scheduleInfo[\u0027itemId\u0027]\n\t\tmodeName \u003d scheduleInfo[\u0027modeName\u0027]\n\t\tsystem.tag.writeBlocking([system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027:assetId}) + \u0027/Line/OEE/scheduleBlockId\u0027], [itemSelection[\u0027scheduleId\u0027]]) #Set the scheduleBlockId\n\telse:\n\t\treturn\n\n\tmodeSourceId \u003d system.kanoa.asset.getModeSourceId(\u0027Operator\u0027)\n\tmodeCode \u003d system.kanoa.utilities.getFieldValue(\u0027modeCode\u0027, system.kanoa.asset.getAssetModes({\u0027assetId\u0027: assetId, \u0027modeName\u0027: modeName}))\n\t\n\tif self.view.custom.asset.customAttributes.has_key(\u0027_runSetupViewPath\u0027) and self.view.custom.asset.customAttributes[\u0027_runSetupViewPath\u0027] is not None:\n\t\tdata \u003d {\"assetId\": assetId, \"modeCode\": modeCode, \"workOrderId\": workOrderId, \"itemId\": itemId, \"modeSourceId\": modeSourceId, \"userId\": self.view.custom.security.userId}\n\t\tsystem.perspective.openPopup(\u0027Confirm Start\u0027, self.view.custom.asset.customAttributes[\u0027_runSetupViewPath\u0027], {\u0027value\u0027: data})\n\t\treturn\n\telse:\n\t\tstandardRate \u003d None\n\t\tassetOperationInfo \u003d {\u0027assetId\u0027: assetId, \u0027modeCode\u0027: modeCode, \u0027workOrderId\u0027: workOrderId, \u0027itemId\u0027: itemId, \u0027standardRate\u0027: standardRate, \u0027modeSourceId\u0027: modeSourceId, \u0027tStamp\u0027: system.date.now(), \u0027includeChildren\u0027: True}\n\t\tmodeEventId, msg \u003d system.kanoa.event.assetOperationChange(assetOperationInfo, self.view.custom.security.userId)\n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Could not change asset mode. %s\u0027%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Asset has been set to %s\u0027%modeName})\n\n\tself.view.getChild(\"root\").updateLineOEE()\n\t\t\n\treturn"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "domId": "btnStart",
                  "name": "btnStart",
                  "tooltip": {
                    "delay": 0,
