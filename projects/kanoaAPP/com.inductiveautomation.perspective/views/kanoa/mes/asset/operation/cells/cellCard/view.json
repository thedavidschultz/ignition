    "custom.countInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tassetId = value['asset']['assetId']\n\tif assetId is None: return []\n\n\tparamsDict = {'assetId': assetId, 'startDate': value['sessionDates']['startDate'], 'endDate': value['sessionDates']['endDate']}\n\tdata = system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getCounterEventTotals(paramsDict))\n\n\tvalues = []\n\tfailedUnits = {}\n\tfor row in data:\n\t\trow = dict(row)\n\t\tif row['value'] == 0: continue\n\t\trow['earnedLaborSecs'] = 0\n\t\tassetPath = row['assetPath']\n\t\tassetName = row['assetName']\n\t\titemPath = row['itemPath']\n\t\tif itemPath:\n\t\t\titemName = itemPath.split(\"\\\\\")[-1]\t\n\t\t\titemRate = value['itemRates'][itemName][assetPath] if value['itemRates'].has_key(itemName) and value['itemRates'][itemName].has_key(assetPath) else None\n\t\t\tif itemRate:\n\t\t\t\ttaktTime = 60.0 / itemRate['standardRate'] if itemRate['itemPeriodName'] == 'Hour' else itemRate['standardRate'] if itemRate else 0\n\t\t\t\trow['earnedLaborSecs'] = int(taktTime * 60.0 * row['value'])\n\t\t\t\n\t\tfailedName = \"%s - %s\"%(assetName, itemPath)\t\t\n\t\tif row['counterName'] != 'waste': values.append(row)\n\t\telif not failedUnits.has_key(failedName): failedUnits[failedName] = row\n\t\telse: failedUnits[failedName]['value'] += row['value']\t\t\n\n\tfor k,v in failedUnits.items(): values.append(v)\n\t\n\treturn sorted(values, key=lambda x: x['itemPath'])\t\t", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "itemRates": "{view.custom.itemRates}", 
            "asset": "{view.custom.asset.assetInfo}", 
            "sessionDates": "{view.custom.sessionValues.dateRange}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
