      "binding": {
        "transforms": [
          {
            "code": "\n\timport time\n\ttime.sleep(0.2)\n\tif value is not None:\n\t\tfor i, tab in enumerate(self.custom.tabInfo.tabs):\n\t\t\tif tab == value: return i\n\n\treturn 0", 
