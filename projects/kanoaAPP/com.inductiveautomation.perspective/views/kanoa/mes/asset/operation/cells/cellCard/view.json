    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\t# implement your handler here\n\tself.view.custom.asset.inputs.state = payload['stateCode']", 
          "messageType": "stateButtonPressed", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\t# implement your handler here\n\t\n\tsystem.perspective.print(\"assetStateSelected() msg rcvd with %s\"%payload)\n\t\n\tif len(payload['selection']) > 0: \n\t\tself.view.custom.asset.inputs.state = payload['selection'][0]['value']['stateCode']\n\t\n\treturn", 
          "messageType": "assetStateSelected", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tself.view.custom.selectedTab = payload['tab']\n\t\n\treturn", 
          "messageType": "tabSelected", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"refreshProductionData() msg rcvd with %s\"%payload)\n\t\n\tif payload.has_key('inputPayload') and payload['inputPayload']['assetId'] ==self.view.params.value.assetId:\n\t\tself.view.refreshBinding(\"custom.asset.assetInfo\")\n\t\n\treturn", 
          "messageType": "refreshProductionData", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [
            "value"
          ], 
          "script": "\n\tuserId = system.kanoa.security.getIDPUserId({'userName': 'SYSTEM'})\n\tcounterId = system.kanoa.utilities.getFieldValue('counterId', system.kanoa.asset.getCounter({'assetId': self.view.params.value.assetId, 'counterName': 'outfeed'}))\n\n\taddCounterInfo = {\n\t\t\t\t\t'counterId': counterId,\n\t\t\t\t\t'tStamp': system.date.now(),\n\t\t\t\t\t'deltaValue': value,\n\t\t\t\t\t'itemStateId': None,\n\t\t\t\t\t'itemId': self.view.custom.orders.selectedItemId,\n\t\t\t\t\t'workOrderId': self.view.custom.orders.selectedOrderId\n\t\t\t\t}\n\t\t\t\t\n\tcounterEventId, msg = system.kanoa.event.addCounterEvent(addCounterInfo, userId)\n\tif msg: system.perspective.sendMessage('showWarningToast', {'message': msg})\n\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': 'Counts have been updated'})\n\t\n\tsystem.perspective.sendMessage(\"refreshProductionData\", {'inputPayload': self.view.params.value})\t\n#\tself.view.refreshBinding(\"custom.countInfo\")\n\t\n\treturn", 
          "name": "addCount"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
