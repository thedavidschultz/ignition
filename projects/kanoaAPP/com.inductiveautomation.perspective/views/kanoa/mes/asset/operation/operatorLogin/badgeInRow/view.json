  "propConfig": {
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.userAction": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tsecurity = value['security']\n\tcanCreate = False\n\tcanEdit = False\n\tif security['userCRUD'] is not None and security['userId'] is not None:\n\t\tif security['userCRUD']['isGatewayAdmin'] or security['userCRUD']['editOperations']['enabled']: \n\t\t\tcanCreate = True \n\t\t\tcanEdit = True\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "custom.display": {
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.display.updateTimer": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\t#If there is no end date, i.e. operator is still badged in, we will update the durationSecs\n\tif self.params.value.endDate: return\n\tif system.date.now() > self.params.value.rangeEnd: return\n\t\n\tself.refreshBinding(\"custom.display.durationSecs\")\n\t\t\n\treturn value\n", 
            "type": "script"
          }
        ], 
        "type": "expr", 
        "overlayOptOut": true, 
        "config": {
          "expression": "now(60000)"
        }
      }
    }, 
    "custom.display.durationSecs": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tif value['endDate']:\n\t\tdurationSecs = value['durationSecs']\n\telse:\n\t\tstartDate = value['startDate'] if value['startDate'] > value['rangeStart'] else value['rangeStart']\n\t\tendDate = system.date.now() if system.date.now() < value['rangeEnd'] else value['rangeEnd']\n\t\tdurationSecs = system.date.secondsBetween(startDate, endDate)\n\n\ttry:\n\t\tint(durationSecs)\n\t\tif (durationSecs or 0) <= 0: return ''\n\t\tif durationSecs <= 60: return '< 1 min'\n\t\treturn system.kanoa.utilities.secondsToText(durationSecs, {'showDays': False, 'showSecs': False, 'roundUp': True})\n\texcept:\n\t\treturn durationSecs", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }
    }
  }
}