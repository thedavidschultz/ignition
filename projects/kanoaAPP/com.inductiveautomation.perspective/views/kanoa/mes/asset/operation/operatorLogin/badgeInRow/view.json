        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"deleteOperatorEvent() called with %s\"%payload)\n\tif payload['userInput'] != 'OK': return\n\tif payload['inputPayload']['attributeEventId'] == self.view.params.value.attributeEventId:\n\n\t\tparams = self.view.params.value\n\t\tuserId = self.view.custom.security.userId\n\t\tsystem.kanoa.attribute.deleteAttributeEvent(params['attributeEventId'], userId)\n\t\t\n\t\tif params['endAttributeEventId']: system.kanoa.attribute.deleteAttributeEvent(params['endAttributeEventId'], userId)\n\t\n\t\tsystem.perspective.sendMessage(\"operatorEventUpdated\", {})\n\t\n\treturn", 
          "messageType": "deleteOperatorEvent", 
          "sessionScope": false, 
          "pageScope": true
        }
