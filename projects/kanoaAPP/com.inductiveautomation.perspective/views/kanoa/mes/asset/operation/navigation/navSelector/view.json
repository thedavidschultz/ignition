            "code": "\n\treturn {\u0027value\u0027: {\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027assetId\u0027: value[\u0027assetId\u0027]}}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.navItems.orders.viewParams": {
      "binding": {
        "config": {
