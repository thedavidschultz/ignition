            "code": "\n\treturn {\u0027value\u0027: {\"assetPath\": value[\u0027assetPath\u0027], \"showAssetSelector\": True}}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.navItems.runChart.viewParams": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn {\u0027value\u0027: {\"assetId\": value[\u0027assetId\u0027]}}",
