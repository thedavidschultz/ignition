  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.filter.assetPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: value or \u0027xxx\u0027}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.assetNavItems": {
      "binding": {
        "config": {
          "path": "view.custom.filter"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetPath\u0027] is None: return {}\n\t\n\tnavItems \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], \u0027_assetOperationNavItems\u0027)\n\tnavItems \u003d system.util.jsonDecode(navItems) if navItems else self.custom.defaultNavItems\n\t\n\treturn system.kanoa.utilities.convertListToDict(navItems, \u0027navItem\u0027)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.defaultNavItems": {
      "persistent": true
    },
    "custom.display": {
      "persistent": true
    },
    "custom.filter": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilter \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\t\n#\tif value[\u0027viewParams\u0027].has_key(\u0027assetId\u0027) and value[\u0027viewParams\u0027][\u0027assetId\u0027]: filter[\u0027assetId\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetId\u0027]\n#\tif filter[\u0027dateRange\u0027][\u0027startDate\u0027] is None:\n#\t\tselectedDateRange \u003d \u0027Today\u0027\n#\t\tstartDate,endDate \u003d system.kanoa.date.getDateRange({\u0027selectedDateRange\u0027:selectedDateRange,\u0027clientTimeZone\u0027:self.session.props.device.timezone.id,\u0027assetPath\u0027:filter[\u0027assetPath\u0027]})\n#\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n#\t\tfilter[\u0027dateRange\u0027][\u0027startDate\u0027] \u003d startDate\n#\t\tfilter[\u0027dateRange\u0027][\u0027endDate\u0027] \u003d endDate\n#\t\tfilter[\u0027dateRange\u0027][\u0027selectedDateRange\u0027] \u003d selectedDateRange\n\t\t\n#\tif filter[\u0027assetPath\u0027] and filter[\u0027assetId\u0027] is None: filter[\u0027assetId\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: filter[\u0027assetPath\u0027]}))\n#\tfilter[\u0027assetPath\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: filter[\u0027assetId\u0027] or -1}))\n#\tfilter[\u0027assetId\u0027] \u003d value[\u0027viewParams\u0027][\u0027assetId\u0027]\n\t\t\n\treturn filter",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.navItems": {
      "persistent": true
    },
    "custom.navItems.downtime.viewParams": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
