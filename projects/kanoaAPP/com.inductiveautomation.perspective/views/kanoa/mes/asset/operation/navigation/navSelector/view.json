          }
        ],
        "type": "property"
      }
    },
    "custom.navItems.runControl.viewParams": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn {\u0027value\u0027: {\u0027assetPath\u0027: value[\u0027assetPath\u0027]}}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.navItems.runReview.viewParams": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn {\u0027value\u0027: {\"initializeAssetSelector\": False, \"showAssetSelector\": False}}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.navItems.schedule.viewParams": {
      "binding": {
        "config": {
          "path": "view.custom.assetInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn {\u0027values\u0027: {\"assetPath\": value[\u0027assetPath\u0027], \"showAssetSelector\": False}}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 379,
      "width": 1539
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "flxRptNav",
          "name": "flxRptNav"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "assetNavItems": "{view.custom.assetNavItems}",
                  "userCRUD": "{view.custom.security.userCRUD}",
                  "width": "{view.custom.display.width}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tnavItems \u003d self.view.custom.navItems\n\tinstances \u003d []\n\tfor k,v in value[\u0027assetNavItems\u0027].items():\n\t\tenabled \u003d self.parent.getNavItemEnabled(v, value[\u0027userCRUD\u0027])\n\t\tif enabled and navItems.has_key(k):\n\t\t\tinstances.append({\u0027value\u0027: navItems[k], \u0027instancePosition\u0027: {\u0027basis\u0027: value[\u0027width\u0027], \u0027grow\u0027: 0, \u0027shrink\u0027: 0}})\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "center",
          "path": "kanoa/mes/asset/operation/navigation/miniNavCard",
          "style": {
            "gap": "5px"
          },
          "useDefaultViewWidth": false,
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "meta": {
          "name": "lblDebug"
        },
        "position": {
          "display": false,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.filter.assetPath"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \"navSelector filter - %s\"%value",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {}
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn str(value)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "style": {
        "padding": "3px"
      },
      "wrap": "wrap"
    },
    "scripts": {
      "customMethods": [
        {
          "name": "getNavItemEnabled",
          "params": [
            "navItem",
            "userCRUD"
          ],
          "script": "\n\tif not navItem[\u0027enabled\u0027]: return False\n\tif userCRUD[\u0027isGatewayAdmin\u0027]: return True\n\tif navItem[\u0027userFunction\u0027] and not userCRUD[navItem[\u0027userFunction\u0027]][\u0027enabled\u0027]: return False\n\n\treturn True"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "navItemsUpdated",
          "pageScope": false,
          "script": "\n\tself.view.refreshBinding(\"custom.assetNavItems\")\n\t\n\treturn",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}