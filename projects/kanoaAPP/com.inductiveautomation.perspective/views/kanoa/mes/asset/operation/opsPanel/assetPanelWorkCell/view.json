                "binding": {
                  "config": {
                    "path": "view.params.value.assetId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tif value is None: return []\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\"assetPath\", system.kanoa.asset.getAssets({\u0027assetId\u0027: value}))\n\tassets \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: assetPath + \"\\\\%\"}))\n\tassets \u003d sorted(assets, key\u003dlambda d: d[\u0027sortOrder\u0027])\n\t\t\n\treturn [{\u0027value\u0027: {\u0027assetId\u0027: asset[\u0027assetId\u0027]}} for asset in assets]",
