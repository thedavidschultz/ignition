{
  "custom": {
    "selectedTab": "State",
    "showNavigation": true,
    "tabInfo": {
      "tabIndex": 1,
      "tabs": [
        "Counts",
        "State",
        "Metrics"
      ]
    }
  },
  "params": {
    "value": {
      "assetId": 1955
    }
  },
  "propConfig": {
    "custom.selectedTab": {
      "binding": {
        "config": {
          "path": "view.custom.tabInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value[\u0027tabs\u0027][value[\u0027tabIndex\u0027]]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\tsystem.perspective.sendMessage(\u0027tabSelected\u0027, {\u0027tab\u0027: self.custom.selectedTab})\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.showNavigation": {
      "binding": {
        "config": {
          "path": "view.params.value.assetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif not value: return False\n\tassetPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetPath\u0027, system.kanoa.asset.getAssets({\u0027assetId\u0027: value}))\n\treturn True if (system.kanoa.asset.getClosestAncestorAttribute(assetPath, \u0027_assetOperationNavLocation\u0027) or \u0027Right Panel\u0027) \u003d\u003d \u0027Right Panel\u0027 else False",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.tabInfo": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 938,
      "width": 1593
    }
  },
