        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.params.value": {
            "binding": {
              "transforms": [
                {
                  "code": "\n\treturn {\n\t\t\t\t\"assetId\": value['assetId'],\n\t\t\t\t\"assetPath\": None,\n\t\t\t\t\"endDate\": value['endDate'],\n\t\t\t\t\"options\": {\n\t\t\t\t\t\t\t\t\"minDurationMins\": 1,\n\t\t\t\t\t\t\t\t\"showAllStates\": False,\n\t\t\t\t\t\t\t\t\"showChanged\": -1,\n\t\t\t\t\t\t\t\t\"showDurationSecs\": False,\n\t\t\t\t\t\t\t\t\"sortDateAsc\": False\n\t\t\t\t\t\t\t},\n\t\t\t\t\"startDate\": value['startDate']\n\t\t\t}", 
