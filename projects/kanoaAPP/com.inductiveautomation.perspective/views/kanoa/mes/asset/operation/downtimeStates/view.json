    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [], 
          "script": "\t\n\tsystem.perspective.print(\"openEditor() called\")\n\tidList = [item.stateEventId for item in self.view.custom.table.selection.data]\n\tassetId = self.view.params.value.assetId\n\n\tpayload = {'value':\t{\"assetId\": assetId, \"idList\": idList}}\t\n\n\teventTitle = 'Edit Event' if len(idList) > 1 else 'Edit Events'\n\tsystem.perspective.openPopup(\"Downtime Editor\", \"kanoa/mes/asset/downtime/downtimeEditor\", params=payload, title=eventTitle,overlayDismiss=True)\n\t\n\treturn", 
          "name": "openEditor"
        }, 
        {
          "params": [], 
          "script": "\n\tself.view.custom.table.selection.row = None\n\tself.view.custom.table.selection.col = None\n\n\treturn", 
          "name": "clearTableSelection"
        }, 
        {
          "params": [], 
          "script": "\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tdata = system.kanoa.event.getStateEventById(self.view.custom.table.selection.data[0].stateEventId)\n\t\n\tfor row in system.dataset.toPyDataSet(data):\n\t\tassetStateId = row['origAssetId'] or row['assetStateId']\n\t\tstateCode = row['origStateCode'] or row['stateCode']\n\t\tsystem.kanoa.event.updateStateEvent({'stateEventId': row['stateEventId'], 'stateCode': stateCode, 'origStateCode': None, 'assetStateId': assetStateId, 'origAssetId': None, 'note':(row['note'] or '') + ' (reverted)'}, userId)\n\t\n\tsystem.perspective.sendMessage(\"DTUpdated\", {})\n\t\n\treturn", 
          "name": "revert"
        }, 
        {
          "params": [], 
          "script": "\t\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tidList = [item.stateEventId for item in self.view.custom.table.selection.data]\n\tfor stateEventId in idList: system.kanoa.event.deleteStateEvent(stateEventId, userId)\n\tsystem.perspective.sendMessage(\"DTUpdated\", {})\n\treturn\t\t", 
          "name": "deleteState"
        }, 
        {
          "params": [], 
          "script": "\n\tif len(self.view.custom.table.selection) == 0: return\n\tstateEventId = self.view.custom.table.selection.data[0].stateEventId\n\tsystem.perspective.print(\"splitEvent() called for stateEventId %i\"%stateEventId)\n\tsystem.perspective.openPopup(\"Split DT\", 'kanoa/mes/asset/downtime/splitDT', params={'values': {\"stateEventId\": stateEventId}})\n\t\n\treturn", 
          "name": "splitEvent"
        }
      ], 
      "extensionFunctions": null
    }
