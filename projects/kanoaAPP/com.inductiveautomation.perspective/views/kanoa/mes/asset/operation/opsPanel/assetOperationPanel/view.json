                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\n\tuserId \u003d self.view.custom.security.userId\n\tsdi \u003d dict(self.view.custom.display.screenDashboard)\n\t\n\tdisplay \u003d self.view.custom.display\n\tsdi[\u0027screenDashboardId\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027screenDashboardId\u0027, system.kanoa.dashboard.getScreenDashboards({\u0027assetId\u0027: display[\u0027dashboardFilter\u0027][\u0027assetId\u0027] or -1, \u0027screenName\u0027: display[\u0027screenName\u0027] or \u0027none\u0027}))\n\tif sdi[\u0027screenDashboardId\u0027] is None or sdi[\u0027assetId\u0027] is None:\n\t\tsdi[\u0027assetId\u0027] \u003d self.view.custom.filter.assetId\n\t\tsystem.perspective.print(\"adding new screenDashboard\")\n\t\tscreenDashBoard, msg \u003d system.kanoa.dashboard.addScreenDashboard(sdi, userId)\n\telse:\n\t\tsystem.perspective.print(\"updating screenDashboard\")\n\t\tretVal, msg \u003d system.kanoa.dashboard.updateScreenDashboard(sdi, userId)\t\t\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, msg)\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Screen dashboard selection has been saved\u0027)\n\t\n\tself.view.custom.display.dashboardFilter.edited \u003d False\n#\tself.view.refreshBinding(\"custom.display.screenDashboard\")\n\t\n\treturn"
