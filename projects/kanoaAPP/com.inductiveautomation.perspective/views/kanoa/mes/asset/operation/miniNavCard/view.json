{
  "custom": {}, 
  "params": {
    "value": {
      "title": "Title", 
      "subTitle": "Subtitle", 
      "iconPath": "material/insert_emoticon"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 360, 
      "height": 80
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "justify": "space-between", 
      "style": {
        "classes": "kanoa/clickable kanoa/container", 
        "overflow": "hidden"
      }
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "space-around", 
          "style": {
            "margin": "16px", 
            "gap": 5
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/titleMedium"
              }
            }, 
            "meta": {
              "domId": "lblTitle", 
              "name": "lblTitle"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.title"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodySmall", 
                "overflowWrap": "break-word"
              }
            }, 
            "meta": {
              "domId": "lblSubtitle", 
              "name": "lblSubtitle"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.subTitle"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxLabel", 
          "name": "flxLabel"
        }, 
        "position": {
          "grow": 1, 
          "basis": "280px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "alignItems": "center", 
          "justify": "center", 
          "style": {
            "background": "--kcPrimaryContainer"
          }
        }, 
        "children": [
          {
            "type": "ia.display.icon", 
            "props": {
              "style": {
                "padding": "10px", 
                "color": "--kcOnPrimaryContainer"
              }
            }, 
            "meta": {
              "domId": "icon", 
              "name": "icon"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0, 
              "basis": "30px"
            }, 
            "propConfig": {
              "props.path": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.iconPath"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxIcon", 
          "name": "flxIcon"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "80px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}