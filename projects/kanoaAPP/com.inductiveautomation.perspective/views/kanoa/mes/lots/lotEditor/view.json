    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tlotInfo \u003d self.view.custom.lotInfo\n\t\n\tif lotInfo[\u0027lotId\u0027]:\t\n\t\tretVal, msg \u003d system.kanoa.lot.updateLot(lotInfo, userId)\n\telse: \n\t\tlotId, msg \u003d system.kanoa.lot.addLot(lotInfo, userId)\n\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Lot was not saved. %s\u0027%msg})\t\t\t\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Lot has been saved\u0027})\n\t\n\tsystem.perspective.sendMessage(\u0027lotUpdate\u0027, {})\t\n\t\n\treturn True if msg is None else False"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "lotItemSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"lotItemSelected() msg rcvd with %s\"%payload)\n\t\n\tlotInfo \u003d dict(self.view.custom.lotInfo)\n\t\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: \n\t\tlotInfo[\u0027itemId\u0027] \u003d None\n\t\tlotInfo[\u0027itemPath\u0027] \u003d None\n\t\tlotInfo[\u0027itemUnitId\u0027] \u003d None\n\telse:\n\t\tsystem.perspective.print(\"Setting itemId to %s\"%payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemId\u0027) else None)\n\t\tlotInfo[\u0027itemId\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemId\u0027) else None\n\t\tlotInfo[\u0027itemPath\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemPath\u0027] if payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemPath\u0027) else None\n\n\tself.view.custom.lotInfo \u003d lotInfo\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
