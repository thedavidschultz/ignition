  "propConfig": {
    "custom.lotEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.lotEventId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tdateFields \u003d [\u0027createdDate\u0027]\n\tclientTZOffset \u003d self.session.props.device.timezone.utcOffset\n\tlotEventInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLotEvents({\u0027lotEventId\u0027: value or -1}),0)\n\tfor field in dateFields:\n\t\tif lotEventInfo[field] is not None: lotEventInfo[field] \u003d system.date.addHours(lotEventInfo[field], clientTZOffset)\n\treturn lotEventInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
