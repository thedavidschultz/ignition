            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom-left", 
                "text": "Save"
              }, 
              "domId": "btnSave", 
              "name": "btnSave"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\trouteStepInfo = dict(self.view.custom.routeStepInfo)\n\tif routeStepInfo['stepDescription'] == '': routeStepInfo['stepDescription'] = None\n\tif routeStepInfo['stepParams'] == '': routeStepInfo['stepParams'] = None\n\t\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif routeStepInfo['routeStepEventId'] is not None: \t#If name has changed, we need to check that it doesn't already exist\n\t\tretVal, msg = system.kanoa.lot.updateRouteStepEvent(routeStepInfo, userId)\n\telse:\n\t\trouteStepId, msg = system.kanoa.lot.addRouteStepEvent(routeStepInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage('showFailerToast', {'message': \"Couldn't save this Route Step Event. %s\"%msg})\n\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': \"Route Step Event has been saved\"})\n\n\tsystem.perspective.sendMessage(\"updateRouteStepEvents\", {})\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\treturn True if (value['routeEventId'] or None) is not None and (value['lotOperationId'] or None) is not None else False", 
