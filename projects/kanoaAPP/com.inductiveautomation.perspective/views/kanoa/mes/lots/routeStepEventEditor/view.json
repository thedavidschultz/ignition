  "propConfig": {
    "custom.routeStepInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\n\trouteInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getRouteStepEvents({'routeStepEventId':value['routeStepEventId'] or -1}), 0)\n\trouteInfo['stepDescription'] = routeInfo['stepDescription'] or ''\n\trouteInfo['stepParams'] = routeInfo['stepParams'] or ''\n\trouteInfo['enabled'] = routeInfo['enabled'] or True\n\trouteInfo['stepNum'] = routeInfo['stepNum'] or 1\n\tif routeInfo['routeStepEventId'] is None: \n\t\trouteInfo['routeEventId'] = value['routeEventId']\n\t\trouteSteps = system.kanoa.utilities.convertDatasetToJSON(system.kanoa.lot.getRouteStepEvents({'routeEventId': value['routeEventId'] or -1}))\n\t\trouteInfo['stepNum'] = max([routeStep['stepNum'] for routeStep in routeSteps]) + 1 if len(routeSteps) > 0 else 1\n\t\n\treturn routeInfo\n", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
