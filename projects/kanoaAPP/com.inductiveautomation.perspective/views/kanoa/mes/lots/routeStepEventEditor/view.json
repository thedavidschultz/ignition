          "script": "\n\tsystem.perspective.print('stepParamsUpdated() msg rcved with %s'%payload)\n\t\n\tself.view.custom.routeStepInfo.stepParams = payload['stepParams']\n\t\n\treturn", 
          "messageType": "stepParamsUpdated", 
          "sessionScope": false, 
          "pageScope": true
