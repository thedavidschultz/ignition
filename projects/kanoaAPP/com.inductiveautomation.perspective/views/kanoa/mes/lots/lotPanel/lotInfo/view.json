  "propConfig": {
    "custom.inputLotEvents": {
      "binding": {
        "config": {
          "path": "view.params.value.lotId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn [row[\u0027lotEventId\u0027] for row in system.kanoa.lot.getLotEvents({\u0027lotId\u0027: value or -1, \u0027itemSourceName\u0027: \u0027input\u0027})]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.lotAttributeInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.lotId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn \tsystem.kanoa.utilities.convertDatasetToJSON(system.kanoa.lot.getLotAttributes({\u0027lotId\u0027: value or -1}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.lotInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.lotId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tdateFields \u003d [\u0027createdDate\u0027]\n\tclientTZOffset \u003d self.session.props.device.timezone.utcOffset\n\tlotInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLots({\u0027lotId\u0027: value or -1}),0)\n\tfor field in dateFields:\n\t\tif lotInfo[field] is not None: lotInfo[field] \u003d system.date.addHours(lotInfo[field], clientTZOffset)\n\treturn lotInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.outputLotEvents": {
      "binding": {
        "config": {
          "path": "view.params.value.lotId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn [row[\u0027lotEventId\u0027] for row in system.kanoa.lot.getLotEvents({\u0027lotId\u0027: value or -1, \u0027itemSourceName\u0027: \u0027output\u0027})]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 950,
      "width": 448
