  "propConfig": {
    "custom.inputLotEvents": {
      "binding": {
        "config": {
          "path": "view.params.value.lotOperationEventId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn [row[\u0027lotEventId\u0027] for row in system.kanoa.lot.getLotEvents({\u0027lotOperationEventId\u0027: value or -1, \u0027itemSourceName\u0027: \u0027input\u0027})]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.lotOperationEventInfo": {
      "binding": {
        "config": {
          "path": "view.params.value.lotOperationEventId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdateFields \u003d [\u0027createdDate\u0027, \u0027tStamp\u0027]\n\tclientTZOffset \u003d self.session.props.device.timezone.utcOffset\n\tloeInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLotOperationEvent({\u0027lotOperationEventId\u0027: value or -1}),0)\n\tfor field in dateFields:\n\t\tif loeInfo[field] is not None: loeInfo[field] \u003d system.date.addHours(loeInfo[field], clientTZOffset)\n\treturn loeInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.outputLotEvents": {
      "binding": {
        "config": {
          "path": "view.params.value.lotOperationEventId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn [row[\u0027lotEventId\u0027] for row in system.kanoa.lot.getLotEvents({\u0027lotOperationEventId\u0027: value or -1, \u0027itemSourceName\u0027: \u0027output\u0027})]",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
