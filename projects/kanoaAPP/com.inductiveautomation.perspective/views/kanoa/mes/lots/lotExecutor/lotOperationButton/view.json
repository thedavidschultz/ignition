{
  "custom": {},
  "params": {
    "value": {
      "lotOperationColor": "#FFCA8A",
      "lotOperationId": 30,
      "lotOperationName": "Apply Sticker",
      "selected": false
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60,
      "width": 160
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t\n\tsystem.perspective.sendMessage(\u0027lotOperationSelected\u0027, self.view.params.value)\n\n\treturn\t\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "button",
          "name": "button",
          "tooltip": {
            "delay": 0,
            "location": "top",
            "tail": false,
            "text": "Changeover"
          }
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.image.icon.path": {
            "binding": {
              "config": {
                "path": "view.custom.modeInfo.iconPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.value.lotOperationColor"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.borderStyle": {
            "binding": {
              "config": {
                "path": "view.params.value.selected"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \u0027solid\u0027 if value else \u0027none\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "path": "this.props.style.backgroundColor"
              },
              "transforms": [
                {
                  "code": "\treturn system.kanoa.utilities.getContrastingColor(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\treturn value[\u0027lotOperationName\u0027] or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {}
          },
          "style": {
            "borderWidth": "3px",
            "classes": "kanoa/button/filled"
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}