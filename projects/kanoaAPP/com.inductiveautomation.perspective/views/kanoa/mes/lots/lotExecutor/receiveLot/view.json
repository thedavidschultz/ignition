    "scripts": {
      "customMethods": [
        {
          "name": "saveLotOperation",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"saveLotOperation called\")\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tlotEventInfo \u003d self.view.custom.lotEventInfo\t\n\tlotOperationInfo \u003d self.view.custom.lotOperationInfo\n\tlotOperationEventInfo \u003d {\u0027lotOperationEventId\u0027: None,  \u0027lotOperationId\u0027: lotOperationInfo[\u0027lotOperationId\u0027], \u0027assetId\u0027: lotEventInfo[\u0027assetId\u0027], \u0027tStamp\u0027: system.date.now(), \u0027enabled\u0027: True}\n\t\n\t\n\titemSources \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.item.getItemSource({\u0027enabled\u0027: True}), \u0027itemSourceName\u0027, \u0027itemSourceId\u0027)\n\n\toutputLotEvent \u003d  {\n\t\t\t\t\t\t\u0027lotEventId\u0027: None, \n\t\t\t\t\t\t\u0027lotId\u0027: None,\n\t\t\t\t\t\t\u0027lotName\u0027: lotEventInfo[\u0027lotName\u0027],\n\t\t\t\t\t\t\u0027lotEventQty\u0027: lotEventInfo[\u0027lotEventQty\u0027], \n\t\t\t\t\t\t\u0027workOrderId\u0027: lotEventInfo[\u0027workOrderId\u0027], \n\t\t\t\t\t\t\u0027assetId\u0027: lotEventInfo[\u0027assetId\u0027],\n\t\t\t\t\t\t\u0027itemId\u0027: lotEventInfo[\u0027itemId\u0027],\n\t\t\t\t\t\t\u0027itemUnitId\u0027: lotEventInfo[\u0027itemUnitId\u0027],\n\t\t\t\t\t\t\u0027itemSourceId\u0027: itemSources[\u0027output\u0027], \n\t\t\t\t\t\t\u0027lotStateId\u0027: system.kanoa.utilities.getFieldValue(\u0027lotStateId\u0027, system.kanoa.lot.getLotStates({\u0027lotStateName\u0027: \u0027OK\u0027})), \n\t\t\t\t\t\t\u0027lotStateReasonId\u0027: None, \n\t\t\t\t\t\t\u0027shiftId\u0027: None, \n\t\t\t\t\t\t\u0027tStamp\u0027: system.date.now(), \n\t\t\t\t\t\t\u0027comment\u0027:None, \n\t\t\t\t\t\t\u0027lotOperationEventId\u0027: None\n\t\t\t\t\t}\n\t\n\tlotOperationEventId, msg \u003d system.kanoa.lot.executeLotOperation(lotOperationEventInfo, [], [outputLotEvent], userId)\n\n\tif msg:\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Lot was not received. %s\u0027%msg})\t\t\t\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Lot has been received\u0027})\t\t\t\n\n\tsystem.perspective.sendMessage(\u0027lotReceived\u0027, {\u0027itemId\u0027: lotEventInfo[\u0027itemId\u0027]})\n\t\n\treturn lotOperationEventId, msg"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
