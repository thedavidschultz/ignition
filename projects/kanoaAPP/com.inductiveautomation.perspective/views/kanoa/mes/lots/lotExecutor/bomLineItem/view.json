    },
    "custom.lots": {
      "persistent": true
    },
    "custom.lots.lotOptions": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\thasQty \u003d False if self.params.value.lotConfig.outputLot \u003d\u003d \u0027selectPart\u0027 else True\n\tlots \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.lot.getLotActivity({\u0027itemId\u0027: value[\u0027itemId\u0027] or -1, \u0027hasQty\u0027: hasQty}))\n\toptions \u003d []\n\tfor i, row in enumerate(lots):\t\t\t\n\t\tlotStatus \u003d row[\u0027lotStateName\u0027] or \u0027\u0027\n\t\tif lotStatus !\u003d (row[\u0027lotStateReasonName\u0027] or lotStatus): lotStatus \u003d \"%s (%s)\"%(lotStatus, row[\u0027lotStateReasonName\u0027])\n\t\toptions.append(\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\u0027label\u0027: \"%s | %s | %s %s | %s\"%(row[\u0027lotName\u0027], row[\u0027assetName\u0027], row[\u0027lotEventQty\u0027], row[\u0027itemUnitName\u0027] or \u0027\u0027, lotStatus),\n\t\t\t\t\t\t\t\u0027lotId\u0027: row[\u0027lotId\u0027],\n\t\t\t\t\t\t\t\u0027assetId\u0027: row[\u0027assetId\u0027],\n\t\t\t\t\t\t\t\u0027itemUnitId\u0027: row[\u0027itemUnitId\u0027],\n\t\t\t\t\t\t\t\u0027lotEventQty\u0027: row[\u0027lotEventQty\u0027],\n\t\t\t\t\t\t\t\u0027lotName\u0027: row[\u0027lotName\u0027],\n\t\t\t\t\t\t\t\u0027itemId\u0027: row[\u0027itemId\u0027],\n\t\t\t\t\t\t\t\u0027itemName\u0027: row[\u0027itemName\u0027],\n\t\t\t\t\t\t\t\u0027itemPath\u0027: row[\u0027itemPath\u0027],\n\t\t\t\t\t\t\t\u0027itemUnitId\u0027: row[\u0027itemUnitId\u0027],\n\t\t\t\t\t\t\t\u0027itemUnitName\u0027: row[\u0027itemUnitName\u0027],\n\t\t\t\t\t\t\t\u0027lotStateId\u0027: row[\u0027lotStateId\u0027],\n\t\t\t\t\t\t\t\u0027lotStateName\u0027: row[\u0027lotStateName\u0027],\n\t\t\t\t\t\t\t\u0027lotStateReasonName\u0027: row[\u0027lotStateReasonName\u0027],\n\t\t\t\t\t\t\t\u0027lotStateReasonId\u0027: row[\u0027lotStateReasonId\u0027],\n\t\t\t\t\t\t\t\u0027value\u0027: i\n\t\t\t\t\t\t})\n\n\treturn options",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.lots.selection": {
      "binding": {
        "config": {
          "struct": {
            "index": "{view.custom.lots.index}",
            "lotOptions": "{view.custom.lots.lotOptions}"
