        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tlotEventInfo \u003d {\n\t\t\t\t\u0027assetId\u0027: self.params.value.assetId,\n\t\t\t\t\u0027lotId\u0027: None,\n\t\t\t\t\u0027lotName\u0027: None,\n\t\t\t\t\u0027itemId\u0027: self.params.value.itemId,\n\t\t\t\t\u0027itemName\u0027: self.params.value.itemName,\n\t\t\t\t\u0027itemUnitId\u0027: None,\n\t\t\t\t\u0027itemUnitName\u0027: self.params.value.itemUnitName,\n\t\t\t\t\u0027lotEventQty\u0027: self.params.value.qty,\n\t\t\t\t\u0027lotStateId\u0027: None,\n\t\t\t\t\u0027lotStateName\u0027: None,\n\t\t\t\t\u0027lotStateReasonId\u0027: None,\n\t\t\t\t\u0027lotStateReasonName\u0027: None\n\t\t\t}\n\n\tif len(value[\u0027lotOptions\u0027]) \u003d\u003d 0 or value[\u0027index\u0027] is None: return lotEventInfo\n\n\tlotInfo \u003d value[\u0027lotOptions\u0027][value[\u0027index\u0027]]\n\n\tlotEventInfo[\u0027assetId\u0027] \u003d lotInfo[\u0027assetId\u0027]\n\tlotEventInfo[\u0027lotId\u0027] \u003d lotInfo[\u0027lotId\u0027]\n\tlotEventInfo[\u0027lotName\u0027] \u003d lotInfo[\u0027lotName\u0027]\n\tlotEventInfo[\u0027itemId\u0027] \u003d lotInfo[\u0027itemId\u0027]\n\tlotEventInfo[\u0027itemName\u0027] \u003d lotInfo[\u0027itemName\u0027]\n\tlotEventInfo[\u0027itemPath\u0027] \u003d lotInfo[\u0027itemPath\u0027]\t\t\t\n\tlotEventInfo[\u0027itemUnitId\u0027] \u003d lotInfo[\u0027itemUnitId\u0027]\n\tlotEventInfo[\u0027itemUnitName\u0027] \u003d lotInfo[\u0027itemUnitName\u0027]\n\tlotEventInfo[\u0027lotEventQty\u0027] \u003d self.params.value.qty\n\tlotEventInfo[\u0027lotStateId\u0027] \u003d lotInfo[\u0027lotStateId\u0027]\n\tlotEventInfo[\u0027lotStateName\u0027] \u003d lotInfo[\u0027lotStateName\u0027]\n\tlotEventInfo[\u0027lotStateReasonId\u0027] \u003d lotInfo[\u0027lotStateReasonId\u0027]\n\tlotEventInfo[\u0027lotStateReasonName\u0027] \u003d lotInfo[\u0027lotStateReasonName\u0027]\n\n\treturn lotEventInfo",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
