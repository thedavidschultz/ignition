          "messageType": "refreshLotAttributes",
          "pageScope": true,
          "script": "\t\t\n\tself.view.refreshBinding(\"custom.lots.data\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "deleteLotAttribute",
          "pageScope": true,
          "script": "\t\n\tretVal, msg \u003d system.kanoa.lot.deleteLotAttribute(self.view.custom.table.selection.data[0][\u0027lotAttributeId\u0027], self.view.custom.security.userId)\n\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027Unable to delete lot attribute\u0027})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027%s has been deleted\u0027%self.view.custom.table.selection.data[0][\u0027lotAttributeName\u0027]})\n\t\n\tself.view.refreshBinding(\"custom.lots.data\")\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
