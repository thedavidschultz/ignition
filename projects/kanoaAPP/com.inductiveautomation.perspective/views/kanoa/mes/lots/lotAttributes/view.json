  "propConfig": {
    "custom.lots": {
      "persistent": true
    },
    "custom.lots.data": {
      "binding": {
        "config": {
          "struct": {
            "lotId": "{view.params.value.lotId}",
            "showLinkedLots": "{view.custom.showLinkedLots}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027lotId\u0027] is None: return []\n\tif value[\u0027showLinkedLots\u0027]: paramsDict \u003d {\u0027lotIdList\u0027: list(set([row[\u0027lotId\u0027] for row in system.dataset.toPyDataSet(system.kanoa.lot.traceLot(value[\u0027lotId\u0027], 20))]))}\n\telse: paramsDict \u003d {\u0027lotId\u0027: value[\u0027lotId\u0027]}\n\n\treturn system.dataset.sort(system.kanoa.lot.getLotAttributes(paramsDict), \u0027createdDate\u0027, False)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.showLinkedLots": {
      "persistent": true
    },
    "custom.table": {
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.table.selection.data}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureLots\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True\n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027] or []) else False\n\t\n\taction \u003d {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}\n\t\n\treturn action",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
