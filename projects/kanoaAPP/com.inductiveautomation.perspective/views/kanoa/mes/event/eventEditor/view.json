    "scripts": {
      "customMethods": [
        {
          "name": "deleteEvent",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"deleteEvent() called\")\n\n\tupdateEvent \u003d self.view.params.value.updateParams.updateEventName\n\t\n\trowData \u003d self.view.custom.table.selection.data\n\tif len(rowData) \u003d\u003d 0: return\n\t\n\tif rowData[0][updateEvent]: \n\t\tpayload \u003d {updateEvent: rowData[0][updateEvent]}\n\t\tsystem.perspective.print(\u0027sending Message deleteEvent with %s\u0027%payload)\n\t\tsystem.perspective.sendMessage(\u0027deleteEvent\u0027, payload)\n\telse:\n\t\tself.view.custom.table.data \u003d system.dataset.deleteRow(self.view.custom.table.data, self.view.custom.table.selection.row)\n\t\n\treturn"
        },
        {
          "name": "addEventRow",
          "params": [],
          "script": "\n\tdata \u003d self.view.custom.table.data\n\t\n\trow \u003d [None for i in range(len(system.dataset.getColumnHeaders(data)))]\n\trowIndex \u003d data.rowCount if self.view.custom.table.selection.row is None else self.view.custom.table.selection.row\n\tsystem.perspective.print(\"row %s\"%rowIndex)\n\tself.view.custom.table.data \u003d system.dataset.addRow(data, rowIndex, row)\n\t\n\treturn"
        },
        {
          "name": "updateEvent",
          "params": [
            "value",
            "tStamp"
          ],
          "script": "\n\tsystem.perspective.print(\"updateEvent() called with %s %s\"%(value, tStamp))\n\n\tupdateEvent \u003d self.view.params.value.updateParams.updateEventName\n\tinsertEvent \u003d self.view.params.value.updateParams.insertEventName\n\tinsertEventId \u003d self.view.params.value.updateParams.insertEventId\n\t\n\trowData \u003d self.view.custom.table.selection.data\n\tif len(rowData) \u003d\u003d 0: return\n\t\n\tif rowData[0][updateEvent]: \n\t\tpayload \u003d {updateEvent: rowData[0][updateEvent], insertEvent: insertEventId, \u0027value\u0027: value, \u0027tStamp\u0027: tStamp}\n\t\tsystem.perspective.print(\u0027sending Message updateEvent with %s\u0027%payload)\n\t\tsystem.perspective.sendMessage(\u0027updateEvent\u0027, payload)\n\telse: \n\t\tpayload \u003d {insertEvent: self.view.params.value.updateParams.insertEventId, \u0027value\u0027: value, \u0027tStamp\u0027: tStamp}\n\t\tsystem.perspective.print(\u0027sending Message insertEvent with %s\u0027%payload)\n\t\tsystem.perspective.sendMessage(\u0027insertEvent\u0027, payload)"
        },
        {
          "name": "refreshEvents",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\u0027sending Message refreshEvents\u0027)\n\tsystem.perspective.sendMessage(\u0027refreshEvents\u0027, {})\n\t\n\treturn"
        }
      ],
