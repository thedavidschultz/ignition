  "propConfig": {
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.table": {
      "persistent": true
    },
    "custom.table.columns": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.table.data}",
            "locale": "{session.props.locale}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tcols \u003d system.dataset.getColumnHeaders(value[\u0027data\u0027])\n\tsubList \u003d [\n\t\t\t\t{\u0027colName\u0027: \u0027EventId\u0027, \u0027colHeader\u0027: \u0027id\u0027, \u0027width\u0027: 20, \u0027editable\u0027: False},\n\t\t\t\t{\u0027colName\u0027: \u0027Name\u0027, \u0027colHeader\u0027: \u0027Name\u0027, \u0027width\u0027: \u0027\u0027, \u0027editable\u0027: False},\n\t\t\t\t{\u0027colName\u0027: \u0027Path\u0027, \u0027colHeader\u0027: \u0027\u0027, \u0027width\u0027: 200, \u0027editable\u0027: False},\n\t\t\t\t{\u0027colName\u0027: \u0027value\u0027, \u0027colHeader\u0027: \u0027Value\u0027, \u0027width\u0027: \u0027\u0027, \u0027editable\u0027: True},\n\t\t\t\t{\u0027colName\u0027: \u0027tStamp\u0027, \u0027colHeader\u0027: \u0027Time Stamp\u0027, \u0027width\u0027: \u0027\u0027, \u0027editable\u0027: False},\n#\t\t\t\t{\u0027colName\u0027: \u0027createdBy\u0027, \u0027colHeader\u0027: \u0027Created By\u0027, \u0027width\u0027: \u0027\u0027},\n#\t\t\t\t{\u0027colName\u0027: \u0027createdDate\u0027, \u0027colHeader\u0027: \u0027Created Date\u0027, \u0027width\u0027: \u0027\u0027},\n#\t\t\t\t{\u0027colName\u0027: \u0027Changed By\u0027, \u0027colHeader\u0027: \u0027Changed By\u0027, \u0027width\u0027: \u0027\u0027},\n#\t\t\t\t{\u0027colName\u0027: \u0027changedDate\u0027, \u0027colHeader\u0027: \u0027Changed Date\u0027, \u0027width\u0027: \u0027\u0027}\n\t\t\t]\n\t\n\tcolList \u003d []\n\t\t\n\tfor col in cols:\n\t\tfor sub in subList:\n\t\t\tif sub[\u0027colName\u0027] in col: colList.append({\u0027colName\u0027: col, \u0027colHeader\u0027: system.util.translate(sub[\u0027colHeader\u0027], value[\u0027locale\u0027]), \u0027width\u0027: sub[\u0027width\u0027], \u0027editable\u0027: sub[\u0027editable\u0027]})\n\t\t\n\treturn colList",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.table.data": {
      "binding": {
        "config": {
          "path": "view.params.value.data"
        },
        "overlayOptOut": true,
        "type": "property"
      }
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "data": "{view.custom.table.selection.data}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027editOperations\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True \n\t\t\tcanEdit \u003d True if len(value[\u0027data\u0027] or []) else False\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
