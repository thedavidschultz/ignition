          "script": "\t\n\tsystem.perspective.print(\"eventTimeStampUpdated() msg received with %s\"%payload)\n\t\n\trowData \u003d self.view.custom.table.selection.data\n\tif len(rowData) \u003d\u003d 0: return\n\t\n\tvalue \u003d rowData[0][\u0027value\u0027]\n\ttStamp \u003d payload[\u0027tStamp\u0027]\n\t\n\tself.updateEvent(value, tStamp)\n\t\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "userResponseDelete",
