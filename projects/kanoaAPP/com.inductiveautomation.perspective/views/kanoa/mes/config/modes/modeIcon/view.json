{
  "custom": {}, 
  "params": {
    "value": ""
  }, 
  "props": {
    "defaultSize": {
      "width": 30, 
      "height": 30
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "width": 30, 
        "height": 30
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.icon", 
        "props": {
          "style": {
            "cursor": "pointer", 
            "classes": "kanoa/button/flatIcon", 
            "width": "100%", 
            "height": "100%"
          }
        }, 
        "meta": {
          "tooltip": {
            "tail": false, 
            "delay": 0, 
            "location": "top"
          }, 
          "domId": "Icon", 
          "name": "Icon"
        }, 
        "position": {
          "shrink": 0
        }, 
        "events": {
          "dom": {
            "onClick": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\t\n\t\n\tif self.view.params.has_key('path'): \n\t\tsystem.perspective.sendMessage(messageType=\"icon-selected\", payload={'path': self.view.params.path})\n\t\n\treturn"
              }
            }
          }
        }, 
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value.split('/')[-1]", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value"
              }
            }
          }, 
          "props.path": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.value"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "tooltip": {
        "tail": false, 
        "location": "top"
      }, 
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}