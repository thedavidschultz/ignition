                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.modeInfo.iconPath"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "default": {
                  "color": "",
                  "path": "material/view_carousel"
                },
                "icon": {
                  "color": null
                }
              },
              "path": "kanoa/core/templates/selectors/icons/iconPickerButton"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "domId": "flxIcon",
          "name": "flxIcon"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tmodeInfo \u003d dict(self.view.custom.modeInfo)\n\tif modeInfo[\u0027reservedBySystem\u0027] is None: modeInfo[\u0027reservedBySystem\u0027] \u003d False\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tif modeInfo[\u0027modeId\u0027] is not None: system.kanoa.asset.updateMode(modeInfo, userId)\n\telse: system.kanoa.asset.addMode(modeInfo, userId)\n\t\n\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Mode has been %s\u0027%\u0027updated\u0027 if modeInfo[\u0027modeId\u0027] else \u0027added\u0027})\n\tsystem.perspective.sendMessage(\"updateModeReasons\", {})\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "expression": "if(isnull({view.params.values.code}), \u0027Add\u0027, \u0027Update\u0027)"
                  },
                  "type": "expr"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.modeInfo"
                  },
                  "transforms": [
                    {
                      "code": "\treturn (value.modeName or None) is not None and value.modeTypeId is not None",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "location": "bottom"
              }
            },
