            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "label",
              "name": "label"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Color"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tself.view.getChild(\"root\").custom.selectedAttribute \u003d \u0027Color-Light\u0027\n\tsystem.perspective.openPopup(\"Color Picker\", \"kanoa/core/templates/colorPicker/main\", {}, overlayDismiss\u003dTrue)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "lblColor",
              "name": "lblColor"
            },
            "position": {
              "basis": "25px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.modeInfo.modeColor"
                  },
                  "overlayOptOut": true,
                  "type": "property"
