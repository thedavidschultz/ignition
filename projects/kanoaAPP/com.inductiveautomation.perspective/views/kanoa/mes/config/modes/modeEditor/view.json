    "custom": {
      "selectedAttribute": "Color-Light"
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/popup",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\tself.view.custom.modeInfo.modeColor \u003d payload[\u0027color\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}