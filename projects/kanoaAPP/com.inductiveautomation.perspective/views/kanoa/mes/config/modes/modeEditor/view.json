          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "label-1",
              "name": "label"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
