{
  "custom": {
    "modeInfo": {
      "canSchedule": true,
      "canSelect": true,
      "enabled": true,
      "iconPath": null,
      "modeColor": null,
      "modeId": null,
      "modeName": "",
      "modeTypeId": null,
      "modeTypeName": null,
      "reservedBySystem": null
    }
  },
  "params": {
    "modeId": null
  },
  "propConfig": {
    "custom.modeInfo": {
      "binding": {
        "config": {
          "path": "view.params.modeId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tmodeInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getModes({\u0027modeId\u0027: value or -1}),0)\n\tif modeInfo[\u0027modeId\u0027] is None: \n\t\tmodeInfo[\u0027modeName\u0027] \u003d \u0027\u0027\n\t\tmodeInfo[\u0027enabled\u0027] \u003d True\n\t\tmodeInfo[\u0027canSelect\u0027] \u003d True\n\t\tmodeInfo[\u0027canSchedule\u0027] \u003d True\n\t\n\treturn modeInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.modeId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 234,
      "width": 350
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "Label",
              "name": "Label"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Mode Name"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "TextField",
              "name": "TextField"
            },
            "position": {
              "basis": "150px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.modeInfo.modeName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default"
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "domId": "flxModeName",
          "name": "flxModeName"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblType",
              "name": "lblType"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Type"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "ddModeType",
              "name": "ddModeType"
            },
            "position": {
              "basis": "150px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "1"
                  },
                  "transforms": [
                    {
                      "code": "\n\treturn [{\u0027value\u0027: row[\u0027modeTypeId\u0027], \u0027label\u0027: row[\u0027modeTypeName\u0027]} for row in system.kanoa.asset.getModeTypes({\u0027enabled\u0027: True})]",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.modeInfo.modeTypeId"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "allowCustomOptions": true,
              "dropdownOptionStyle": {
                "classes": "kanoa/font/default"
              },
              "showClearIcon": true,
              "style": {
                "classes": "kanoa/font/default"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "domId": "flxModeType",
          "name": "flxModeType"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
