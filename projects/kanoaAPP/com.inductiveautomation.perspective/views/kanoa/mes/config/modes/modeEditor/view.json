              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxActions",
          "name": "flxActions"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "props": {
