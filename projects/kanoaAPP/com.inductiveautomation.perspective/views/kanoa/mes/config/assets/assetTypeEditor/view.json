    "scripts": {
      "customMethods": [
        {
          "name": "saveAssetType",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"saveAssetType() called\")\n\tassetTypeInfo \u003d dict(self.view.custom.values)\n\tassetTypeId \u003d assetTypeInfo[\u0027assetTypeId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif assetTypeId is None:\n\t\tsystem.perspective.print(\"checking name...\")\n\t\tif system.kanoa.asset.getAssetTypes({\u0027assetTypeName\u0027:assetTypeInfo[\u0027assetTypeName\u0027], \u0027parentTypeId\u0027:assetTypeInfo[\u0027parentId\u0027]}).rowCount \u003e 0:\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This asset type already exists\u0027})\n\t\t\treturn\n\t\n\t\tassetTypeId, msg \u003d system.kanoa.asset.addAssetType(assetTypeInfo, userId)\n\t\tself.view.custom.values.assetTypeId \u003d assetTypeId\n\telse:\n\t\tsystem.perspective.print(\"Caling updateAssetType() ...\")\n\t\tretVal, msg \u003d system.kanoa.asset.updateAssetType(assetTypeInfo, userId)\n\n\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save Asset Type. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Asset Type saved\u0027})\n\t\t\n\tself.view.refreshBinding(\"custom.data\") #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshAssetTypes\", {})\n\treturn"
        },
        {
          "name": "deleteAssetType",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"deleteAssetType() called\")\n\tassetTypeId \u003d self.view.params.value.assetTypeId\n\tif assetTypeId is None: return\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tretVal, msg \u003d system.kanoa.asset.deleteAssetType(assetTypeId, userId)\n\tif not retVal:\n\t\tif \u0027The DELETE statement conflicted with the REFERENCE constraint\u0027 in str(msg) or \u0027The DELETE statement conflicted with the SAME TABLE REFERENCE constraint\u0027 in str(msg):\n\t\t\tmsg \u003d \u0027This asset type is being used. Please remove any assets within this asset type before deleting\u0027\n#\t\t\tsystem.perspective.openPopup(\u0027userDeleteConfirm\u0027, \u0027kanoa/core/templates/inputs/confirm\u0027, {\u0027text\u0027:msg, \u0027messageHandler\u0027:\u0027deleteAssetHistory\u0027}, title\u003d\u0027Delete Asset and Historical data\u0027, modal\u003dTrue, overlayDismiss\u003dTrue)\t\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: msg})\t\t\n\n\tself.view.params.value.assetTypeId \u003d None\n\tself.view.refreshBinding(\"custom.data\") #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshAssetTypes\", {})\n\n\treturn"
        },
        {
          "name": "clearAssetInfo",
          "params": [],
          "script": "\n\treturn {\n\t\t\t\t\u0027path\u0027: \u0027\u0027,\n\t\t\t\t\u0027changedDate\u0027: None,\n\t\t\t\t\u0027createdDate\u0027: None,\n\t\t\t\t\u0027assetTypeId\u0027: None,\n\t\t\t\t\u0027createdBy\u0027: None,\n\t\t\t\t\u0027changedBy\u0027: None,\n\t\t\t\t\u0027assetTypeName\u0027: \u0027\u0027,\n\t\t\t\t\u0027iconPath\u0027: \u0027\u0027,\n\t\t\t\t\u0027parentId\u0027: None,\n\t\t\t\t\u0027enabled\u0027: True\n\t\t\t}"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "#\n#\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n#\tself.view.custom.modeInfo.modeColor \u003d payload[\u0027color\u0027]\n#\t\n#\treturn\n\tpass",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\tif payload.has_key(\u0027msgHandler\u0027) and payload[\u0027msgHandler\u0027] \u003d\u003d \u0027assetTypeSelected\u0027:\n\t\tself.view.params.value.assetTypeId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027assetTypeId\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 else None\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
