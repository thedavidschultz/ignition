    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n#\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\n\tif len(payload['selection']) == 0: return\n\t\n\tself.view.params.value.performanceStateClassId = payload['selection'][0]['value']['performanceStateClassId']\n\n\treturn", 
          "messageType": "updatePopupSelection", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tinfo = dict(self.view.custom.values)\n\t\n\tsystem.perspective.print(\"save() called with %s\"%info)\t\n\t\n\tperformanceStateClassId = info['performanceStateClassId']\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tif info['performanceStateClassId'] is None:\n\t\tif system.kanoa.utilities.getFieldValue('performanceStateClassId', system.kanoa.performanceState.getPerformanceStateClasses({'performanceStateClassName': info['performanceStateClassName'], 'parentId': info['parentId']})) is not None:\n\t\t\tsystem.perspective.sendMessage('showWarningToast', {'message': 'This performance state class already exists'})\n\t\t\treturn\n\t\t\n\t\tperformanceStateClassId, msg = system.kanoa.performanceState.addPerformanceStateClass(info, userId)\n\t\tsystem.perspective.print(\"addPerformanceStateClass() returned %s %s\"%(performanceStateClassId, msg)) \n\t\tif msg: system.perspective.sendMessage('showWarningToast', {'message': \"Couldn't add performance state class. %s\"%msg})\n\t\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': 'performance State Class added'})\n\telse: \n\t\tretVal, msg = system.kanoa.performanceState.updatePerformanceStateClass(info, userId)\n\t\tsystem.perspective.print(\"updatePerformanceStateClass() returned %s %s\"%(retVal, msg)) \n\t\tif msg: system.perspective.sendMessage('showWarningToast', {'message': \"Couldn't update performance state class. %s\"%msg})\n\t\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': 'performance State Class updated'})\n\t\t\n\tself.view.params.value.performanceStateClassId = performanceStateClassId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshPerformanceStateClasses\", {})\n\t\n\treturn", 
          "name": "save"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"delete() called\")\n\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tperformanceStateClassId = self.view.params.value.performanceStateClassId\n\tretVal, msg = system.kanoa.performanceState.deletePerformanceStateClass(performanceStateClassId, userId)\n\t\n\tif retVal:\n\t\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': 'Performance State Class has been deleted'})\n\telse:\n\t\tif 'The DELETE statement conflicted with the REFERENCE constraint' in str(msg) or 'The DELETE statement conflicted with the SAME TABLE REFERENCE constraint' in str(msg):\n\t\t\tmsg = 'There are performance states or links associated with this class. Please delete any performances states and links before deleting.'\n\n\t\tsystem.perspective.sendMessage('showFailerToast', {'message': 'Failed to delete %s. %s'%(performanceStateClassId, msg)})\t\n\t\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshPerformanceStateClasses\", {})\t\n\t\n\treturn", 
          "name": "delete"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
