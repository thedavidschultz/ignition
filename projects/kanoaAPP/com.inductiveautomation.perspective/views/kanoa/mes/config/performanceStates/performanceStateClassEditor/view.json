        "script": "\t\n\tself.custom.canAdd = True\n\t\n\treturn"
      }, 
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.data": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.performanceState.getPerformanceStateClasses({})", 
            "type": "script"
          }
        ], 
        "type": "expr", 
        "config": {
          "expression": "now(0)"
        }
      }, 
      "persistent": true
    }, 
    "params.equipId": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.canSave": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn value.assetName != '' and not value.duplicate", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "duplicate": "{view.custom.customAttributes.duplicate}", 
            "assetName": "{view.custom.values.assetName}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }
  }
}