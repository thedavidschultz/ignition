                  "config": {
                    "script": "\n\tparams \u003d self.view.params.values\n\tstateCategoryInfo \u003d dict(self.view.custom.stateCategoryInfo)\n\tstateCategoryId \u003d stateCategoryInfo[\u0027stateCategoryId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif params[\u0027add\u0027] or params[\u0027stateCategoryId\u0027] is None:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding state category\u0027})\t\n\t\tstateCategoryId, msg \u003d system.kanoa.asset.addStateCategory(stateCategoryInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating state category Id %s\u0027%stateCategoryId})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.asset.updateStateCategory(stateCategoryInfo, userId)\n\t\t\n\tsystem.perspective.sendMessage(\"updateStates\", {\u0027stateCategoryId\u0027: stateCategoryId})\n\n\tif msg: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save state category. %s\"%msg})\n\telse: \n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027State category as been saved.\u0027})\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
