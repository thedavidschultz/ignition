        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tstateCategoryInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getStateCategory({\u0027stateCategoryId\u0027: value[\u0027stateCategoryId\u0027] or -1}),0)\n\n\tif value[\u0027stateCategoryId\u0027] is not None and value[\u0027add\u0027]:\n\t\tstateCategoryInfo[\u0027parentId\u0027] \u003d stateCategoryInfo[\u0027stateCategoryId\u0027]\t\t\n\t\tstateCategoryInfo[\u0027stateCategoryId\u0027] \u003d None\n\t\tstateCategoryInfo[\u0027stateCategoryName\u0027] \u003d None\n\n\tstateCategoryInfo[\u0027stateCategoryName\u0027] \u003d stateCategoryInfo[\u0027stateCategoryName\u0027] or \u0027\u0027\n\n\tif value[\u0027stateCategoryId\u0027] is None: stateCategoryInfo[\u0027enabled\u0027] \u003d True\n\t\n\treturn stateCategoryInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
