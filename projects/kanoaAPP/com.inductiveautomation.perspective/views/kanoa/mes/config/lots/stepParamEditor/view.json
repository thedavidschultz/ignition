{
  "custom": {
    "stepParams": ""
  }, 
  "params": {
    "value": {
      "stepParams": null
    }
  }, 
  "props": {
    "defaultSize": {
      "height": 159
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Step Parameters"
            }, 
            "meta": {
              "domId": "lblname", 
              "name": "lblname"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-area", 
            "props": {
              "style": {
                "classes": "kanoa/font/default"
              }, 
              "deferUpdates": false
            }, 
            "meta": {
              "domId": "txtStepParams", 
              "name": "txtStepParams"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.text": {
                "onChange": {
                  "enabled": null, 
                  "script": "\t\t\n\tif origin == 'Browser': system.perspective.sendMessage('stepParamsUpdated', {'stepParams': self.props.text})\n\t\n\treturn"
                }, 
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.stepParams"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxStepParams", 
          "name": "flxStepParams"
        }, 
        "position": {
          "grow": 1, 
          "basis": 120
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.stepParams": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\treturn value['stepParams'] or ''", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }
  }
}