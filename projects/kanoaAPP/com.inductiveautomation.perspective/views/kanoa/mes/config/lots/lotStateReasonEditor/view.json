{
  "custom": {
    "stateInfo": {
      "lotStateReasonName": "", 
      "createdByUser": null, 
      "lotStateReasonId": null, 
      "lotStateReasonPath": null, 
      "displayPath": null, 
      "enabled": null, 
      "lotStateId": null, 
      "changedDate": null, 
      "createdDate": null, 
      "createdBy": null, 
      "changedBy": null, 
      "lotStateName": null, 
      "changedByUser": null
    }
  }, 
  "params": {
    "values": {
      "id": null
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 350, 
      "height": 157
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5, 
        "classes": "kanoa/container", 
        "overflow": "hidden", 
        "gap": 5
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Lot State Reason"
            }, 
            "meta": {
              "domId": "lblLotStateName", 
              "name": "lblLotStateName"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "style": {
                "classes": "kanoa/font/default kanoa/border"
              }
            }, 
            "meta": {
              "domId": "txtLotStateReasonName", 
              "name": "txtLotStateReasonName"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0, 
              "basis": "150px"
            }, 
            "events": {
              "system": {
                "onStartup": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\timport time\n\ttime.sleep(0.2)\n\tself.focus()"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.stateInfo.lotStateReasonName"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxStateName", 
          "name": "flxStateName"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Lot State"
            }, 
            "meta": {
              "domId": "lblType", 
              "name": "lblType"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.dropdown", 
            "props": {
              "showClearIcon": true, 
              "dropdownOptionStyle": {
                "classes": "kanoa/font/default"
              }, 
              "style": {
                "classes": "kanoa/font/default kanoa/border"
              }
            }, 
            "meta": {
              "domId": "dropdown", 
              "name": "dropdown"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0, 
              "basis": "150px"
            }, 
            "propConfig": {
              "props.options": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn [{'value': row['lotStateId'], 'label': row['lotStateName']} for row in system.kanoa.lot.getLotStates({'enabled': True})]", 
                      "type": "script"
                    }
                  ], 
                  "type": "expr", 
                  "config": {
                    "expression": "1"
                  }
                }
              }, 
              "props.value": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.stateInfo.lotStateId"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxLotState", 
          "name": "flxLotState"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Enabled"
            }, 
            "meta": {
              "domId": "Label", 
              "name": "Label"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.checkbox", 
            "props": {
              "checkedIcon": {
                "color": {
                  "enabled": "--kcGray-60"
                }
              }, 
              "text": ""
            }, 
            "meta": {
              "domId": "Checkbox", 
              "name": "Checkbox"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.selected": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.stateInfo.enabled"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxStateEnabled", 
          "name": "flxStateEnabled"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "padding": "5px", 
            "overflow": "hidden", 
            "gap": "5px"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              }, 
              "style": {
                "classes": "kanoa/button/filled"
              }, 
              "text": "Save"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom-left", 
                "text": "Save"
              }, 
              "domId": "btnSave", 
              "name": "btnSave"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tstateInfo = dict(self.view.custom.stateInfo)\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif stateInfo['lotStateReasonId'] is not None: \t#If state name has changed, we need to check that it doesn't already exist\n\t\tcurrentStateId = system.kanoa.utilities.getFieldValue('lotStateReasonId', system.kanoa.lot.getLotStateReasons({'lotStateReasonName': stateInfo['lotStateReasonName'], 'lotStateId': stateInfo['lotStateId']}))\n\t\tif currentStateId is not None and currentStateId != stateInfo['lotStateReasonId']:\n\t\t\tsystem.perspective.sendMessage('showFailerToast', {'message': 'This state already exists'})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage('showInfoToast', {'message': 'Updating lotStateReasonId %i '%stateInfo['lotStateReasonId']})\t\t\t\n\t\tretVal = system.kanoa.lot.updateLotStateReason(stateInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage('showInfoToast', {'message': 'Adding lot state reason'})\t\n\t\tstateId = system.kanoa.lot.addLotStateReason(stateInfo, userId)\n\n\tsystem.perspective.sendMessage(\"updateStates\", {})\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn True if (value['lotStateReasonName'] or None) is not None and value['lotStateId'] else False", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.custom.stateInfo"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              }, 
              "style": {
                "classes": "kanoa/button/outlined", 
                "marginLeft": "5px"
              }, 
              "text": "Close"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom-left", 
                "text": "Close"
              }, 
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup('')\n\treturn"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxActions", 
          "name": "flxActions"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.stateInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tstateInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLotStateReasons({'lotStateReasonId':value or -1}),0)\n\tstateInfo['lotStateReasonName'] = stateInfo['lotStateReasonName'] or ''\n\treturn stateInfo\n", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.params.values.id"
        }
      }, 
      "persistent": true
    }, 
    "params.values": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}