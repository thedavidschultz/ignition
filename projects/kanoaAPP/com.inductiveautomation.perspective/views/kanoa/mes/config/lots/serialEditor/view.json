{
  "custom": {
    "display": {
      "lblBasis": "80px"
    },
    "serialInfo": {
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": true,
      "prefix": "",
      "serialId": null,
      "serialName": "",
      "serialNumber": null,
      "serialValue": null,
      "suffix": "",
      "zfill": null
    }
  },
  "params": {
    "value": {
      "serialId": null,
      "userId": null
    }
  },
  "propConfig": {
    "custom.display": {
      "persistent": true
    },
    "custom.serialInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tserialInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.serial.getSerialNumbers({\u0027serialId\u0027: value[\u0027serialId\u0027] or -1}), 0)\n\tif serialInfo[\u0027serialId\u0027] is None:\n\t\tserialInfo[\u0027serialName\u0027] \u003d \u0027\u0027\n\t\tserialInfo[\u0027prefix\u0027] \u003d \u0027\u0027\n\t\tserialInfo[\u0027suffix\u0027] \u003d \u0027\u0027\n\t\tserialInfo[\u0027enabled\u0027] \u003d True\n\t\n\treturn serialInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 262,
      "width": 350
    }
  },
