  "propConfig": {
    "custom.routeStepInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\trouteInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getRouteSteps({\u0027routeStepId\u0027:value[\u0027routeStepId\u0027] or -1}), 0)\n\trouteInfo[\u0027stepDescription\u0027] \u003d routeInfo[\u0027stepDescription\u0027] or \u0027\u0027\n\trouteInfo[\u0027stepParams\u0027] \u003d routeInfo[\u0027stepParams\u0027] or \u0027\u0027\n\trouteInfo[\u0027enabled\u0027] \u003d routeInfo[\u0027enabled\u0027] or True\n\trouteInfo[\u0027stepNum\u0027] \u003d routeInfo[\u0027stepNum\u0027] or 1\n\tif routeInfo[\u0027routeStepId\u0027] is None: \n\t\trouteInfo[\u0027routeId\u0027] \u003d value[\u0027routeId\u0027]\n\t\trouteSteps \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.lot.getRouteSteps({\u0027routeId\u0027: value[\u0027routeId\u0027] or -1}))\n\t\trouteInfo[\u0027stepNum\u0027] \u003d max([routeStep[\u0027stepNum\u0027] for routeStep in routeSteps]) + 1 if len(routeSteps) \u003e 0 else 1\n\t\n\treturn routeInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
