          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\trouteStepInfo \u003d dict(self.view.custom.routeStepInfo)\n\tif routeStepInfo[\u0027stepDescription\u0027] \u003d\u003d \u0027\u0027: routeStepInfo[\u0027stepDescription\u0027] \u003d None\n\tif routeStepInfo[\u0027stepParams\u0027] \u003d\u003d \u0027\u0027: routeStepInfo[\u0027stepParams\u0027] \u003d None\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif routeStepInfo[\u0027routeStepId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tretVal, msg \u003d system.kanoa.lot.updateRouteStep(routeStepInfo, userId)\n\telse:\n\t\trouteStepId, msg \u003d system.kanoa.lot.addRouteStep(routeStepInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this Route Step. %s\"%msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Route Step has been saved\"})\n\n\tsystem.perspective.sendMessage(\"updateRouteSteps\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
