          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\trouteInfo \u003d dict(self.view.custom.routeInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif routeInfo[\u0027routeId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentRouteId \u003d system.kanoa.utilities.getFieldValue(\u0027routeId\u0027, system.kanoa.lot.getRoutes({\u0027routeName\u0027: routeInfo[\u0027routeName\u0027]}))\n\t\tif currentRouteId is not None and currentRouteId !\u003d routeInfo[\u0027routeId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This route already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating routeId %i \u0027%routeInfo[\u0027routeId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.lot.updateRoute(routeInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding Route\u0027})\t\n\t\trouteId, msg \u003d system.kanoa.lot.addRoute(routeInfo, userId)\n\n\tsystem.perspective.sendMessage(\"updateRoutes\", {})\n\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this Route. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Route has been saved\"})\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
