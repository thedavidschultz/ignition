{
  "custom": {
    "lotOperationInfo": {
      "allowInputLots": null,
      "allowOutputLots": null,
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": null,
      "lotOperationColor": "",
      "lotOperationId": null,
      "lotOperationName": ""
    }
