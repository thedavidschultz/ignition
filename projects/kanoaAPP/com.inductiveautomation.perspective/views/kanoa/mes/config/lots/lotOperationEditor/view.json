            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tlotOperationInfo \u003d dict(self.view.custom.lotOperationInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif lotOperationInfo[\u0027lotOperationId\u0027] is not None: \t#If name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentLotOperationId \u003d system.kanoa.utilities.getFieldValue(\u0027lotOperationId\u0027, system.kanoa.lot.getLotOperations({\u0027lotOperationName\u0027: lotOperationInfo[\u0027lotOperationName\u0027], \u0027lotOperationId\u0027: lotOperationInfo[\u0027lotOperationId\u0027]}))\n\t\tif currentLotOperationId is not None and currentLotOperationId !\u003d lotOperationInfo[\u0027lotOperationId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This Lot Operation already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Updating lotOperationId %i \u0027%lotOperationInfo[\u0027lotOperationId\u0027]})\t\t\t\n\t\tretVal, msg \u003d system.kanoa.lot.updateLotOperation(lotOperationInfo, userId)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Adding lot Operation\u0027})\t\n\t\tlotOperationId, msg \u003d system.kanoa.lot.addLotOperation(lotOperationInfo, userId)\n\t\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t save this Lot Operation. %s\"%msg})\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Lot Operation has been saved\"})\n\n\tsystem.perspective.sendMessage(\"updateLotOperations\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save"
              }
