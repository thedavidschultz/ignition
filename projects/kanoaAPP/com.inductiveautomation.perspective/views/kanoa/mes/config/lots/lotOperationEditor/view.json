  "propConfig": {
    "custom.lotOperationInfo": {
      "binding": {
        "config": {
          "path": "view.params.values.lotOperationId"
        },
        "transforms": [
          {
            "code": "\n\tlotOperationInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.lot.getLotOperations({\u0027lotOperationId\u0027:value or -1}),0)\n\tlotOperationInfo[\u0027lotOperationName\u0027] \u003d lotOperationInfo[\u0027lotOperationName\u0027] or \u0027\u0027\n\tlotOperationInfo[\u0027lotOperationColor\u0027] \u003d lotOperationInfo[\u0027lotOperationColor\u0027] or \u0027\u0027\n\treturn lotOperationInfo\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 188,
      "width": 350
    }
  },
