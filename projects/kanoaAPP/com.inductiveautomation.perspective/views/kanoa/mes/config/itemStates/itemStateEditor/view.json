            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif stateInfo[\u0027itemStateId\u0027] is not None: \t#If state name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentStateId \u003d system.kanoa.utilities.getFieldValue(\u0027itemStateId\u0027, system.kanoa.item.getItemStates({\u0027itemStateName\u0027: stateInfo[\u0027itemStateName\u0027], \u0027itemStateClassId\u0027: stateInfo[\u0027itemStateClassId\u0027]}))\n\t\tif currentStateId is not None and currentStateId !\u003d stateInfo[\u0027itemStateId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This state already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tretVal, msg \u003d system.kanoa.item.updateItemState(stateInfo, userId)\n\t\tsystem.perspective.print(\"updateItemState() returned %s %s\"%(retVal, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t update item state. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item State updated\u0027})\t\t\t\t\n\telse:\n\t\titemStateId, msg \u003d system.kanoa.item.addItemState(stateInfo, userId)\n\t\tsystem.perspective.print(\"addItemState() returned %s %s\"%(itemStateId, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t add item state. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item State added\u0027})\t\t\n\n\tsystem.perspective.sendMessage(\"refreshItemStates\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
