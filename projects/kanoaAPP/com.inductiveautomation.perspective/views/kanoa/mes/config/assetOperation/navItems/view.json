  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027]}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.customAttributes": {
      "persistent": true
    },
    "custom.defaultNavItems": {
      "persistent": true
    },
    "custom.navItemLocation": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tnavLocation \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], \u0027_assetOperationNavLocation\u0027)\n\treturn navLocation or \u0027Right Panel\u0027\n",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\n\tif origin \u003d\u003d \u0027BindingWriteback\u0027: self.getChild(\"root\").setNavLocation()\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.navItems": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n#\tsystem.perspective.print(\"getting navItems for %s\"%value[\u0027assetPath\u0027])\n\tself.custom.customAttributes.navItems.inherited \u003d False\n\tself.custom.customAttributes.navItems.default \u003d False\n\n\tnavItems \u003d system.kanoa.utilities.getFieldValue(\u0027assetAttrValue\u0027, system.kanoa.asset.getAssetAttributes({\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027assetAttrName\u0027: self.custom.customAttributes.navItems.attributeName}))\n#\tsystem.perspective.print(\"Found navItems %s for %s\"%(navItems,value[\u0027assetPath\u0027]))\n\tif navItems is None:\n#\t\tsystem.perspective.print(\"getting ancestor navItems for %s\"%value[\u0027assetPath\u0027])\n\t\tnavItems \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], self.custom.customAttributes.navItems.attributeName)\n#\t\tsystem.perspective.print(\"Found ancestor navItems %s for %s\"%(navItems,value[\u0027assetPath\u0027]))\n\t\tif navItems: self.custom.customAttributes.navItems.inherited \u003d True\n\t\n\tif navItems is None:\n\t\tnavItems \u003d self.custom.defaultNavItems\n\t\tself.custom.customAttributes.navItems.default \u003d True\n\telse: navItems \u003d system.util.jsonDecode(navItems)\n\t\n\treturn navItems",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "asset": "{view.custom.assetInfo}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value[\u0027asset\u0027][\u0027assetPath\u0027] or \u0027\u0027\n\n\tsecurity \u003d value[\u0027security\u0027]\n\tconfigureAssets \u003d security[\u0027userCRUD\u0027][\u0027configureAssets\u0027]\n\t\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]: canCreate \u003d True\n\telif configureAssets:\n\t\tfor asset in configureAssets[\u0027assets\u0027]:\n\t\t\tif asset in (value[\u0027asset\u0027][\u0027path\u0027] or \u0027\u0027):\n\t\t\t\tcanCreate \u003d True\n\t\t\t\tbreak\n\t\t\t\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None and assetPath !\u003d \u0027\u0027:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]:\n\t\t\tcanEdit \u003d True if assetPath else False\n\t\telif security[\u0027userCRUD\u0027][\u0027configureAssets\u0027][\u0027enabled\u0027]:\n\t\t\tfor path in security[\u0027userCRUD\u0027][\u0027configureAssets\u0027][\u0027assets\u0027]:\n\t\t\t\tif path in assetPath:\n\t\t\t\t\tcanEdit \u003d True\n\t\t\t\t\tbreak\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userFunctions": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfunctionData \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.security.getUserFunctions({\u0027enabled\u0027: True}))\n\treturn [{\u0027label\u0027: item[\u0027label\u0027], \u0027value\u0027: item[\u0027functionName\u0027]} for item in functionData]",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
