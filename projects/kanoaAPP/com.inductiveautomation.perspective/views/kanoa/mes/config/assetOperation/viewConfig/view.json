  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027]}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.opsViews": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\n\tviews \u003d system.perspective.getProjectInfo()[\u0027views\u0027]\t\n\tinfoPanelPath \u003d \u0027kanoa/mes/asset/operation/infoPanel/\u0027\n\topsPanelPath \u003d \u0027kanoa/mes/asset/operation/opsPanel/\u0027\n\tinfoPanels \u003d []\n\topsPanels \u003d []\n\tfor view in views:\n\t\tif infoPanelPath in view[\u0027path\u0027] and \u0027_\u0027 not in view[\u0027path\u0027] and len(view[\u0027path\u0027].replace(infoPanelPath, \u0027\u0027).split(\u0027/\u0027)) \u003d\u003d 1: infoPanels.append(view[\u0027path\u0027])\n\t\telif opsPanelPath in view[\u0027path\u0027] and \u0027_\u0027 not in view[\u0027path\u0027] and len(view[\u0027path\u0027].replace(opsPanelPath, \u0027\u0027).split(\u0027/\u0027)) \u003d\u003d 1: opsPanels.append(view[\u0027path\u0027])\n\t\t\t\t\n\treturn {\u0027infoPanels\u0027: infoPanels, \u0027opsPanels\u0027: opsPanels}\n\t\n\t",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.panels": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tvals \u003d {\n\t\t\t\t\u0027left\u0027: {\u0027viewPath\u0027: \u0027kanoa/mes/asset/operation/infoPanel/assetInfoPanel\u0027, \u0027inherited\u0027: False, \u0027default\u0027: True, \u0027assetAttrName\u0027: \u0027_assetOpsInfoPanelViewPath\u0027},\n\t\t\t\t\u0027right\u0027: {\u0027viewPath\u0027: \u0027kanoa/mes/asset/operation/opsPanel/assetOperationPanel\u0027, \u0027inherited\u0027: False, \u0027default\u0027: True, \u0027assetAttrName\u0027: \u0027_assetOpsViewPath\u0027}\n\t\t\t}\n\n\tleftPanelViewPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetAttrValue\u0027, system.kanoa.asset.getAssetAttributes({\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027assetAttrName\u0027: vals[\u0027left\u0027][\u0027assetAttrName\u0027]}))\n\tif leftPanelViewPath is None:\n\t\tleftPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], vals[\u0027left\u0027][\u0027assetAttrName\u0027])\n\t\tif leftPanelViewPath: \n\t\t\tvals[\u0027left\u0027][\u0027inherited\u0027] \u003d True\n\n\tif leftPanelViewPath: \n\t\tvals[\u0027left\u0027][\u0027viewPath\u0027] \u003d leftPanelViewPath\n\t\tvals[\u0027left\u0027][\u0027default\u0027] \u003d False\n\t\t\n\trightPanelViewPath \u003d system.kanoa.utilities.getFieldValue(\u0027assetAttrValue\u0027, system.kanoa.asset.getAssetAttributes({\u0027assetPath\u0027: value[\u0027assetPath\u0027], \u0027assetAttrName\u0027: vals[\u0027right\u0027][\u0027assetAttrName\u0027]}))\n\tif rightPanelViewPath is None:\n\t\trightPanelViewPath \u003d system.kanoa.asset.getClosestAncestorAttribute(value[\u0027assetPath\u0027], vals[\u0027right\u0027][\u0027assetAttrName\u0027])\n\t\tif rightPanelViewPath: \n\t\t\tvals[\u0027right\u0027][\u0027inherited\u0027] \u003d True\n\n\tif rightPanelViewPath: \n\t\tvals[\u0027right\u0027][\u0027viewPath\u0027] \u003d rightPanelViewPath\n\t\tvals[\u0027right\u0027][\u0027default\u0027] \u003d False\n\t\t\n\treturn vals",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "asset": "{view.custom.assetInfo}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value[\u0027asset\u0027][\u0027assetPath\u0027] or \u0027\u0027\n\n\tsecurity \u003d value[\u0027security\u0027]\n\tconfigureAssets \u003d security[\u0027userCRUD\u0027][\u0027configureAssets\u0027]\n\t\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]: canCreate \u003d True\n\telif configureAssets:\n\t\tfor asset in configureAssets[\u0027assets\u0027]:\n\t\t\tif asset in (value[\u0027asset\u0027][\u0027path\u0027] or \u0027\u0027):\n\t\t\t\tcanCreate \u003d True\n\t\t\t\tbreak\n\t\t\t\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None and assetPath !\u003d \u0027\u0027:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]:\n\t\t\tcanEdit \u003d True if assetPath else False\n\t\telif security[\u0027userCRUD\u0027][\u0027configureAssets\u0027][\u0027enabled\u0027]:\n\t\t\tfor path in security[\u0027userCRUD\u0027][\u0027configureAssets\u0027][\u0027assets\u0027]:\n\t\t\t\tif path in assetPath:\n\t\t\t\t\tcanEdit \u003d True\n\t\t\t\t\tbreak\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userFunctions": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfunctionData \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.security.getUserFunctions({\u0027enabled\u0027: True}))\n\treturn [{\u0027label\u0027: item[\u0027label\u0027], \u0027value\u0027: item[\u0027functionName\u0027]} for item in functionData]",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
