        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\torderStateInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.order.getProductionOrderStates({\u0027workOrderStatusId\u0027: value[\u0027workOrderStatusId\u0027] or -1}), 0)\n\torderStateInfo[\u0027workOrderStatusName\u0027] \u003d orderStateInfo[\u0027workOrderStatusName\u0027] or \u0027\u0027\n\tif orderStateInfo[\u0027reservedBySystem\u0027] is None: orderStateInfo[\u0027reservedBySystem\u0027] \u003d False\n\tif orderStateInfo[\u0027enabled\u0027] is None: orderStateInfo[\u0027enabled\u0027] \u003d True\n\tif orderStateInfo[\u0027isActive\u0027] is None: orderStateInfo[\u0027isActive\u0027] \u003d False\n\tif orderStateInfo[\u0027canSchedule\u0027] is None: orderStateInfo[\u0027canSchedule\u0027] \u003d False\n\tif orderStateInfo[\u0027canExecute\u0027] is None: orderStateInfo[\u0027canExecute\u0027] \u003d False\n\t\n\treturn orderStateInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
