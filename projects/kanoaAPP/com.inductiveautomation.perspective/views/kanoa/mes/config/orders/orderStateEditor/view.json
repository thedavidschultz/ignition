      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tstateInfo \u003d dict(self.view.custom.stateInfo)\n\tuserId \u003d self.session.custom.kanoa.security.userId\n\t\n\tif stateInfo[\u0027workOrderStatusId\u0027] is not None: \t#If state name has changed, we need to check that it doesn\u0027t already exist\n\t\tcurrentStateId \u003d system.kanoa.utilities.getFieldValue(\u0027workOrderStatusId\u0027, system.kanoa.order.getProductionOrderStates({\u0027workOrderStatusName\u0027: stateInfo[\u0027workOrderStatusName\u0027]}))\n\t\tif currentStateId is not None and currentStateId !\u003d stateInfo[\u0027workOrderStatusId\u0027]:\n\t\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027This state already exists\u0027})\n\t\t\treturn\n\t\t\n\t\tretVal, msg \u003d system.kanoa.order.updateProductionOrderState(stateInfo, userId)\n\t\tsystem.perspective.print(\"updateProductionOrderState() returned %s %s\"%(retVal, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t update order state. %s\"%msg})\n\t\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Order State updated\u0027})\t\t\t\t\n\telse:\n\t\tworkOrderStatusId, msg \u003d system.kanoa.order.addProductionOrderState(stateInfo, userId)\n\t\tsystem.perspective.print(\"addProductionOrderState() returned %s %s\"%(workOrderStatusId, msg)) \n\t\tif msg: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \"Couldn\u0027t add order state. %s\"%msg})\n\t\telse: \n\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Order State added\u0027})\n\t\t\tself.view.params.value.workOrderStatusId \u003d workOrderStatusId\n\n\tsystem.perspective.sendMessage(\"refreshOrderStates\", {})\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
