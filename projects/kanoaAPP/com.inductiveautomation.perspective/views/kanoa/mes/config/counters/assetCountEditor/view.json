          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tcounterInfo \u003d dict(self.view.custom.counterInfo)\n\torigCounterInfo \u003d self.view.custom.origCounterInfo\n\tuserId \u003d self.view.custom.security.userId\n\tmsg \u003d None\n\t\n\tlog \u003d system.util.getLogger(\u0027kanoa_counter\u0027)\n\t\n\timport re\n\tpattern \u003d re.compile(r\u0027^[A-Za-z_][A-Za-z0-9_\\-\\. ]*$\u0027)\n\tif not bool(pattern.match(counterInfo[\u0027counterName\u0027])):\n\t\tmsg \u003d \"Invalid counterName. Ignition tags requires that names start with a letter or _ and then letters, numbers, _, -, .\"\n\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: msg})\t\t\n\t\treturn\t\n\t\n\tcounterId \u003d counterInfo[\u0027counterId\u0027]\n\tcounterInfo[\u0027counterTypeName\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027counterTypeName\u0027, system.kanoa.asset.getCounterType({\u0027counterTypeId\u0027: counterInfo[\u0027counterTypeId\u0027]}))\n\t\n\tif counterId is not None:\n\t\tlog.trace(\"updateCounter() called with %s\"%counterInfo)\n\t\tretVal \u003d system.kanoa.asset.updateCounter(counterInfo, userId)\n\t\tif retVal \u003d\u003d 0: msg \u003d \u0027We were unable to update this counter\u0027\n\telse: \n\t\tcounterId \u003d system.kanoa.utilities.getFieldValue(\u0027counterId\u0027, system.kanoa.asset.getCounter(counterInfo))\n\t\tlog.trace(\"getCounter() called with %s returned %s\"%(counterInfo, counterId))\n\t\tif counterId: msg \u003d \u0027This counter already exists for this asset\u0027\n\t\telse:\n\t\t\tlog.trace(\"addCounter() called with %s %s %s\"%(counterInfo[\u0027assetId\u0027], counterInfo[\u0027counterName\u0027], counterInfo[\u0027counterTypeName\u0027]))\n\t\t\tcounterId \u003d system.kanoa.asset.addCounter(counterInfo[\u0027assetId\u0027], counterInfo[\u0027counterName\u0027], counterInfo[\u0027counterTypeName\u0027], userId)\n\t\t\tif counterId is None: msg \u003d \u0027We were unable to add this counter\u0027\n\t\t\tcounterInfo[\u0027counterId\u0027] \u003d counterId\n\t\t\t\n\tif msg:\t\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\tlog.error(msg)\n\t\treturn\n\t\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Counter saved\u0027})\n\n\tlog.warn(\"CounterInfo is set to %s\"%counterInfo)\n\tif counterInfo[\u0027tag\u0027]:\n\t\tif counterInfo[\u0027tagPath\u0027] is None:\n\t\t\ttagPath, msg \u003d system.kanoa.asset.addCounterTag(counterId, userId)\n\t\t\tlog.trace(\"addCounterTag() called with %s %s returned %s %s\"%(counterId, userId, tagPath, msg ))\n\t\t\tcounterInfo[\u0027tagPath\u0027] \u003d tagPath\n\t\telif counterInfo[\u0027counterName\u0027] !\u003d origCounterInfo[\u0027counterName\u0027]:\t#rename this tag\n\t\t\tparent \u003d counterInfo[\u0027tagPath\u0027].rsplit(\"/\", 1)[0]\n\t\t\tretVal \u003d system.tag.rename(counterInfo[\u0027tagPath\u0027], counterInfo[\u0027counterName\u0027], \"o\")\n\t\t\tlog.trace(\"rename() returned %s\"%retVal)\n\t\t\tcounterInfo[\u0027tagPath\u0027] \u003d parent + \u0027/\u0027 + counterInfo[\u0027counterName\u0027]\n\t\telse:\n\t\t\tlog.trace(\"Nothing to do for adding tags\")\n\t\t\tpass\t#nothing to do, tag already exists\n\telif counterInfo[\u0027tagPath\u0027]: \n\t\tretVal \u003d system.tag.deleteTags([counterInfo[\u0027tagPath\u0027]])\n\t\tlog.trace(\"deleteTags() called for counterInfo[\u0027tagPath\u0027] returned %s\"%retVal)\n\t\tcounterInfo[\u0027tagPath\u0027] \u003d None\n\t\t\t\t\n\timport time\n\ttime.sleep(0.1)\t#think the tags need some time to update\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Counter tag saved\u0027})\n\t\n\tself.view.custom.counterInfo \u003d counterInfo\n\tself.view.custom.origCounterInfo \u003d counterInfo\n\tsystem.perspective.sendMessage(\u0027countersUpdated\u0027, {})\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
