  "propConfig": {
    "custom.changesMade": {
      "binding": {
        "config": {
          "struct": {
            "counterInfo": "{view.custom.counterInfo}",
            "origCounterInfo": "{view.custom.origCounterInfo}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027counterInfo\u0027][\u0027counterName\u0027] \u003d\u003d \u0027\u0027: return False\n\tif value[\u0027counterInfo\u0027][\u0027counterTypeName\u0027] \u003d\u003d \u0027\u0027: return False\n\tif value[\u0027counterInfo\u0027][\u0027assetId\u0027] is None: return False\n\t\n\treturn dict(value[\u0027counterInfo\u0027]) !\u003d dict(value[\u0027origCounterInfo\u0027])",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.counterInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tcounterInfo \u003d dict(value[\u0027counterInfo\u0027])\n\tif counterInfo[\u0027counterName\u0027] is None: counterInfo[\u0027counterName\u0027] \u003d \u0027\u0027\n\tcounterInfo[\u0027tag\u0027] \u003d True if counterInfo[\u0027tagPath\u0027] else False\n\t\n\treturn counterInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tif origin \u003d\u003d \u0027Binding\u0027: \n\t\tif self.custom.counterInfo: self.custom.origCounterInfo \u003d dict(self.custom.counterInfo)\n\t\n\treturn"
      },
      "persistent": true
    },
