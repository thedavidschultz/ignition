    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo \u003d dict(self.view.custom.values)\n\tattributeId \u003d info[\u0027attributeId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif attributeId is None:\n\t\tif system.kanoa.utilities.getFieldValue(\u0027attributeId\u0027, system.kanoa.attribute.getAttributes({\u0027attributeName\u0027: info[\u0027attributeName\u0027], \u0027parentId\u0027: info[\u0027parentId\u0027]})):\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This attribute already exists\u0027})\n\t\t\treturn\n\t\n\t\tattributeId \u003d system.kanoa.attribute.addAttribute(info, userId)\n\telse: system.kanoa.attribute.updateAttribute(info, userId)\n\t\t\n\tself.view.params.value.attributeId \u003d attributeId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshAttributes\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Attribute saved\u0027})\n\t\n\treturn"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo \u003d self.view.custom.values\n\tattributeId \u003d info[\u0027attributeId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif attributeId is None:\n\t\tif system.kanoa.utilities.getFieldValue(\u0027attributeId\u0027, system.kanoa.attribute.getAttributes({\u0027attributeName\u0027: info[\u0027attributeName\u0027], \u0027parentId\u0027: info[\u0027parentId\u0027]})):\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This attribute already exists\u0027})\n\t\t\treturn\n\n\tretVal, msg \u003d system.kanoa.attribute.deleteAttribute(attributeId, userId)\n\tif retVal: system.perspective.sendMessage(\u0027showInfoToast\u0027, {\u0027message\u0027: \u0027Attribute deleted\u0027})\n\telse: system.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: msg})\n\t\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshAttributes\", {})\t"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\n\tself.view.custom.values.itemClassColor \u003d payload[\u0027color\u0027]\n\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: return\n\t\n\tself.view.params.value.attributeId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027attributeId\u0027]\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
