    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"save() called\")\n\tinfo \u003d self.view.custom.values\n\titemIds \u003d self.view.params.value.itemIds\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tfor itemId in itemIds:\n\t\tif info[\u0027itemClassId\u0027]: system.kanoa.item.updateItemField(itemId, \u0027itemClassId\u0027, info[\u0027itemClassId\u0027], userId)\n\t\tsystem.kanoa.item.updateItemField(itemId, \u0027enabled\u0027, info[\u0027enabled\u0027], userId)\n\t\tsystem.kanoa.item.updateItemField(itemId, \u0027itemColor\u0027, info[\u0027itemColor\u0027], userId)\n\t\t\n\tsystem.perspective.sendMessage(\"refreshItems\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Items updated\u0027})\t\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\t\n\tself.view.custom.values.itemColor \u003d payload[\u0027color\u0027]\n\t\n\treturn",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "itemClassSelectedForItemEditor",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"itemClassSelectedForItemEditor msg received with %s\"%payload)\n\n\tif len(payload[\u0027selection\u0027]) \u003e 0: \n\t\tself.view.custom.values.itemClassId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemClassId\u0027]\n\t\tself.view.custom.values.itemClassPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027]\n\t\tself.view.custom.values.itemClassName \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemClassName\u0027]\n\t\tself.view.custom.values.itemClassColor \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemClassColor\u0027]\n\telse:\n\t\tself.view.custom.values.itemClassId \u003d None\n\t\tself.view.custom.values.itemClassPath \u003d None\n\t\tself.view.custom.values.itemClassName \u003d None\n\t\tself.view.custom.values.itemClassColor \u003d None\n\t\n\treturn\n\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
