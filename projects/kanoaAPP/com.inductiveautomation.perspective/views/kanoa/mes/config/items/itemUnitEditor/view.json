{
  "custom": {
    "itemUnitInfo": {
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": true,
      "itemUnitId": null,
      "itemUnitName": "",
      "lastUpdated": null
    }
  },
  "params": {
    "value": {
      "itemUnitId": null
    }
  },
  "propConfig": {
    "custom.itemUnitInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\titemUnitInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.item.getItemUnits({\u0027itemUnitId\u0027: value[\u0027itemUnitId\u0027] or -1}), 0)\n\tif itemUnitInfo[\u0027itemUnitName\u0027] is None: itemUnitInfo[\u0027itemUnitName\u0027] \u003d \u0027\u0027\n\tif itemUnitInfo[\u0027enabled\u0027] is None: itemUnitInfo[\u0027enabled\u0027] \u003d True\n\t\n\treturn itemUnitInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 118,
      "width": 361
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "label",
              "name": "label",
              "tooltip": {
                "enabled": true
              }
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Unit Name"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "text",
              "name": "text"
            },
            "position": {
              "basis": "180px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.itemUnitInfo.itemUnitName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "type": "ia.input.text-field"
          }
        ],
        "meta": {
          "domId": "flxItemName",
          "name": "flxItemName"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblEnabled",
              "name": "lblEnabled"
            },
            "position": {
              "basis": "80px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Enabled"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "chkEnabled",
              "name": "chkEnabled"
            },
            "position": {
              "basis": "25px",
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.itemUnitInfo.enabled"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "text": ""
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "domId": "flxEnabled",
          "name": "flxEnabled"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\titemUnitInfo \u003d self.view.custom.itemUnitInfo\n\tif itemUnitInfo[\u0027itemUnitId\u0027]: retVal, msg \u003d system.kanoa.item.updateItemUnit(itemUnitInfo, userId)\n\telse: itemUnitId, msg \u003d system.kanoa.item.addItemUnit(itemUnitInfo, userId)\n\t\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Item unit could not be saved. %s\u0027%msg})\n\telse: \n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item unit saved\u0027})\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027refreshItemUnits\u0027, {})\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "top",
                "text": "Save"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.values"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\treturn value[\u0027itemUnitName\u0027] !\u003d \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled",
                "height": "30px"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "enabled": true,
                "location": "top",
                "text": "Close"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined",
                "height": "30px"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxActions",
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcGray-0",
        "classes": "kanoa/font/default kanoa/popup",
        "gap": 5,
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}