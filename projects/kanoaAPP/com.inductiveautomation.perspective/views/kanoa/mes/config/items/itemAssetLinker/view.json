    "scripts": {
      "customMethods": [
        {
          "name": "linkItems",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"Link Items\")\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tfor asset in self.view.custom.assets.selected:\n\t\tfor itemId in self.view.custom.items.selected:\n\t\t\trateInfo \u003d {\n\t\t\t\t\t\t\t\u0027itemAssetRateId\u0027: None,\n\t\t\t\t\t\t\t\u0027itemId\u0027: itemId,\n\t\t\t\t\t\t\t\u0027assetId\u0027: asset[\u0027assetId\u0027],\n\t\t\t\t\t\t\t\u0027standardRate\u0027: None,\n\t\t\t\t\t\t\t\u0027scheduleRate\u0027: None,\n\t\t\t\t\t\t\t\u0027itemPeriodId\u0027: None,\n\t\t\t\t\t\t\t\u0027infeedUnitId\u0027: None,\n\t\t\t\t\t\t\t\u0027outfeedUnitId\u0027: None,\n\t\t\t\t\t\t\t\u0027wasteUnitId\u0027: None,\n\t\t\t\t\t\t\t\u0027packageCount\u0027: None,\n\t\t\t\t\t\t\t\u0027itemSourceId\u0027: self.view.custom.itemSourceId,\n\t\t\t\t\t\t\t\u0027enabled\u0027: True\n\t\t\t\t\t\t}\n\t\t\tsystem.kanoa.item.addItemAssetRate(rateInfo, userId)\n\t\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Adding link\u0027})\n\n\tsystem.perspective.sendMessage(\"refreshItems\", payload\u003d{})\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\u0027updatePopupSelection msg rcvd with %s\u0027%payload)\n\tif payload[\u0027msgHandler\u0027] \u003d\u003d \u0027assetItemSelected\u0027:\n\t\titems \u003d list(payload[\u0027selection\u0027])\n\t\tself.view.custom.items.selected \u003d [] if len(items) \u003d\u003d 0 else [item[\u0027value\u0027][\u0027itemId\u0027] for item in items if item.value.has_key(\u0027itemId\u0027)]\n\telif payload[\u0027msgHandler\u0027] \u003d\u003d \u0027assetSelected\u0027:\n\t\tassetsSelected \u003d []\t\t\n\t\tfor item in payload[\u0027selection\u0027]:\n\t\t\tassetsSelected.append({\u0027path\u0027: item[\u0027value\u0027][\u0027assetPath\u0027], \u0027assetId\u0027: item[\u0027value\u0027][\u0027assetId\u0027], \u0027name\u0027: item[\u0027value\u0027][\u0027assetName\u0027], \u0027assetType\u0027: item[\u0027value\u0027][\u0027assetTypeName\u0027]})\n\n\t\tself.view.custom.assets.selected \u003d assetsSelected\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
