    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\"save() called\")\n\tinfo \u003d self.view.custom.values\n\titemId \u003d info[\u0027itemId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif itemId is None:\n\t\tif system.kanoa.utilities.getFieldValue(\u0027itemId\u0027, system.kanoa.item.getItems({\u0027itemName\u0027: info[\u0027itemName\u0027], \u0027itemClassId\u0027: info[\u0027itemClassId\u0027]})) is not None:\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This item already exists\u0027})\n\t\t\treturn\n\t\n\t\titemId \u003d system.kanoa.item.addItem(info, userId)\n\telse: system.kanoa.item.updateItem(info, userId)\n\t\n\tattributes \u003d self.view.custom.attributes\n\tattrList \u003d [x.label or None for x in attributes.custom]\n\tif None in attrList:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027One of the custom attributes is missing a label.\u0027})\n\t\treturn\n\tif len(attrList) !\u003d len(set(attrList)):\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027You have more than one attribute with the same name.\u0027})\n\t\treturn\t\n\t\n\tfor itemAttr in attributes.custom:\n\t\tsystem.kanoa.item.addItemAttribute({\u0027itemId\u0027:itemId, \u0027itemAttrName\u0027: itemAttr.label, \u0027itemAttrValue\u0027: itemAttr.text}, userId)\n\t\t\n\tfor attrId in attributes.delete: \n\t\tsystem.kanoa.item.deleteItemAttribute(attrId, userId)\n\t\n\tattributes.delete \u003d []\n\tself.view.params.value.itemId \u003d None\n\tself.view.params.value.itemId \u003d itemId\n\tsystem.perspective.sendMessage(\"refreshItems\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item saved\u0027})\n\t\n\treturn"
        },
        {
          "name": "clearData",
          "params": [],
