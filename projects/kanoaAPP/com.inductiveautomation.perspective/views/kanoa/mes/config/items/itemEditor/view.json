    "custom.attributes.custom": {
      "binding": {
        "config": {
          "path": "view.params.value.itemId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn [{\u0027attrId\u0027: row[\u0027itemAttrId\u0027],\t\u0027label\u0027: row[\u0027itemAttrName\u0027], \u0027text\u0027: row[\u0027itemAttrValue\u0027]} for row in system.kanoa.item.getItemAttributes({\u0027itemId\u0027:value})] if value is not None else []\n",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.attributes.delete": {
      "binding": {
        "config": {
          "path": "view.params.value.itemId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn []\n",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.state": {
      "persistent": true
    },
    "custom.values": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tdata \u003d system.kanoa.item.getItems({\u0027itemId\u0027:value[\u0027itemId\u0027] or -1})\n\tif data.rowCount \u003e 0: info \u003d system.kanoa.utilities.convertDatasetRowToJSON(data, 0)\n\telse:\t\n\t\tpath, itemClassColor, itemClassName, itemClassPath \u003d [None] * 4\n\t\tif value[\u0027itemClassId\u0027] is not None:\n\t\t\titemClassInfo \u003d system.kanoa.item.getItemClasses({\u0027itemClassId\u0027: value[\u0027itemClassId\u0027]})\n\t\t\tif itemClassInfo.rowCount \u003e 0:\n\t\t\t\titemClassColor \u003d itemClassInfo.getValueAt(0, \u0027itemClassColor\u0027)\n\t\t\t\titemClassName \u003d itemClassInfo.getValueAt(0, \u0027itemClassName\u0027)\n\t\t\t\titemClassPath \u003d itemClassInfo.getValueAt(0, \u0027path\u0027)\n\t\n\t\tinfo \u003d {\n\t\t\t\t  \"changedBy\": None,\n\t\t\t\t  \"changedDate\": None,\n\t\t\t\t  \"createdBy\": None,\n\t\t\t\t  \"createdDate\": None,\n\t\t\t\t  \"enabled\": True,\n\t\t\t\t  \"itemClassColor\": itemClassColor,\n\t\t\t\t  \"itemClassId\": value[\u0027itemClassId\u0027],\n\t\t\t\t  \"itemClassName\": itemClassName,\n\t\t\t\t  \"parentId\": None,\n\t\t\t\t  \"path\": path,\n\t\t\t\t  \"itemColor\": None,\n\t\t\t\t  \"itemId\": None,\n\t\t\t\t  \"itemName\": \u0027\u0027,\n\t\t\t\t  \"groupName\": None,\n\t\t\t\t  \"itemDescription\": \u0027\u0027,\n\t\t\t\t  \"groupCode\": None,\n\t\t\t\t  \"itemClassPath\": itemClassPath\n\t\t\t\t}\t\t\t\t\n\n\treturn info",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.height": {
      "binding": {
