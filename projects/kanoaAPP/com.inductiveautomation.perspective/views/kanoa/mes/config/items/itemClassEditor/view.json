    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tinfo \u003d dict(self.view.custom.values)\n\titemClassId \u003d info[\u0027itemClassId\u0027]\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tif info[\u0027itemClassId\u0027] is None:\n\t\tif system.kanoa.utilities.getFieldValue(\u0027itemClassId\u0027, system.kanoa.item.getItemClasses({\u0027itemClassName\u0027: info[\u0027itemClassName\u0027], \u0027parentId\u0027: info[\u0027parentId\u0027]})) is not None:\n\t\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, {\u0027message\u0027: \u0027This item class already exists\u0027})\n\t\t\treturn\n\t\n\t\titemClassId \u003d system.kanoa.item.addItemClass(info, userId)\n\telse: system.kanoa.item.updateItemClass(info, userId)\n\t\t\n\tself.view.params.value.itemClassId \u003d itemClassId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshItemClasses\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Item Class saved\u0027})\n\t\n\treturn"
        },
        {
          "name": "delete",
          "params": [],
          "script": "\n\tsystem.perspective.print(\"delete() called\")\n\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tretVal, msg \u003d system.kanoa.item.deleteItemClass(self.view.params.value.itemClassId, userId)\n\tif retVal \u003d\u003d False:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\telse:\n\t\tself.view.params.value.itemClassId \u003d None\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: msg})\t\t\n\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshItemClasses\", {})\t\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "colorPicked",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\n\tself.view.custom.values.itemClassColor \u003d payload[\u0027color\u0027]\n\n\treturn\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\n\tif len(payload[\u0027selection\u0027]) \u003d\u003d 0: return\n\t\n\tself.view.params.value.itemClassId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemClassId\u0027]\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
