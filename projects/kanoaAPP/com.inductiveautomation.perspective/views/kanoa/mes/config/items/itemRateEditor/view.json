  "propConfig": {
    "custom.info": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\titemAssetRateIds \u003d self.view.params.values.itemAssetRateIds\n\tif len(itemAssetRateIds) \u003e 0:\n\t\tdata \u003d system.kanoa.item.getAssetItems({\u0027itemAssetRateIdList\u0027:itemAssetRateIds})\n\t\t\n\t\t#The selected rates may be all the same or different. We\u0027ll check. If they are the same we will populate the fields.\n\t\t#If they are different we will indicate they are mixed.\n\n\t\tstdRates \u003d [row[\u0027standardRate\u0027] for row in data]\n\t\tschRates \u003d [row[\u0027scheduleRate\u0027] for row in data]\n\t\tperiods \u003d [row[\u0027itemPeriodId\u0027] for row in data]\n\t\tinfeedUnits \u003d [row[\u0027infeedUnitId\u0027] for row in data]\t\t\n\t\toutfeedUnits \u003d [row[\u0027outfeedUnitId\u0027] for row in data]\t\t\n\t\twasteUnits \u003d [row[\u0027wasteUnitId\u0027] for row in data]\t\t\n\t\tpackageCounts \u003d [row[\u0027packageCount\u0027] for row in data]\t\t\n\t\tenablers \u003d [row[\u0027assetRateEnabled\u0027] for row in data]\n\t\tsources \u003d [row[\u0027itemSourceId\u0027] for row in data]\t\n\n\t\treturn {\n\t\t\t\t\t\u0027standardRate\u0027: stdRates[0] if len(set(stdRates)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027scheduleRate\u0027: schRates[0] if len(set(schRates)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027itemPeriodId\u0027: periods[0] if len(set(periods)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027packageCount\u0027: packageCounts[0] if len(set(packageCounts)) \u003d\u003d 1 else 1.0,\n\t\t\t\t\t\u0027infeedUnitId\u0027: infeedUnits[0] if len(set(infeedUnits)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027outfeedUnitId\u0027: outfeedUnits[0] if len(set(outfeedUnits)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027wasteUnitId\u0027: wasteUnits[0] if len(set(wasteUnits)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027enabled\u0027: enablers[0] if len(set(enablers)) \u003d\u003d 1 else None,\n\t\t\t\t\t\u0027itemSourceId\u0027: sources[0] if len(set(sources)) \u003d\u003d 1 else None\n\t\t\t\t}\n\telse:\n\t\treturn {\n\t\t\t\t\t\u0027standardRate\u0027: None,\n\t\t\t\t\t\u0027scheduleRate\u0027: None,\n\t\t\t\t\t\u0027wasteUnitId\u0027: None,\n\t\t\t\t\t\u0027infeedUnitId\u0027: None,\n\t\t\t\t\t\u0027packageCount\u0027: 1.0,\n\t\t\t\t\t\u0027itemPeriodId\u0027: None,\n\t\t\t\t\t\u0027outfeedUnitId\u0027: None,\n\t\t\t\t\t\u0027enabled\u0027:False,\n\t\t\t\t\t\u0027sources\u0027:None\n\t\t\t\t}\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "expression": "1"
        },
        "transforms": [
          {
            "code": "\n\treturn [{\u0027value\u0027: row[\u0027itemUnitId\u0027], \u0027label\u0027:row[\u0027itemUnitName\u0027]} for row in system.kanoa.item.getItemUnits({\u0027enabled\u0027: True})]",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
