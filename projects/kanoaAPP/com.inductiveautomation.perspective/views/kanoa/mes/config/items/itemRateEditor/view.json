    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\t\n\tsystem.perspective.print(\u0027save() called\u0027)\n\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tdata \u003d system.kanoa.item.getAssetItems({\u0027itemAssetRateIdList\u0027:self.view.params.values.itemAssetRateIds})\n\tinfo \u003d self.view.custom.info\n\t\n\t#We have turned on the ability for the user to create a new unit, if they do this, the value in the value.infeedUnitId will likely be a string\n\t#If we detect a string, then we will add this to the units table\n\tinfeedUnitId \u003d info.infeedUnitId\n\toutfeedUnitId \u003d info.outfeedUnitId\n\twasteUnitId \u003d info.wasteUnitId\n\t\n\tif type(infeedUnitId) in (type(\u0027\u0027), type(u\u0027\u0027)): infeedUnitId \u003d system.kanoa.item.addItemUnit(infeedUnitId)\n\tif type(outfeedUnitId) in (type(\u0027\u0027), type(u\u0027\u0027)): outfeedUnitId \u003d system.kanoa.item.addItemUnit(outfeedUnitId)\n\tif type(wasteUnitId) in (type(\u0027\u0027), type(u\u0027\u0027)): wasteUnitId \u003d system.kanoa.item.addItemUnit(wasteUnitId)\n\n\tself.view.refreshBinding(\"custom.units\")\t#If we added any units, we\u0027ll refresh the dropdown options\n\t\n\t#If the user has not selected a value for a field, we will use the value that was previously stored for this item\n\tfor row in data:\n\t\titemAssetRateId \u003d row[\u0027itemAssetRateId\u0027]\n\t\titemId \u003d row[\u0027itemId\u0027]\n\t\tassetId \u003d row[\u0027assetId\u0027]\n\t\trateInfo \u003d {\n\t\t\t\t\t\t\u0027itemAssetRateId\u0027: row[\u0027itemAssetRateId\u0027],\n\t\t\t\t\t\t\u0027itemId\u0027: row[\u0027itemId\u0027],\n\t\t\t\t\t\t\u0027assetId\u0027: row[\u0027assetId\u0027],\n\t\t\t\t\t\t\u0027standardRate\u0027: info.standardRate or row[\u0027standardRate\u0027],\n\t\t\t\t\t\t\u0027scheduleRate\u0027: info.scheduleRate or row[\u0027scheduleRate\u0027],\n\t\t\t\t\t\t\u0027itemPeriodId\u0027: info.itemPeriodId or row[\u0027itemPeriodId\u0027],\n\t\t\t\t\t\t\u0027infeedUnitId\u0027: infeedUnitId or row[\u0027infeedUnitId\u0027],\n\t\t\t\t\t\t\u0027outfeedUnitId\u0027: outfeedUnitId or row[\u0027outfeedUnitId\u0027],\n\t\t\t\t\t\t\u0027wasteUnitId\u0027: wasteUnitId or row[\u0027wasteUnitId\u0027],\n\t\t\t\t\t\t\u0027packageCount\u0027: info.packageCount or row[\u0027packageCount\u0027],\n\t\t\t\t\t\t\u0027enabled\u0027: info.enabled,\n\t\t\t\t\t\t\u0027itemSourceId\u0027: info.itemSourceId or row[\u0027itemSourceId\u0027]\n\t\t\t\t\t}\n\n\t\tsystem.kanoa.item.updateItemAssetRate(rateInfo, userId)\n\t\t\n\tsystem.perspective.sendMessage(\"refreshItems\", {})\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Rates saved\u0027})\n\tself.view.refreshBinding(\"custom.info\")\t#update the info values with any changes to the units\n\n\treturn\t"
        },
        {
          "name": "checkUnit",
          "params": [
            "unitName"
          ],
          "script": "\t\n\titemUnitId \u003d None\n\tif unitName and unitName not in [unit[\u0027label\u0027] for unit in self.view.custom.units]:\n\t\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\titemUnitId, msg \u003d system.kanoa.item.addItemUnit(unitName, userId)\n\n\tself.view.refreshBinding(\"custom.units\")\n\t\n\treturn itemUnitId"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetItemRatesSelected",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\"assetItemRatesSelected() msg rcvd with %s\"%payload)\n\t\n\tself.view.params.values.itemAssetRateIds \u003d payload[\u0027itemAssetRateIds\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
