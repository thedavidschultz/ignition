{
  "custom": {},
  "params": {
    "barColor": "value",
    "direction": "value",
    "specName": "value",
    "specValue": "value"
  },
  "propConfig": {
    "params.barColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.direction": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.specName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.specValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 57,
      "width": 391
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "lblSpecName",
          "name": "lblSpecName"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.specName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/labelSmall"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "lblBar",
          "name": "lblBar"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.barColor"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "lblValue",
          "name": "lblValue"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.params.direction"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.specValue"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/labelSmall"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}