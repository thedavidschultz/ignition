{
  "custom": {}, 
  "params": {
    "text_style": {}, 
    "button_text": 0
  }, 
  "props": {
    "defaultSize": {
      "width": 50, 
      "height": 50
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.button", 
        "props": {
          "style": {
            "backgroundColor": "--kcBlue-10", 
            "classes": "kanoa/button/flat"
          }
        }, 
        "meta": {
          "domId": "btnNumber", 
          "name": "btnNumber"
        }, 
        "position": {
          "grow": 1, 
          "basis": "50px"
        }, 
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\tsystem.perspective.sendMessage('keypad', payload={'value':self.props.text}, scope='session')"
              }
            }
          }
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.button_text"
              }
            }
          }, 
          "props.textStyle": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.text_style"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.style.button_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.button_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.button_text": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.text_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.style.text_style": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}