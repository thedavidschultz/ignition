{
  "custom": {}, 
  "params": {
    "value": {
      "chkShtStateId": 4, 
      "color": "--kcOrange-50", 
      "label": "Approved"
    }, 
    "selected": true
  }, 
  "props": {
    "defaultSize": {
      "width": 185, 
      "height": 35
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.toggle-switch", 
        "props": {
          "color": {
            "unselected": "#D5D5D5"
          }, 
          "label": {}, 
          "style": {
            "classes": "kanoa/font/default"
          }
        }, 
        "meta": {
          "domId": "tglApproved", 
          "name": "tglApproved"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.label.text": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.label"
              }
            }
          }, 
          "props.color.selected": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value.color if value else 'kcGray-10' ", 
                  "type": "script"
                }
              ], 
              "type": "expr-struct", 
              "overlayOptOut": true, 
              "config": {
                "struct": {
                  "color": "{view.params.value.color}", 
                  "selected": "{view.params.selected}"
                }, 
                "waitOnAll": true
              }
            }
          }, 
          "props.selected": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.selected"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.selected": {
      "paramDirection": "inout", 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}