{
  "custom": {}, 
  "params": {
    "value": {
      "measNum": 1, 
      "selectedDatetime": {
        "$ts": 1673521200000, 
        "$": [
          "ts", 
          0, 
          1675124078251
        ]
      }, 
      "chkShtDetailId": 250
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 307, 
      "height": 399
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": "--kcSurface", 
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.date-time-picker", 
        "props": {
          "format": "YYYY-MM-DD HH:mm", 
          "formattedValue": "2023-01-12 03:00", 
          "style": {
            "backgroundColor": "--kcSurface", 
            "borderStyle": "none"
          }
        }, 
        "meta": {
          "domId": "DateTimePicker", 
          "name": "DateTimePicker"
        }, 
        "position": {
          "basis": "351px"
        }, 
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.value.selectedDatetime"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center"
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "classes": "kanoa/button/filled"
              }, 
              "text": "OK"
            }, 
            "meta": {
              "domId": "btnOk", 
              "name": "btnOk"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "100px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tpayload = {'value':self.parent.parent.getChild(\"DateTimePicker\").props.formattedValue}\n\tsystem.perspective.print(\"Sending 'ValuePicked' message with \" + str(payload))\n\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\t\n\t\n\treturn"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxActions", 
          "name": "flxActions"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
