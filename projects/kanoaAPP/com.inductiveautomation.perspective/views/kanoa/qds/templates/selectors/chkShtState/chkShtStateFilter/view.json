  "props": {
    "defaultSize": {
      "width": 139, 
      "height": 362
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": "--kcSurface", 
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.flex-repeater", 
        "props": {
          "useDefaultViewWidth": false, 
          "path": "kanoa/qds/templates/selectors/chkShtState/chkState", 
          "style": {
            "overflow": "hidden"
          }, 
          "useDefaultViewHeight": false, 
          "direction": "column"
        }, 
        "meta": {
          "domId": "FlexRepeater", 
          "name": "FlexRepeater"
        }, 
        "position": {
          "basis": "320px"
        }, 
        "propConfig": {
          "props.instances": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.custom.data"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "padding": "5px", 
            "gap": "5px"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "color": "#2B2B2B", 
                  "path": "material/toggle_off"
                }
              }, 
              "style": {
                "backgroundColor": "#FFFFFF", 
                "borderStyle": "solid"
              }, 
              "text": ""
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom", 
                "text": "Clear all"
              }, 
              "domId": "btn_ClearAll", 
              "name": "btn_ClearAll"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "30px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tself.view.getChild(\"root\").setToggleSwitches(False)"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "color": "#2B2B2B", 
                  "path": "material/toggle_on"
                }
              }, 
              "style": {
                "backgroundColor": "#FFFFFF", 
                "marginLeft": "5px", 
                "borderStyle": "solid"
              }, 
              "text": ""
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom", 
                "text": "Set All"
              }, 
              "domId": "btn_SetAll", 
              "name": "btn_SetAll"
            }, 
            "position": {
              "basis": "30px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tself.view.getChild(\"root\").setToggleSwitches(True)"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxAction", 
          "name": "flxAction"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [
            "state"
          ], 
          "script": "\n\tdata = self.view.custom.data\n\tfor row in data:\n\t\trow['selected'] = state\n\t\t\n\treturn", 
          "name": "setToggleSwitches"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.data": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn [{\"selected\": True, \"value\": {\"chkShtStateId\": row['chkShtStateId'], \"color\": row['chkShtStateColor'], \"label\": row['chkShtStateName']}} for row in system.kanoa.quality.sheet.getStates({})]", 
            "type": "script"
          }
        ], 
        "type": "expr", 
        "config": {
          "expression": "1"
        }
      }, 
      "persistent": true
    }, 
    "params.filterStates": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "/root/FlexRepeater.props.instances"
        }
      }, 
      "paramDirection": "output", 
      "persistent": true
    }
  }
}