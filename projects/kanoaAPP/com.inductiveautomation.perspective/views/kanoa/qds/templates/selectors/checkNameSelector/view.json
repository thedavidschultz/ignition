        "propConfig": {
          "props.value": {
            "onChange": {
              "enabled": null, 
              "script": "\t\n\tchkDataType = None\n\tchkName = None\n\t\n\tif currentValue.value is not None:\n\t\tdata = self.props.options\n\t\tfor row in range(data.rowCount):\n\t\t\tif data.getValueAt(row, 'Check_Sheet_Detail_Id') == currentValue.value:\n\t\t\t\tchkDataType = data.getValueAt(row, 'Attribute_Data_Type')\n\t\t\t\tchkName = data.getValueAt(row, 'Check_Name')\n\t\t\t\tbreak\n\t\n\tself.view.params.values = {\n\t\t\t\t\t\t\t  \"chkDetailID\": currentValue.value,\n\t\t\t\t\t\t\t  \"chkName\": chkName,\n\t\t\t\t\t\t\t  \"chkDataType\": chkDataType\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\n\treturn"
            }
          }, 
          "props.enabled": {
