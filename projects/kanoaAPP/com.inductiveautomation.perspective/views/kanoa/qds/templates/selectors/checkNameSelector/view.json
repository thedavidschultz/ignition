      "customMethods": [
        {
          "params": [], 
          "script": "\t\n\tsitePath = self.session.custom.site.path or ''\n\tchkShtID = self.view.params.chkShtID\n\t\n\tif chkShtID is None:\n\t\tdata = system.dataset.clearDataset(self.getChild(\"dropdown\").props.options )\n\t\tself.getChild(\"dropdown\").props.value = None\n\telse:\n\t\n\t\tquery = \"\"\"\n\t\t\t\tSELECT DISTINCT\n\t\t\t\t\tcsd.[Attribute_Data_Type]\n\t\t\t\t\t,csd.[Check_Sheet_Detail_Id]\t      \t\t\n\t\t\t\t\t,csd.[Check_Name]    \t\t\n\t\t\t\tFROM qds.[Check_Sheet_Detail] csd WITH (NOLOCK)\n\t\t\t\tWHERE (csd.[Check_Sheet_Id] = ? OR ISNULL(?,'') = '')\n\t\t\t\tORDER BY csd.[Check_Name]\n\t\t\t\t\"\"\"\n\t\t\t\t\n\t\tdbName = shared.Kanoa.MES.Gateway_Config.getDBName('QDS')\n\t\t\n\t\tdata = system.db.runPrepQuery(query, [chkShtID, chkShtID], dbName)\n\t\tdata = system.dataset.toDataSet(data)\n\n\tself.getChild(\"dropdown\").props.options = data\n\t\n\treturn", 
          "name": "getData"
        }
      ], 
      "extensionFunctions": null
    }
