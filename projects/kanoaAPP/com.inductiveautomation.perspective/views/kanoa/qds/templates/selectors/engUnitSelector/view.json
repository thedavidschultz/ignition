  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\t\n\tself.custom.tagProvider \u003d system.kanoa.config.getTagProvider(\u0027Core\u0027)"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "enabled": true,
    "engUnitId": null
  },
  "propConfig": {
    "custom.options": {
      "binding": {
        "config": {
          "expression": "1"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn [{\u0027value\u0027:row[\u0027engUnitId\u0027], \u0027label\u0027:row[\u0027engUnitName\u0027]} for row in system.kanoa.quality.config.getUnits({\u0027enabled\u0027: True})]",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.security": {
      "binding": {
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecConfig \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), \u0027configName\u0027, \u0027configValue\u0027)\n\tuserId \u003d system.kanoa.security.getIDPUserId(value[\u0027user\u0027])\t\n\tuserCRUD \u003d system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.userAction": {
      "binding": {
        "config": {
          "struct": {
            "enabled": "{view.params.enabled}",
            "engUnitId": "{view.params.engUnitId}",
            "security": "{view.custom.security}"
          },
          "waitOnAll": false
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tsecurity \u003d value[\u0027security\u0027]\n\tcanCreate \u003d False\n\tcanEdit \u003d False\n\tif security[\u0027userCRUD\u0027] is not None and security[\u0027userId\u0027] is not None:\n\t\tif security[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027] or security[\u0027userCRUD\u0027][\u0027configureQuality\u0027][\u0027enabled\u0027]: \n\t\t\tcanCreate \u003d True if value[\u0027enabled\u0027] else False\n\t\t\tcanEdit \u003d True if value[\u0027engUnitId\u0027] else False\n\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.enabled": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.engUnitId": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 31,
      "width": 244
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "ddEngUnits",
          "name": "ddEngUnits"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.allowCustomOptions": {
            "binding": {
              "config": {
                "path": "view.custom.userAction"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value[\u0027canCreate\u0027]",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.enabled"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.options": {
            "binding": {
              "config": {
                "path": "view.custom.options"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.engUnitId"
              },
              "overlayOptOut": true,
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\t\n#\tsystem.perspective.print(\"units changes origin %s value %s\"%(origin, currentValue.value))\n\timport time\n\tvalue \u003d currentValue.value or \u0027\u0027\n\tif origin \u003d\u003d \u0027Browser\u0027:\t\t\n\t\tif value !\u003d \u0027\u0027 and next((d for d in self.props.options if d.get(\u0027value\u0027) \u003d\u003d value), None) is None:\t#Doesn\u0027t exist, we\u0027ll create this entry\n\t\t\tsystem.perspective.print(\"%s\"%value)\n\t\t\tunitId, msg \u003d system.kanoa.quality.config.addUnit({\u0027engUnitName\u0027: value, \u0027enabled\u0027: True}, self.view.custom.security.userId)\n\t\t\tself.view.refreshBinding(\"custom.options\")\n\t\t\ttime.sleep(0.1)\n\t\t\tself.props.value \u003d unitId\n\t\n\treturn\n\n"
            }
          }
        },
        "props": {
          "placeholder": {
            "text": "Select Units..."
          },
          "showClearIcon": true,
          "style": {
            "classes": "kanoa/border kanoa/font/default",
            "minWidth": "120px"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tretVal, msg \u003d system.kanoa.quality.config.deleteUnit(self.view.params.engUnitId, self.view.custom.security.userId)\n\n\tif retVal \u003e 0: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \"Unit deleted\"})\n\telse: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Failed to delete this unit. This is most likely as it is being used by a Check Item\"})\n\n\tself.view.refreshBinding(\"custom.options\")\n\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "btnDelete",
          "name": "btnDelete",
          "tooltip": {
            "enabled": true,
            "location": "bottom",
            "text": "Delete this unit"
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "action": "{view.custom.userAction}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\treturn value[\u0027action\u0027][\u0027canDelete\u0027]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "image": {
            "height": 20,
            "icon": {
              "color": "--kcRed-60",
              "path": "material/delete_forever"
            },
            "width": 20
          },
          "style": {
            "classes": "kanoa/button/flatIcon",
            "height": "24px",
            "marginRight": "3px",
            "width": "24px"
          },
          "text": ""
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignContent": "center",
      "alignItems": "center",
      "style": {
        "backgroundColor": "--kcSurface",
        "gap": "5px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
