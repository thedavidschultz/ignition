{
  "custom": {}, 
  "params": {}, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "margin": "5px"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "text": "Nelson Rules"
            }, 
            "meta": {
              "domId": "btnNelson", 
              "name": "btnNelson"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "200px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tself.parent.parent.getChild(\"IFrame\").props.src = 'https://en.wikipedia.org/wiki/Nelson_rules'"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "marginLeft": "5px"
              }, 
              "text": "Western Electric Rules"
            }, 
            "meta": {
              "domId": "btnWestern", 
              "name": "btnWestern"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "200px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tself.parent.parent.getChild(\"IFrame\").props.src = 'https://en.wikipedia.org/wiki/Western_Electric_rules'"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "FlxCntSelector", 
          "name": "FlxCntSelector"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.display.iframe", 
        "props": {
          "src": "https://en.wikipedia.org/wiki/Nelson_rules"
        }, 
        "meta": {
          "domId": "IFrame", 
          "name": "IFrame"
        }, 
        "position": {
          "grow": 1, 
          "basis": "200px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }
}