{
  "custom": {}, 
  "params": {
    "value": {
      "backgroundColor": "#D97700", 
      "value": "sausages"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 215, 
      "height": 31
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "padding": "2px", 
            "height": "30px"
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "classes": "kanoa/border", 
                "borderTopLeftRadius": "20px", 
                "borderBottomLeftRadius": "20px", 
                "borderBottomRightRadius": "20px", 
                "borderTopRightRadius": "20px"
              }, 
              "textStyle": {
                "textAlign": "center", 
                "fontWeight": "bold"
              }
            }, 
            "meta": {
              "domId": "lblName", 
              "name": "lblName"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.backgroundColor"
                  }
                }
              }, 
              "props.style.color": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn system.kanoa.utilities.getContrastingColor(value) if value else ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "this.props.style.backgroundColor"
                  }
                }
              }, 
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.value"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxCntr", 
          "name": "flxCntr"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}