                      "config": {
                        "struct": {
                          "numCols": "{this.custom.updateColumns.numOfCols}", 
                          "splitPercent": "{view.custom.table.columns.splitPosition}", 
                          "cols": "{this.custom.updateColumns.columns}"
                        }, 
                        "waitOnAll": true
                      }
                    }
                  }, 
                  "props.enableFooterGroups": {
                    "binding": {
                      "transforms": [
                        {
                          "code": "\n\treturn value.displaySettings.showSummary or value.displaySettings.showItemInfo", 
                          "type": "script"
                        }
                      ], 
                      "type": "expr-struct", 
                      "overlayOptOut": true, 
                      "config": {
                        "struct": {
                          "displaySettings": "{view.params.value.displaySettings}"
                        }, 
                        "waitOnAll": true
                      }
                    }
                  }, 
                  "props.columns": {
                    "onChange": {
                      "enabled": null, 
                      "script": "\t\n#\tsystem.perspective.print(\"column change origin %s\"%origin)\n\t#If orgign is browser, believe that the user has moved the columns around. This is essentially the sortOrder\n\t#If the user has edit rights, we will update the matrix items to reflect the new order\n\tif origin == 'Browser':\n\t\tsystem.perspective.print(\"column change origin %s. updating items sortOrder\"%origin)\n\t\tuser = self.session.props.auth.user.userName\n\n\t\tcols = list(self.props.columns)\t#make a copy so we don't affect the actual colmns\n\t\ti= 0\n\t\tfor col in cols:\n\t\t\tif 'dci_' in col['field']: \n\t\t\t\tfor item in self.view.custom.itemData:\n\t\t\t\t\tif item['data_configuration_id'] == int(col['field'].replace('dci_','')):\n\t\t\t\t\t\tkpiMatrix.config.updateMatrixItem(item['Matrix_Data_Id'], 'Sort_Order', i, user)\n\t\t\t\t\t\tbreak\n\t\t\t\ti += 1\n\n\treturn"
                    }
                  }, 
                  "custom.updateColumns": {
                    "onChange": {
                      "enabled": null, 
                      "script": "\n\tdef buildColumn(field, title, justify, sortable, hdrStyle, rowStyle, width, visible):\n\t\treturn {\n\t\t\t\t  \"field\": field,\n\t\t\t\t  \"visible\": visible,\n\t\t\t\t  \"editable\": False,\n\t\t\t\t  \"render\": \"auto\",\n\t\t\t\t  \"justify\": justify,\n\t\t\t\t  \"align\": \"center\",\n\t\t\t\t  \"resizable\": True,\n\t\t\t\t  \"sortable\": sortable,\n\t\t\t\t  \"sort\": \"none\",\n\t\t\t\t  \"filter\": {\"enabled\": False, \"visible\": \"on-hover\", \"string\": {\"condition\": \"\", \"value\": \"\" }, \"number\": {\"condition\": \"\", \"value\": \"\"}, \"boolean\": {\"condition\": \"\"}, \"date\": {\"condition\": \"\", \"value\": \"\"}},\n\t\t\t\t  \"viewPath\": \"\",\n\t\t\t\t  \"viewParams\": {},\n\t\t\t\t  \"boolean\": \"checkbox\",\n\t\t\t\t  \"number\": \"value\",\n\t\t\t\t  \"progressBar\": {\"max\": 100, \"min\": 0, \"bar\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"track\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"value\": {\"enabled\": True, \"format\": \"0,0.##\", \"justify\": \"center\", \"style\": {\"classes\": \"\"}}},\n\t\t\t\t  \"toggleSwitch\": {\"color\": {\"selected\": \"\", \"unselected\": \"\"}},\n\t\t\t\t  \"NoneFormat\": {\"includeNoneStrings\": False, \"strict\": False, \"NoneFormatValue\": \"\"},\n\t\t\t\t  \"numberFormat\": \"0,0.##\",\n\t\t\t\t  \"dateFormat\": \"MM/DD/YY HH:mm\",\n\t\t\t\t  \"width\": width,\n\t\t\t\t  \"strictWidth\": True,\n\t\t\t\t  \"style\": rowStyle,\n\t\t\t\t  \"header\": {\"title\": title, \"justify\": justify, \"align\": \"center\", \"style\": hdrStyle},\n\t\t\t\t  \"footer\": {\"title\": \"\", \"justify\": \"left\", \"align\": \"center\", \"style\": {\"classes\": \"\" }}\n\t\t\t\t}\n\n\tcolInfo = self.custom.updateColumns\n\tif not colInfo.has_key('columns'): return\n\tif not colInfo.has_key('startingCol'): return\n\tif not colInfo.has_key('numOfCols'): return\t\n\tif colInfo.startingCol is None: return\n\tif colInfo.numOfCols is None: return\n\tif colInfo.columns is None: return\n\n\thdrStyle = {'backgroundColor' : '--kcBlue-10', 'fontWeight': 'bold', 'fontSize' : '12px', 'borderBottomWidth' : '1px' , 'borderBottomStyle' : 'solid','borderBottomColor':'#D5D5D5'}\n\trowStyle = ({'backgroundColor' : '--kcBlue-10', 'fontSize' : '10px','borderRightWidth' : '1px' , 'borderRightStyle' : 'solid','borderRightColor':'#C1C1C1'})\n\tcolHeader = system.dataset.getColumnHeaders(self.props.data)\n\n\tcols = [{'colName':'takenDate', 'title':'Taken Date', 'justify': 'left', 'width':110, 'visible': True}]\n\tif self.custom.updateColumns.displaySettings.showFooter:\n\t\tcols.append({'colName':'shiftName', 'title':'Shift', 'justify': 'left', 'width':70,'sortable':True, 'visible':True})\n\t\tcols.append({'colName':'itemName','title':'Item', 'width':100, 'justify': 'center', 'sortable':False, 'visible': True})\n\t\tcols.append({'colName':'assetPath', 'title':'Asset', 'justify': 'left', 'width':160, 'sortable':False, 'visible': True})\n\t\tcols.append({'colName':'chkShtStateName', 'title':'Status', 'justify': 'left', 'width':70,'sortable':True, 'visible':True})\n\n#\tcols = [{'colName':'takenDate', 'title':'Taken Date', 'justify': 'left', 'width':110, 'visible': True}]\n\n\tfixedColumns = [buildColumn(item['colName'], item['title'], item['justify'], True, hdrStyle, rowStyle, item['width'], item['visible']) for item in cols if item['colName'] in colHeader]\n\n\tself.view.custom.table.columns.fixedColLength = len([i for i in fixedColumns if i['visible']])\n\tself.props.columns = list(fixedColumns) +  colInfo.columns[colInfo.startingCol:colInfo.startingCol + colInfo.numOfCols]\n\n\treturn"
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxTable", 
              "name": "flxTable"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "position.display": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn value.getColumnCount > 0", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.custom.table.data"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxBody", 
          "name": "flxBody"
        }, 
        "position": {
          "grow": 1
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tself.clearData()\n\tself.view.custom.table.data = self.view.getChild(\"root\").getData()\n\n\treturn", 
          "messageType": "getTableData", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tself.clearData()\n\n\treturn", 
          "messageType": "clearTableData", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tself.clearTableSelection()\n\n\treturn", 
          "messageType": "clearTableSelection", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"getData() called\")\n\n\tfilters = self.view.params.value.filters\n\tif filters.chkShtId is None: return system.dataset.toDataSet([],[])\n\n\tsystem.perspective.print(\"getData() called\")\n\tchkStates = system.kanoa.utilities.convertDatasetToDict(system.kanoa.quality.sheet.getStates({'enabled': True}), 'chkShtStateName', 'chkShtStateId')\n\tself.view.params.infoBar = {\"showBar\": True, \"text\": \"Getting data...\", \"type\": \"INFO\"}\n\t\n\tchkShtEventInfo = dict(filters)\t\n\tif chkShtEventInfo.has_key('assetPath') and chkShtEventInfo['assetPath'] is not None: chkShtEventInfo['assetPath'] = chkShtEventInfo['assetPath'] + '%'\n\t\n\tif chkShtEventInfo.has_key('itemClasses') and len(chkShtEventInfo['itemClasses']) > 0: chkShtEventInfo['itemClassPath'] = chkShtEventInfo['itemClasses'][0]['itemClassPath'] +'%'\n\tif chkShtEventInfo.has_key('items') and len(chkShtEventInfo['items']) > 0: chkShtEventInfo['itemId'] = chkShtEventInfo['items'][0]['itemId']\n\n\tchkShtEventInfo['chkShtStateIds'] = [chkStates['Approved']]\n\tif chkShtEventInfo.has_key('itemClasses'): chkShtEventInfo.pop('itemClasses')\n\tif chkShtEventInfo.has_key('items'): chkShtEventInfo.pop('items')\t\n\tif chkShtEventInfo.has_key('chkStates'): chkShtEventInfo.pop('chkStates')\n\n\tdata, msg = system.kanoa.quality.analysis.getChkItemEventsByColumn(chkShtEventInfo)\n\n\tself.view.params.infoBar = {\"showBar\": False, \"text\": \"\", \"type\": \"INFO\"}\n\tif data.rowCount == 0: system.perspective.sendMessage('showWarningToast', {'message': 'No checks found'})\n\treturn data", 
          "name": "getData"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"clearMatrixData() called\")\n\tself.clearTableSelection()\n\tself.view.custom.table.data = system.dataset.toDataSet([],[])\n\tself.view.params.infoBar = {\"showBar\": False, \"text\": \"\", \"type\": \"INFO\"}\n\n\treturn", 
          "name": "clearData"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"clearTableSelection() called\")\n\tself.view.custom.table.selection.col = None\n\tself.view.custom.table.selection.row = None\n\t\n\treturn", 
          "name": "clearTableSelection"
        }, 
        {
          "params": [
            "row"
          ], 
          "script": "\n\tsystem.perspective.print(\"setTableSelection() called for row %s\"%row)\n\tself.view.custom.table.selection.col = None\n\tself.view.custom.table.selection.row = row\n\t\n\treturn", 
          "name": "setTableSelection"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.table": {
      "persistent": true
    }, 
    "params.infoBar": {
      "paramDirection": "output", 
      "persistent": true
    }, 
    "custom.table.getData": {
      "onChange": {
        "enabled": null, 
        "script": "\n\tif currentValue.value:\n\t\tsystem.perspective.sendMessage('getTableData', {})\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tself.custom.table.getData = False\n\n\treturn\t"
      }
    }, 
    "custom.itemInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.config.getChecks({'chkShtId': value or -1}))", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value.filters.chkShtId"
        }
      }, 
      "persistent": true
    }, 
    "custom.table.columns.totalCols": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn value.getColumnCount()", 
