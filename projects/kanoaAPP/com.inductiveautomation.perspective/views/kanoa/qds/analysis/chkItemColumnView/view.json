                    "binding": {
                      "transforms": [
                        {
                          "code": "\t\n\tdef getChkItemColName(dci):\n\t\tfor item in value['itemInfo']:\n\t\t\tif item['chkItemId'] == int(dci.replace('dci_','')): return item['chkItemGroupName'] + ' ' + item['chkItemName'] if value.displaySettings.showCheckItemPath else item['chkItemName']\n\t\treturn dci\n\n\tdef buildColumn(field, title, justify, sortable, hdrStyle, rowStyle, visible):\n\t\treturn {\n\t\t\t\t  \"field\": field,\n\t\t\t\t  \"visible\": visible,\n\t\t\t\t  \"editable\": False,\n\t\t\t\t  \"render\": \"auto\",\n\t\t\t\t  \"justify\": justify,\n\t\t\t\t  \"align\": \"center\",\n\t\t\t\t  \"resizable\": True,\n\t\t\t\t  \"sortable\": sortable,\n\t\t\t\t  \"sort\": \"none\",\n\t\t\t\t  \"filter\": {\"enabled\": False, \"visible\": \"on-hover\", \"string\": {\"condition\": \"\", \"value\": \"\" }, \"number\": {\"condition\": \"\", \"value\": \"\"}, \"boolean\": {\"condition\": \"\"}, \"date\": {\"condition\": \"\", \"value\": \"\"}},\n\t\t\t\t  \"viewPath\": \"\",\n\t\t\t\t  \"viewParams\": {},\n\t\t\t\t  \"boolean\": \"checkbox\",\n\t\t\t\t  \"number\": \"value\",\n\t\t\t\t  \"progressBar\": {\"max\": 100, \"min\": 0, \"bar\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"track\": {\"color\": \"\", \"style\": {\"classes\": \"\"}}, \"value\": {\"enabled\": True, \"format\": \"0,0.##\", \"justify\": \"center\", \"style\": {\"classes\": \"\"}}},\n\t\t\t\t  \"toggleSwitch\": {\"color\": {\"selected\": \"\", \"unselected\": \"\"}},\n\t\t\t\t  \"NoneFormat\": {\"includeNoneStrings\": False, \"strict\": False, \"NoneFormatValue\": \"\"},\n\t\t\t\t  \"numberFormat\": \"0,0.##\",\n\t\t\t\t  \"dateFormat\": \"MM/DD/YYYY HH:mm\",\n\t\t\t\t  \"width\": 90,\n\t\t\t\t  \"strictWidth\": True,\n\t\t\t\t  \"style\": rowStyle,\n\t\t\t\t  \"header\": {\"title\": title, \"justify\": justify, \"align\": \"center\", \"style\": hdrStyle},\n\t\t\t\t  \"footer\": {\"title\": \"\", \"justify\": \"left\", \"align\": \"center\", \"style\": {\"classes\": \"\" }}\n\t\t\t\t}\n\n\thdrStyle = {'backgroundColor' : '--kcBlue-10', 'fontWeight': 'bold', 'fontSize' : '10px', 'borderBottomWidth' : '1px' , 'borderBottomStyle' : 'solid','borderBottomColor':'#D5D5D5'}\n\n\tcolHeader = system.dataset.getColumnHeaders(value['data'])\n\tcolHeader = [hdr for hdr in colHeader if 'dci_' in hdr]\n\n\trowStyle = ({'backgroundColor' : '--kcBlue-0', 'fontSize' : '10px','borderRightWidth' : '1px' , 'borderRightStyle' : 'solid','borderRightColor':'#C1C1C1'})\n\treturn [buildColumn(colName, getChkItemColName(colName), 'center', False, hdrStyle, rowStyle, True) for colName in colHeader]\t#This list is ordered by the items sort order", 
