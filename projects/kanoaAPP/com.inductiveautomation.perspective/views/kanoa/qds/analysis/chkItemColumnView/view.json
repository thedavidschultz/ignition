                      "type": "script", 
                      "scope": "G", 
                      "config": {
                        "script": "\t\n\tsystem.perspective.print('dc with %s'%self.view.params.selectedDCIs)\n\tif len(self.view.params.selectedDCIs) == 0: return\n\n\tchkItemId = self.view.params.selectedDCIs[0]\n\tsystem.perspective.print('sending msg chkItemSelected')\n\tsystem.perspective.sendMessage('chkItemSelected', {'chkItemId': chkItemId})\n\t\t\n\treturn"
