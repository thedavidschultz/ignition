                  "props.footerGroups": {
                    "binding": {
                      "transforms": [
                        {
                          "code": "\n\tdef getChkItemInfo(dci):\n\t\tfor item in value['itemInfo']:\n\t\t\tif item['chkItemId'] == int(dci.replace('dci_','')): return item\n\t\treturn None\n\t\n\tdef buildFootCol(title, span, justify, fontWeight):\n\t\treturn {\"title\": title, \"span\": span, \"justify\": justify, \"align\": \"center\", \"style\": {\"classes\": \"\", 'padding':'5px', 'backgroundColor':'--kcGray-10', 'fontWeight': fontWeight}}\n\n\tif not value.displaySettings.showSummary: return []\n\n\tcalcs = ['Units', 'Average', 'Sum', 'Min', 'Max', 'Range', 'STDev']\n\tfooters = [[buildFootCol(calcs[y], self.view.custom.table.columns.fixedColLength,  'right', 'bold') for i in range(len(value.cols))] for y in range(len(calcs))]\n\n\tdata = value.filterData if len(value.filterData) > 0 else system.kanoa.utilities.convertDatasetToJSON(value.data)\n\tif len(data) == 0: return []\n\t\n\tfor i, col in enumerate(value.cols[self.view.custom.table.columns.fixedColLength:]):\n\t\tchkItemInfo = getChkItemInfo(col.field)\n\t\tvalues = [float(row[col.field]) for row in data if row[col.field] is not None] if chkItemInfo['isNumeric'] else [None for row in data]\n\t\tengUnit = chkItemInfo['engUnitName']\n\n\t\ty = 0\t\t\t\n\t\tfooters[y][i+1] = buildFootCol(engUnit, 1, 'right', 'normal')\n\t\tfooters[y+1][i+1] = buildFootCol(str(round(system.math.mean(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\t\tfooters[y+2][i+1] = buildFootCol(str(round(system.math.sum(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\t\tfooters[y+3][i+1] = buildFootCol(str(round(system.math.min(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\t\tfooters[y+4][i+1] = buildFootCol(str(round(system.math.max(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\t\tfooters[y+5][i+1] = buildFootCol(str(round(system.math.max(values) - system.math.min(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\t\tfooters[y+6][i+1] = buildFootCol(str(round(system.math.standardDeviation(values),3)), 1, 'right', 'normal') if chkItemInfo['isNumeric'] else buildFootCol('', 1, 'right', 'normal')\n\n\treturn footers", 
                          "type": "script"
