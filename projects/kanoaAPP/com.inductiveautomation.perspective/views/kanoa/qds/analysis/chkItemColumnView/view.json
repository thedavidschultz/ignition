          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.table.data"
        }
      }
    }, 
    "custom.table.selection.data": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "bidirectional": true, 
          "path": "/root/flxBody/flxTable/tblData.props.selection.data"
        }
      }
    }, 
    "params.tableData": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.table.data"
        }
      }, 
      "paramDirection": "output", 
      "persistent": true
    }, 
    "params.value": {
      "onChange": {
        "enabled": null, 
        "script": "\n\tif self.params.value.filters.chkShtId is None: self.getChild(\"root\").clearData()\n\treturn"
      }, 
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.selectedDCIs": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn [int(item.replace('dci_','')) for item in value[0]] if len(value) > 0 else []", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.table.selection.data"
        }
      }, 
      "paramDirection": "output", 
      "persistent": true
    }, 
    "custom.table.data": {
      "onChange": {
        "enabled": null, 
        "script": "\t\n\tif currentValue.value is None: return\n\tif self.custom.table.columns.numCols > (currentValue.value.getColumnCount() - self.custom.table.columns.fixedColLength) and currentValue.value.getColumnCount() >  20:\n\t\tself.custom.table.columns.numCols = currentValue.value.getColumnCount() - self.custom.table.columns.fixedColLength"
      }
    }
  }
}