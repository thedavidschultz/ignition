{
  "custom": {}, 
  "params": {
    "value": {
      "color": "", 
      "icon": "material/edit", 
      "toolTip": ""
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 39, 
      "height": 39
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "justify": "center", 
      "style": {
        "margin": "5px"
      }
    }, 
    "children": [
      {
        "type": "ia.display.icon", 
        "meta": {
          "domId": "icon", 
          "name": "icon"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "20px"
        }, 
        "propConfig": {
          "props.color": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.color"
              }
            }
          }, 
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value != ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "enabled": false, 
              "overlayOptOut": true, 
              "config": {
                "path": "this.props.path"
              }
            }
          }, 
          "props.path": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.icon"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "tooltip": {
        "enabled": true
      }, 
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "transforms": [
            {
              "code": "\treturn value.toolTip or ''", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "path": "view.params.value"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}