          "script": "\t# implement your handler here\n\tmultiSelect \u003d self.view.custom.values.multiSelect\n\tif not multiSelect:\n\t\tsystem.perspective.print(\"Sending \u0027ValuePicked\u0027 message with \" + str(payload))\n\t\tsystem.perspective.sendMessage(\"ValuePicked\", payload, scope\u003d\u0027page\u0027)\n\telse:\n\t\tselectedValue \u003d payload[\u0027value\u0027]\n\t\tif selectedValue in self.view.custom.selection: self.view.custom.selection.remove(selectedValue)\n\t\telse: self.view.custom.selection.append(selectedValue)\n\t\n\treturn",
