{
  "custom": {},
  "params": {
    "label": "",
    "value": null
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 38,
      "width": 137
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tpayload \u003d {\u0027value\u0027:self.view.params.value}\n\tsystem.perspective.print(\"Sending \u0027buttonSelection\u0027 message with \" + str(payload))\n\tsystem.perspective.sendMessage(\"buttonSelection\", payload, scope\u003d\u0027page\u0027)\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "Button",
          "name": "Button"
        },
        "position": {
          "basis": "34px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "path": "this.props.text"
              },
              "transforms": [
                {
                  "code": "#\treturn len(value)\n\tif len(value) \u003c\u003d 40: return \u002712px\u0027\n\tif len(value) \u003c\u003d 70: return \u00279px\u0027\n\treturn \u00278px\u0027\n\t",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "align": "center",
            "backgroundColor": "--kcPrimaryContainer",
            "classes": "kanoa/button/flatIcon",
            "justify": "center"
          },
          "textStyle": {
            "align": "center",
            "color": "--kcOnPrimaryContainer",
            "justify": "center"
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}