              "style": {
                "gap": "5px",
                "padding": "5px"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "domId": "Label",
                  "name": "lblInstructions"
                },
                "position": {
                  "basis": "20px",
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "fontWeight": "bold"
                  },
                  "text": "Check Item Instructions"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "domId": "txtInstructions",
                  "name": "txtInstructions"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.value.instructions"
                      },
                      "transforms": [
                        {
                          "code": "\treturn value or \u0027\u0027",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "enabled": false,
                  "rejectUpdatesWhileFocused": false,
                  "style": {
                    "backgroundColor": "--kcGray-0",
                    "classes": "kanoa/border kanoa/font/default"
                  }
                },
                "type": "ia.input.text-area"
              },
              {
                "meta": {
                  "name": "flxRptImages"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "config": {
                        "path": "view.custom.chkItemImages"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn [{\u0027imageData\u0027: image} for image in value]",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "direction": "column",
                  "elementPosition": {
                    "basis": "auto",
                    "grow": 0,
                    "shrink": 0
                  },
                  "path": "kanoa/qds/config/checks/chkItemImageViewer",
                  "useDefaultViewHeight": false,
                  "wrap": "wrap"
                },
                "type": "ia.display.flex-repeater"
              }
            ],
            "meta": {
              "domId": "flxChkInstructions",
              "name": "flxChkItemInstructions"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "5px",
                "padding": "5px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "tbInstructions"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "expression": "now(0)"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn 0",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "menuType": "modern",
          "style": {
            "classes": "kanoa/font/default"
          },
          "tabStyle": {
            "active": {
              "classes": "kanoa/font/default"
            },
            "inactive": {
              "classes": "kanoa/font/default"
            }
          },
          "tabs": [
            "Check Sheet",
            "Check item"
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "updateChkItemComment",
          "params": [
            "comment"
          ],
          "script": "\t\n\tchkDetailId \u003d self.view.params.value.chkdetailId\n\tmeasNum \u003d self.view.params.value.measNum\n\tparams \u003d {\u0027chkItemComment\u0027:comment, \u0027chkDetailId\u0027:chkDetailId, \u0027measNum\u0027:measNum}\n\tsystem.perspective.print(\"Sending message updateCheckComment with payload \" + str(params))\n\tsystem.perspective.sendMessage(\"updateCheckComment\", payload \u003d params, scope\u003d\u0027page\u0027)"
        },
        {
          "name": "updateChkShtComment",
          "params": [
            "comment"
          ],
          "script": "\t\n\tchkShtComment \u003d self.view.params.value.ChkShtComment or None\n\tparams \u003d {\u0027chkShtComment\u0027: comment}\n\tsystem.perspective.print(\"Sending message updateCheckShtComment with payload \" + str(params))\n\tsystem.perspective.sendMessage(\"updateCheckShtComment\", payload \u003d params, scope\u003d\u0027page\u0027)\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "setInstructions",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\u0027setInstructions() msg rcvd with %s\u0027%payload)\n\t\n\tself.view.params.value \u003d payload[\u0027value\u0027]",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}