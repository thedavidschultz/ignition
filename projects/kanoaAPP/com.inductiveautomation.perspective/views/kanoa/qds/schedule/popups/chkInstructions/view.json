                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "path": "view.params.value.chkShtFile"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn value is not None",
