                    "binding": {
                      "config": {
                        "path": "view.params.value.chkInstructions"
                      },
                      "transforms": [
                        {
                          "code": "\treturn value or \u0027\u0027",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "deferUpdates": false,
                  "enabled": false,
                  "rejectUpdatesWhileFocused": false,
