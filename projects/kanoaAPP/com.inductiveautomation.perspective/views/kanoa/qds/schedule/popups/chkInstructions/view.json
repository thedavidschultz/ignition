{
  "custom": {
    "chkItemImages": []
  },
  "params": {
    "value": {
      "chkInstructions": null,
      "chkItemId": null,
      "chkShtFile": null,
      "instructions": null
    }
  },
  "propConfig": {
    "custom.chkItemImages": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tif value[\u0027chkItemId\u0027] is None: return []\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.config.getChkItemImageData({\u0027chkItemId\u0027: value[\u0027chkItemId\u0027], \u0027includeThumbnail\u0027: False}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value.instructions": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize": {
      "binding": {
        "config": {
          "path": "view.params.value.chkShtFile"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn {\n\t\t\u0027height\u0027: 700 if value is not None else 244,\n\t\t\u0027width\u0027: 600 if value is not None else 520\n\t}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {},
  "root": {
    "children": [
      {
