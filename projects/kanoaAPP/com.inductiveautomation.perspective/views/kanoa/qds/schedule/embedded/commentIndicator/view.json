{
  "custom": {}, 
  "params": {
    "value": "hello"
  }, 
  "props": {
    "defaultSize": {
      "width": 30, 
      "height": 31
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.icon", 
        "props": {
          "color": "#FF8C00", 
          "path": "material/sticky_note_2"
        }, 
        "meta": {
          "tooltip": {
            "location": "center-left"
          }, 
          "domId": "Icon", 
          "name": "Icon"
        }, 
        "position": {
          "grow": 1, 
          "shrink": 0, 
          "basis": "30px"
        }, 
        "propConfig": {
          "meta.tooltip.enabled": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\treturn value is not None", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.value"
              }
            }
          }, 
          "meta.tooltip.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn str(value)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value"
              }
            }
          }, 
          "meta.visible": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\treturn value is not None", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.value"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}