        }, 
        {
          "viewScope": false, 
          "script": "\t\n\tsystem.perspective.print(\"deleteChkEvent message received with %s\"%payload)\n\t\n\tif payload.has_key('userInput') and payload['userInput'] == 'OK':\t\n\t\tif payload.has_key('inputPayload') and payload['inputPayload']['chkShtEventId'] == self.view.params.value.chkShtEventId:\n\t\t\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\tsystem.kanoa.quality.event.deleteChkEvent(self.view.params.value.chkShtEventId, userId)\n\t\t\tsystem.kanoa.quality.event.updateChkEventDataTag()\n\t\n\treturn", 
