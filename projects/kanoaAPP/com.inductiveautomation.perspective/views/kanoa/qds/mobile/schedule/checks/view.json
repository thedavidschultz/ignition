{
  "custom": {},
  "params": {
    "value": {
      "bgColor": "--kcRed-60",
      "foreColor": "--kcGray-0",
      "label": "Submitted",
      "num": 5,
      "popup": "kanoa/qds/schedule/addCheckEvent",
      "selected": true
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 50
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblNum",
              "name": "lblNum"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value.num"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.textStyle.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.foreColor"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "textAlign": "center"
              },
              "textStyle": {
                "fontSize": "1.5em"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblText",
              "name": "lblText"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value.label"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.textStyle.color": {
                "binding": {
                  "config": {
                    "path": "view.params.value.foreColor"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "textAlign": "center"
              },
              "textStyle": {
                "fontSize": "0.8em"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n#\tself.view.params.value.selected \u003d not self.view.params.value.selected\n\tsystem.perspective.sendMessage(\u0027chkShtStateSelected\u0027, {\u0027chkShtStateName\u0027: self.view.params.value.label, \u0027selected\u0027: not self.view.params.value.selected})\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "flxBody",
          "name": "flxBody",
          "tooltip": {
            "enabled": true,
            "location": "bottom",
            "text": "Click to filter"
          }
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value[\u0027bgColor\u0027] if value[\u0027selected\u0027] else \u0027--kcGray-10\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "direction": "column",
          "justify": "center",
          "style": {
            "borderStyle": "none",
            "classes": "kanoa/border",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "",
        "cursor": "pointer",
        "overflow": "hidden",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}