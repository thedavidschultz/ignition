    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcGray-0",
        "classes": "kanoa/font/default",
        "gap": "5px",
        "overflow": "hidden",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "add",
          "params": [],
          "script": "\n\tchkShtId \u003d self.view.custom.selection.chkShtId\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tchkStates \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.quality.sheet.getStates({\u0027enabled\u0027: True}), \u0027chkShtStateName\u0027, \u0027chkShtStateId\u0027)\n\t\n\tchkShtTriggers \u003d system.kanoa.utilities.convertDatasetToDict(system.kanoa.quality.config.getChkShtTriggers({\u0027chkShtId\u0027: chkShtId}), \u0027triggerTypeName\u0027, \u0027chkShtTriggerId\u0027)\t\n\tif not chkShtTriggers.has_key(\u0027Manual\u0027):\n\t\ttriggerTypeId \u003d system.kanoa.utilities.getFieldValue(\u0027triggerTypeId\u0027, system.kanoa.quality.config.getTriggerTypes({\u0027triggerTypeName\u0027: \u0027Manual\u0027}))\n\t\ttriggerInfo \u003d {\u0027chkShtId\u0027: chkShtId,\u0027triggerTypeId\u0027:triggerTypeId, \u0027modeId\u0027: None, \u0027shiftNameId\u0027: None, \u0027intervalMins\u0027: 10, \u0027delayMins\u0027: 5, \u0027productionCount\u0027: None, \u0027comingDueMins\u0027: 5, \u0027overDueMins\u0027: 5, \u0027graceMins\u0027: 10, \u0027enabled\u0027: True, \u0027modifier\u0027: None}\n\t\tchkShtTriggerId \u003d system.kanoa.quality.config.addChkShtTrigger(triggerInfo, userId)\n\telse:\n\t\tchkShtTriggerId \u003d chkShtTriggers[\u0027Manual\u0027]\n\t\n\titemId \u003d self.view.custom.selection.item.itemId if self.view.custom.selection.item.required else None\n\tassetId \u003d self.view.custom.selection.asset.assetId\n\tshiftNameId \u003d system.kanoa.utilities.getFieldValue(\u0027shiftNameId\u0027, system.kanoa.shift.getCurrentShift({\u0027assetId\u0027: assetId})) if assetId is not None else None\n\t\n\tchkEventInfo \u003d {\n\t\t\t\t\t\t\u0027chkShtId\u0027: chkShtId,\n\t\t\t\t\t\t\u0027assetId\u0027: assetId,\n\t\t\t\t\t\t\u0027itemId\u0027: itemId,\n\t\t\t\t\t\t\u0027shiftNameId\u0027: shiftNameId,\n\t\t\t\t\t\t\u0027comment\u0027: None,\n\t\t\t\t\t\t\u0027scheduledDate\u0027: system.date.now(),\n\t\t\t\t\t\t\u0027chkShtStateId\u0027: chkStates[\u0027Due\u0027],\n\t\t\t\t\t\t\u0027chkShtTriggerId\u0027: chkShtTriggerId\n\t\t\t\t\t}\n\t\n\tchkShtEventId \u003d system.kanoa.quality.event.addCheckEvent(chkEventInfo, userId)\n\tif chkShtEventId:\n\t\tsystem.kanoa.quality.event.updatePersistentValues(chkShtId, assetId, itemId, chkShtEventId, userId)\n\t\t\n\t\tsystem.kanoa.quality.event.updateChkEventDataTag()\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Check Sheet has been added\u0027)\n\t\tsystem.perspective.sendMessage(\u0027chkShtEventAdded\u0027, {})\n\t\tself.getChkShtInfo(None)\n\t\t\n\t\tparams\u003d {\n\t\t\t\t\t\"path\": \u0027kanoa/qds/schedule/chkShtEventEditor\u0027,\n\t\t\t\t\t\"name\": \u0027Check Table\u0027,\n\t\t\t\t\t\"type\": \u0027view\u0027,\n\t\t\t\t\t\"params\": {\u0027chkShtEventId\u0027: chkShtEventId}\n\t\t\t\t}\n\t\tsystem.perspective.sendMessage(\"updateNavigation\", payload\u003dparams)\n\telse:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027Failed to add Check Sheet\u0027)\n\t\n\treturn"
        },
        {
          "name": "getChkShtInfo",
          "params": [
            "chkShtId"
          ],
          "script": "\n#\tif chkShtId is None: return\n\tsystem.perspective.print(\"getChkShtInfo() called with %s\"%chkShtId)\n\t\n\tself.view.custom.chkShtInfo \u003d {\n\t\t\t\t\u0027chkSht\u0027: system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.quality.sheet.getSheets({\u0027chkShtId\u0027: chkShtId or -1}), 0),\n\t\t\t\t\u0027assets\u0027: system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.sheet.getAssets(chkShtId or -1)),\n\t\t\t\t\u0027items\u0027: system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.sheet.getItems(chkShtId or -1)),\n\t\t\t\t\u0027itemClasses\u0027: system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.sheet.getItemClasses(chkShtId or -1)),\n\t\t\t\t\u0027itemSets\u0027: system.kanoa.utilities.convertDatasetToJSON(system.kanoa.quality.sheet.getItemSets(chkShtId or -1)),\n\t\t\t}\n\n\tself.view.custom.selection[\"chkShtId\"] \u003d chkShtId\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updatePopupSelection",
          "pageScope": true,
          "script": "\t\t\n\tif payload[\u0027msgHandler\u0027] \u003d\u003d \u0027itemSelected\u0027:\n\t\tself.view.params.value.itemId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027itemId\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 and payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027itemId\u0027) else None\n\t\n\tif payload[\u0027msgHandler\u0027] \u003d\u003d \u0027chkShtSelected\u0027:\n\t\t\n\t\tsystem.perspective.print(\"chkShtSelected() msg rcvd with %s\"%payload)\n\t\t\n\t\tchkShtId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027chkShtId\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 and payload[\u0027selection\u0027][0][\u0027value\u0027].has_key(\u0027chkShtId\u0027) else None\n\t\t\n\t\tif chkShtId is not None: self.getChkShtInfo(chkShtId)\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "clearSelection",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"clearSelection() msg rcvd with %s\"%payload)\n\n\tself.getChkShtInfo(None)\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}