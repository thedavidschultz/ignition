                    {
                      "code": "\n\tif value[\u0027chkShtId\u0027] is None: return False\n\tif value[\u0027asset\u0027][\u0027required\u0027] and value[\u0027asset\u0027][\u0027selected\u0027] is False: return False\n\tif value[\u0027item\u0027][\u0027required\u0027] and value[\u0027item\u0027][\u0027selected\u0027] is False: return False\n\t\n\treturn True",
                      "type": "script"
                    }
                  ],
