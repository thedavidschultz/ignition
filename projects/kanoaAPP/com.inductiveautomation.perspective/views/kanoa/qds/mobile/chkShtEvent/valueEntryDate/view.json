{
  "custom": {}, 
  "params": {
    "value": {
      "chkItemValue": "2024-05-15 00:00:00", 
      "dataTypeName": "Image", 
      "enabled": true, 
      "chkItemStateId": null, 
      "measNumber": 1, 
      "chkItemStateName": null, 
      "chkItemId": 1286, 
      "chkItemStateColor": null, 
      "meascount": 1, 
      "chkItemTakenDate": {
        "$ts": 1716261243877, 
        "$": [
          "ts", 
          192, 
          1716479012700
        ]
      }
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 252, 
      "height": 44
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "style": {
        "padding": "5px", 
        "backgroundColor": "--kcOnPrimary", 
        "overflow": "hidden", 
        "gap": "5px"
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "right"
          }
        }, 
        "meta": {
          "domId": "lblMeasNum", 
          "name": "lblMeasNum"
        }, 
        "position": {
          "basis": "32px"
        }, 
        "propConfig": {
          "meta.visible": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value > 1", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measCount"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn '#%s'%(value or 1)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measNumber"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.input.date-time-input", 
        "props": {
          "dismissOnSelect": false, 
          "format": "MM-DD-YY HH:mm", 
          "inputProps": {
            "style": {
              "fontSize": "16px"
            }
          }, 
          "formattedValue": "05-14-24 17:00", 
          "style": {
            "classes": "kanoa/font/bodyLarge", 
            "height": "30px"
          }
        }, 
        "meta": {
          "domId": "dateTimeInput", 
          "name": "dateTimeInput"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemStateColor"
              }
            }
          }, 
          "props.value": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn system.date.parse(value) if value else None", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemValue"
              }
            }
          }, 
          "props.enabled": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.enabled"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.input.button", 
        "props": {
          "image": {
            "icon": {
              "path": "material/keyboard_return"
            }
          }, 
          "style": {
            "classes": "kanoa/button/flatIcon", 
            "width": "30px", 
            "height": "30px"
          }, 
          "text": ""
        }, 
        "meta": {
          "domId": "btnSubmit", 
          "name": "btnSubmit"
        }, 
        "position": {
          "shrink": 0
        }, 
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\t\n\tsystem.perspective.print(\"enter pressed\")\n\t\n\t\n\t\n\tpayload = {'value':self.getSibling(\"dateTimeInput\").props.value, 'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId}\n\tsystem.perspective.print(\"Sending ValuePicked message with %s from sendValue()\"%(payload))\n\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\n\t\t\n\treturn\t\t"
              }
            }
          }
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value['params']['enabled'] and value['value'] is not None", 
                  "type": "script"
                }
              ], 
              "type": "expr-struct", 
              "overlayOptOut": true, 
              "config": {
                "struct": {
                  "params": "{view.params.value}", 
                  "value": "{../dateTimeInput.props.value}"
                }, 
                "waitOnAll": false
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tif payload.has_key('chkItemId') and payload.has_key('measNumber'):\n\t\tif payload['chkItemId'] == self.view.params.value.chkItemId and payload['measNumber'] == self.view.params.value.measNumber:\n\t\t\tsystem.perspective.print(\"setfocus msg rcvd with %s\"%payload)\n\t\t\tself.getChild(\"dateTimeInput\").focus()\n\t\n\treturn", 
          "messageType": "setFocus", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}