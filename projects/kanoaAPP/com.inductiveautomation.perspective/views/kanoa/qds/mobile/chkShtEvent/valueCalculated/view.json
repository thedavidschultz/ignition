{
  "custom": {}, 
  "params": {
    "value": {
      "chkItemValue": null, 
      "dataTypeName": "Float", 
      "enabled": false, 
      "chkItemStateId": null, 
      "measNumber": 1, 
      "chkItemStateName": null, 
      "chkItemId": 1306, 
      "chkItemStateColor": null, 
      "measCount": 1, 
      "chkItemTakenDate": null
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 133, 
      "height": 44
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "style": {
        "padding": "5px", 
        "backgroundColor": "#FFFFFF00", 
        "overflow": "hidden", 
        "gap": "5px"
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "right"
          }
        }, 
        "meta": {
          "domId": "lblMeasNum", 
          "name": "lblMeasNum"
        }, 
        "position": {
          "basis": "32px"
        }, 
        "propConfig": {
          "meta.visible": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value > 1", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measCount"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn '#%s'%(value or 1)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measNumber"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "classes": "kanoa/border", 
            "fontSize": "16px", 
            "height": "30px"
          }, 
          "textStyle": {
            "textAlign": "center"
          }
        }, 
        "meta": {
          "domId": "lblValue", 
          "name": "lblValue"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemStateColor"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn '%s'%(value or '')", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemValue"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "events": {
      "dom": {
        "onClick": {
          "type": "script", 
          "scope": "G", 
          "config": {
            "script": "\n\tsystem.perspective.print(\"valueCalculated - onClick for chkItemId %s meas# %s\"%(self.view.params.value.chkItemId, self.view.params.value.measNumber))\n\tsystem.perspective.sendMessage(\"chkItemSelected\", {'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId})\n\t\n\treturn"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}