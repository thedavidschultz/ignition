              "scope": "G", 
              "config": {
                "script": "\n\n\tif not \tself.session.props.geolocation.enabled:\n\t\tself.session.props.geolocation.enabled = True\n\t\treturn\n\n\tdata = self.session.props.geolocation.data\n\tvalue = {'latitude': data['latitude'], 'longitude': data['longitude'], 'altitude': data['altitude']}\n\t\n\tpayload = {'value': system.util.jsonEncode(value), 'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId}\n\tsystem.perspective.print(\"Sending ValuePicked message with %s from sendValue()\"%(payload))\n\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\n\t\n\treturn"
              }
            }
          }
        }, 
        "propConfig": {
          "props.textStyle.fontSize": {
            "binding": {
              "transforms": [
                {
                  "code": "#\treturn len(value)\n\tif len(value) <= 40: return '12px'\n\tif len(value) <= 70: return '9px'\n\treturn '8px'\n\t", 
