  "propConfig": {
    "params.enabled": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.stats": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tif value['dataTypeName'] not in ('Integer', 'Float') or value['measCount'] == 1: return  {'min': None,'max': None,'mean': None,'stdDev': None}\n\t\n\tmeasurements = [float(item['chkItemValue']) for item in value['measurements'] if item['chkItemValue'] is not None]\n\t\n\treturn {\n\t\t\t\t'min': system.math.min(measurements),\n\t\t\t\t'max': system.math.max(measurements),\n\t\t\t\t'mean': system.math.mean(measurements),\n\t\t\t\t'stdDev': round(system.math.standardDeviation(measurements),5)\n\t\t\t}", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }, 
    "custom.showSpec": {
      "binding": {
