    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [
            "chkItem"
          ], 
          "script": "\n\t#If we don't find a tolerance spec, we will default to the picklist values\n\t\n\tspecs = {'lel':None, 'lsl':None, 'lcl':None, 'tgt':None, 'ucl':None, 'usl':None, 'uel':None}\n\tpickListValues = system.util.jsonDecode(chkItem['pickListValues'] or '{}')\n\t\n\tif (chkItem['lsl'] or chkItem['ldl']) is not None and (chkItem['usl'] or chkItem['udl']) is not None:\t#We got our specs from the attributes table\n\t\tspecs['lel'] = chkItem['lel']\n\t\tspecs['lsl'] = chkItem['lsl'] or chkItem['ldl']\n\t\tspecs['lcl'] = chkItem['lcl']\n\t\tspecs['tgt'] = chkItem['tgt']\n\t\tspecs['ucl'] = chkItem['ucl']\n\t\tspecs['usl'] = chkItem['usl'] or chkItem['udl']\n\t\tspecs['uel'] = chkItem['uel']\n\telse:\n\t\tif pickListValues.has_key('lel'): specs['lel'] = pickListValues['lel']\n\t\tif pickListValues.has_key('lsl'): specs['lsl'] = pickListValues['lsl']\n\t\tif pickListValues.has_key('lcl'): specs['lcl'] = pickListValues['lcl']\n\t\tif pickListValues.has_key('tgt'): specs['tgt'] = pickListValues['tgt']\n\t\tif pickListValues.has_key('ucl'): specs['ucl'] = pickListValues['ucl']\n\t\tif pickListValues.has_key('usl'): specs['usl'] = pickListValues['usl']\n\t\tif pickListValues.has_key('uel'): specs['uel'] = pickListValues['uel']\n\n\treturn specs", 
          "name": "getTolerances"
        }
      ], 
      "extensionFunctions": null
    }
