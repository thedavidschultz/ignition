{
  "custom": {}, 
  "params": {
    "value": {
      "chkItemValue": "qw23", 
      "dataTypeName": "String", 
      "enabled": true, 
      "chkItemStateId": 1, 
      "measNumber": 1, 
      "pickListValues": "{\"script\":\"Left Four Chars\"}", 
      "chkItemEventId": 157899, 
      "chkItemStateName": "PASS", 
      "chkItemId": 2313, 
      "chkItemStateColor": "--kcGoodContainer", 
      "measCount": 1, 
      "chkItemTakenDate": {
        "$ts": 1733255361060, 
        "$": [
          "ts", 
          192, 
          1733262658588
        ]
      }
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 133, 
      "height": 44
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "style": {
        "padding": "5px", 
        "backgroundColor": "--kcOnPrimary", 
        "overflow": "hidden", 
        "gap": "5px"
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "right"
          }
        }, 
        "meta": {
          "domId": "lblMeasNum", 
          "name": "lblMeasNum"
        }, 
        "position": {
          "basis": "32px"
        }, 
        "propConfig": {
          "meta.visible": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value > 1", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measCount"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn '#%s'%(value or 1)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.measNumber"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "center", 
            "classes": "kanoa/border", 
            "height": "30px"
          }, 
          "textStyle": {
            "classes": "kanoa/font/bodyLarge"
          }
        }, 
        "meta": {
          "domId": "lblValue", 
          "name": "lblValue"
        }, 
        "position": {
          "grow": 1
        }, 
        "events": {
          "dom": {
            "onClick": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\n\tsystem.perspective.print(\"valueEntryTxt - onFocus for chkItemId %s meas# %s\"%(self.view.params.value.chkItemId, self.view.params.value.measNumber))\n\tsystem.perspective.sendMessage(\"chkItemSelected\", {'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId})\n\t\n\treturn"
              }
            }
          }
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemStateColor"
              }
            }
          }, 
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn not value['enabled'] or (value['enabled'] and (value['pickListValues'] or None) is not None)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemValue"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.input.text-field", 
        "props": {
          "rejectUpdatesWhileFocused": false, 
          "style": {
            "textAlign": "center", 
            "classes": "kanoa/font/bodyLarge"
          }
        }, 
        "meta": {
          "domId": "txtValue", 
          "name": "txtValue"
        }, 
        "position": {
          "grow": 1
        }, 
        "events": {
          "dom": {
            "onFocus": {
              "stopPropagation": true, 
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\n\tsystem.perspective.print(\"valueEntryTxt - onFocus for chkItemId %s meas# %s\"%(self.view.params.value.chkItemId, self.view.params.value.measNumber))\n\tsystem.perspective.sendMessage(\"chkItemSelected\", {'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId})\n\t\n\treturn"
              }
            }, 
            "onSelect": {
              "type": "script", 
              "enabled": false, 
              "scope": "G", 
              "config": {
                "script": "\n#\tsystem.perspective.print(\"valueEntry txtValue - onSelect\")\n#\tsystem.perspective.sendMessage(\"chkItemSelected\", {'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId})\n#\t\n\treturn"
              }
            }
          }
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemStateColor"
              }
            }
          }, 
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value['enabled'] and (value['pickListValues'] or None) is None", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value"
              }
            }
          }, 
          "props.text": {
            "onChange": {
              "enabled": null, 
              "script": "\t\n#\tsystem.perspective.print(\"valueEntry %s\"%origin)\n\t\n\tif origin == 'Browser':\n\t\tpayload = {'value':self.props.text, 'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId}\n\t\tsystem.perspective.print(\"Sending ValuePicked message with %s from sendValue()\"%(payload))\n\t\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\n\t\t\n\treturn"
            }, 
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemValue"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tif payload.has_key('chkItemId') and payload.has_key('measNumber'):\n\t\tif payload['chkItemId'] == self.view.params.value.chkItemId and payload['measNumber'] == self.view.params.value.measNumber:\n\t\t\tsystem.perspective.print(\"setfocus msg rcvd with %s\"%payload)\n\t\t\tself.getChild(\"txtValue\").focus()\n\t\n\treturn", 
          "messageType": "setFocus", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"updateValue msg rcvd with %s\"%payload)\n\t\n\tif payload['chkItemId'] == self.view.params.value.chkItemId and payload['measNumber'] == self.view.params.value.measNumber:\n\t\tself.getChild(\"txtValue\").props.text = payload['value']\n\t\t\n\treturn", 
          "messageType": "updateValue", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "params.value": {
      "onChange": {
        "enabled": null, 
        "script": "\t\n#\tif self.params.value.measNumber == 1: self.getChild(\"root\").getChild(\"txtValue\").focus()\n\t\n\treturn"
      }, 
      "paramDirection": "input", 
      "persistent": true
    }
  }
}