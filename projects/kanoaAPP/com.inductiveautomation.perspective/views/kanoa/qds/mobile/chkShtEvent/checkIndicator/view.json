{
  "custom": {}, 
  "params": {
    "borderColor": "#BADA55", 
    "label": "", 
    "bgColor": "#FF0000"
  }, 
  "props": {
    "defaultSize": {
      "width": 106, 
      "height": 76
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "margin": "10px", 
        "classes": "kanoa/border", 
        "overflow": "hidden", 
        "borderWidth": "2px", 
        "maxWidth": "100px"
      }, 
      "direction": "column"
    }, 
    "meta": {
      "tooltip": {
        "enabled": true, 
        "location": "bottom"
      }, 
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "property", 
          "config": {
            "path": "view.params.bgColor"
          }
        }
      }, 
      "meta.tooltip.text": {
        "binding": {
          "transforms": [
            {
              "code": "\treturn value or ''", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "config": {
            "path": "view.params.label"
          }
        }
      }, 
      "props.style.borderColor": {
        "binding": {
          "type": "property", 
          "config": {
            "path": "view.params.borderColor"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.label": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.bgColor": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.borderColor": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}