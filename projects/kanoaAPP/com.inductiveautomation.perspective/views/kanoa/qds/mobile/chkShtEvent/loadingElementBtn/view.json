{
  "custom": {}, 
  "params": {
    "name": ""
  }, 
  "props": {
    "defaultSize": {
      "width": 158, 
      "height": 74
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "classes": "kanoa/smooth-appear"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.button", 
        "props": {
          "text": "", 
          "textStyle": {
            "fontSize": "24px"
          }
        }, 
        "meta": {
          "domId": "btnNumber", 
          "name": "btnNumber"
        }, 
        "position": {
          "grow": 1, 
          "basis": "34px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.name"
              }
            }, 
            "persistent": true
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.name": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}