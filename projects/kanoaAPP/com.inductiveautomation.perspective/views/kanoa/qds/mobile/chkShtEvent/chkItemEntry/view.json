                  "config": {
                    "struct": {
                      "chkItem": "{view.params.value}",
                      "enabled": "{view.params.enabled}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tchkItem \u003d value[\u0027chkItem\u0027]\n\t\n\tmeasInfo \u003d dict(value[\u0027chkItem\u0027][\u0027measurements\u0027][0])\n\tmeasInfo[\u0027chkItemId\u0027] \u003d chkItem[\u0027chkItemId\u0027]\n\tmeasInfo[\u0027enabled\u0027] \u003d value[\u0027enabled\u0027] and chkItem[\u0027chkItemTypeName\u0027] in (\u0027Check\u0027, \u0027Trigger\u0027)\n\tmeasInfo[\u0027dataTypeName\u0027] \u003d chkItem[\u0027dataTypeName\u0027]\n\tmeasInfo[\u0027measCount\u0027] \u003d chkItem[\u0027measCount\u0027]\n\tmeasInfo[\u0027pickListValues\u0027] \u003d chkItem[\u0027pickListValues\u0027] if chkItem[\u0027pickListName\u0027] !\u003d \u0027Barcode Scanner\u0027 else None\n\tself.props.params \u003d {\u0027value\u0027:measInfo}\n\t\n\t\t\n\tif chkItem[\u0027chkItemTypeName\u0027] \u003d\u003d \u0027Check\u0027:\n\t\tif chkItem[\u0027dataTypeName\u0027] in (\u0027Float\u0027, \u0027Integer\u0027): viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryNum\u0027\n\t\telif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Boolean\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryBool\u0027\n\t\telif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Datetime\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryDate\u0027\n\t\telif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Image\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryImage\u0027\n\t\telif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Geo Location\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryGPS\u0027\n\t\telse: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryTxt\u0027\n\telif chkItem[\u0027chkItemTypeName\u0027] \u003d\u003d \u0027Trigger\u0027:\n\t\tif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Boolean\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryTrigger\u0027\n\t\telif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Datetime\u0027: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryDate\u0027\n\t\telse: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryTxt\u0027\n\telif chkItem[\u0027chkItemTypeName\u0027] \u003d\u003d \u0027Calculated\u0027:\n\t\tviewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueCalculated\u0027\n\telse: viewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/valueEntryTxt\u0027\n\t\n\treturn viewPath",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
