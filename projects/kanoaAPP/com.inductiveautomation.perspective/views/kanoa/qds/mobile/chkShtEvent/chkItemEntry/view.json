    "scripts": {
      "customMethods": [
        {
          "name": "openEditor",
          "params": [
            "measNumber"
          ],
          "script": "\n\tsystem.perspective.print(\"openEditor() called with %s\"%measNumber)\n\t\n\tif measNumber is None: \n\t\tself.view.custom.valuePicker \u003d {\u0027path\u0027: \u0027\u0027, \u0027params\u0027: {}}\n\t\treturn\n\n\tif not self.view.params.enabled: return\n\tif self.view.params.value.dataTypeName \u003d\u003d \u0027Boolean\u0027: return\t#Handled in the valueEntryBool view.\n\t\n\tviewPath \u003d None\n\tparams \u003d {}\n\tchkItem \u003d self.view.params.value\n\t\n\tsystem.perspective.closePopup(\u0027imageUploader\u0027)\n\tsystem.perspective.closePopup(\u0027chkValueSelector\u0027)\n\t\n\tif chkItem[\u0027dataTypeName\u0027] \u003d\u003d \u0027Image\u0027:\n\t\timageId \u003d system.kanoa.quality.image.getImageId(chkItem[\u0027chkItemId\u0027], chkItem.measurements[0].chkItemValue) if chkItem.measurements[0].chkItemValue else None\n\t\tparams \u003d {\u0027value\u0027: {\"chkItemId\": chkItem[\u0027chkItemId\u0027], \"imageType\": chkItem[\u0027chkItemName\u0027], \u0027imageId\u0027: imageId}}\n\t\tviewPath \u003d \u0027kanoa/qds/mobile/chkShtEvent/checkImageSelector\u0027\n\telif chkItem[\u0027pickListName\u0027] \u003d\u003d \u0027Barcode Scanner\u0027:\n\t\tviewPath \u003d \u0027\u0027\n\t\tparams \u003d {}\n\telif chkItem[\u0027pickListId\u0027]:\n\t\tparams \u003d {\u0027value\u0027: {\n\t\t\t\t\t\t\t\"chkItemId\": chkItem[\u0027chkItemId\u0027],\n\t\t\t\t\t\t\t\"chkItemTypeId\": chkItem[\u0027chkItemTypeId\u0027],\n\t\t\t\t\t\t\t\"dataTypeId\": chkItem[\u0027dataTypeId\u0027],\n\t\t\t\t\t\t\t\"engUnitId\": chkItem[\u0027engUnitId\u0027],\n\t\t\t\t\t\t\t\"pickListId\": chkItem[\u0027pickListId\u0027],\n\t\t\t\t\t\t\t\"pickListValues\": system.util.jsonDecode(chkItem[\u0027pickListValues\u0027]),\n\t\t\t\t\t\t\t\"specification\": system.util.jsonDecode(chkItem[\u0027specification\u0027]),\n\t\t\t\t\t\t\t\"tolerances\": chkItem[\u0027spec\u0027]\n\t\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t\n\t\tviewPath \u003d \u0027kanoa/qds/schedule/popups/checkValueSelector\u0027\n\n\tself.view.custom.valuePicker \u003d {\u0027path\u0027: viewPath or \u0027\u0027, \u0027params\u0027: params}\n\t\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "chkItemSelected",
          "pageScope": true,
          "script": "\n\tif payload.has_key(\u0027chkItemId\u0027) and int(payload[\u0027chkItemId\u0027]) \u003d\u003d int(self.view.params.value.chkItemId):\n\t\tsystem.perspective.print(\"chkItemSelected msg rcvd with %s\"%payload)\n\t\tmeasNum \u003d payload[\u0027measNum\u0027] if payload.has_key(\u0027measNum\u0027) else None\n\t\tif measNum \u003d\u003d self.view.params.value.measurements[0].measNumber: \n\t\t\tself.openEditor(measNum)\n\t\t\treturn\n\n\tself.view.custom.valuePicker \u003d {\u0027path\u0027: \u0027\u0027, \u0027params\u0027: {}}\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
