              }
            }, 
            "onSelect": {
              "type": "script", 
              "enabled": false, 
              "scope": "G", 
              "config": {
                "script": "\n#\tsystem.perspective.print(\"valueEntryNum - onSelect\")\n#\tsystem.perspective.sendMessage(\"chkItemSelected\", {'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId})\n#\t\n\treturn"
              }
            }
          }
