    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tif payload.has_key('chkItemId') and payload.has_key('measNumber'):\n\t\tif payload['chkItemId'] == self.view.params.value.chkItemId and payload['measNumber'] == self.view.params.value.measNumber:\n\t\t\tsystem.perspective.print(\"valueNumEntry - setfocus msg rcvd with %s\"%payload)\n\t\t\tself.getChild(\"numValue\").focus()\n\t\n\treturn", 
          "messageType": "setFocus", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "params.value": {
      "onChange": {
        "enabled": null, 
        "script": "\t\n#\tif self.params.value.measNumber == 1: self.getChild(\"root\").getChild(\"numValue\").focus()\n\t\n\treturn"
