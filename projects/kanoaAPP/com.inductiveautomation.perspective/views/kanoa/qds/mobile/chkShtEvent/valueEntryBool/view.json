            }, 
            "binding": {
              "transforms": [
                {
                  "code": "\treturn 0 if isinstance(value, str) else value", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.chkItemValue"
