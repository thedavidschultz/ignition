              "props.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\n\ttry:\n\t\treturn system.util.jsonDecode(value)['FALSE'][0] if value else 'False'\n\texcept:\n\t\treturn 'False'\n", 
