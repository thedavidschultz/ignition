                  "config": {
                    "script": "\n\tpayload = {'value': '0', 'measNum': self.view.params.value.measNumber, 'chkItemId': self.view.params.value.chkItemId}\n\tsystem.perspective.print(\"Sending ValuePicked message with %s from sendValue()\"%(payload))\n\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\n\t\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn '--kcPrimaryContainer' if value == '0' else ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.chkItemValue"
                  }
