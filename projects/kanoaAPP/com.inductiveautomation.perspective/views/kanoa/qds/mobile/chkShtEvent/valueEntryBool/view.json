                "align": "center", 
                "borderWidth": "1px", 
                "justify": "center", 
                "borderStyle": "solid"
              }, 
              "textStyle": {
                "color": "--kcOnPrimaryContainer", 
                "align": "center", 
                "justify": "center"
              }
            }, 
