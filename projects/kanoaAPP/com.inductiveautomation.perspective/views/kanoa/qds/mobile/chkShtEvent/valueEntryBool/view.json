              "props.style.backgroundColor": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn '--kcPrimaryContainer' if value == '1' else ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.chkItemValue"
                  }
                }
              }, 
              "props.textStyle.fontSize": {
                "binding": {
                  "transforms": [
                    {
                      "code": "#\treturn len(value)\n\tif len(value) <= 40: return '12px'\n\tif len(value) <= 70: return '9px'\n\treturn '8px'\n\t", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "config": {
                    "path": "this.props.text"
                  }
                }
              }, 
              "props.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\n\ttry:\n\t\treturn system.util.jsonDecode(value)['TRUE'][0] if value else 'True'\n\texcept:\n\t\treturn 'True'\n", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.pickListValues"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "padding": "5px", 
