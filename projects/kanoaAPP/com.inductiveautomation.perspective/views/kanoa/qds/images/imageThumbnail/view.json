            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tretVal \u003d system.kanoa.quality.image.deleteImage(self.view.custom.imageData.imageId, self.view.custom.security.userId)\n\tif retVal: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Image has been deleted\u0027})\n\telse: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \"Couldn\u0027t delete image\"})\n\t\n\tsystem.perspective.sendMessage(\"refreshImages\", {})\n\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnDelete",
              "name": "btnDelete",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "center-right",
                "text": "Delete"
