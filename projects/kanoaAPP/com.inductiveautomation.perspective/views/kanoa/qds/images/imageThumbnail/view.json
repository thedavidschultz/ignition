      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tfrom com.inductiveautomation.ignition.common import Base64\n\t\n\timage \u003d system.kanoa.quality.image.getImage(self.view.custom.imageData.imageId)\t\n\tbytes \u003d Base64.decode(image)\n\tsystem.perspective.download(self.view.custom.imageData.imageName, bytes)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnDownload",
              "name": "btnDownload",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "center-right",
                "text": "Download image"
              }
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
