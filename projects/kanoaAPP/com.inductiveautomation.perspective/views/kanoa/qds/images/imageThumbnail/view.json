                "binding": {
                  "config": {
                    "path": "view.custom.imageData.thumbnail"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\treturn \u0027data:imagef;base64,\u0027 + value if value is not None else \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
