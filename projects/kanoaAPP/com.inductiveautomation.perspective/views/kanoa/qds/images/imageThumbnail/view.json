            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\timageData \u003d dict(self.view.custom.imageData)\n\timageData.pop(\u0027thumbnail\u0027)\n\timageData.pop(\u0027image\u0027)\n\t\t\n\tparams \u003d {\u0027imageData\u0027: imageData}\n\ttitle \u003d \u0027Image: %s\u0027 % self.view.custom.imageData.imageName\n\t\n\tsystem.perspective.openPopup(\u0027Image Viewer\u0027, \u0027kanoa/qds/images/imageViewer\u0027, params, title, resizable\u003dTrue, draggable\u003dTrue, showCloseIcon\u003dTrue)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "stopPropagation": true,
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "image",
              "name": "image"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
