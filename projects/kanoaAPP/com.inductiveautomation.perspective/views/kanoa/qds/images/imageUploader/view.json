      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\timageData \u003d self.view.custom.imageData\n\tchkItemId \u003d self.view.params.value.chkItemId if self.view.params.value.has_key(\u0027chkItemId\u0027) else None\n\t\t\n\tif imageData.image is None: \n\t\tsystem.perspective.print(\u0027ERROR: No image selected!\u0027)\n\t\treturn\n\tif imageData.imageType is None: \n\t\tsystem.perspective.print(\u0027ERROR: No type selected!\u0027)\n\t\treturn\n\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\timageId, msg \u003d system.kanoa.quality.image.processImage(imageData[\u0027filePath\u0027], chkItemId, None, imageData[\u0027imageName\u0027], imageData[\u0027imageType\u0027], imageData[\u0027imageDescription\u0027] or None, userId)\n\tsystem.kanoa.file.deleteFile(imageData[\u0027filePath\u0027])\n\t\n\tif msg:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: msg})\n\t\treturn\n\n\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Image Added\u0027})\t\t\n\n\tif self.view.params.value.has_key(\u0027chkItemId\u0027) and self.view.params.value.chkItemId:\n\t\tpayload \u003d {\u0027value\u0027:self.view.custom.imageData.imageName}\n\t\tsystem.perspective.print(\"Sending \u0027ValuePicked\u0027 message with \" + str(payload))\n\t\tsystem.perspective.sendMessage(\"ValuePicked\", payload)\n\t\n\tself.view.getChild(\"root\").clearImageData()\t\n\t\n\tsystem.perspective.closePopup(\u0027Image Popup\u0027)\t#If we are uploading an image from the imagePopup, we need it to update\n\tsystem.perspective.sendMessage(\u0027refreshImages\u0027, {})\t#Tell calling screen to update itself to show the new image\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnAddImage",
              "name": "btnAddImage"
