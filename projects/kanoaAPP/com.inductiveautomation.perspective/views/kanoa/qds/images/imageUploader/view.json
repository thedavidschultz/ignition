                      "code": "\t\n\timage \u003d value[\u0027image\u0027] or value[\u0027thumbnail\u0027]\n\tif (image or None) is None: return \u0027\u0027\n\t\n\treturn \"data:imagef;base64,%s\" %image",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
