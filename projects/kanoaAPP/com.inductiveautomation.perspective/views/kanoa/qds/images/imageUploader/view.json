                  "config": {
                    "script": "\n\tdata \u003d dict(self.view.custom.imageData)\n\tdata.pop(\u0027image\u0027)\n\tdata.pop(\u0027thumbnail\u0027)\n\t\n\tsystem.perspective.openPopup(\u0027Image Popup\u0027, \u0027kanoa/qds/images/imageViewer\u0027, params\u003d{\u0027imageData\u0027: data} , title \u003d \u0027%s\u0027% data[\u0027imageName\u0027], resizable\u003dTrue, showCloseIcon\u003dTrue, draggable\u003dTrue)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "image",
              "name": "image"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "this.props.source"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value !\u003d \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.source": {
                "binding": {
                  "config": {
                    "struct": {
                      "image": "{view.custom.imageData.image}",
                      "thumbnail": "{view.custom.imageData.thumbnail}"
                    },
                    "waitOnAll": false
                  },
                  "overlayOptOut": true,
                  "transforms": [
