  "events": {
    "system": {
      "onShutdown": {
        "config": {
          "script": "\t\n\tif (self.custom.imageData.filePath or None) is not None: system.kanoa.file.deleteFile(self.custom.imageData.filePath)\n\t\n\treturn"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "value": {
      "chkItemId": null,
      "imageId": null,
      "imageType": null
    }
  },
  "propConfig": {
    "custom.gettingImage": {
      "persistent": true
    },
    "custom.imageData": {
      "persistent": true
    },
    "params.value": {
      "onChange": {
        "enabled": null,
        "script": "\t\n\tif self.params.value.has_key(\u0027imageId\u0027):\n\t\timageData \u003d system.kanoa.quality.image.getImageData({\u0027imageId\u0027: self.params.value.imageId or -1, \u0027includeThumbnail\u0027: True})\n\t\timageData \u003d system.kanoa.utilities.convertDatasetRowToJSON(imageData, 0)\n\t\timageData[\u0027filePath\u0027] \u003d None\n\t\tif imageData[\u0027imageDescription\u0027] is None: imageData[\u0027imageDescription\u0027] \u003d \u0027\u0027 \n\t\tif imageData[\u0027imageName\u0027] is None: imageData[\u0027imageName\u0027] \u003d \u0027\u0027 \n\t\tif imageData[\u0027imageType\u0027] is None: imageData[\u0027imageType\u0027] \u003d \u0027\u0027 \n\t\tself.custom.imageData \u003d imageData\n\t\n\tif self.custom.imageData[\u0027imageId\u0027] is None and self.params.value.has_key(\u0027imageType\u0027):\n\t\tself.custom.imageData.imageType \u003d self.params.value.imageType or \u0027\u0027\n\t\n\treturn"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 511,
      "width": 456
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "component": {
                "onFileReceived": {
                  "config": {
                    "script": "\n\tlog \u003d system.util.getLogger(\"kanoaImage\")\n\tlog.info(\"onFileReceived event\")\n\n\tself.view.custom.gettingImage \u003d True\n\t\n\tfrom java.io import File\n\timport base64\n\t\n\tdirPath \u003d \"C:\\\\kanoaImages\"\n\tdirectory \u003d File(dirPath)\n\tif not directory.exists(): directory.mkdirs()\n\t\n\tfilePath \u003d \"%s\\\\%s\" % (dirPath, event.file.name)\t\n\t\n\tself.view.custom.imageData.image \u003d base64.b64encode(event.file.getBytes())\n\tself.view.custom.imageData.imageName \u003d event.file.name\n\n\tsystem.kanoa.file.deleteFile(filePath)\n\tevent.file.copyTo(filePath) #We\u0027ll store this file on the gateway so we can convert and create thumbnails\n\tself.view.custom.imageData.filePath \u003d filePath\t\t\n\tself.view.custom.gettingImage \u003d False\n\t\n\treturn\n"
                  },
                  "scope": "G",
                  "type": "script"
                },
                "onUploadsCleared": {
                  "config": {
                    "script": "\t\n\tself.view.getChild(\"root\").clearImageData()\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "FileUpload",
              "name": "FileUpload"
            },
            "position": {
              "grow": 1
            },
