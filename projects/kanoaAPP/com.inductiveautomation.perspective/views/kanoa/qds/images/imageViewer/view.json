    "scripts": {
      "customMethods": [
        {
          "name": "lookupImage",
          "params": [
            "searchNetwork"
          ],
          "script": "\t\n\tlookupImage \u003d self.view.params.lookupImage\n\tname \u003d lookupImage[\u0027name\u0027] or \u0027\u0027\n\tmachine \u003d lookupImage[\u0027machine\u0027] or None\n\ttype \u003d lookupImage[\u0027type\u0027]\n\timageId \u003d lookupImage[\u0027imageId\u0027]\n\tifpId \u003d lookupImage[\u0027ifpId\u0027]\n\timage, description, warn, camera, filePath \u003d [\u0027\u0027] * 5\n\t\n#\tsystem.perspective.print(\u0027lookupImage called\u0027)\n\t \n\tif name!\u003d \u0027\u0027:\n\t\tdata \u003d shared.AllHealth.database.ignCustom.getThumbnailByImageId(imageId)\n\t\tif data is not None: \n\t\t\timage \u003d data[\u0027image\u0027] \n\t\t\tdescription \u003d data[\u0027description\u0027]\n\t\t\tcamera \u003d data[\u0027camera\u0027]\n\t\t\tfilePath \u003d data[\u0027filePath\u0027]\n\t\telse:\n\t\t\tdata \u003d shared.AllHealth.database.ignCustom.getPartImageById(imageId)\n\t\t\tif data is not None:\n\t\t\t\timage \u003d data[\u0027image\u0027] \n\t\t\t\tdescription \u003d data[\u0027description\u0027] or \u0027\u0027\n\t\t\t\tcamera \u003d data[\u0027camera\u0027]\n\t\t\t\tfilePath \u003d data[\u0027filePath\u0027]\n\t\t\t\twarn \u003d \"No thumbnail found\"\n\t\t\telse:\n\t\t\t\tdescription \u003d \u0027No image found\u0027\n\t\t\t\twarn \u003d \u0027No image found\u0027\n\t\t\t\tcamera \u003d \u0027\u0027\n\n\tself.view.params.data[\u0027name\u0027] \u003d name\n\tself.view.params.data[\u0027description\u0027] \u003d description\t\n\tself.view.params.data[\u0027image\u0027] \u003d image\n\tself.view.params.data[\u0027imageId\u0027] \u003d imageId\n\tself.view.params.data[\u0027ifpId\u0027] \u003d ifpId\n\tself.view.params.data[\u0027type\u0027] \u003d type\n\tself.view.params.data[\u0027machine\u0027] \u003d machine\n\tself.view.params.data[\u0027camera\u0027] \u003d camera\n\tself.view.params.data[\u0027filePath\u0027] \u003d filePath\n\tself.getChild(\"lblWarn\").props.text \u003d warn\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "imageRenamed",
          "pageScope": true,
          "script": "\t\n\tsystem.perspective.print(\"imageRenamed() msg recd with payload %s\" %payload)\n\t#oldFilename is what mySQL says it is\n\t#newFileName is the actual filename. We just change the actualfilename in sql to be the mySql filename\n\n\tif payload[\u0027oldFileName\u0027] \u003d\u003d self.view.params.lookupImage.name:\n\t\tsystem.perspective.print(\u0027looking up image\u0027)\n\t\tself.lookupImage(False)",
          "sessionScope": false,
          "viewScope": false
        }
