    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\n\tself.view.custom.values.itemClassColor = payload['color']\n\n\treturn\n", 
          "messageType": "colorPicked", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\n\tif len(payload['selection']) == 0: return\n\t\n\tself.view.params.value.attributeId = payload['selection'][0]['value']['attributeId']\n\n\treturn", 
          "messageType": "updatePopupSelection", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo = dict(self.view.custom.values)\n\tattributeId = info['attributeId']\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif attributeId is None:\n\t\tif system.kanoa.utilities.getFieldValue('attributeId', system.kanoa.quality.config.getAttributes({'attributeName': info['attributeName'], 'parentId': info['parentId']})):\n\t\t\tsystem.perspective.sendMessage('showWarningToast', {'message': 'This attribute already exists'})\n\t\t\treturn\n\t\n\t\tattributeId = system.kanoa.quality.config.addAttribute(info, userId)\n\telse: system.kanoa.quality.config.updateAttribute(info, userId)\n\t\t\n\tself.view.params.value.attributeId = attributeId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshAttributes\", {})\n\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': 'Attribute saved'})\n\t\n\treturn", 
          "name": "save"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.currentTabIndex": {
      "binding": {
        "type": "expr", 
        "overlayOptOut": true, 
        "config": {
          "expression": "0"
        }
      }
    }, 
    "custom.canAdd": {
      "persistent": true
    }, 
    "custom.values": {
      "binding": {
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.quality.config.getAttributes({'attributeId': value or -1}), 0)", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value.attributeId"
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "onChange": {
        "enabled": null, 
        "script": "\t\n\tself.custom.canAdd = True\n\t\n\treturn"
      }, 
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.data": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn system.kanoa.quality.config.getAttributes({})", 
            "type": "script"
          }
        ], 
        "type": "expr", 
        "config": {
          "expression": "1"
        }
      }, 
      "persistent": true
    }, 
    "params.equipId": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.canSave": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn value.assetName != '' and not value.duplicate", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "duplicate": "{view.custom.customAttributes.duplicate}", 
            "assetName": "{view.custom.values.assetName}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }
  }
}