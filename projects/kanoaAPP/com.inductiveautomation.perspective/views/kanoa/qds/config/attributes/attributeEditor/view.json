                    "binding": {
                      "transforms": [
                        {
                          "code": "\t\n\treturn value is not None", 
                          "type": "script"
                        }
                      ], 
                      "type": "property", 
                      "config": {
                        "path": "view.custom.values.attributeId"
                      }
                    }
                  }
                }
              }, 
              {
                "type": "ia.input.button", 
                "props": {
                  "image": {
                    "icon": {
                      "color": "--kcPrimary", 
                      "path": "material/add"
                    }, 
                    "height": 30
                  }, 
                  "style": {
                    "classes": "kanoa/button/outlined"
                  }, 
                  "text": "Add"
                }, 
                "meta": {
                  "tooltip": {
                    "enabled": true, 
                    "location": "top", 
                    "text": "Clear the form to create a new Attribute"
                  }, 
                  "domId": "btnAdd", 
                  "name": "btnAdd"
                }, 
                "position": {
                  "shrink": 0
                }, 
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script", 
                      "scope": "G", 
                      "config": {
                        "script": "\n\tself.view.custom.values.parentId = self.view.custom.values.attributeId\n\tself.view.custom.values.path += '\\\\'\n\tself.view.custom.values.attributeId = None\n\tself.view.custom.values.attributeName = ''\n\tself.view.custom.values.attributeDescription = ''\n\tself.view.custom.canAdd = True = False\t#Don't allow the user to press 'Add' again until they have saved the latest one or selected another\n\t\t\n\treturn"
                      }
                    }
                  }
                }, 
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "type": "property", 
                      "overlayOptOut": true, 
                      "config": {
                        "path": "view.custom.canAdd"
                      }
                    }
                  }
                }
              }, 
              {
                "type": "ia.input.button", 
                "props": {
                  "image": {
                    "icon": {
                      "path": "material/save"
                    }, 
                    "height": 30
                  }, 
                  "style": {
                    "classes": "kanoa/button/filled"
                  }, 
                  "text": "Save"
                }, 
                "meta": {
                  "tooltip": {
                    "enabled": true, 
                    "location": "top", 
                    "text": "Save"
                  }, 
                  "domId": "btnSave", 
                  "name": "btnSave"
                }, 
                "position": {
                  "shrink": 0
                }, 
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script", 
                      "scope": "G", 
                      "config": {
                        "script": "\t\n\tself.view.getChild(\"root\").save()\n\t\n\treturn"
                      }
                    }
                  }
                }, 
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "transforms": [
                        {
                          "code": "\t\n\treturn value['attributeName'] != ''", 
                          "type": "script"
                        }
                      ], 
                      "type": "property", 
                      "overlayOptOut": true, 
                      "config": {
                        "path": "view.custom.values"
