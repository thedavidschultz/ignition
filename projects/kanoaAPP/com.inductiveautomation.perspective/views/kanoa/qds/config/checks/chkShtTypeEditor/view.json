    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"colorPicked message received with payload \" + str(payload))\n\n\tself.view.custom.values.itemClassColor = payload['color']\n\n\treturn\n", 
          "messageType": "colorPicked", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"refreshChkShtTypes msg rcvd by chkShtTypeEditor with %s\"%payload)\n\tself.view.refreshBinding(\"custom.data\")\n\n\treturn", 
          "messageType": "refreshChkShtTypes", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"updatePopupSelection msg rcvd with %s\"%payload)\n\t\n\tif len(payload['selection']) == 0: return\n\t\n\tself.view.params.value.chkShtTypeId = payload['selection'][0]['value']['chkShtTypeId']\n\n\treturn", 
          "messageType": "updatePopupSelection", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo = self.view.custom.values\n\tchkShtTypeId = info['chkShtTypeId']\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\t\n\tif chkShtTypeId is None:\n\t\tif system.kanoa.quality.sheet.getSheets({'chkShtTypeName': info['chkShtTypeName'], 'parentId': info['parentId']}).rowCount > 0:\n\t\t\tsystem.perspective.sendMessage('showWarningToast', {'message': 'This Type already exists'})\n\t\t\treturn\n\t\n\t\tchkShtTypeId = system.kanoa.quality.sheet.addSheetType(info, userId)\n\t\tmsg = 'Check Sheet Type added'\n\telse:\n\t\tsystem.kanoa.quality.sheet.updateSheetType(info, userId)\n\t\tmsg = 'Check Sheet Type updated'\n\t\t\n\tself.view.params.value.chkShtTypeId = chkShtTypeId\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\t\n\tsystem.perspective.sendMessage(\"refreshChkShtTypes\", {})\n\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': msg})\n\t\n\treturn", 
          "name": "save"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"delete() called\")\n\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tretVal, msg = system.kanoa.quality.sheet.deleteSheetType(self.view.params.value.chkShtTypeId, userId)\n\tif retVal == False:\n\t\tsystem.perspective.sendMessage('showFailerToast', {'message': msg})\n\telse:\n\t\tself.view.params.value.chkShtTypeId = None\n\t\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': msg})\t\t\n\n\tself.view.refreshBinding(\"custom.data\")\t #Update the Tree Selector\n\tsystem.perspective.sendMessage(\"refreshChkShtTypes\", {})\t\n\t\n\treturn", 
          "name": "delete"
        }
      ], 
      "extensionFunctions": null
    }
