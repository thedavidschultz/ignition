{
  "custom": {},
  "params": {
    "value": {
      "editMode": true,
      "txtOption": null,
      "txtType": null,
      "txtValue": null
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 45,
      "width": 173
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "txtValue",
          "name": "txtValue",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.txtValue"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn value or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\t\n\tif origin in (\u0027Browser\u0027, \u0027Script\u0027):\n\t\tpayload \u003d {\u0027text\u0027: currentValue.value, \u0027params\u0027: self.view.params.value}\n\t\tsystem.perspective.print(\"Sending msg pickListButton() with %s\"%payload)\n\t\tsystem.perspective.sendMessage(\u0027pickListButton\u0027, payload)\n\t\t\n\treturn"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--kcPrimaryContainer",
            "borderStyle": "none",
            "fontSize": "12px",
            "height": "100%",
            "textAlign": "center"
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n\tself.getSibling(\"txtValue\").props.text \u003d \u0027\u0027\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "icoDelete",
          "name": "icoDelete",
          "tooltip": {
            "enabled": true,
            "text": "Remove"
          }
        },
        "position": {
          "basis": "16px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "params": "{view.params.value}",
                  "txtValue": "{../txtValue.props.text}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\treturn value[\u0027params\u0027][\u0027editMode\u0027] and value[\u0027params\u0027][\u0027txtType\u0027] !\u003d \u0027Boolean\u0027 and value[\u0027txtValue\u0027] !\u003d \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "path": "material/close"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "align": "center",
        "backgroundColor": "--kcPrimaryContainer",
        "classes": "kanoa/button/flatIcon",
        "justify": "center"
      }
    },
    "type": "ia.container.flex"
  }
}