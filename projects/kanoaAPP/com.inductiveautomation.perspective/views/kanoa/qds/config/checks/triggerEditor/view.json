        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tif self.view.getChild(\"root\").saveData():\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, {\u0027message\u0027: \u0027Triggers updated\u0027})\n\telse: system.perspective.sendMessage(\u0027showFailerToast\u0027, {\u0027message\u0027: \u0027Triggers were not updated\u0027})\n\t\t\n\tsystem.perspective.sendMessage(\"triggerUpdate\", payload\u003d{})\t\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "top",
                "text": "Save"
              }
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "struct": {
                      "info": "{view.custom.info}",
                      "triggerTypeName": "{view.custom.triggerTypeName}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\t\n\tif value[\u0027info\u0027][\u0027triggerTypeId\u0027] is None: return False\n\t\n\ttriggerTypeName \u003d value[\u0027triggerTypeName\u0027]\n\tif triggerTypeName \u003d\u003d \u0027Mode Change\u0027: return True \t\t#don\u0027t need anything else\n\telif triggerTypeName \u003d\u003d \u0027Product Change\u0027:\treturn True\n\tif triggerTypeName \u003d\u003d \u0027Shift Change\u0027: return True\n\tif triggerTypeName \u003d\u003d \u0027Timed Interval\u0027: (self.view.custom.info.intervalMins or 0) \u003e 0\n\telif \u0027Count\u0027 in triggerTypeName: return (self.view.custom.info.productionCount or 0) \u003e 0\n\t\n\treturn True",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "enabled": true,
                "location": "top",
                "text": "Close"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxAction",
          "name": "flxAction"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "flex-start",
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "Label",
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "display": false
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.values"
              },
              "transforms": [
                {
                  "code": "\treturn str(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.label"
      }
    ],
    "custom": {
      "action": {
        "Create": true,
        "Delete": true,
        "Edit": true,
        "View": true
      },
      "viewName": "Check Sheet Editor",
      "viewPath": "Kanoa/Quality/Configuration/Checksheet"
    },
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface",
        "classes": "kanoa/font/default",
        "gap": "5px",
        "overflow": "hidden",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "saveData",
          "params": [],
          "script": "\t\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\ttriggerInfo \u003d dict(self.view.custom.info)\n\tchkShtTriggerId \u003d self.view.custom.info.chkShtTriggerId\n\t\n\tif chkShtTriggerId is None: \n\t\tchkShtTriggerId \u003d system.kanoa.quality.config.addChkShtTrigger(triggerInfo, userId)\n\t\tself.view.params.values.chkShtTriggerId \u003d chkShtTriggerId\n\t\tretVal \u003d 1 if (chkShtTriggerId or None) is not None else 0\n\telse: \n\t\tretVal \u003d system.kanoa.quality.config.updateChkShtTrigger(triggerInfo, userId)\n\t\tself.view.refreshBinding(\"custom.info\")\n\t\n\treturn retVal"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
    },
    "type": "ia.container.flex"
  }
}