{
  "custom": {
    "hasName": false, 
    "oldPath": "", 
    "createOptions": {}, 
    "unique": false, 
    "newPath": ""
  }, 
  "params": {
    "createModes": false, 
    "assetPath": "", 
    "createItems": false, 
    "createStates": false
  }, 
  "props": {
    "defaultSize": {
      "width": 350, 
      "height": 199
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5, 
        "backgroundColor": "--kcGray-0", 
        "gap": 5
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "marginBottom": 5
          }, 
          "text": "All check sheet names must be unique within its parent folder. Please update the current name.", 
          "textStyle": {
            "fontSize": "1.25em", 
            "fontWeight": "bold"
          }
        }, 
        "meta": {
          "domId": "lblInfo", 
          "name": "lblInfo"
        }, 
        "position": {
          "shrink": 0
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Name:", 
              "textStyle": {
                "fontSize": "1.15em", 
                "textAlignLast": "right", 
                "fontWeight": "bold"
              }
            }, 
            "meta": {
              "domId": "label", 
              "name": "label"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "deferUpdates": false
            }, 
            "meta": {
              "domId": "textBox", 
              "name": "textBox"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.name"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxName", 
          "name": "flxName"
        }, 
        "position": {
          "shrink": 0
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Parent Path:", 
              "textStyle": {
                "fontSize": "1.15em", 
                "textAlignLast": "right", 
                "fontWeight": "bold"
              }
            }, 
            "meta": {
              "domId": "label-1", 
              "name": "label"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "meta": {
              "domId": "textBox-1", 
              "name": "textBox"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.folder"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxParent", 
          "name": "flxParent"
        }, 
        "position": {
          "shrink": 0
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "gap": 10
          }
        }, 
        "children": [
          {
            "custom": {
              "name": "mode"
            }, 
            "type": "ia.input.checkbox", 
            "props": {
              "uncheckedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "checkedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "style": {
                "fontWeight": "bold"
              }, 
              "text": "Create Modes"
            }, 
            "meta": {
              "tooltip": {
                "tail": false, 
                "enabled": true, 
                "delay": 0, 
                "location": "top", 
                "sustain": 0
              }, 
              "domId": "cbxCreateModes", 
              "name": "cbxCreateModes"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\tname = self.custom.name\n\t\n\treturn 'If the %s can be created, then create it.'%name if value else 'Even if the %s can be created, do not create it.'%name", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "this.props.selected"
                  }
                }
              }, 
              "props.selected": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.createOptions.createModes"
                  }
                }
              }
            }
          }, 
          {
            "custom": {
              "name": "state"
            }, 
            "type": "ia.input.checkbox", 
            "props": {
              "uncheckedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "checkedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "style": {
                "fontWeight": "bold"
              }, 
              "text": "Create States"
            }, 
            "meta": {
              "tooltip": {
                "tail": false, 
                "enabled": true, 
                "delay": 0, 
                "location": "top", 
                "sustain": 0
              }, 
              "domId": "cbxCreateStates", 
              "name": "cbxCreateStates"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\tname = self.custom.name\n\t\n\treturn 'If the %s can be created, then create it.'%name if value else 'Even if the %s can be created, do not create it.'%name", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "this.props.selected"
                  }
                }
              }, 
              "props.selected": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.createOptions.createStates"
                  }
                }
              }
            }
          }, 
          {
            "custom": {
              "name": "item"
            }, 
            "type": "ia.input.checkbox", 
            "props": {
              "uncheckedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "checkedIcon": {
                "style": {
                  "marginRight": -6
                }
              }, 
              "style": {
                "fontWeight": "bold"
              }, 
              "text": "Create Items"
            }, 
            "meta": {
              "tooltip": {
                "tail": false, 
                "enabled": true, 
                "delay": 0, 
                "location": "top", 
                "sustain": 0
              }, 
              "domId": "cbxCreateItems", 
              "name": "cbxCreateItems"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\tname = self.custom.name\n\t\n\treturn 'If the %s can be created, then create it.'%name if value else 'Even if the %s can be created, do not create it.'%name", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "this.props.selected"
                  }
                }
              }, 
              "props.selected": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.createOptions.createItems"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxCreateOptions", 
          "name": "flxCreateOptions"
        }, 
        "position": {
          "shrink": 0, 
          "display": false
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "gap": 5, 
            "marginTop": "auto"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/check"
                }
              }, 
              "style": {
                "classes": "kanoa/button/filled"
              }, 
              "text": "Confirm"
            }, 
            "meta": {
              "tooltip": {
                "tail": false, 
                "enabled": true, 
                "delay": 0, 
                "location": "top", 
                "sustain": 0
              }, 
              "domId": "btmConfirm", 
              "name": "btmConfirm"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tif not self.view.custom.hasName: return\n\tif not self.view.custom.unique: return\n\t\n\tnewPath = self.view.custom.newPath\t\n\toldPath = self.view.custom.oldPath\n\t\n\tcreateModes = self.view.custom.createOptions.createModes\n\tcreateStates = self.view.custom.createOptions.createStates\n\tcreateItems = self.view.custom.createOptions.createItems\n\t\n\tsystem.perspective.sendMessage(\n\t\tmessageType = 'assetImportUpdate', \n\t\tpayload = { \n\t\t\t'oldPath': oldPath, \n\t\t\t'newPath': newPath, \n\t\t\t'createModes': createModes,\n\t\t\t'createStates': createStates,\n\t\t\t'createItems': createItems,\n\t\t}\n\t)\n\t\n\tsystem.perspective.closePopup('')\n\t"
                  }
                }
              }
            }, 
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\tif not value.hasName:\n\t\treturn 'There is no name for the asset.'\n\t\n\tif not value.unique:\n\t\treturn 'The name is not unique within the folder.'\n\t\n\treturn ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "expr-struct", 
                  "overlayOptOut": true, 
                  "config": {
                    "struct": {
                      "hasName": "{view.custom.hasName}", 
                      "unique": "{view.custom.unique}"
                    }, 
                    "waitOnAll": true
                  }
                }
              }, 
              "props.enabled": {
                "binding": {
                  "type": "expr", 
                  "config": {
                    "expression": "{view.custom.hasName} && {view.custom.unique}"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              }, 
              "style": {
                "classes": "kanoa/button/outlined"
              }, 
              "text": "Close", 
              "primary": false
            }, 
            "meta": {
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tsystem.perspective.closePopup('')\n\t"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxActions", 
          "name": "flxActions"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.createItems": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.createOptions.createModes": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.createModes"
        }
      }
    }, 
    "custom.oldPath": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.assetPath"
        }
      }, 
      "persistent": true
    }, 
    "custom.hasName": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tname = value or None\n\t\n\treturn name is not None\n\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.name"
        }
      }, 
      "persistent": true
    }, 
    "custom.createOptions.createItems": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.createItems"
        }
      }
    }, 
    "custom.newPath": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn '\\\\'.join(value.folder.split('\\\\') + [value.name]) if value.folder else value.name", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "folder": "{view.custom.folder}", 
            "name": "{view.custom.name}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "custom.folder": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\treturn '\\\\'.join(value.split('\\\\')[:-1])\n\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.oldPath"
        }
      }
    }, 
    "params.createStates": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.createOptions.createStates": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.createStates"
        }
      }
    }, 
    "params.assetPath": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.name": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\treturn value.split('\\\\')[-1]\n\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.oldPath"
        }
      }
    }, 
    "custom.unique": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tnewPath = value or None\n\t\n\tif newPath is None: return False\n\t\n\tunique = len(system.kanoa.asset.getAssets({'assetPath': newPath})) == 0\n\t\n\treturn unique\n\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.newPath"
        }
      }, 
      "persistent": true
    }, 
    "params.createModes": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}