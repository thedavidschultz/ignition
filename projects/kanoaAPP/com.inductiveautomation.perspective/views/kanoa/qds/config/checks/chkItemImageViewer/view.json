  "propConfig": {
    "custom.gettingImage": {
      "persistent": true
    },
    "custom.image": {
      "binding": {
        "config": {
          "path": "view.params.imageData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tself.custom.gettingImage \u003d True\n\timage \u003d system.kanoa.quality.config.getChkItemImage(value[\u0027chkItemImageId\u0027] or -1)\n\tself.custom.gettingImage \u003d False\n\treturn image",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.thumbnail": {
      "binding": {
        "config": {
          "path": "view.params.imageData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.quality.config.getChkItemImageThumbnail(value[\u0027chkItemImageId\u0027] or -1)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.b64Image": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.imageData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
