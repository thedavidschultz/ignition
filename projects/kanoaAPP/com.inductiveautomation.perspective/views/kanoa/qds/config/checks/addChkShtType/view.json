        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "alignItems": "center", 
          "justify": "center", 
          "style": {
            "padding": "5px", 
            "overflow": "hidden", 
            "gap": "5px"
          }, 
          "wrap": "wrap"
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              }, 
              "style": {
                "classes": "kanoa/button/filled", 
                "height": "30px"
              }, 
              "text": "Save"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "top-left", 
                "text": "Save"
              }, 
              "domId": "btnSave", 
              "name": "btnSave"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tself.view.getChild(\"root\").save()\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\treturn value['chkShtTypeName'] != ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.custom.values"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              }, 
              "style": {
                "classes": "kanoa/button/outlined", 
                "height": "30px"
              }, 
              "text": "Close"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "top-left", 
                "text": "Close"
              }, 
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  }
                }
              }
            }
          }
