    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"save() called\")\n\tinfo = dict(self.view.custom.values)\n\tchkShtTypeId = info['chkShtTypeId']\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tif self.view.params.value.action == 'add':\n\t\tif system.kanoa.quality.sheet.getSheets({'chkShtTypeName': info['chkShtTypeName'], 'parentId': info['parentId']}).rowCount > 0:\n\t\t\tsystem.perspective.sendMessage('showWarningToast', {'message': 'This Type already exists'})\n\t\t\treturn\n\t\n\t\tchkShtTypeId = system.kanoa.quality.sheet.addSheetType(info, userId)\n\telif self.view.params.value.action == 'edit':\n\t\tsystem.kanoa.quality.sheet.updateSheetType(info, userId)\n\telse:\n\t\treturn\n\t\t\n\tself.view.params.value.chkShtTypeId = chkShtTypeId\n\t\n\tsystem.perspective.sendMessage(\"refreshChkShtTypes\", {})\n\tsystem.perspective.sendMessage('showSuccessfulToast', {'message': 'Check Sheet Type saved'})\n\t\n\treturn", 
          "name": "save"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.values": {
      "binding": {
        "transforms": [
          {
            "code": "\tif value['action'] == 'edit':\n\t\tchkShtTypeInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.quality.sheet.getSheetTypes({'chkShtTypeId': value['chkShtTypeId'] or -1}), 0)\n\n\telif value['action'] == 'add':\n\t\tparentInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.quality.sheet.getSheetTypes({'chkShtTypeId': value['chkShtTypeId'] or -1}), 0)\n\t\tchkShtTypeInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.quality.sheet.getSheetTypes({'chkShtTypeId': -1}), 0)\n\t\t\n\t\tchkShtTypeInfo['path'] = parentInfo['path']\n\t\tchkShtTypeInfo['parentId'] = value['chkShtTypeId']\n\t\n\telse: return {}\n\t\n\tif chkShtTypeInfo['enabled'] is None: chkShtTypeInfo['enabled'] = True\n\t\n\treturn chkShtTypeInfo\n\t\t\n\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "onChange": {
        "enabled": null, 
        "script": "\t\n\tself.custom.canAdd = True\n\tif not self.params.value.chkShtTypeId: self.custom.clearSelection = True\n\t\n\treturn"
      }, 
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.equipId": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}