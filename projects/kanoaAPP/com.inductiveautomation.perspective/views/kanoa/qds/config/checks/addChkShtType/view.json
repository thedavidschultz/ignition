                "position": {
                  "shrink": 0, 
                  "basis": "80px"
                }
              }, 
              {
                "type": "ia.display.label", 
                "props": {
                  "style": {
                    "classes": "kanoa/inputs"
                  }
                }, 
                "meta": {
                  "domId": "lblColor", 
                  "name": "lblColor"
                }, 
                "position": {
