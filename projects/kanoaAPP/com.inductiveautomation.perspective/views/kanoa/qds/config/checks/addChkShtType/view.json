                  "dom": {
                    "onClick": {
                      "type": "script", 
                      "scope": "G", 
                      "config": {
                        "script": "\t\n\tsystem.perspective.openPopup(\"Color Picker\", \"kanoa/core/templates/colorPicker/main\", {}, overlayDismiss=True)\n\t\n\treturn"
                      }
                    }
                  }
                }, 
                "propConfig": {
                  "props.style.backgroundColor": {
                    "binding": {
                      "transforms": [
                        {
                          "code": "\t\n\treturn value or '#D5D5D5'", 
                          "type": "script"
                        }
                      ], 
                      "type": "property", 
                      "overlayOptOut": true, 
                      "config": {
                        "path": "view.custom.values.itemClassColor"
                      }
                    }
                  }
                }
              }
            ], 
            "meta": {
              "domId": "flxCntColor", 
              "name": "flxCntColor"
            }, 
            "position": {
