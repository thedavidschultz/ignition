    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tself.deleteItemSet()\n\t\n\treturn", 
          "messageType": "deleteItemSet", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\t\n#\tsystem.perspective.print(\"saveData called\")\n\t\t\n \titemSetInfo = system.kanoa.utilities.convertDatasetRowToJSON(self.view.custom.table.data, self.view.custom.table.selection.row)\n \tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user) \t\n \t\n \tif itemSetInfo['itemSetId']:\n\t\tretVal, msg = system.kanoa.quality.config.updateItemSet(itemSetInfo, userId)\n\telse:\n\t\tretVal, msg = system.kanoa.quality.config.addItemSet(itemSetInfo, userId)\n \t\n\tif retVal: system.perspective.sendMessage('showSuccessfulToast', {'message': msg})\n\telse: system.perspective.sendMessage('showFailerToast', {'message': msg})\n\t\n\tself.view.refreshBinding(\"custom.table.data\")\n\tsystem.perspective.sendMessage(\"refreshItemSets\", {})\n\t\n\treturn", 
          "name": "saveData"
        }, 
        {
          "params": [], 
          "script": "\t\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\n\tfor row in self.view.custom.table.selection.data:\n\t\tretVal, msg = system.kanoa.quality.config.deleteItemSet(row['itemSetId'], userId)\n\t\tif not retVal: system.perspective.sendMessage('showFailerToast', {'message': msg})\n\t\telse: system.perspective.sendMessage('showSuccessfulToast', {'message': msg})\n\n\tself.view.refreshBinding(\"custom.table.data\")\n\n\treturn\t\t\t", 
          "name": "deleteItemSet"
        }, 
        {
          "params": [], 
          "script": "\n#\t\"itemSetId\",\"itemSetName\",\"itemSetDescription\",\"enabled\",\"createdBy\",\"createdDate\",\"changedBy\",\"changedDate\"\n\tself.view.custom.table.data = system.dataset.addRow(self.view.custom.table.data, 0, [None, '','', False, None, None, None, None])\n\t\n\treturn", 
          "name": "addItemSet"
        }
      ], 
      "extensionFunctions": null
    }
