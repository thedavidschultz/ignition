{
  "custom": {
    "changeInfo": {
      "manifestChanged": null, 
      "project": null, 
      "changeId": null, 
      "changedDate": null, 
      "path": null, 
      "createdDate": null, 
      "createdBy": null, 
      "changedBy": null, 
      "name": null, 
      "action": null, 
      "comment": "", 
      "taskId": "", 
      "editCount": null, 
      "resourceType": null
    }
  }, 
  "params": {
    "values": {
      "changeIds": []
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 350, 
      "height": 359
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5, 
        "classes": "kanoa/container", 
        "overflow": "hidden", 
        "gap": 5
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Task Id"
            }, 
            "meta": {
              "domId": "label", 
              "name": "label"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "rejectUpdatesWhileFocused": false, 
              "style": {
                "classes": "kanoa/font/default kanoa/border"
              }
            }, 
            "meta": {
              "domId": "txtInput", 
              "name": "txtInput"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0, 
              "basis": "150px"
            }, 
            "events": {
              "system": {
                "onStartup": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\timport time\n\ttime.sleep(0.2)\n\tself.focus()"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.changeInfo.taskId"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "tooltip": {
            "enabled": true, 
            "location": "bottom", 
            "text": "This would be the id of the clickup task associated with this change. If you don't have a clickup task id, now would be a good time to create one."
          }, 
          "domId": "flxTask", 
          "name": "flxTask"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden", 
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "textAlign": "right", 
                "classes": "kanoa/font/default"
              }, 
              "text": "Project"
            }, 
            "meta": {
              "domId": "label-1", 
              "name": "label"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.dropdown", 
            "props": {
              "options": [
                {
                  "label": "kanoaCore", 
                  "value": "kanoaCore"
                }, 
                {
                  "label": "kanoaOPS", 
                  "value": "kanoaOPS"
                }, 
                {
                  "label": "kanoaQDS", 
                  "value": "kanoaQDS"
                }, 
                {
                  "label": "KANOA_SCRIPTS", 
                  "value": "KANOA_SCRIPTS"
                }, 
                {
                  "label": "kanoaMES", 
                  "value": "kanoaMES"
                }
              ]
            }, 
            "meta": {
              "domId": "ddProject", 
              "name": "ddProject"
            }, 
            "position": {
              "basis": "256px"
            }, 
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.changeInfo.project"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "tooltip": {
            "location": "bottom"
          }, 
          "domId": "flxProject", 
          "name": "flxProject"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "text": "Comment"
        }, 
        "meta": {
          "tooltip": {
            "enabled": true
          }, 
          "domId": "Label", 
          "name": "Label"
        }, 
        "position": {
          "basis": "32px"
        }, 
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn str(value)", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.values"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.input.text-area", 
        "props": {
          "rejectUpdatesWhileFocused": false
        }, 
        "meta": {
          "tooltip": {
            "enabled": true, 
            "text": "Add a comment about the nature of the change"
          }, 
          "domId": "TextArea", 
          "name": "TextArea"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.custom.changeInfo.comment"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "padding": "5px", 
            "overflow": "hidden", 
            "gap": "5px"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              }, 
              "style": {
                "classes": "kanoa/button/filled"
              }, 
              "text": "Save"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom-left"
              }, 
              "domId": "btnSave", 
              "name": "btnSave"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tself.view.getChild(\"root\").save()\n\t\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn str(value)", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.values"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              }, 
              "style": {
                "classes": "kanoa/button/outlined", 
                "marginLeft": "5px"
              }, 
              "text": "Close"
            }, 
            "meta": {
              "tooltip": {
                "enabled": true, 
                "location": "bottom-left", 
                "text": "Close"
              }, 
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "shrink": 0
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup('')\n\treturn"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxActions", 
          "name": "flxActions"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\tchangeInfo = dict(self.view.custom.changeInfo)\n\tuserName = self.session.props.auth.user.userName\n\t\n\tsystem.perspective.print(\"save() called by %s for %s\"%changeInfo)\t\n\t\n\tfor changeId in self.view.params.values.changeIds:\n\t\tsystem.kanoa.devOps.updateAppChangeField('taskId', changeInfo['taskId'] or None, changeId, userName)\n\t\tsystem.kanoa.devOps.updateAppChangeField('project', changeInfo['project'] or None, changeId, userName)\n\t\tsystem.kanoa.devOps.updateAppChangeField('comment', changeInfo['comment'] or None, changeId, userName)\n\t\t\n\tsystem.perspective.sendMessage(\"updateChanges\", {})\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn", 
          "name": "save"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.changeInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\tchangeId = value[0] if len(value) == 1 else -1\n\tchangeInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.devOps.getAppChanges({'changeId': changeId}),0)\n\tif changeInfo['taskId'] is None: changeInfo['taskId'] = ''\n\tif changeInfo['comment'] is None: changeInfo['comment'] = ''\n\t\n\treturn changeInfo", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.values.changeIds"
        }
      }, 
      "persistent": true
    }, 
    "params.values": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}