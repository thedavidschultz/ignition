{
  "custom": {}, 
  "params": {
    "data": {
      "featuredIcon": "material/4k", 
      "mainText": "Main Text", 
      "trailingIcon": "material/arrow_right", 
      "supportingText": ""
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 300, 
      "height": 53
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "space-between", 
      "style": {
        "borderColor": "--kcOutline", 
        "backgroundColorX": "--kcSurface", 
        "classes": "kanoa/clickable", 
        "paddingRight": 0, 
        "overflow": "hidden", 
        "paddingBottom": 3, 
        "borderWidth": "1px", 
        "gap": "5px", 
        "paddingTop": 3, 
        "borderStyle": "solid", 
        "paddingLeft": 8
      }
    }, 
    "children": [
      {
        "type": "ia.display.icon", 
        "meta": {
          "domId": "iconFeatured", 
          "name": "iconFeatured"
        }, 
        "position": {
          "basis": "30px"
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value is not \"\" or None: return True\n\treturn False", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.data.featuredIcon"
              }
            }
          }, 
          "props.path": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.data.featuredIcon"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "overflow": "hidden"
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodyLarge"
              }
            }, 
            "meta": {
              "domId": "lblMain", 
              "name": "lblMain"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "20px"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.data.mainText"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodyMedium", 
                "textOverflow": "ellipsis"
              }
            }, 
            "meta": {
              "domId": "lbSupporting", 
              "name": "lbSupporting"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "position.display": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\tif value is not None: return True\n\treturn False", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "config": {
                    "path": "view.params.data.supportingText"
                  }
                }
              }, 
              "props.textStyle.fontSize": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\tletterCount = len(value)\n\tif letterCount > 30: return 12\n\treturn 16\n\t\n\t\n\treturn letterCount", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "this.props.text"
                  }
                }
              }, 
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.data.supportingText"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxText", 
          "name": "flxText"
        }, 
        "position": {
          "grow": 1, 
          "basis": "200px"
        }
      }, 
      {
        "type": "ia.display.icon", 
        "meta": {
          "domId": "iconTrailing", 
          "name": "iconTrailing"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value is not None: return True\n\treturn False", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.data.trailingIcon"
              }
            }
          }, 
          "props.path": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.data.trailingIcon"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.data": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}