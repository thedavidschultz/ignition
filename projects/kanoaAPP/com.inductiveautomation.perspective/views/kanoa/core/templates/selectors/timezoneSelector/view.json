    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "text": "Timezone", 
          "textStyle": {
            "paddingLeft": "10px"
          }
        }, 
        "meta": {
          "domId": "lblTZ", 
          "name": "lblTZ"
        }, 
        "position": {
          "basis": "100px"
        }
      }, 
      {
        "type": "ia.input.dropdown", 
        "props": {
          "showClearIcon": true
        }, 
        "meta": {
          "domId": "dropdown", 
          "name": "dropdown"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.options": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn [{'label': row['name'], 'value': row} for row in value]", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.custom.timezones"
              }
            }
          }, 
          "props.value": {
            "binding": {
              "type": "property", 
              "config": {
                "bidirectional": true, 
                "path": "view.params.selection"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "events": {
    "system": {
      "onStartup": {
        "type": "script", 
        "scope": "G", 
        "config": {
          "script": "\tdef getTimezones():\n\t\t'''\n\t\t\tReturns a dataset of timezones (kanoaCore)\n\t\n\t\t\tArgs:\n\t\t\t\tNone\n\t\t\treturns:\n\t\t\t\tdataset: Columns: name (string), current_utc_offset (), is_currently_dst (boolean)\n\t\t\t\t\n\t\t\tUpdated:\n\t\t\t\tJZ - 8/9/2024: created\n\t\t'''\n\t\tdef parseTimeString(time):\n\t\t\tsign = time[0]\n\t\t\thours = time[1:3].replace('0', '')\n\t\t\tmins = time[4:6]\n\t\t\ttimeString = '-' if sign == '-' else ''\n\t\t\ttimeString += hours\n\t\t\ttimeString += '.5' if mins == '30' else '.0'\n\t\t\treturn float(timeString)\n\t\t\t\n\t\tdbName = system.kanoa.config.getDBName('core')\n\t\tdataset = system.dataset.toPyDataSet(system.db.runPrepQuery(\"SELECT * FROM sys.[time_zone_info]\", [], dbName))\n\t\treturn sorted([{'name': row['name'], 'UTCOffset': parseTimeString(row['current_utc_offset']), 'isDST': row['is_currently_dst']} for row in dataset], key=lambda x:x['name'])\n\tself.custom.timezones = getTimezones()"
        }
      }
    }
  }, 
  "propConfig": {
    "params.selection": {
      "paramDirection": "inout", 
      "persistent": true
    }, 
    "custom.timezones": {
      "persistent": true
    }
  }
