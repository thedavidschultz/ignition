    "scripts": {
      "customMethods": [
        {
          "name": "setRange",
          "params": [
            "selectedDateRange",
            "startDate",
            "endDate"
          ],
          "script": "\t\n\tif selectedDateRange not in (\u0027Custom\u0027, \u0027\u0027) and selectedDateRange is not None:\n\t\tclientTZOffset \u003d self.session.props.device.timezone.utcOffset\t\n\t\tstartDate, endDate \u003d self.getRelativeDateRange({\u0027selectedDateRange\u0027: selectedDateRange, \u0027clientOffset\u0027: clientTZOffset, \u0027assetId\u0027: self.view.params.assetId})\n\t\tself.view.params.startDate \u003d startDate\n\t\tself.view.params.endDate \u003d endDate\n\t\tsystem.perspective.print(\"storeDateRangeSelection() called wth %s by dateRangeSelectorCompact setRange() function\"%selectedDateRange)\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n\treturn"
        },
        {
          "name": "update",
          "params": [],
          "script": "\treturn\n\tsystem.perspective.print(\"dateRangeSelectorCompact update() called. Get dates from session properties\")\n\n\tdateRange \u003d system.kanoa.utilities.getStoredDateRange(self)\n\tselectedRange \u003d dateRange.selectedRange\n\tstartDate \u003d dateRange.startDate\n\tendDate \u003d dateRange.endDate\n\n\tif selectedRange is not None:\n\t\tself.view.params.selectedRange \u003d None\n\t\tself.view.params.selectedRange \u003d selectedRange\t\n\telse:\t\n\t\tself.view.params.startDate \u003d startDate\n\t\tself.view.params.endDate \u003d endDate\t\n\t\n\treturn"
        },
        {
          "name": "getRelativeDateRange",
          "params": [
            "paramsDict"
          ],
          "script": "\n\t\u0027\u0027\u0027\n\tReturn relative Date ranges (kanoaCore)\n\t\n\tArgs:\n\t    selectedRelativeRange: str, one of \u0027Last 24 Hours\u0027, \u0027Last 7 Days\u0027, \u0027Last 14 Days\u0027, \u0027Current Run\u0027\n\t    clientTZOffset: int, client timezone offset value in minutes (default: 0)\n\t    assetId: int, asset ID (default: 0)\n\tReturns:\n\t    startDate: datetime, start date and time\n\t    endDate: datetime, end date and time\n\t    \n\tUpdated:\n\t\tsr - 1/6/24 5:35pm Created\n\t\u0027\u0027\u0027\n\tclientOffset \u003d paramsDict[\u0027clientTZOffset\u0027] if paramsDict.has_key(\u0027clientTZOffset\u0027) and paramsDict[\u0027clientTZOffset\u0027] is not None else 0\n\tselectedRelativeRange \u003d paramsDict[\u0027selectedDateRange\u0027] if paramsDict.has_key(\u0027selectedDateRange\u0027) and paramsDict[\u0027selectedDateRange\u0027] is not None else \u0027\u0027\n\tassetId \u003d paramsDict[\u0027assetId\u0027] if paramsDict.has_key(\u0027assetId\u0027) and paramsDict[\u0027assetId\u0027] is not None else None\n\t\n\tgatewayOffSetMins \u003d system.kanoa.date.getGatewayTimeZoneOffsetMins()\n\ttzOffsetMins \u003d gatewayOffSetMins + int(clientOffset * 60.0)\n\tstartOfDay \u003d system.date.setTime(system.date.addMinutes(system.date.now(), tzOffsetMins), 0,0,0)\n\n\tend_time \u003d system.date.now()\n\n\tif selectedRelativeRange \u003d\u003d \u0027Last 24 Hours\u0027: start_time \u003d system.date.addDays(end_time, -1)\n\telif selectedRelativeRange \u003d\u003d \u0027Last 7 Days\u0027: start_time \u003d system.date.addDays(end_time, -7)\n\telif selectedRelativeRange \u003d\u003d \u0027Last 14 Days\u0027: start_time \u003d system.date.addDays(end_time, -14)\n\telif selectedRelativeRange \u003d\u003d \u0027Current Run\u0027:\n\t\tif assetId: \n\t\t\ttagPath \u003d system.kanoa.asset.getAssetTagPath({\u0027assetId\u0027: assetId})\n\t\t\tstart_time \u003d system.tag.read(tagPath + \u0027/Line/OEE/startDate\u0027).value if tagPath else end_time\n\t\telse:\n\t\t\tstart_time \u003d end_time\n\telse: raise ValueError(\"Invalid selectedRelativeRange: \" + selectedRelativeRange)\n\t\n\tif start_time is None: start_time \u003d end_time\n\treturn start_time, end_time"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
    },
    "type": "ia.container.flex"
  }
