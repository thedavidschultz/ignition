      "customMethods": [
        {
          "params": [
            "selectedRange", 
            "startDate", 
            "endDate"
          ], 
          "script": "\n\tsystem.perspective.print(\"setRange() called with %s clientTZ %s\" %(selectedRange, self.session.props.device.timezone.id))\t\n\n\tif selectedRange != 'Custom':\n\t\tstartDate, endDate = system.kanoa.date.getDateRange({'selectedDateRange': selectedRange, 'clientTZ': self.session.props.device.timezone.id})\n\t\n\tsystem.perspective.print(\"calling storeDateRangeSelection() with %s %s %s\"%(startDate, endDate, selectedRange))\n\t\n\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedRange)\n\tself.view.refreshBinding(\"custom.session\")\n\tsystem.perspective.sendMessage(\"dateRangeSessionChanged\", {})\n\t\n\treturn", 
          "name": "setRange"
        }
      ], 
