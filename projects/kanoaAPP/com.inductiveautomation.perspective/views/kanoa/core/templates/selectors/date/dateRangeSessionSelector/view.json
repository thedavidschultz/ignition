        "config": {
          "script": "\n\tsystem.perspective.print(\"Date Range Picker onStartup()\")\n\n\tdateRange = system.kanoa.utilities.getStoredDateRange(self)\n\tselectedRange = dateRange.selectedRange\n\tstartDate = dateRange.startDate\n\tendDate = dateRange.endDate\n\n\tsystem.perspective.print(\"datRangeSelectorCompact update(). Got %s from session properties\"%(dateRange))\t\n\t\t\t\n\tif selectedRange not in ('Custom', '') and selectedRange is not None:\n\t\tsystem.perspective.print(\"setting selectedRange to \" + str(selectedRange))\n\t\tself.view.custom.selectedRange = None\n\t\tself.view.custom.selectedRange = selectedRange\t\n\telse:\n\t\tsystem.perspective.print(\"setting dates to %s %s \"%(startDate, endDate))\n\t\tself.view.custom.startDate = startDate\n\t\tself.view.custom.endDate = endDate\t\n\t\n\treturn"
        }
      }
    }
