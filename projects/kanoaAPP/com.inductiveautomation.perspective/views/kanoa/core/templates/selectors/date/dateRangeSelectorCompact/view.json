        "propConfig": {
          "props.params.addValue": {
            "onChange": {
              "enabled": null, 
              "script": "\t\n\tincrement = currentValue.value\n\tif increment != 0:\n\t\tperiod = self.props.params.period\n\t\tstartDate = self.getSibling(\"dpStartDate\").props.value\n\t\tendDate = self.getSibling(\"dpEndDate\").props.value\n\t\t\n\t\tif period == 'Day':\n\t\t\tstartDate = system.date.addDays(startDate, increment)\n\t\t\tendDate = system.date.addDays(endDate, increment)\n\t\telif period == 'Week':\n\t\t\tstartDate = system.date.addWeeks(startDate, increment)\n\t\t\tendDate = system.date.addWeeks(endDate, increment)\n\t\telif period == 'Month':\n\t\t\tstartDate = system.date.addMonths(startDate, increment)\n\t\t\tendDate = system.date.addMonths(endDate, increment)\n\t\telif period == 'Year':\n\t\t\tstartDate = system.date.addYears(startDate, increment)\n\t\t\tendDate = system.date.addYears(endDate, increment)\n\t\t\t\t\t\t\n\t\tself.getSibling(\"dpStartDate\").props.value= startDate\n\t\tself.getSibling(\"dpEndDate\").props.value= endDate\n\t\t\n\t\tself.getSibling(\"ddDateRange\").props.value = 'Custom'\n\t\tself.props.params.addValue = 0"
            }
          }, 
          "meta.visible": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.enabled"
              }
