    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [
            "selectedDateRange", 
            "startDate", 
            "endDate"
          ], 
          "script": "\n\tif selectedDateRange not in ('Custom', '') and selectedDateRange is not None:\t\t\n\t\tclientTZ = self.session.props.device.timezone.id\n\t\tstartDate, endDate = system.kanoa.date.getDateRange({'selectedDateRange': selectedDateRange, 'clientTZ': clientTZ})\n\t\tself.view.params.startDate = startDate\n\t\tself.view.params.endDate = endDate\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedDateRange)\n\t\t\n\treturn", 
          "name": "setRange"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"dateRangeSelectorCompact update() called. Get dates from session properties\")\n\n\tdateRange = system.kanoa.utilities.getStoredDateRange(self)\n\tselectedRange = dateRange.selectedRange\n\tstartDate = dateRange.startDate\n\tendDate = dateRange.endDate\n\t\n\tsystem.perspective.print(\"getStoredDateRange returned %s %s %s\"%(selectedRange, startDate, endDate))\n\n\tif selectedRange is not None:\n\t\tself.view.params.selectedRange = selectedRange\t\n\t\tself.setRange(selectedRange, None, None)\n\telse:\t\n\t\tself.view.params.startDate = startDate\n\t\tself.view.params.endDate = endDate\t\n\t\n\treturn", 
          "name": "update"
        }
      ], 
      "extensionFunctions": null
    }
