{
  "custom": {
    "assetPath": null,
    "selectorId": "07720c74-b2ca-4d1e-a17e-3a2b99e5c78d"
  },
  "params": {
    "assetInfo": {
      "assetGroupColor": null,
      "assetGroupId": null,
      "assetGroupName": null,
      "assetId": null,
      "assetName": null,
      "assetPath": null,
      "assetTypeId": null,
      "assetTypeName": null,
      "assetTypePath": null,
      "displayPath": null,
      "enabled": null,
      "iconPath": null,
      "oeeEnabled": null,
      "parentId": null,
      "path": null,
      "processTypeId": null,
      "processTypeName": null,
      "sortOrder": null,
      "tagPath": null,
      "timeZone": null
    },
    "value": {
      "assetPath": null,
      "options": {
        "dragDrop": false,
        "expand": false,
        "multiSelect": false,
        "showBreadcrumb": true,
        "showClear": true,
        "showSelectedPath": false
      },
      "parentPathList": [],
      "persistent": false,
      "useSessionValue": false
    }
  },
  "propConfig": {
    "custom.assetPath": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "params": "{view.params.value}",
            "sessionCustomProps": "{session.custom.kanoa}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n#\tsystem.perspective.print(\"assetSelector assetPath change\")\n\tparams \u003d value[\u0027params\u0027]\n\tif not params.has_key(\u0027useSessionValue\u0027) or params[\u0027useSessionValue\u0027]: \n\t\tpage \u003d \u0027designer\u0027 if \u0027/\u0027 in value[\u0027page\u0027] else value[\u0027page\u0027]\n\t\tassetPath \u003d value[\u0027sessionCustomProps\u0027][page][\u0027selectors\u0027][\u0027assetPath\u0027]\n#\t\tsystem.perspective.print(\"session assetPath is %s\"%assetPath)\n\t\treturn assetPath\n\telif params.has_key(\u0027assetPath\u0027) and params[\u0027assetPath\u0027]: return params[\u0027assetPath\u0027]\n\t\n\treturn self.custom.assetPath",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.selectorId": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\treturn str(system.kanoa.utilities.getUUID())",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.assetPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027:value or \u0027None\u0027}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 32,
      "width": 545
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "evTreeSelector",
          "name": "evTreeSelector",
          "tooltip": {
            "location": "center-left"
          }
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.params.values.data": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tparamsDict \u003d {\u0027userId\u0027: userId, \u0027enabled\u0027: True}\n\n\tviewParams \u003d value\n\tif viewParams.has_key(\u0027parentPathList\u0027) and len(viewParams[\u0027parentPathList\u0027] or []) \u003e 0:\n\t\tassets \u003d system.kanoa.utilities.convertDatasetToJSON(system.kanoa.asset.getAssets({\u0027assetPathList\u0027: viewParams[\u0027parentPathList\u0027]}))\n\t\tassetPathList \u003d []\n\t\tfor asset in assets:\n\t\t\tif asset[\u0027assetTypeName\u0027].lower() in (\u0027enterprise\u0027, \u0027site\u0027, \u0027area\u0027): \tassetPathList.append(asset[\u0027assetPath\u0027] + \u0027%\u0027)\n\t\t\telse: assetPathList.append(asset[\u0027assetPath\u0027])\n\t\t\t\n\t\tparamsDict[\u0027assetPathList\u0027] \u003d assetPathList\n\t\n\treturn system.kanoa.asset.getAssets(paramsDict)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.params.values.options": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif not value.has_key(\u0027options\u0027):\n\t\toptions \u003d {\n\t\t\t\t\t\"dragDrop\": False,\n\t\t\t\t\t\"expand\": False,\n\t\t\t\t\t\"multiSelect\": False,\n\t\t\t\t\t\"showBreadcrumb\": True,\n\t\t\t\t\t\"showClear\": True,\n\t\t\t\t\t\"showSelectedPath\": False\n\t\t\t\t\t}\n\telse:\n\t\toptions \u003d dict(value[\u0027options\u0027])\n\t\n\t#If we are filtering for specifc assets, we can\u0027t use the breadcrumb as the user selection may not exist in the dataset\n\tif value.has_key(\u0027parentPathList\u0027) and len(value[\u0027parentPathList\u0027]) \u003e 0:\n\t\toptions[\u0027showBreadcrumb\u0027] \u003d False\n\t\toptions[\u0027showSelectedPath\u0027] \u003d True\n\t\n\treturn options",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.params.values.path": {
            "binding": {
              "config": {
                "path": "view.custom.assetPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.params.values.selectorId": {
            "binding": {
              "config": {
                "path": "view.custom.selectorId"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "selection": [],
            "values": {
              "msgHandler": "assetSelected",
              "selection": [],
              "style": {
                "iconColor": "",
                "iconPath": null,
                "tooltip": null
              },
              "treePath": "assetPath"
            }
          },
          "path": "kanoa/core/templates/selectors/tree/selector"
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "alignItems": "flex-start",
      "direction": "column",
      "justify": "center"
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "assetSelected",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"assetSelected msg rcvd with %s\"%payload)\n\tif payload[\u0027selectorId\u0027] is not None and payload[\u0027selectorId\u0027] !\u003d self.view.custom.selectorId: return\n\t\n\tif payload[\u0027activity\u0027] \u003d\u003d \u0027nodeSelected\u0027: \n\t\tassetPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 else None\n\t\tparams \u003d dict(self.view.params.value)\n\t\tif not (params.has_key(\u0027persistent\u0027) and params[\u0027persistent\u0027] \u003d\u003d False): system.kanoa.utilities.storeAssetPath(self, assetPath)\t\n\t\tself.view.custom.assetPath \u003d assetPath\n\t\n\tif payload[\u0027activity\u0027] \u003d\u003d \u0027nodeDropped\u0027: system.perspective.print(\u0027asset drag and drop done\u0027)\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "setAsset",
          "pageScope": true,
          "script": "\n\tif payload.has_key(\u0027assetPath\u0027): self.getChild(\"evTreeSelector\").props.params.values.path \u003d payload[\u0027assetPath\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}