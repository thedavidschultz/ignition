              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value is None: return False\n\tif value.has_key(\u0027showBreadcrumb\u0027) and value[\u0027showBreadcrumb\u0027]: return False\n\tif value.has_key(\u0027showSelectedPath\u0027): return value[\u0027showSelectedPath\u0027] \n\treturn True",
