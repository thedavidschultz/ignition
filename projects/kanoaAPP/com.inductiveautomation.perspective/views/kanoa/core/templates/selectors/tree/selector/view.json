    "scripts": {
      "customMethods": [
        {
          "name": "clearSelection",
          "params": [],
          "script": "\n\tself.view.custom.selection \u003d []\n\tself.view.custom.path \u003d \u0027\u0027\n\tsystem.perspective.sendMessage(self.view.params.values.msgHandler, {\u0027selection\u0027:[], \u0027activity\u0027: \u0027nodeSelected\u0027, \u0027selectorId\u0027: self.view.custom.selectorId})\n\t\n\treturn"
        },
        {
          "name": "sendUpdate",
          "params": [
            "payload"
          ],
          "script": "\n#\tsystem.perspective.print(\u0027sendUpdate calling with view msgHandler: %s\u0027%(payload))\n\tselection \u003d [{\u0027value\u0027: item[\u0027value\u0027]} for item in payload[\"selection\"]]\n\tif self.view.custom.params.msgHandler:\n\t\tsystem.perspective.sendMessage(self.view.custom.params.msgHandler, {\u0027activity\u0027: payload[\u0027activity\u0027], \u0027selection\u0027: selection, \u0027msgHandler\u0027: payload[\"msgHandler\"], \u0027selectorId\u0027: payload[\"selectorId\"]})\n\n\tself.view.custom.selection \u003d selection\n\tself.view.custom.path \u003d selection[0][\u0027value\u0027][self.view.custom.params.treePath] if len(selection) else \u0027\u0027\n\t\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateSelection",
          "pageScope": true,
          "script": "\t\n\tif payload.has_key(\u0027selectorId\u0027) and self.view.custom.selectorId \u003d\u003d payload[\u0027selectorId\u0027]: \n\t\tsystem.perspective.print(\u0027updateSelection() msg rcvd by %s with payload: %s\u0027%(self.view.params.values.msgHandler, payload))\t\t\n\t\tself.sendUpdate(payload)\n\t\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "clearSelection",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"clearSelection() msg rcvd by treeSelector with payload %s\"%payload)\n\tif payload.has_key(\u0027selectorId\u0027) and self.view.custom.selectorId \u003d\u003d payload[\u0027selectorId\u0027]: self.clearSelection()\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "breadCrumbSelected",
          "pageScope": true,
          "script": "\t\n#\tsystem.perspective.print(\"breadCrumbSelected msg handler rcvd with %s\"%payload)\n#\tsystem.perspective.print(\"self.view.custom.selectorId is %s\"%self.view.custom.selectorId)\n\tif payload.has_key(\u0027selectorId\u0027) and self.view.custom.selectorId \u003d\u003d payload[\u0027selectorId\u0027]: self.sendUpdate(payload)\n#\telse: system.perspective.print(\u0027breadCrumbSelected but not fired for targeted selector\u0027)\n\t\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
