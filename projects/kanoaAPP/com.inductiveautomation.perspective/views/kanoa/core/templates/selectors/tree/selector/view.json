  "propConfig": {
    "custom.display": {
      "binding": {
        "config": {
          "path": "view.custom.selection"
        },
        "transforms": [
          {
            "code": "\tif len(value) \u003d\u003d 0: return \u0027\u0027\n\treturn \", \".join([element[\u0027value\u0027][self.custom.params.treePath] for element in value])",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.params": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tparams \u003d dict(value)\n\tif not params.has_key(\u0027msgHandler\u0027): params[\u0027msgHandler\u0027] \u003d None\n\tif not params.has_key(\u0027treePath\u0027) or params[\u0027treePath\u0027] is None: params[\u0027treePath\u0027] \u003d \u0027path\u0027\n\tif not params.has_key(\u0027options\u0027): params[\u0027options\u0027] \u003d {\"expand\": False, \"multiSelect\": False, \"showBreadcrumb\": True, \"dragDrop\": False}\n\telse: params[\u0027options\u0027] \u003d dict(params[\u0027options\u0027])\n\tif not params[\u0027options\u0027].has_key(\u0027expand\u0027): params[\u0027options\u0027][\u0027expand\u0027] \u003d False\n\tif not params[\u0027options\u0027].has_key(\u0027multiSelect\u0027): params[\u0027options\u0027][\u0027multiSelect\u0027] \u003d False\n\tif not params[\u0027options\u0027].has_key(\u0027showBreadcrumb\u0027): params[\u0027options\u0027][\u0027showBreadcrumb\u0027] \u003d True\n\tif not params[\u0027options\u0027].has_key(\u0027dragDrop\u0027): params[\u0027options\u0027][\u0027dragDrop\u0027] \u003d False\n\tif not params[\u0027options\u0027].has_key(\u0027showClear\u0027): params[\u0027options\u0027][\u0027showClear\u0027] \u003d True\n\t\n\tif params[\u0027options\u0027][\u0027showBreadcrumb\u0027]: params[\u0027options\u0027][\u0027multiSelect\u0027] \u003d False\n\t\n\treturn params",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\n#\tsystem.perspective.print(\"selector params change script called\")\t\n\tparams \u003d self.custom.params\n\t\n\tif params is None: return\n\tif not params.has_key(\u0027data\u0027) or params[\u0027data\u0027] is None or params[\u0027data\u0027].rowCount \u003d\u003d 0: return\t#system.perspective.print(\"Data not set. Exiting\")\t\n\tif not params.has_key(\u0027path\u0027): return # system.perspective.print(\"No path. Exiting\")\n\t\t\n\ttry:\n\t\tif currentValue.value[\u0027path\u0027].value is None: self.custom.setPath \u003d True\n\t\telif currentValue.value[\u0027path\u0027].value !\u003d previousValue.value[\u0027path\u0027].value:\tself.custom.setPath \u003d False\n\texcept:\n\t\tself.custom.setPath \u003d False\n\t\t\n\tif self.custom.setPath: return\t#Prevent flooding system.perspective.print(\"setPath is true. Exiting\")\t\n\t\n#\tsystem.perspective.print(\"selector params change script called with %s\"%params)\t\n\tif params[\u0027path\u0027]:\n\t\tparamsData \u003d system.kanoa.utilities.convertDatasetToDict(params[\u0027data\u0027], str(params[\u0027treePath\u0027]), None)\n\t\tif paramsData.has_key(params[\u0027path\u0027]):\t#Might be set to a value that is not selectable and not passed in the dataset\n\t\t\tpayload \u003d {\u0027activity\u0027: \u0027nodeSelected\u0027, \u0027selection\u0027: [{\u0027value\u0027: paramsData[params[\u0027path\u0027]]}], \u0027msgHandler\u0027: params[\"msgHandler\"], \u0027selectorId\u0027: self.custom.selectorId}\n\t\t\tself.getChild(\"root\").sendUpdate(payload)\n\telse:\n#\t\tsystem.perspective.print(\"Clearing selection\")\t\t\n\t\tself.custom.selection \u003d []\n\t\tself.custom.path \u003d None\n\t\t\n\tself.custom.setPath \u003d True\t#Prevent flooding\n\t\t\n\treturn"
      },
      "persistent": true
    },
    "custom.selection": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\treturn []",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.selectorId": {
      "binding": {
        "config": {
          "path": "view.params.values"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn value[\u0027selectorId\u0027] if (value.has_key(\u0027selectorId\u0027) and value[\u0027selectorId\u0027] is not None) else str(system.kanoa.utilities.getUUID())",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.setPath": {
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
