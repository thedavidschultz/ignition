{
  "custom": {}, 
  "params": {
    "selection": 1
  }, 
  "props": {
    "defaultSize": {
      "width": 342, 
      "height": 30
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "center", 
      "style": {
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden"
          }
        }, 
        "children": [
          {
            "type": "ia.input.radio-group", 
            "props": {
              "index": 1, 
              "selectedIcon": {
                "style": {
                  "width": 15
                }
              }, 
              "radios": [
                {
                  "text": "Show All", 
                  "value": -1, 
                  "selected": false
                }, 
                {
                  "text": "Show Enabled", 
                  "value": 1, 
                  "selected": true
                }, 
                {
                  "text": "Show Disabled", 
                  "value": 0, 
                  "selected": false
                }
              ], 
              "style": {
                "classes": "kanoa/font/default"
              }, 
              "unselectedIcon": {
                "style": {
                  "width": 15
                }
              }
            }, 
            "meta": {
              "domId": "chkOptions", 
              "name": "chkOptions"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.params.selection"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxContainer", 
          "name": "flxContainer"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.selection": {
      "paramDirection": "inout", 
      "persistent": true
    }
  }
}