{
  "custom": {}, 
  "params": {
    "enabled": true, 
    "disabled": false
  }, 
  "props": {
    "defaultSize": {
      "width": 250, 
      "height": 30
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "center", 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "hidden"
          }
        }, 
        "children": [
          {
            "type": "ia.input.checkbox", 
            "props": {
              "checkedIcon": {
                "color": {
                  "enabled": "--kcGray-60"
                }
              }, 
              "style": {
                "classes": "kanoa/font/default"
              }, 
              "text": "Show Enabled", 
              "selected": true
            }, 
            "meta": {
              "domId": "chkEnabled", 
              "name": "chkEnabled"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0
            }
          }, 
          {
            "type": "ia.input.checkbox", 
            "props": {
              "checkedIcon": {
                "color": {
                  "enabled": "--kcGray-60"
                }
              }, 
              "style": {
                "classes": "kanoa/font/default"
              }, 
              "text": "Show Disabled"
            }, 
            "meta": {
              "domId": "chkDisabled", 
              "name": "chkDisabled"
            }, 
            "position": {
              "grow": 1, 
              "shrink": 0
            }
          }
        ], 
        "meta": {
          "domId": "FlexContainer", 
          "name": "FlexContainer"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.enabled": {
      "binding": {
        "type": "property", 
        "config": {
          "path": "/root/FlexContainer/chkEnabled.props.selected"
        }
      }, 
      "paramDirection": "output", 
      "persistent": true
    }, 
    "params.disabled": {
      "binding": {
        "type": "property", 
        "config": {
          "path": "/root/FlexContainer/chkDisabled.props.selected"
        }
      }, 
      "paramDirection": "output", 
      "persistent": true
    }
  }
}