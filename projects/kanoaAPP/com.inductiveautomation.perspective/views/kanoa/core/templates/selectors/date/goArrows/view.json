{
  "custom": {},
  "params": {
    "addValue": -1,
    "period": "Week"
  },
  "propConfig": {
    "params.addValue": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.period": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 175
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n\tself.view.params.addValue \u003d -1"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "icoLeft",
          "name": "icoLeft",
          "tooltip": {
            "delay": 0,
            "enabled": true,
            "location": "top",
            "tail": false
          }
        },
        "position": {
          "basis": "30px"
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "struct": {
                  "label": "{../ddGoPeriod.props.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\n\tif value[\u0027label\u0027] is None: return \u0027\u0027\n\treturn \u0027Decrement \u0027 + value[\u0027label\u0027].lower()",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "color": "--kcGray-60",
          "path": "material/skip_previous"
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "domId": "ddGoPeriod",
          "name": "ddGoPeriod"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.period"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default",
            "textAlign": "center"
          },
          "options": [
            {
              "label": "Day",
              "value": "Day"
            },
            {
              "label": "Week",
              "value": "Week"
            },
            {
              "label": "Month",
              "value": "Month"
            },
            {
              "label": "Year",
              "value": "Year"
            }
          ],
          "search": {
            "enabled": false
          },
          "style": {
            "classes": "kanoa/font/default",
            "height": 25,
            "textAlign": "center"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n\tself.view.params.addValue \u003d 1"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "icoRight",
          "name": "icoRight",
          "tooltip": {
            "delay": 0,
            "enabled": true,
            "location": "top",
            "tail": false
          }
        },
        "position": {
          "basis": "30px"
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "struct": {
                  "label": "{../ddGoPeriod.props.value}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tif value[\u0027label\u0027] is None: return \u0027\u0027\n\treturn \u0027Increment \u0027 + value[\u0027label\u0027].lower()",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "color": "--kcGray-60",
          "path": "material/skip_next"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "space-evenly",
      "style": {
        "backgroundColor": "--kcSurface",
        "gap": 5,
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}