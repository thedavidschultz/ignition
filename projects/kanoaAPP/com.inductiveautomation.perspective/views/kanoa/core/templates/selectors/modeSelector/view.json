{
  "custom": {}, 
  "params": {
    "modeType": null, 
    "selectedMode": "Production"
  }, 
  "props": {
    "defaultSize": {
      "width": 400, 
      "height": 30
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "children": [
      {
        "type": "ia.input.dropdown", 
        "props": {
          "showClearIcon": true, 
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default"
          }, 
          "options": {
            "$": [
              "ds", 
              192, 
              1603728352620
            ], 
            "$columns": [
              {
                "data": [
                  "All", 
                  "Idle", 
                  "Setup", 
                  "Changeover", 
                  "Production", 
                  "Maintenance", 
                  "Cleaning"
                ], 
                "type": "String", 
                "name": "Mode"
              }
            ]
          }, 
          "style": {
            "classes": "kanoa/font/default"
          }, 
          "placeholder": {
            "text": "Select Mode..."
          }, 
          "value": "Production"
        }, 
        "meta": {
          "domId": "dropdown", 
          "name": "dropdown"
        }, 
        "position": {
          "grow": 1, 
          "basis": "36px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.modeType": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.selectedMode": {
      "binding": {
        "type": "property", 
        "config": {
          "bidirectional": true, 
          "path": "/root/dropdown.props.value"
        }
      }, 
      "paramDirection": "inout", 
      "persistent": true
    }
  }
