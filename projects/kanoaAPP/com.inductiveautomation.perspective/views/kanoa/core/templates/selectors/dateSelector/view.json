  "propConfig": {
    "custom.dateCheckOK": {
      "binding": {
        "config": {
          "struct": {
            "endDate": "{view.params.endDate}",
            "startDate": "{view.params.startDate}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn False if value[\u0027startDate\u0027] \u003c value[\u0027endDate\u0027] else True",
