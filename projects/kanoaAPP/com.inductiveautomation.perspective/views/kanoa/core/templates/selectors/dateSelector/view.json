          }
        ],
        "meta": {
          "domId": "flxAutoRefresh",
          "name": "flxAutoRefresh"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "session": "{view.custom.session}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tshowAutoRefresh \u003d True if not value[\u0027session\u0027][\u0027display\u0027].has_key(\u0027showAutoRefresh\u0027) else value[\u0027session\u0027][\u0027display\u0027][\u0027showAutoRefresh\u0027]\t\n\treturn (value[\u0027session\u0027][\u0027oeeEnabled\u0027] or False) and showAutoRefresh and value[\u0027session\u0027][\u0027dateRange\u0027][\u0027selectedRange\u0027] in (\u0027Current Run\u0027, \u0027Current Shift\u0027)\n\t\n\t",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "alignItems": "center",
