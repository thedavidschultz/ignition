      }
    ],
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "location": "bottom"
      }
    },
    "props": {
      "alignItems": "flex-start",
      "style": {
        "backgroundColor": "tranparent",
        "classes": "kanoa/font/default",
        "gap": "5px",
        "overflow": "hidden",
        "padding": "2px"
      },
      "wrap": "wrap"
    },
    "scripts": {
      "customMethods": [
        {
          "name": "setRange",
          "params": [
            "selectedRange",
            "startDate",
            "endDate"
          ],
          "script": "\n#\tsystem.perspective.print(\"setRange() called with %s %s %s\" %(selectedRange, startDate, endDate))\t\n\n\tif selectedRange !\u003d \u0027Custom\u0027:\n\t\tassetPath \u003d self.view.custom.session[\u0027assetPath\u0027] if self.view.custom.session.has_key(\u0027assetPath\u0027) else None\n\t\tparamsDict \u003d {\u0027assetPath\u0027: assetPath, \u0027selectedDateRange\u0027: selectedRange, \u0027clientTZ\u0027: self.session.props.device.timezone.id}\n\t\tstartDate, endDate \u003d system.kanoa.date.getDateRange(paramsDict)\n#\t\tsystem.perspective.print(\"getDateRange() called with %s returned %s %s\"%(paramsDict, startDate, endDate))\n\t\n\tif self.view.params.value.display.has_key(\u0027persistent\u0027) and not self.view.params.value.display[\u0027persistent\u0027]:\n#\t\tsystem.perspective.print(\"Setting local dates to %s %s as this is not persistent\"%(startDate, endDate))\n\t\tself.view.custom.session.dateRange.startDate \u003d startDate\n\t\tself.view.custom.session.dateRange.endDate \u003d endDate\n\telse:\n#\t\tsystem.perspective.print(\"storeDateRangeSelection() called with %s %s\"%(startDate, endDate))\n\t\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, selectedRange)\n\t\tself.view.refreshBinding(\"custom.session\")\n\t\tsystem.perspective.sendMessage(\"dateRangeSessionChanged\", {})\n\t\n\treturn"
        },
        {
          "name": "incrementRange",
          "params": [
            "increment"
          ],
          "script": "\n\tif increment !\u003d 0:\n\t\tperiod \u003d self.view.custom.period\n\t\tstartDate \u003d self.view.custom.session.dateRange.startDate\n\t\tendDate \u003d self.view.custom.session.dateRange.endDate\n\t\t\n\t\tif period \u003d\u003d \u0027Day\u0027:\n\t\t\tstartDate \u003d system.date.addDays(startDate, increment)\n\t\t\tendDate \u003d system.date.addDays(endDate, increment)\n\t\telif period \u003d\u003d \u0027Week\u0027:\n\t\t\tstartDate \u003d system.date.addWeeks(startDate, increment)\n\t\t\tendDate \u003d system.date.addWeeks(endDate, increment)\n\t\telif period \u003d\u003d \u0027Month\u0027:\n\t\t\tstartDate \u003d system.date.addMonths(startDate, increment)\n\t\t\tendDate \u003d system.date.addMonths(endDate, increment)\n\t\telif period \u003d\u003d \u0027Year\u0027:\n\t\t\tstartDate \u003d system.date.addYears(startDate, increment)\n\t\t\tendDate \u003d system.date.addYears(endDate, increment)\n\t\t\t\t\t\t\n#\tsystem.perspective.print(\"calling storeDateRangeSelection() with %s %s %s\"%(startDate, endDate, selectedRange))\n\tsystem.kanoa.utilities.storeDateRangeSelection(self, startDate, endDate, \u0027Custom\u0027)\n\tself.view.refreshBinding(\"custom.session\")\n\tsystem.perspective.sendMessage(\"dateRangeSessionChanged\", {})\n\t\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateDateSelector",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"updateDateSelector() msg rcvd with %s\"%payload)\n\tselectedRange \u003d payload[\u0027selectedRange\u0027] if payload.has_key(\u0027selectedRange\u0027) and payload[\u0027selectedRange\u0027] else self.view.params.dates.selectedRange\t\n\tself.setRange(selectedRange, None, None)\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}