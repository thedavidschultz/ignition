    "custom.period": {
      "persistent": true
    },
    "custom.session": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tpage \u003d \u0027designer\u0027 if \u0027/\u0027 in value[\u0027page\u0027] else value[\u0027page\u0027]\n\tinfo \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tinfo[\u0027oeeEnabled\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027oeeEnabled\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: info[\u0027assetPath\u0027]}))\n\t\n\treturn info",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\t\t\n\tif self.custom.session is None: return\n\tif not self.custom.session.has_key(\u0027dateRange\u0027): return\n\t\n\tdateParams \u003d self.custom.session.dateRange\n\t\n\tif dateParams[\u0027startDate\u0027] is None and dateParams[\u0027endDate\u0027] is None: self.getChild(\"root\").setRange(dateParams[\u0027selectedRange\u0027], dateParams[\u0027startDate\u0027], dateParams[\u0027endDate\u0027])\n\telse: self.params.dates \u003d {\u0027startDate\u0027: dateParams[\u0027startDate\u0027], \u0027endDate\u0027: dateParams[\u0027endDate\u0027], \u0027selectedRange\u0027: dateParams[\u0027selectedRange\u0027]}\n\t\n\treturn"
      },
      "persistent": true
    },
    "custom.timer": {
      "persistent": true
    },
    "custom.timer.enabled": {
      "binding": {
        "config": {
          "struct": {
            "autoRefresh": "{view.custom.timer.autoRefresh}",
            "display": "{view.params.value.display}",
            "selectedRange": "{view.custom.session.dateRange.selectedRange}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\t\n\treturn value[\u0027autoRefresh\u0027] and value[\u0027display\u0027].has_key(\u0027showAutoRefresh\u0027) and value[\u0027display\u0027][\u0027showAutoRefresh\u0027] and value[\u0027selectedRange\u0027] in (\u0027Current Run\u0027, \u0027Current Shift\u0027)\n\t\n\t",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.timer.timeNow": {
      "binding": {
        "config": {
          "expression": "now(30000)"
        },
        "transforms": [
          {
            "code": "\t\n#\tsystem.perspective.print(\"timer timeNow\")\n\t\n\tlastUpdated \u003d self.custom.timer.timeNow\n\tif not self.custom.timer.enabled: return system.date.now() #\t\tsystem.perspective.print(\"timer disabled\")\n\tif lastUpdated is None: return system.date.now() #\t\tsystem.perspective.print(\"lastUpdated is None\")\n#\tsystem.perspective.print(\"Checking time between %s %s %s %s\"%(lastUpdated, value, self.custom.timer.intervalMin, system.date.minutesBetween(lastUpdated, value)))\n\tif system.date.minutesBetween(lastUpdated, value) \u003c self.custom.timer.intervalMin: return lastUpdated #\t\tsystem.perspective.print(\"Not time yet %s\"%value)\n\t\n#\tsystem.perspective.print(\"Calling setRange() called with %s %s %s\" %(self.custom.session.dateRange.selectedRange, None, None))\n\tself.getChild(\"root\").setRange(self.custom.session.dateRange.selectedRange, None, None)\n\t\n\treturn system.date.now()",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.dates": {
      "paramDirection": "output",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
