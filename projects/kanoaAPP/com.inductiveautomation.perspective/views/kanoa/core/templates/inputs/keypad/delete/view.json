{
  "custom": {}, 
  "params": {
    "text_style": {
      "fontSize": 32, 
      "fontWeight": "bold"
    }, 
    "button_text": "DEL"
  }, 
  "props": {
    "defaultSize": {
      "width": 75, 
      "height": 75
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.button", 
        "props": {
          "style": {
            "backgroundColor": "--kcTertiaryContainer", 
            "color": "--kcOnTertiaryContainer", 
            "classes": "kanoa/button/flat"
          }
        }, 
        "meta": {
          "domId": "btnDelete", 
          "name": "btnDelete"
        }, 
        "position": {
          "grow": 1, 
          "basis": "50px"
        }, 
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\tsystem.perspective.sendMessage('keypad', payload={'value':self.props.text})"
              }
            }
          }
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.button_text"
              }
            }
          }, 
          "props.textStyle": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.text_style"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.button_style.borderRadius": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.style.button_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.button_style.backgroundColor": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.button_style": {
      "paramDirection": "inout", 
      "persistent": true
    }, 
    "params.button_text": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.text_style.fontSize": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.text_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.text_style.fontWeight": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.style.text_style": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.button_style.borderWidth": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}