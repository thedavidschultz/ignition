{
  "custom": {}, 
  "params": {
    "data": null
  }, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "text": "Select the type of pet:"
        }, 
        "meta": {
          "domId": "lblTitle", 
          "name": "lblTitle"
        }, 
        "position": {
          "basis": "32px"
        }
      }, 
      {
        "type": "ia.input.dropdown", 
        "props": {
          "options": [
            {
              "label": "Dog", 
              "value": "Dog"
            }, 
            {
              "label": "Cat", 
              "value": "Cat"
            }
          ]
        }, 
        "meta": {
          "domId": "ddAnimals", 
          "name": "ddAnimals"
        }, 
        "position": {
          "basis": "36px"
        }, 
        "propConfig": {
          "props.value": {
            "persistent": false
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.data": {
      "binding": {
        "transforms": [
          {
            "code": "\tvalue = value or ''\n\tif value != '':\n\t\tself.params.data.fields.type.value = value\n\treturn self.params.data", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "/root/ddAnimals.props.value"
        }
      }, 
      "paramDirection": "inout", 
      "persistent": true
    }
  }
}