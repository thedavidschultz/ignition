{
  "custom": {}, 
  "params": {
    "stepTitle": "", 
    "index": 1, 
    "selected": ""
  }, 
  "props": {
    "defaultSize": {
      "width": 50, 
      "height": 82
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": ""
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "cursor": "pointer", 
            "borderRadius": "50%"
          }, 
          "textStyle": {
            "textAlign": "center", 
            "fontSize": "20px"
          }
        }, 
        "meta": {
          "domId": "lblStepNo", 
          "name": "lblStepNo"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "50px"
        }, 
        "events": {
          "dom": {
            "onClick": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"traverseWizard\", payload={\"newIndex\": self.view.params.index})"
              }
            }
          }
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn \"black\" if value else \"white\"", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.selected"
              }
            }
          }, 
          "props.textStyle.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn \"white\" if value else \"black\"", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.selected"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn int(value) + 1", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.index"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "cursor": "pointer"
          }, 
          "textStyle": {
            "textAlign": "center", 
            "fontSize": "12px"
          }
        }, 
        "meta": {
          "domId": "lblStep", 
          "name": "lblStep"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }, 
        "events": {
          "dom": {
            "onClick": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\tsystem.perspective.sendMessage(\"traverseWizard\", payload={\"newIndex\": self.view.params.index})"
              }
            }
          }
        }, 
        "propConfig": {
          "props.textStyle.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn \"black\" if value else \"white\"", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.selected"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.stepTitle"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.index": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.selected": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.stepTitle": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}