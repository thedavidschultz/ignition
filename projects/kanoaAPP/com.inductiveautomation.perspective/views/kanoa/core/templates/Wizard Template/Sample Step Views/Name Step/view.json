{
  "custom": {
    "data": {}
  }, 
  "params": {}, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "text": "What is your new pet's name?"
        }, 
        "meta": {
          "domId": "lblTitle", 
          "name": "lblTitle"
        }, 
        "position": {
          "basis": "32px"
        }
      }, 
      {
        "type": "ia.input.text-field", 
        "meta": {
          "domId": "txtName", 
          "name": "txtName"
        }, 
        "position": {
          "basis": "32px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.data": {
      "persistent": true
    }, 
    "custom.data.name": {
      "binding": {
        "type": "property", 
        "config": {
          "path": "/root/txtName.props.text"
        }
      }
    }
  }
}