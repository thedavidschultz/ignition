{
  "custom": {}, 
  "params": {
    "data": null
  }, 
  "props": {}, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "text": "Select a breed:"
        }, 
        "meta": {
          "domId": "lblTitle", 
          "name": "lblTitle"
        }, 
        "position": {
          "basis": "32px"
        }
      }, 
      {
        "type": "ia.input.dropdown", 
        "meta": {
          "domId": "ddBreed", 
          "name": "ddBreed"
        }, 
        "position": {
          "basis": "36px"
        }, 
        "propConfig": {
          "props.options": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif value == 'Dog':\n\t\treturn [{\"value\": \"French Bulldog\", \"label\": \"French Bulldog\"}, {\"value\": \"Golden Retriever\", \"label\": \"Golden Retriever\"}, {\"value\": \"Samoyed\", \n\t\t\"label\": \"Samoyed\"}, {\"value\": \"Husky\", \"label\": \"Husky\"}, {\"value\": \"Maltese\", \"label\": \"Maltese\"}]\n\telif value == 'Cat':\n\t\treturn [{\"value\": \"Ragdoll\", \"label\": \"Ragdoll\"}, {\"value\": \"British Shorthair\", \"label\": \"British Shorthair\"}, {\"value\": \"Siamese\", \n\t\t\"label\": \"Siamese\"}, {\"value\": \"Scottish Fold\", \"label\": \"Scottish Fold\"}, {\"value\": \"Maine Coon\", \"label\": \"Maine Coon\"}]", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.data.dependencies.type"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.data": {
      "binding": {
        "transforms": [
          {
            "code": "\tif value is not None:\n\t\tself.params.data.fields.breed.value = value\n\treturn self.params.data", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "/root/ddBreed.props.value"
        }
      }, 
      "paramDirection": "inout", 
      "persistent": true
    }
  }
}