{
  "custom": {},
  "params": {
    "selected": true,
    "values": {
      "color": "#FFFF00",
      "label": "value",
      "selectionValue": "value"
    }
  },
  "propConfig": {
    "params.selected": {
      "paramDirection": "output",
      "persistent": true
    },
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 34,
      "width": 332
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "chkBox",
          "name": "chkBox"
        },
        "position": {
          "basis": "36px"
        },
        "propConfig": {
          "props.checkedIcon.color.enabled": {
            "binding": {
              "config": {
                "path": "view.params.values.color"
              },
              "type": "property"
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.selected"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.values.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "checkedIcon": {
            "color": {}
          }
        },
        "type": "ia.input.checkbox"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}