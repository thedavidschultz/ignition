      "binding": {
        "config": {
          "path": "/root/FlexRepeater.props.instances"
        },
        "transforms": [
          {
            "code": "\t\n\tselected \u003d []\n\tfor item in value:\n\t\tif item[\u0027selected\u0027]: selected.append(item[\u0027values\u0027][\u0027selectedValue\u0027])\n\t\n\treturn selected",
