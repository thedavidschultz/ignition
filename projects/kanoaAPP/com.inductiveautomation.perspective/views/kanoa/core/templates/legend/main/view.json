        "meta": {
          "domId": "FlexRepeater",
          "name": "FlexRepeater"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.values"
              },
              "transforms": [
                {
                  "code": "\t\n#\treturn value\n\tcatList \u003d value[\u0027catList\u0027]\n\tcolorList \u003d value[\u0027colorList\u0027]\n\tvalueList \u003d value[\u0027valueList\u0027]\n\tinstances \u003d []\n\n\tfor i in range(len(catList)):\n\t\tinstances.append({\"values\": {\n\t\t\t\t\t\t\t\t\t\t\"color\": colorList[i],\n\t\t\t\t\t\t\t\t\t\t\"label\": catList[i],\n\t\t\t\t\t\t\t\t\t\t\"selectedValue\": valueList[i],\n\t\t\t\t\t\t\t\t\t  },\n\t\t\t\t\t\t\t\t\t  \"selected\": True\n\t\t\t\t\t\t\t})\n\n\t\t\n\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "path": "kanoa/core/templates/legend/element",
          "style": {
            "overflow": "hidden"
          },
          "wrap": "wrap"
        },
        "type": "ia.display.flex-repeater"
      }
