            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.instances": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn [{\"color\": componentColor} for componentColor in value]", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "/root.custom.componentColors"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxComponentColors", 
          "name": "flxComponentColors"
        }, 
        "position": {
          "grow": 1, 
          "shrink": 0
        }
