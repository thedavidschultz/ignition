            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.flex-repeater", 
            "props": {
              "path": "kanoa/core/templates/colorThemePicker/embedded/colorRow", 
              "style": {
                "gap": 5
              }, 
              "direction": "column"
            }, 
            "meta": {
              "domId": "rptColorRows", 
              "name": "rptColorRows"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.instances": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\treturn [{\"color\": mainColor} for mainColor in value]", 
                      "type": "script"
                    }
                  ], 
