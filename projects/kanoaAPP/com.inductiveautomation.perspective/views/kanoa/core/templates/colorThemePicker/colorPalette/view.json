    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "custom.mainColors": {
        "binding": {
          "transforms": [
            {
              "code": "\tcolors = ['primary', 'neutral', 'red', 'orange', 'yellow', 'green', 'blue', 'purple', \n\t'pink', 'gray']\n#\t:root {\n#\n#\t    --kcKanoa: #00a2e8;\n#\t    --kcDockBackground: var(--kcBlue-80);\n#\t    --kcDockBackgroundAccent: var(--kcBlue-70);\n#\t    --kcDockColor: #ffffff;\n#\t    --kcDockColorAccent: #ffffff;\n#\t    --kcCardBackground: #f8f8f8;\n#\t    --kcCardShadow: 2px 2px 3px #88888844;\n#\t    --kcCardBorder: #d5d5d5;\n#\t    --popupBackground: #eeeeee;\n#\t    --kcRootBackground: var(--white);\n#\t    --kcContainerBackground: var(--white);\n#\t    --kcNestedBackground: var(--kcNeutral-10);\n#\t    --kcTooltipBackground: #131a20;\n#\t    --kcTooltipColor: #dfe6ec;\n#\t    --kcTooltipBorder: #558fda;\n#\t    --kcTooltipBackground-Error: #ffaabb;\n#\t    --kcTooltipColor-Error: #bb1133;\n#\t    --kcTooltipBorder-Error: #bb1133;\n#\t    --kcInputBorder: #a1a1a1;\n#\t    --kcButton-DefaultBackground: var(--kcGray-20);\n#\t    --kcButton-DefaultColor: var(--kcGray-80);\n#\t    --kcButton-DefaultBorder: var(--kcGray-40);\n#\t    --kcButtonShadow: var(--kcCardShadow);\n#\t    --kcButton-DisabledBackground: var(--kcGray-30);\n#\t    --kcButton-DisabledColor: var(--kcGray-50);\n#\t    --kcButton-DisabledBorder: var(--kcGray-50);\n#\t    --kcButton-GreenBackground: var(--kcGreen-40);\n#\t    --kcButton-GreenColor: var(--kcGreen-80);\n#\t    --kcButton-GreenBorder: var(--kcGreen-60);\n#\t    --kcButton-RedBackground: var(--kcRed-40);\n#\t    --kcButton-RedColor: var(--kcRed-80);\n#\t    --kcButton-RedBorder: var(--kcRed-60);\n#\t    --kcButton-BlueBackground: var(--kcBlue-40);\n#\t    --kcButton-BlueColor: var(--kcBlue-80);\n#\t    --kcButton-BlueBorder: var(--kcBlue-60);\n#\t}\n\treturn colors", 
              "type": "script"
            }
          ], 
          "type": "expr", 
          "config": {
            "expression": "0"
          }
        }
      }, 
      "custom.componentColors": {
        "binding": {
          "transforms": [
            {
              "code": "\treturn [\n\t\t\t\"--kcKanoa\",\n\t\t\t\"--kcDockBackground\",\n\t\t\t\"--kcDockBackgroundAccent\",\n\t\t\t\"--kcDockColor\",\n\t\t\t\"--kcDockColorAccent\",\n\t\t\t\"--kcCardBackground\",\n\t\t\t\"--kcCardShadow\",\n\t\t\t\"--kcCardBorder\",\n\t\t\t\"--popupBackground\",\n\t\t\t\"--kcRootBackground\",\n\t\t\t\"--kcContainerBackground\",\n\t\t\t\"--kcNestedBackground\",\n\t\t\t\"--kcTooltipBackground\",\n\t\t\t\"--kcTooltipColor\",\n\t\t\t\"--kcTooltipBorder\",\n\t\t\t\"--kcTooltipBackground-Error\",\n\t\t\t\"--kcTooltipColor-Error\",\n\t\t\t\"--kcTooltipBorder-Error\",\n\t\t\t\"--kcInputBorder\",\n\t\t\t\"--kcButton-DefaultBackground\",\n\t\t\t\"--kcButton-DefaultColor\",\n\t\t\t\"--kcButton-DefaultBorder\",\n\t\t\t\"--kcButtonShadow\",\n\t\t\t\"--kcButton-DisabledBackground\",\n\t\t\t\"--kcButton-DisabledColor\",\n\t\t\t\"--kcButton-DisabledBorder\",\n\t\t\t\"--kcButton-GreenBackground\",\n\t\t\t\"--kcButton-GreenColor\",\n\t\t\t\"--kcButton-GreenBorder\",\n\t\t\t\"--kcButton-RedBackground\",\n\t\t\t\"--kcButton-RedColor\",\n\t\t\t\"--kcButton-RedBorder\",\n\t\t\t\"--kcButton-BlueBackground\",\n\t\t\t\"--kcButton-BlueColor\",\n\t\t\t\"--kcButton-BlueBorder\"\n\t\t]", 
              "type": "script"
            }
          ], 
          "type": "expr", 
          "config": {
            "expression": "0"
          }
        }
      }
    }
