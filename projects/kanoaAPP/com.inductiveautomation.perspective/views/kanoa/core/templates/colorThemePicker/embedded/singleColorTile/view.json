{
  "custom": {}, 
  "params": {
    "color": ""
  }, 
  "props": {
    "defaultSize": {
      "width": 280, 
      "height": 70
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "alignContent": "center", 
      "justify": "center", 
      "style": {
        "border": "1px solid var(--kcGray-100)", 
        "padding": 5, 
        "borderRadius": 5
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "center"
          }
        }, 
        "meta": {
          "domId": "Label", 
          "name": "Label"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn system.kanoa.utilities.stringFormat(value[4:])", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.color"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.view", 
        "props": {
          "useDefaultViewWidth": true, 
          "path": "kanoa/core/templates/colorThemePicker/embedded/colorTile", 
          "useDefaultViewHeight": true
        }, 
        "meta": {
          "domId": "Color-Tile", 
          "name": "Color Tile"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.params.color": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.color"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.color": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}