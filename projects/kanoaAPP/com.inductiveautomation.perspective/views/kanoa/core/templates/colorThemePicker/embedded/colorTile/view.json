{
  "custom": {}, 
  "params": {
    "color": ""
  }, 
  "props": {
    "defaultSize": {
      "width": 50, 
      "height": 50
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "meta": {
      "tooltip": {
        "tail": false, 
        "enabled": true, 
        "delay": 0, 
        "location": "top"
      }, 
      "domId": "root", 
      "name": "root"
    }, 
    "events": {
      "dom": {
        "onClick": {
          "type": "script", 
          "scope": "G", 
          "config": {
            "script": "\n\tsystem.perspective.sendMessage(\"color-clicked\", payload={\"color\": self.view.params.color})\n\treturn"
          }
        }
      }
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "bidirectional": true, 
            "path": "view.params.color"
          }
        }
      }, 
      "meta.tooltip.text": {
        "binding": {
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "bidirectional": true, 
            "path": "view.params.color"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.color": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}