{
  "custom": {}, 
  "params": {
    "values": {
      "color": "--kcBlue-30", 
      "tooltip": "value"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 177, 
      "height": 21
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "marginRight": "0.5px", 
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "meta": {
      "tooltip": {
        "enabled": true, 
        "location": "bottom"
      }, 
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "transforms": [
            {
              "code": "\treturn value if value is not None else ''", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "path": "view.params.values.color"
          }
        }
      }, 
      "meta.tooltip.text": {
        "binding": {
          "type": "property", 
          "config": {
            "path": "view.params.values.tooltip"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.values": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}