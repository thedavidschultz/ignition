{
  "custom": {},
  "params": {
    "value": {
      "color": "--kcBlue-40",
      "foreColor": "#FFFFFF",
      "iconPath": "material/warning",
      "label": "Down",
      "tooltip": null
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 34,
      "width": 184
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "ico",
          "name": "ico"
        },
        "position": {
          "basis": "25px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.value.foreColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.value.iconPath"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "height": "25px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "domId": "label",
          "name": "label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.params.value.foreColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.label"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "enabled": true
      }
    },
    "propConfig": {
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.value.tooltip"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\t\n\treturn value or \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "view.params.value.color"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      },
      "props.style.color": {
        "binding": {
          "config": {
            "path": "view.params.value.foreColor"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "style": {
        "borderBottomLeftRadius": "5px",
        "borderBottomRightRadius": "5px",
        "borderTopLeftRadius": "5px",
        "borderTopRightRadius": "5px",
        "classes": "kanoa/font/default",
        "margin": "2px",
        "paddingLeft": "2px",
        "textAlign": "center"
      }
    },
    "type": "ia.container.flex"
  }
}