{
  "custom": {},
  "params": {
    "text": "value"
  },
  "propConfig": {
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 167,
      "width": 420
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "lblMsg",
          "name": "lblMsg"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.text"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose"
            },
            "position": {
              "basis": "100px"
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxAction",
          "name": "flxAction"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "textAlign": "center"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "flex-end",
      "style": {
        "gap": 5,
        "padding": 5
      }
    },
    "type": "ia.container.flex"
  }
}