            "propConfig": {
              "props.text": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\n\tif value is None: return ''\n\ttry:\n\t\treturn \"{:,g}\".format(value) if int(value) == value else \"{:,.1f}\".format(value)\n\texcept:\n\t\treturn ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.value.value"
