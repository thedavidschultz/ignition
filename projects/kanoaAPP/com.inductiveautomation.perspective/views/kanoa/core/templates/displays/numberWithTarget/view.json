{
  "custom": {}, 
  "params": {
    "value": {
      "targetString": "target", 
      "valueNum": 50, 
      "label": "label", 
      "valueString": "value", 
      "targetNum": 60
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 140, 
      "height": 101
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "textAlign": "right", 
            "classes": "kanoa/font/titleMedium"
          }
        }, 
        "meta": {
          "domId": "Label", 
          "name": "Label"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.label"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "textAlign": "right", 
            "classes": "kanoa/font/headlineMedium"
          }
        }, 
        "meta": {
          "domId": "value", 
          "name": "value"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.valueString"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "flex-end", 
          "style": {
            "gap": 5
          }
        }, 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "target", 
              "textStyle": {
                "classes": "kanoa/font/labelMedium"
              }
            }, 
            "meta": {
              "domId": "label", 
              "name": "label"
            }, 
            "position": {
              "shrink": 0
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "textStyle": {
                "classes": "kanoa/font/bodyMedium"
              }
            }, 
            "meta": {
              "domId": "value_0", 
              "name": "value_0"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "config": {
                    "path": "view.params.value.targetString"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "FlexContainer", 
          "name": "FlexContainer"
        }, 
        "position": {
          "shrink": 0
        }
      }, 
      {
        "type": "ia.display.progress", 
        "props": {
          "bar": {
            "color": "--kcPrimary"
          }, 
          "track": {
            "color": "--kcSurfaceVariant"
          }
        }, 
        "meta": {
          "domId": "Progress", 
          "name": "Progress"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "10px"
        }, 
        "propConfig": {
          "props.max": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.targetNum"
              }
            }
          }, 
          "props.value": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.valueNum"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}