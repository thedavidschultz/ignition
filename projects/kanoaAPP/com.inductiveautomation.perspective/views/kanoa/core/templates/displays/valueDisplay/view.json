{
  "custom": {}, 
  "params": {
    "label": "label", 
    "units": "units", 
    "enabled": true, 
    "numberFormat": "#,##0.###", 
    "value": "0.0"
  }, 
  "props": {
    "defaultSize": {
      "width": 131, 
      "height": 26
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "flex-end"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "rightt", 
            "classes": "kanoa/font/default"
          }
        }, 
        "meta": {
          "domId": "lblValue", 
          "name": "lblValue"
        }, 
        "position": {
          "grow": 1, 
          "basis": "80px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr", 
              "config": {
                "expression": "{view.params.label} + \": \" + if(isnull({view.params.value}), '', numberFormat({view.params.value}, {view.params.numberFormat})) + ' ' + {view.params.units} "
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.enabled": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.numberFormat": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.label": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "inout", 
      "persistent": true
    }, 
    "params.units": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}