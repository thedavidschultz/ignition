{
  "custom": {}, 
  "params": {
    "options": {
      "style": "primary", 
      "hideLabel": false
    }, 
    "value": {
      "label": "value", 
      "value": "value"
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 136, 
      "height": 72
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "center", 
      "style": {
        "classes": "kanoa/container", 
        "paddingRight": "15px", 
        "overflow": "hidden", 
        "paddingBottom": "10px", 
        "paddingTop": "10px", 
        "paddingLeft": "15px"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "textAlign": "center", 
            "classes": "kanoa/font/headlineMedium"
          }
        }, 
        "meta": {
          "domId": "value", 
          "name": "value"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.textStyle.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif 'style' in value:\n\t\tif value['style'] == 'primary': return '--kcOnPrimaryContainer'\n\t\telif value['style'] == 'secondary': return '--kcOnSecondaryContainer'\n\t\telif value['style'] == 'tertiary': return '--kcOnTertiaryContainer'\n\treturn '--kcOnSurface'", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.options"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.value"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "textStyle": {
            "textAlign": "center", 
            "classes": "kanoa/font/labelMedium"
          }
        }, 
        "meta": {
          "domId": "label", 
          "name": "label"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "position.display": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif 'hideLabel' in value:\n\t\tif value['hideLabel']: return False\n\treturn True", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.options"
              }
            }
          }, 
          "props.textStyle.color": {
            "binding": {
              "transforms": [
                {
                  "code": "\tif 'style' in value:\n\t\tif value['style'] == 'primary': return '--kcOnPrimaryContainer'\n\t\telif value['style'] == 'secondary': return '--kcOnSecondaryContainer'\n\t\telif value['style'] == 'tertiary': return '--kcOnTertiaryContainer'\n\treturn '--kcOnSurface'", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.options"
              }
            }
          }, 
          "props.text": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.value.label"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "transforms": [
            {
              "code": "\tif 'style' in value:\n\t\tif value['style'] == 'primary': return '--kcPrimaryContainer'\n\t\telif value['style'] == 'secondary': return '--kcSecondaryContainer'\n\t\telif value['style'] == 'tertiary': return '--kcTertiaryContainer'\n\treturn '--kcSurface'", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "config": {
            "path": "view.params.options"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.options": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}