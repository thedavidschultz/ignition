{
  "custom": {}, 
  "params": {
    "values": {
      "showBar": false, 
      "type": "INFO", 
      "textColor": null, 
      "text": ""
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 484, 
      "height": 31
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": "--kcSurface", 
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "padding": "3px", 
            "color": "--kcRed-40", 
            "overflow": "hidden"
          }, 
          "wrap": "wrap", 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.progress", 
            "props": {
              "mode": "indeterminate", 
              "valueDisplay": {
                "style": {
                  "borderStyle": "none"
                }
              }, 
              "style": {
                "height": "8px"
              }, 
              "track": {
                "style": {
                  "borderStyle": "none"
                }
              }
            }, 
            "meta": {
              "domId": "Progress", 
              "name": "Progress"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.values.showBar"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.display.label", 
            "props": {
              "style": {
                "classes": "kanoa/font/bodySmall", 
                "fontSize": "8px"
              }
            }, 
            "meta": {
              "domId": "lblInfo", 
              "name": "lblInfo"
            }, 
            "position": {
              "grow": 1
            }, 
            "propConfig": {
              "props.style.color": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\ttry:\n\t\tif value.textColor is not None: return value.textColor\n\texcept:\n\t\tpass\n\t\t\n\tif value.type == 'INFO': return '--kcGreen-60'\n\tif value.type == 'WARN': return '--kcOrange-50'\n\tif value.typ == 'ERROR': return '--kcRed-50'\n\t\n\treturn '--kcGray-80'", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.values"
                  }
                }
              }, 
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.params.values.text"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxCntInfo", 
          "name": "flxCntInfo"
        }, 
        "position": {
          "grow": 1, 
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.values": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}