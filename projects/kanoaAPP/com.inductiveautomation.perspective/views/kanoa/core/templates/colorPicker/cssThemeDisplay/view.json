{
  "custom": {},
  "params": {
    "data": {
      "cssLabel": "--kcPrimary"
    }
  },
  "propConfig": {
    "params.data": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 45,
      "width": 250
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "Button",
          "name": "Button",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "basis": "45px"
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.data.cssLabel"
              },
              "type": "property"
            }
          },
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.data.cssLabel"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderColor": "--kcOutline",
            "borderStyle": "solid",
            "borderWidth": "1px"
          },
          "text": ""
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "domId": "Label",
          "name": "Label"
        },
        "position": {
          "basis": "152px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.data.cssLabel"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/bodyMedium",
            "color": "--kcOnSurface"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}