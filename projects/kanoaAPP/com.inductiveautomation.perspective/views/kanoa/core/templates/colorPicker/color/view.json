{
  "custom": {}, 
  "params": {
    "color": "#00FF00"
  }, 
  "props": {
    "defaultSize": {
      "width": 20, 
      "height": 20
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "cursor": "pointer"
          }
        }, 
        "meta": {
          "domId": "Label", 
          "name": "Label"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "20px"
        }, 
        "events": {
          "dom": {
            "onClick": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\tcolor = self.view.params.color\n\tsystem.perspective.sendMessage(messageType=\"color-clicked\", payload={\"color\":color})"
              }
            }
          }
        }, 
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.params.color"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "params.color": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}