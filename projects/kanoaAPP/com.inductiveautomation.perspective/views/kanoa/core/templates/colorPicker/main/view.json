        }
      }, 
      "custom.rgb": {
        "onChange": {
          "enabled": null, 
          "script": "\n\tif origin in ['Browser', 'BindingWriteback']:\tself.custom.color = system.kanoa.utilities.RGBToHex(*self.custom.rgb)\n\n\treturn"
