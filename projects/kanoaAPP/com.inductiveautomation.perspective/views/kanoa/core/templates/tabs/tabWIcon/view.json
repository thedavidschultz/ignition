{
  "custom": {},
  "params": {
    "icon": "material/360",
    "label": "Label"
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 38,
      "width": 158
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "icoTab",
          "name": "icoTab"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.icon"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "height": "20px",
            "width": "20px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "domId": "lblTab",
          "name": "lblTab"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/labelMedium",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "gap": "5px",
        "overflow": "hidden",
        "padding": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}