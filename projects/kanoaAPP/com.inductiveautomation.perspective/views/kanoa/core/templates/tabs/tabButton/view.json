{
  "custom": {},
  "params": {
    "values": {
      "bgColor": "--kcBadContainer",
      "icon": {
        "color": "--kcRed-30",
        "iconPath": "material/warning"
      },
      "selected": true,
      "text": "Sprocket Alignment",
      "toolTip": "FAIL"
    }
  },
  "propConfig": {
    "params.values": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 35,
      "width": 231
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblTab",
              "name": "lblTab"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.values.text"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value or \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.textStyle.fontWeight": {
                "binding": {
                  "config": {
                    "path": "view.params.values.selected"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027bold\u0027 if value else \u0027normal\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "classes": "kanoa/font/labelMedium",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "icoTab",
              "name": "icon",
              "tooltip": {
                "location": "top"
              }
            },
            "position": {
              "basis": "18px",
              "shrink": 0
            },
            "propConfig": {
              "meta.tooltip.enabled": {
                "binding": {
                  "config": {
                    "path": "view.params.values.toolTip"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn True if (value or None) is not None else False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "path": "view.params.values.toolTip"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value or \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.values"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value.get(\u0027icon\u0027,{}).get(\u0027iconPath\u0027) is not None",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.color": {
                "binding": {
                  "config": {
                    "path": "view.params.values"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value.get(\u0027icon\u0027, {}).get(\u0027color\u0027) or \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "path": "view.params.values"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value.get(\u0027icon\u0027, {}).get(\u0027iconPath\u0027) or \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "backgroundColor": "--kcSurface",
                "border-radius": "15px",
                "classes": "kanoa/button/flatIcon",
                "height": "18px",
                "padding": "2px",
                "width": "18px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "flxInfo"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.values.bgColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "border-radius": "15px",
            "borderStyle": "none",
            "margin": "2px",
            "padding": "2px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root",
      "tooltip": {
        "location": "top"
      }
    },
    "propConfig": {
      "meta.tooltip.enabled": {
        "binding": {
          "config": {
            "path": "view.params.values"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn True if (value.get(\u0027toolTip\u0027) or None) is not None and value.get(\u0027icon\u0027,{}).get(\u0027iconPath\u0027) is None else False",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.params.values.toolTip"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn value or \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.border-bottom": {
        "binding": {
          "config": {
            "path": "view.params.values.selected"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u00272px solid #AAAAAA\u0027 if value else \u0027\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "gap": "5px",
        "padding": "0px 5px 0px 0px"
      }
    },
    "type": "ia.container.flex"
  }
}