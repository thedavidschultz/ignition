{
  "custom": {},
  "params": {
    "icon": "material/360",
    "label": "Label"
  },
  "propConfig": {
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 33,
      "width": 133
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "Icon",
          "name": "Icon"
        },
        "position": {
          "basis": "24px"
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.icon"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "domId": "Label",
          "name": "Label"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "textStyle": {
            "classes": "kanoa/font/labelMedium",
            "textAlign": "left"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "gap": 8,
        "overflow": "hidden",
        "paddingLeft": "16px",
        "paddingRight": "24px"
      }
    },
    "type": "ia.container.flex"
  }
}