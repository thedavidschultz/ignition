{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 661,
      "width": 262
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "evLogo",
              "name": "evLogo"
            },
            "position": {
              "display": false,
              "shrink": 0
            },
            "props": {
              "path": "kanoa/core/docks/navigation/homeLogo",
              "style": {
                "margin": "4px"
              },
              "useDefaultViewHeight": true
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "domId": "evMenu",
              "name": "evMenu"
            },
            "position": {
              "basis": "320px",
              "grow": 1
            },
            "props": {
              "path": "kanoa/core/docks/navigation/menu"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "domId": "flexContTop",
          "name": "flexContTop"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": 5,
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "space-between",
      "style": {
        "backgroundColor": "--kcDockBackground",
        "color": "--kcDockColor",
        "overflow": "hidden",
        "padding": "3px"
      }
    },
    "type": "ia.container.flex"
  }
}