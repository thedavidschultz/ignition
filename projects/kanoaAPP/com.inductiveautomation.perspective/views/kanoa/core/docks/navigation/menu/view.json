    "scripts": {
      "customMethods": [
        {
          "name": "navigateTo",
          "params": [
            "navType",
            "navPath",
            "navParams"
          ],
          "script": "\t\n\tsystem.perspective.print(\"navigating to \" + str(navPath) + \" with \" + str(navParams))\n\tself.custom.currentViewPath \u003d navPath\n\tself.view.custom.search \u003d \u0027\u0027\n\tnewTab \u003d True if navType \u003d\u003d \u0027url\u0027 else False\n\tsystem.perspective.navigate(**{navType: navPath, \u0027params\u0027: navParams or {}, \u0027newTab\u0027:newTab})\n\t#This has a problem with None being passed in for params when it thinks it should a dictionary.\n"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateNavigation",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"updateNavigation() msg rcvd with \" + str(payload))\n\t# - implement your handler here\n\t# - any navigation action will call this, ex: menu tree, home button, any links\n\t# - this function adds new history items\n\t# - if this function is called when currentIndex is not pointing to the end of history,\n\t# delete every entry after the currentIndex, then add the new history item\n\t# - afterwards, navigate to the newly added history item/view\n\n\tif payload[\u0027type\u0027]\t!\u003d \u0027url\u0027:\t#urls will be opened in a new tab so we don\u0027t need to store history\n\t\t\t\n\t\tpageId \u003d self.page.props.pageId\n\t\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\t\t#For debug in designer\n\t\t\t\n\t\ttabNavigation \u003d self.session.custom.kanoa[pageId].navigation\n\t\thistory \u003d tabNavigation[\"history\"]\n\t\tcurrentIndex \u003d tabNavigation[\"currentIndex\"]\n\t\t\n\t\tif currentIndex \u003c len(history) - 1: self.session.custom.kanoa[pageId].navigation[\"history\"] \u003d history[:currentIndex + 1]\n\t\t\t\n\t\tif history[currentIndex][\"path\"] !\u003d payload[\"path\"]:\n\t\t\tnewHistoryItem \u003d {\n\t\t\t\t\"path\": payload[\"path\"],\n\t\t\t\t\"name\": payload[\u0027name\u0027],\n\t\t\t\t\"type\": payload[\u0027type\u0027],\n\t\t\t\t\"params\": system.util.jsonEncode(payload[\u0027params\u0027])\n\t\t\t}\n\t\t\tself.session.custom.kanoa[pageId].navigation[\"history\"].append(newHistoryItem)\n\t\t\tif len(self.session.custom.kanoa[pageId].navigation[\"history\"]) \u003e 30: self.session.custom.kanoa[pageId].navigation[\"history\"] \u003d self.session.custom.kanoa[pageId].navigation[\"history\"][1:]\n\t\t\telse: self.session.custom.kanoa[pageId].navigation[\"currentIndex\"] +\u003d 1\n\t\telse: return\n\t\t\t\t\t\n\tself.navigateTo(payload[\u0027type\u0027], payload[\u0027path\u0027], payload[\u0027params\u0027])\n\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "traverseNavigation",
          "pageScope": true,
          "script": "\n\t# - passing in parameters, goes back and forth within the history item list\n\t# - decrements/increments currentIndex for prev/next, then navigates to the item\n\t# at the new index\n\t# payload: {direction: (-1 for previous, +1 for next)}\n\t\n\tsystem.perspective.print(\"traverseNavigation() msg rcvd with %s\"%(payload))\n\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\t\n\tself.session.custom.kanoa[pageId].navigation[\u0027currentIndex\u0027] +\u003d payload[\u0027direction\u0027]\n\tnewIndex \u003d self.session.custom.kanoa[pageId].navigation[\u0027currentIndex\u0027]\n\tnavHistory \u003d self.session.custom.kanoa[pageId].navigation.history[newIndex]\n\tnavParams \u003d system.util.jsonDecode(navHistory[\"params\"])\n\tself.navigateTo(navHistory[\u0027type\u0027], navHistory[\u0027path\u0027], navParams)\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "refreshNavigation",
          "pageScope": true,
          "script": "\n\tself.view.refreshBinding(\"custom.hierarchy\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
