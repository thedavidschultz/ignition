            "code": "\n#\tsystem.perspective.print(\"Building navigation menu for %s with roles %s\"%(self.custom.security.userId, value))\n\tuserRoles \u003d value[\u0027roles\u0027] or []\n\thierarchy \u003d []\n\tindexDict \u003d {}\n\texcludePaths \u003d []\n\tdata \u003d system.kanoa.config.getNavigation({\u0027enabled\u0027: True})\n\tproject \u003d system.util.getProjectName()\n\t\n\tfor row in data:\n#\t\tsystem.perspective.print(\u0027%s %s %s\u0027%(row[\u0027path\u0027], row[\u0027roles\u0027], row[\u0027parentId\u0027]))\n\t\tif not value[\u0027userCRUD\u0027][\u0027isGatewayAdmin\u0027]:\n\t\t\troles \u003d system.util.jsonDecode(row[\u0027roles\u0027])\n\t\t\tif roles and len(roles) !\u003d 0 and not any(e in userRoles for e in roles):\n#\t\t\t\tsystem.perspective.print(\u0027excluding based on role\u0027)\n\t\t\t\tcontinue\n\t\n\t\tprojects \u003d system.util.jsonDecode(row[\u0027project\u0027]) or []\n\t\tif len(projects) !\u003d 0 and project not in projects: \n\t\t\texcludePaths.append(row[\u0027path\u0027])\n#\t\t\tsystem.perspective.print(\u0027excluding %s. Adding %s to exclusions\u0027%(row[\u0027name\u0027], row[\u0027path\u0027]))\n\t\t\tcontinue\n\t\t\n\t\tif any([element + \u0027\\\\\u0027 in row[\u0027path\u0027] for element in excludePaths]): continue\n\t\t\n\t\tif row[\u0027parentId\u0027] is not None and not indexDict.has_key(row[\u0027parentId\u0027]): continue\n\t\n\t\tcurrentLevel \u003d hierarchy\n\t\tindexPath \u003d indexDict.get(row[\u0027parentId\u0027]) or []\n\t\tfor index in indexPath:\n\t\t\tcurrentLevel \u003d currentLevel[index][\u0027children\u0027]\n\t\n\t\tindexDict[row[\u0027id\u0027]] \u003d indexPath + [len(currentLevel)]\n\t\tcurrentLevel.append({\u0027enabled\u0027: True, \u0027icon\u0027: row[\u0027icon\u0027], \u0027label\u0027: row[\u0027name\u0027], \u0027target\u0027: {\u0027path\u0027: row[\u0027viewPath\u0027], \u0027type\u0027: row[\u0027type\u0027]}, \u0027children\u0027: []})\n\n\treturn hierarchy",
            "type": "script"
          }
        ],
        "type": "property"
      },
