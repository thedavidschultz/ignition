                "script": "\t\n\tif event[\u0027data\u0027][\u0027target\u0027][\u0027path\u0027]:\n\t\tparams\u003d {\n\t\t\t\t\t\"path\": event[\"data\"][\"target\"][\"path\"],\n\t\t\t\t\t\"name\": event[\"label\"],\n\t\t\t\t\t\"type\": event[\"data\"][\"target\"][\"type\"],\n\t\t\t\t\t\"params\": None\n\t\t\t\t}\n\t\tsystem.perspective.sendMessage(\"updateNavigation\", payload\u003dparams)\n\t\t\n\t\tsystem.perspective.print(\"width is %s\"%self.view.custom.dimensions.primaryView.width)\n\t\tif self.view.custom.dimensions.primaryView.width \u003c 600:\n\t\t\tsystem.perspective.closeDock(\u0027NavBar\u0027)\t\n\t\t\n\telse:\t#If the user selected a folder, then open or close that folder.\n\t\titem \u003d eval(\u0027self.props.%s\u0027 % \u0027.\u0027.join([\u0027items[%d]\u0027 % i for i in event.itemPath]))\n\t\tif item.items:\titem.expanded \u003d not item.expanded\n\n\treturn"
              },
