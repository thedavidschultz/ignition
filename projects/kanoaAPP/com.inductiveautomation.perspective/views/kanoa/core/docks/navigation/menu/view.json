        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.itemMappings": {
            "binding": {
              "config": {
                "path": "this.props.items"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t#\tsystem.perspective.print(\"itemMappings binding change\")\n\titemMappings \u003d {}\n\t\n\tdef addMapping(item):\n\t\tkeyFormat \u003d item[\u0027data\u0027][\u0027target\u0027][\u0027path\u0027].replace(\"/\", \"_\") if item[\u0027data\u0027][\u0027target\u0027][\u0027path\u0027] is not None else \u0027\u0027\n\t\tkeyFormat \u003d keyFormat.replace(\" \", \"__\")\n\t\tindexStrs \u003d list(filter(None, item[\u0027data\u0027][\u0027index\u0027]))\n\t\tif len(indexStrs) \u003e 1: itemMappings[keyFormat] \u003d \"/\".join(indexStrs)\n\t\telse: itemMappings[keyFormat] \u003d indexStrs[0]\n\t\t\t\n\tdef traverseTree(level):\n\t\tfor item in level:\n\t\t\tif isinstance(item, str): continue\n\t\t\tif item[\u0027data\u0027][\u0027target\u0027]: addMapping(item)\n\t\t\tif len(item[\u0027items\u0027]): \ttraverseTree(item[\u0027items\u0027])\n\n\ttraverseTree(value)\n\t\t\n\treturn itemMappings",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.items": {
            "binding": {
              "config": {
                "struct": {
                  "hierarchy": "{view.custom.hierarchy}",
                  "search": "{view.custom.search}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tsearch \u003d value[\u0027search\u0027] or \u0027\u0027\n\thierarchy \u003d value[\u0027hierarchy\u0027]\n\n\tcurrentViewPath \u003d self.parent.custom.currentViewPath\n\n\tdef checkIfCurrentPathInItem(item):\n\t\tif item.has_key(\u0027target\u0027) and item[\u0027target\u0027][\u0027path\u0027] \u003d\u003d currentViewPath: return True\n\t\tif item.has_key(\u0027children\u0027): \n\t\t\tfor item in item[\u0027children\u0027]:\n\t\t\t\tif checkIfCurrentPathInItem(item): return True\n\t\t\t\n\t\treturn False\n\t\t\n\tdef translateItem(item, index, parentIndices):\n\t\ttargetPath \u003d item[\"target\"][\"path\"] if item.has_key(\"target\") else None\n\t\tisSearchPath \u003d search.lower() in item[\"label\"].lower()\n\t\tisCurrentInPath \u003d checkIfCurrentPathInItem(item)\n\n\t\treturn {\n\t\t\t\"label\": item[\"label\"],\n\t\t\t\"data\": {\"target\": item[\"target\"] if item.has_key(\"target\") else \u0027\u0027, \"display\": isSearchPath or isCurrentInPath, \u0027index\u0027: parentIndices + [str(index)]},\n\t\t\t\"expanded\": isCurrentInPath,\n\t\t\t\"items\": [],\n\t\t\t\"icon\": {\"path\": item[\"icon\"], \"color\": \"\"}\n\t\t}\n\t\t\n\tdef buildTreeLevel(items, parent):\n\t\ttranslatedItems \u003d []\n\t\tindexCounter \u003d 0\n\t\tfor item in items:\n\t\t\tif not item.has_key(\u0027enabled\u0027) or (item.has_key(\u0027enabled\u0027) and item[\u0027enabled\u0027]):\n\t\t\t\ttranslatedItem \u003d translateItem(item, indexCounter, parent[\"data\"][\"index\"])\n\t\t\t\t#Call a function to find out if the currentViewPath is contained within this item or its children ONLY if this item is a folder\n\t\t\t\t\n\t\t\t\tif item.has_key(\u0027children\u0027): translatedItem[\u0027items\u0027] \u003d buildTreeLevel(item[\u0027children\u0027], translatedItem)\n\t\t\t\tfor i in range(len(translatedItem[\u0027items\u0027])):\n\t\t\t\t\tif translatedItem[\u0027items\u0027][i][\u0027data\u0027][\u0027display\u0027]: translatedItem[\u0027data\u0027][\u0027display\u0027] \u003d True\n\t\t\t\t\tif translatedItem[\u0027items\u0027][i][\u0027expanded\u0027]: translatedItem[\u0027expanded\u0027] \u003d True\n\t\t\t\tif translatedItem[\u0027data\u0027][\u0027display\u0027]:\n\t\t\t\t\tif search !\u003d \u0027\u0027: translatedItem[\u0027expanded\u0027] \u003d True\t\t\n\t\t\t\t\ttranslatedItems.append(translatedItem)\n\t\t\t\t\tindexCounter +\u003d 1\n\t\treturn translatedItems\n\t\n\thierarchyRoot \u003d {\"data\": {\"index\": []}}\n\treturn buildTreeLevel(hierarchy, hierarchyRoot)",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
