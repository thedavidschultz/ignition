          "component": {
            "onItemClicked": {
              "type": "script", 
              "scope": "G", 
              "config": {
                "script": "\t\n\tif event['data']['target']['path']:\n\t\tparams= {\n\t\t\t\t\t\"path\": event[\"data\"][\"target\"][\"path\"],\n\t\t\t\t\t\"name\": event[\"label\"],\n\t\t\t\t\t\"type\": event[\"data\"][\"target\"][\"type\"],\n\t\t\t\t\t\"params\": None\n\t\t\t\t}\n\t\tsystem.perspective.sendMessage(\"updateNavigation\", payload=params)\n\t\t\n\t\tsystem.perspective.print(\"width is %s\"%self.view.custom.dimensions.primaryView.width)\n\t\tif self.view.custom.dimensions.primaryView.width < 600:\n\t\t\tsystem.perspective.closeDock('NavBar')\t\n\t\t\n\telse:\t#If the user selected a folder, then open or close that folder.\n\t\titem = eval('self.props.%s' % '.'.join(['items[%d]' % i for i in event.itemPath]))\n\t\tif item.items:\titem.expanded = not item.expanded\n\n\treturn"
              }
            }
          }
        }, 
        "propConfig": {
          "props.selection[0]": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\tpageId = self.page.props.pageId\n\tif '/' in pageId: pageId = 'designer'\n\t\n\ttabHistory = self.session.custom.kanoa[pageId]['navigation']\n\tcurrentPath = tabHistory['history'][tabHistory['currentIndex']]['path']\n\tformatPath = currentPath.replace(\" \", \"__\")\n\tformatPath = formatPath.replace(\"/\", \"_\")\n\n\ttry:\n\t\tselection = self.custom.itemMappings[formatPath]\n\texcept:\n\t\tselection = '0'\n\t\n\treturn selection", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "this.custom.itemMappings"
              }
            }
          }, 
          "custom.itemMappings": {
            "binding": {
              "transforms": [
                {
                  "code": "\t#\tsystem.perspective.print(\"itemMappings binding change\")\n\titemMappings = {}\n\t\n\tdef addMapping(item):\n\t\tkeyFormat = item['data']['target']['path'].replace(\"/\", \"_\") if item['data']['target']['path'] is not None else ''\n\t\tkeyFormat = keyFormat.replace(\" \", \"__\")\n\t\tindexStrs = list(filter(None, item['data']['index']))\n\t\tif len(indexStrs) > 1: itemMappings[keyFormat] = \"/\".join(indexStrs)\n\t\telse: itemMappings[keyFormat] = indexStrs[0]\n\t\t\t\n\tdef traverseTree(level):\n\t\tfor item in level:\n\t\t\tif isinstance(item, str): continue\n\t\t\tif item['data']['target']: addMapping(item)\n\t\t\tif len(item['items']): \ttraverseTree(item['items'])\n\n\ttraverseTree(value)\n\t\t\n\treturn itemMappings", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "this.props.items"
              }
            }
          }, 
          "props.items": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\tsearch = value['search'] or ''\n\thierarchy = value['hierarchy']\n\n\tcurrentViewPath = self.parent.custom.currentViewPath\n\n\tdef checkIfCurrentPathInItem(item):\n\t\tif item.has_key('target') and item['target']['path'] == currentViewPath: return True\n\t\tif item.has_key('children'): \n\t\t\tfor item in item['children']:\n\t\t\t\tif checkIfCurrentPathInItem(item): return True\n\t\t\t\n\t\treturn False\n\t\t\n\tdef translateItem(item, index, parentIndices):\n\t\ttargetPath = item[\"target\"][\"path\"] if item.has_key(\"target\") else None\n\t\tisSearchPath = search.lower() in item[\"label\"].lower()\n\t\tisCurrentInPath = checkIfCurrentPathInItem(item)\n\n\t\treturn {\n\t\t\t\"label\": item[\"label\"],\n\t\t\t\"data\": {\"target\": item[\"target\"] if item.has_key(\"target\") else '', \"display\": isSearchPath or isCurrentInPath, 'index': parentIndices + [str(index)]},\n\t\t\t\"expanded\": isCurrentInPath,\n\t\t\t\"items\": [],\n\t\t\t\"icon\": {\"path\": item[\"icon\"], \"color\": \"\"}\n\t\t}\n\t\t\n\tdef buildTreeLevel(items, parent):\n\t\ttranslatedItems = []\n\t\tindexCounter = 0\n\t\tfor item in items:\n\t\t\tif not item.has_key('enabled') or (item.has_key('enabled') and item['enabled']):\n\t\t\t\ttranslatedItem = translateItem(item, indexCounter, parent[\"data\"][\"index\"])\n\t\t\t\t#Call a function to find out if the currentViewPath is contained within this item or its children ONLY if this item is a folder\n\t\t\t\t\n\t\t\t\tif item.has_key('children'): translatedItem['items'] = buildTreeLevel(item['children'], translatedItem)\n\t\t\t\tfor i in range(len(translatedItem['items'])):\n\t\t\t\t\tif translatedItem['items'][i]['data']['display']: translatedItem['data']['display'] = True\n\t\t\t\t\tif translatedItem['items'][i]['expanded']: translatedItem['expanded'] = True\n\t\t\t\tif translatedItem['data']['display']:\n\t\t\t\t\tif search != '': translatedItem['expanded'] = True\t\t\n\t\t\t\t\ttranslatedItems.append(translatedItem)\n\t\t\t\t\tindexCounter += 1\n\t\treturn translatedItems\n\t\n\thierarchyRoot = {\"data\": {\"index\": []}}\n\treturn buildTreeLevel(hierarchy, hierarchyRoot)", 
                  "type": "script"
                }
              ], 
              "type": "expr-struct", 
              "overlayOptOut": true, 
              "config": {
                "struct": {
                  "hierarchy": "{view.custom.hierarchy}", 
                  "search": "{view.custom.search}"
                }, 
                "waitOnAll": true
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.icon", 
