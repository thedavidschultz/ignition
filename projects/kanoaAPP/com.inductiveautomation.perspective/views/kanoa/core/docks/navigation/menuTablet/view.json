    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\tsystem.perspective.print(\"updateNavigation() msg rcvd with \" + str(payload))\n\t# - implement your handler here\n\t# - any navigation action will call this, ex: menu tree, home button, any links\n\t# - this function adds new history items\n\t# - if this function is called when currentIndex is not pointing to the end of history,\n\t# delete every entry after the currentIndex, then add the new history item\n\t# - afterwards, navigate to the newly added history item/view\n\n\tif payload['type']\t!= 'url':\t#urls will be opended in a new tab so we don't need to store history\n\t\t\t\n\t\tpageId = self.page.props.pageId\n\t\tif '/' in pageId: pageId = 'designer'\t\t#For debug in designer\n\t\t\t\n\t\ttabNavigation = self.session.custom.kanoa[pageId].navigation\n\t\thistory = tabNavigation[\"history\"]\n\t\tcurrentIndex = tabNavigation[\"currentIndex\"]\n\t\t\n\t\tif currentIndex < len(history) - 1: self.session.custom.kanoa[pageId].navigation[\"history\"] = history[:currentIndex + 1]\n\t\t\t\n\t\tif history[currentIndex][\"path\"] != payload[\"path\"]:\n\t\t\tnewHistoryItem = {\n\t\t\t\t\"path\": payload[\"path\"],\n\t\t\t\t\"name\": payload['name'],\n\t\t\t\t\"type\": payload['type'],\n\t\t\t\t\"params\": system.util.jsonEncode(payload['params'])\n\t\t\t}\n\t\t\tself.session.custom.kanoa[pageId].navigation[\"history\"].append(newHistoryItem)\n\t\t\tif len(self.session.custom.kanoa[pageId].navigation[\"history\"]) > 30: self.session.custom.kanoa[pageId].navigation[\"history\"] = self.session.custom.kanoa[pageId].navigation[\"history\"][1:]\n\t\t\telse: self.session.custom.kanoa[pageId].navigation[\"currentIndex\"] += 1\n\t\telse: return\n\t\t\t\t\t\n\tself.navigateTo(payload['type'], payload['path'], payload['params'])\n\tsystem.perspective.print('currentNavigation: %s'%self.session.custom.kanoa[pageId].navigation)\n\n\treturn", 
          "messageType": "updateNavigation", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\t# - passing in parameters, goes back and forth within the history item list\n\t# - decrements/increments currentIndex for prev/next, then navigates to the item\n\t# at the new index\n\t# payload: {direction: (-1 for previous, +1 for next)}\n\t\n\tsystem.perspective.print(\"traverseNavigation() msg rcvd with %s\"%(payload))\n\tpageId = self.page.props.pageId\n\tif '/' in pageId: pageId = 'designer'\t\n\tself.session.custom.kanoa[pageId].navigation['currentIndex'] += payload['direction']\n\tsystem.perspective.print(self.session.custom.kanoa[pageId].navigation)\n\tnewIndex = self.session.custom.kanoa[pageId].navigation['currentIndex']\n\tnavHistory = self.session.custom.kanoa[pageId].navigation.history[newIndex]\n\tnavParams = system.util.jsonDecode(navHistory[\"params\"])\n\tself.navigateTo(navHistory['type'], navHistory['path'], navParams)\n\treturn", 
          "messageType": "traverseNavigation", 
          "sessionScope": false, 
          "pageScope": true
        }, 
        {
          "viewScope": false, 
          "script": "\n\tself.view.refreshBinding(\"custom.hierarchy\")\n\t\n\treturn", 
          "messageType": "refreshNavigation", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [
            "navType", 
            "navPath", 
            "navParams"
          ], 
          "script": "\t\n\tsystem.perspective.print(\"navigating to \" + str(navPath) + \" with \" + str(navParams))\n\tself.custom.currentViewPath = navPath\n\tself.view.custom.search = ''\n\tnewTab = True if navType == 'url' else False\n\tsystem.perspective.navigate(**{navType: navPath, 'params': navParams or {}, 'newTab':newTab})\n\t#This has a problem with None being passed in for params when it thinks it should a dictionary.\n", 
          "name": "navigateTo"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.search": {
      "persistent": true
    }, 
    "custom.dimensions": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "page.props.dimensions"
        }
      }, 
