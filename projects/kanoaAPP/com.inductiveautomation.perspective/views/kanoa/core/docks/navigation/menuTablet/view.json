    }, 
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\troles = self.session.props.auth.user.roles or []\n\tuserRoles = list(set([row['roleName'] for row in system.kanoa.security.getUserAssetRoles({'userId': userId})])) or roles if value != -1 else roles\n\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD, 'roles': userRoles}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.hierarchy": {
      "binding": {
        "transforms": [
          {
            "code": "\n#\tsystem.perspective.print(\"Building navigation menu for %s with roles %s\"%(self.custom.security.userId, value))\n\tuserRoles = value['roles'] or []\n\thierarchy = []\n\tindexDict = {}\n\texcludePaths = []\n\tdata = system.kanoa.config.getNavigation({'enabled': True})\n\tproject = system.util.getProjectName()\n\t\n\tfor row in data:\n#\t\tsystem.perspective.print('%s %s %s'%(row['path'], row['roles'], row['parentId']))\n\t\tif not value['userCRUD']['isGatewayAdmin']:\n\t\t\troles = system.util.jsonDecode(row['roles'])\n\t\t\tif roles and len(roles) != 0 and not any(e in userRoles for e in roles):\n#\t\t\t\tsystem.perspective.print('excluding based on role')\n\t\t\t\tcontinue\n\t\n\t\tprojects = system.util.jsonDecode(row['project']) or []\n\t\tif len(projects) != 0 and project not in projects: \n\t\t\texcludePaths.append(row['path'])\n#\t\t\tsystem.perspective.print('excluding %s. Adding %s to exclusions'%(row['name'], row['path']))\n\t\t\tcontinue\n\t\t\n\t\tif any([element + '\\\\' in row['path'] for element in excludePaths]): continue\n\t\t\n\t\tif row['parentId'] is not None and not indexDict.has_key(row['parentId']): continue\n\t\n\t\tcurrentLevel = hierarchy\n\t\tindexPath = indexDict.get(row['parentId']) or []\n\t\tfor index in indexPath:\n\t\t\tcurrentLevel = currentLevel[index]['children']\n\t\n\t\tindexDict[row['id']] = indexPath + [len(currentLevel)]\n\t\tcurrentLevel.append({'enabled': True, 'icon': row['icon'], 'label': row['name'], 'target': {'path': row['viewPath'], 'type': row['type']}, 'children': []})\n\n\treturn hierarchy", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.security"
        }
      }, 
      "persistent": true
    }
  }
}