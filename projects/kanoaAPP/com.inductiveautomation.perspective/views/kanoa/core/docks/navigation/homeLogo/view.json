{
  "custom": {
    "programName": "MES"
  }, 
  "params": {}, 
  "props": {
    "defaultSize": {
      "width": 300, 
      "height": 50
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "alignContent": "center", 
      "justify": "center", 
      "style": {
        "padding": "5px", 
        "backgroundColor": "--kcDockBackground", 
        "overflow": "hidden", 
        "maxWidth": 300
      }
    }, 
    "children": [
      {
        "type": "ia.display.image", 
        "props": {
          "fit": {
            "aspectRatio": 1, 
            "mode": "contain", 
            "width": 0, 
            "height": 0
          }, 
          "style": {
            "padding": "3px 10px", 
            "backgroundColor": "White", 
            "objectFit": "contain", 
            "borderRadius": 100, 
            "height": 40, 
            "maxWidth": "calc(100% - 5px)"
          }
        }, 
        "meta": {
          "domId": "icoLogo", 
          "name": "icoLogo"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.source": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\tdata = system.kanoa.config.getConfig({'project': system.util.getProjectName(), 'configName':'logo'})\n\tif data.rowCount == 0:\tdata = system.kanoa.config.getConfig({'project': 'kanoaCore', 'configName':'logo'})\t\n\treturn '/system/images/' + data.getValueAt(0, 'configValue') if data and data.rowCount else '/system/images/Logos/primary_logo.png'\n\t", 
                  "type": "script"
                }
              ], 
              "type": "expr", 
              "overlayOptOut": true, 
              "config": {
                "expression": "1"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "transforms": [
            {
              "code": "\t\n\treturn system.kanoa.config.getBackgroundColor(self.session.props.theme)", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "enabled": false, 
          "config": {
            "path": "session.props.theme"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "custom.programName": {
      "persistent": true
    }
  }
}