{
  "custom": {
    "programName": "MES"
  }, 
  "params": {}, 
  "props": {
    "defaultSize": {
      "width": 100, 
      "height": 50
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "alignContent": "center", 
      "justify": "center", 
      "style": {
        "padding": "5px", 
        "backgroundColor": "--kcDockBackground", 
        "overflow": "hidden"
      }
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "alignItems": "center", 
          "alignContent": "center", 
          "justify": "center", 
          "style": {
            "padding": 3, 
            "backgroundColor": "#FFFFFF", 
            "overflow": "hidden", 
            "borderRadius": 50, 
            "height": "100%"
          }
        }, 
        "children": [
          {
            "type": "ia.display.image", 
            "props": {
              "fit": {
                "aspectRatio": 1, 
                "mode": "contain"
              }, 
              "style": {
                "padding": 3, 
                "width": "auto", 
                "height": 35
              }
            }, 
            "meta": {
              "domId": "icoLogo", 
              "name": "icoLogo"
            }, 
            "position": {
              "shrink": 0
            }, 
            "propConfig": {
              "props.source": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\tdata = system.kanoa.config.getConfig({'project': system.util.getProjectName(), 'configName':'logoMobile'})\n\tif data.rowCount == 0: \tdata = system.kanoa.config.getConfig({'project': 'kanoaCore', 'configName': 'logoMobile'})\n\treturn '/system/images/' + data.getValueAt(0, 'configValue') if data and data.rowCount else '/system/images/Logos/primary_favicon.png'", 
                      "type": "script"
                    }
                  ], 
                  "type": "expr", 
                  "overlayOptOut": true, 
                  "config": {
                    "expression": "1"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxLogo", 
          "name": "flxLogo"
        }, 
        "position": {
          "shrink": 0
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "transforms": [
            {
              "code": "\t\n\treturn system.kanoa.config.getBackgroundColor(self.session.props.theme)", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "enabled": false, 
          "config": {
            "path": "session.props.theme"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "custom.programName": {
      "persistent": true
    }
  }
}