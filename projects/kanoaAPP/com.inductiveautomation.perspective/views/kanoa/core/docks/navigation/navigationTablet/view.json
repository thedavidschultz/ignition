{
  "custom": {}, 
  "params": {}, 
  "props": {
    "defaultSize": {
      "width": 262, 
      "height": 661
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "justify": "space-between", 
      "style": {
        "padding": "3px", 
        "backgroundColor": "--kcDockBackground", 
        "color": "--kcDockColor", 
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "style": {
            "overflow": "visible", 
            "gap": 5
          }, 
          "direction": "column"
        }, 
        "children": [
          {
            "type": "ia.display.view", 
            "props": {
              "path": "kanoa/core/docks/navigation/homeLogo", 
              "style": {
                "margin": "4px"
              }, 
              "useDefaultViewHeight": true
            }, 
            "meta": {
              "domId": "evLogo", 
              "name": "evLogo"
            }, 
            "position": {
              "shrink": 0, 
              "display": false
            }
          }, 
          {
            "type": "ia.display.view", 
            "props": {
              "path": "kanoa/core/docks/navigation/menuTablet"
            }, 
            "meta": {
              "domId": "evMenu", 
              "name": "evMenu"
            }, 
            "position": {
              "grow": 1, 
              "basis": "320px"
            }
          }
        ], 
        "meta": {
          "domId": "flexContTop", 
          "name": "flexContTop"
        }, 
        "position": {
          "grow": 1, 
          "basis": "200px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }
}