        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n#\tuserSource \u003d system.kanoa.security.getUserSource()\n#\tallRoles \u003d [role for role in system.user.getRoles(userSource) if role !\u003d \u0027Gateway Admin\u0027]\n\troles \u003d system.kanoa.security.getRoles({\u0027enabled\u0027:True})\n\tuserRoles \u003d system.kanoa.security.getUserAssetRoles({\u0027userId\u0027: value})\n\trolesHeaders \u003d [\u0027roleId\u0027, \u0027Role\u0027, \u0027Assets\u0027, \u0027assetIds\u0027]\n\trolesRows \u003d []\n\trolesDict \u003d {}\n\tfor row in roles:\n\t\trolesDict[row[\u0027roleName\u0027]] \u003d [row[\u0027roleId\u0027], row[\u0027roleName\u0027], [], []]\n\t\n\tfor row in userRoles:\n\t\tif row[\u0027assetPath\u0027] not in rolesDict[row[\u0027roleName\u0027]][2]:\n\t\t\trolesDict[row[\u0027roleName\u0027]][2].append(row[\u0027assetPath\u0027])\n\t\trolesDict[row[\u0027roleName\u0027]][3].append(str(row[\u0027assetId\u0027]))\n\t\t\n\tfor role in rolesDict:\n\t\trolesDict[role][2] \u003d \", \".join(rolesDict[role][2])\n\t\trolesDict[role][3] \u003d \", \".join(rolesDict[role][3])\n\t\trolesRows.append(rolesDict[role])\n\t\t\n\trolesRows.sort(key\u003dlambda x: x[0])\n\t\n\treturn system.dataset.toDataSet(rolesHeaders, rolesRows)",
            "type": "script"
          }
        ],
        "type": "property"
      },
