                {
                  "code": "\t\n\tpageId \u003d value\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\treturn self.session.custom.kanoa[pageId].navigation.history",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
