      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\tnavHistory \u003d self.session.custom.kanoa[pageId].navigation \n\tnavHistory.history \u003d [navHistory.history[navHistory.currentIndex]]\n\tnavHistory.currentIndex \u003d 0\n\tself.parent.parent.getChild(\"Table\").refreshBinding(\"props.data\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
