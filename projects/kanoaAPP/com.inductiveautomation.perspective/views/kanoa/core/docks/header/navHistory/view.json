        "events": {
          "component": {
            "onRowClick": {
              "config": {
                "script": "\t\n#\tsystem.perspective.print(\"onClick !!!!\")\n\n#\tsystem.perspective.print(self.props.data[event.row][\u0027navIndex\u0027])\n#\tindex \u003d self.props.data[event.row][\u0027navIndex\u0027]\n\tindex \u003d event.row\n#\tsystem.perspective.print(\"huh\", event)\n\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\tcurrentIndex \u003d self.session.custom.kanoa[pageId].navigation.currentIndex\n\tsystem.perspective.sendMessage(\u0027traverseNavigation\u0027, payload\u003d{\u0027direction\u0027: index - currentIndex})\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
