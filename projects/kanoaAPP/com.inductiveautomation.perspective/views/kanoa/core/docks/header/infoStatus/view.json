                {
                  "code": "\t\n\tif (value or None) is None: return False\n\treturn not(value[\u0027trialActive\u0027] or value[\u0027opsActive\u0027] or value[\u0027qdsActive\u0027] or value[\u0027traceActive\u0027])",
