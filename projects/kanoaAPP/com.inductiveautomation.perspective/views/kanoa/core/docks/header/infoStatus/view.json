{
  "custom": {
    "configInfo": {
      "environment": "development"
    },
    "installError": false,
    "installInfo": {
      "dbProduct": "Microsoft SQL Server",
      "dbVersion": "15.00.2000",
      "driverName": "Microsoft JDBC Driver 9.4 for SQL Server",
      "driverVersion": "9.4.0.0",
      "hawthornStatus": "Database tables present but no changeSet",
      "ignitionSystemName": "Kanoa Dev Gateway",
      "ignitionVersion": "8.1.50 (b2025093011)",
      "installationDate": "2026-03-10T14:11:02.799855500",
      "kanoaMESVersion": "1.14.6-beta1",
      "systemTimeZone": "Etc/UTC"
    },
    "licenseState": {
      "opsActive": true,
      "opsLicensed": true,
      "qdsActive": true,
      "qdsLicensed": true,
      "traceActive": true,
      "traceLicensed": true,
      "trialActive": false
    }
  },
  "params": {},
  "propConfig": {
    "custom.configInfo": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToDict(system.kanoa.config.getConfig({\u0027configTypeName\u0027: \u0027application\u0027}), \u0027configName\u0027, \u0027configValue\u0027)",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.installError": {
      "binding": {
        "config": {
          "path": "view.custom.installInfo"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn False if value[\u0027hawthornStatus\u0027] in (\u0027Database tables present but no changeSet\u0027, \u0027Hawthorn Success\u0027) else True",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.installInfo": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tparentPath \u003d \u0027[kanoaMES]installationInfo\u0027\n\tbrowse \u003d system.tag.browse(parentPath)\n\tresults \u003d browse.getResults()\n\t\n\tpaths \u003d [str(r[\"fullPath\"]) for r in results]\n\tqvs \u003d system.tag.readBlocking(paths)\n\treturn {r[\"name\"]: qv.value for r, qv in zip(results, qvs)}",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.licenseState": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[kanoaMES]licenseInfo"
        },
        "transforms": [
          {
            "code": "\t\n\tsystem.perspective.print(\u0027licenseState bindng fired\u0027)\n\tlicenseInfo \u003d {}\n\ttags \u003d system.tag.browse(\u0027[kanoaMES]licenseInfo\u0027, {})\n\tfor tag in tags:\n\t\tlicenseInfo[tag[\u0027name\u0027]] \u003d tag[\u0027value\u0027]\n\treturn licenseInfo",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 41,
      "width": 262
    }
  },
  "root": {
    "children": [
      {
