      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\n\tinfo \u003d [{\"name\": k, \"value\": v} for k,v in self.view.custom.installInfo.items()]\n\t\n\tsession \u003d self.session.props\n\ttimezoneInfo \u003d [\n#\t\t\t\t\t\t{\"name\": \"Gateway Timezone\", \"value\": \"%s (%s)\"%(session[\u0027gateway\u0027][\u0027timezone\u0027][\u0027name\u0027], session[\u0027gateway\u0027][\u0027timezone\u0027][\u0027utcOffset\u0027])},\n\t\t\t\t\t\t{\"name\": \"Client Timezone\", \"value\": \"%s (%s)\"%(session[\u0027device\u0027][\u0027timezone\u0027][\u0027id\u0027], session[\u0027device\u0027][\u0027timezone\u0027][\u0027utcOffset\u0027])},\n\t\t\t\t\t\t{\"name\": \"Database Timezone\", \"value\": system.db.runScalarQuery(\"SELECT FORMAT(SYSDATETIMEOFFSET(), \u0027zzz\u0027)\", system.kanoa.config.getDBName(\u0027mes\u0027))}\n\t\t\t\t\t]\n\t\n\tinfo.extend(timezoneInfo)\n\tmdInfo \u003d \"| Name | Value |\\n|---|---|\\n\" + \"\\n\".join(\"| {} | {} |\".format(d[\"name\"], d[\"value\"])for d in info)\n\tsystem.perspective.openPopup(\"infoPopup\", \"kanoa/core/templates/displays/diagnosticsPopup\", {\u0027text\u0027:mdInfo}, title\u003d\u0027Diagnostics Info\u0027, draggable\u003dTrue, resizable\u003d True)\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
