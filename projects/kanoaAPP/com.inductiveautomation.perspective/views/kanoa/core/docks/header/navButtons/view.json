{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.sendMessage(\u0027traverseNavigation\u0027, payload\u003d{\u0027direction\u0027: -1})"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnNavLeft",
              "name": "btnNavLeft",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "text": "Navigate back"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "session.custom.kanoa"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\tshow \u003d value[pageId][\u0027navigation\u0027][\u0027currentIndex\u0027] !\u003d 0 or False\n\treturn show",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.image.icon.color": {
                "binding": {
                  "config": {
                    "path": "this.props.enabled"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027--kcOnPrimary\u0027 if value else \u0027--kcButton-DisabledColor\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "height": 30,
                "icon": {
                  "path": "material/arrow_back"
                },
                "width": 30
              },
              "style": {
                "backgroundColor": "--kcPrimary",
                "classes": "kanoa/button/flatIcon",
                "height": "25px",
                "width": "25px"
              },
              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.sendMessage(\u0027traverseNavigation\u0027, payload\u003d{\u0027direction\u0027: 1})"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnNavRight",
              "name": "btnNavRight",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "text": "Navigate forward"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "session.custom.kanoa"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\tshow \u003d value[pageId][\u0027navigation\u0027][\u0027currentIndex\u0027] !\u003d len(value[pageId][\u0027navigation\u0027][\u0027history\u0027]) - 1\n\t\t\n\treturn show",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.image.icon.color": {
                "binding": {
                  "config": {
                    "path": "this.props.enabled"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027--kcOnPrimary\u0027 if value else \u0027--kcButton-DisabledColor\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "height": 30,
                "icon": {
                  "path": "material/arrow_forward"
                },
                "width": 30
              },
              "style": {
                "backgroundColor": "--kcPrimary",
                "classes": "kanoa/button/flatIcon",
                "height": "25px",
                "width": "25px"
              },
              "text": ""
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.openPopup(\"History Selector\", \"kanoa/core/docks/header/navHistory\", params\u003d {},title\u003d \u0027Navigation History\u0027, overlayDismiss\u003dTrue, modal\u003dTrue)\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnHistory",
              "name": "btnHistory",
              "tooltip": {
                "enabled": true,
                "location": "bottom",
                "text": "Show navigation history"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "height": 30,
                "icon": {
                  "color": "--kcDockColor",
                  "path": "material/history"
                },
                "width": 30
              },
              "style": {
                "backgroundColor": "--kcDockBackground",
                "classes": "kanoa/button/flatIcon",
                "cursor": "pointer",
                "height": "30px",
                "width": "30px"
              },
              "text": ""
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxcntHistory",
          "name": "flxcntHistory"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "session.custom.kanoa"
              },
              "transforms": [
                {
                  "code": "\t\n\tpageId \u003d self.page.props.pageId\n\tif \u0027/\u0027 in pageId: pageId \u003d \u0027designer\u0027\n\ttry:\t\t#If page is refreshed afte ran update, sometimes there is no index\n\t\ttabNavigation \u003d self.session.custom.kanoa[pageId].navigation\n\t\tenabled \u003d True if len(tabNavigation[\"history\"]) \u003e 1 else False\t\n\texcept:\n\t\tenabled \u003d False\n\t\n\treturn enabled",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "border": "1px solid var(--kcOutlineVariant)",
            "borderRadius": 5,
            "borderWidth": "1px",
            "gap": "5px",
            "overflow": "hidden",
            "padding": "2px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcDockBackground",
        "overflow": "hidden",
        "padding": "2px"
      }
    },
    "type": "ia.container.flex"
  }
}