{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "id": "options",
                "type": "close"
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "domId": "btnClose",
          "name": "btnClose"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "props": {
          "path": "material/close",
          "style": {
            "classes": "kanoa/button/flatIcon",
            "height": 20,
            "left": 175,
            "position": "absolute",
            "top": 5,
            "width": 20
          }
        },
        "type": "ia.display.icon"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblHeader",
              "name": "lblHeader"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/titleMedium"
              },
              "text": "Themes"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "dropdown",
              "name": "dropdown"
            },
            "position": {
              "basis": "36px"
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.props.theme"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "dropdownOptionStyle": {
                "classes": "kanoa/font/default"
              },
              "options": [
                {
                  "label": "kanoa blue",
                  "value": "kanoa-light"
                },
                {
                  "label": "dark",
                  "value": "kanoa-dark"
                },
                {
                  "label": "forest",
                  "value": "kanoa-light-forest"
                },
                {
                  "label": "firetruck",
                  "value": "kanoa-light-firetruck"
                },
                {
                  "label": "orange",
                  "value": "kanoa-light-orange"
                },
                {
                  "label": "grape",
                  "value": "kanoa-light-grape"
                }
              ],
              "style": {
                "background-color": "--kcSurface",
                "classes": "kanoa/font/default"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "domId": "flxThemes",
          "name": "flxThemes"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblHeader-1",
              "name": "lblHeader"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "kanoa/font/titleMedium"
              },
              "text": "Languages"
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "domId": "RadioGroup",
                  "name": "RadioGroup"
                },
                "position": {
                  "basis": "155px"
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "session.props.locale"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "align": "start",
                  "radioStyle": {
                    "fontSize": "0.8em",
                    "margin": "-10px 0px"
                  },
                  "radios": [
                    {
                      "selected": true,
                      "text": "English",
                      "value": "en-US"
                    },
                    {
                      "selected": false,
                      "text": "Español",
                      "value": "es-US"
                    },
                    {
                      "selected": false,
                      "text": "Francais",
                      "value": "fr"
                    },
                    {
                      "selected": false,
                      "text": "Deutsch",
                      "value": "de"
                    },
                    {
                      "selected": false,
                      "text": "Italiano",
                      "value": "it"
                    },
                    {
                      "selected": false,
                      "text": "中文 (Chinese)",
                      "value": "zh-US"
                    },
                    {
                      "selected": false,
                      "text": "한국어 (Korean)",
                      "value": "ko"
                    }
                  ],
                  "selectedIcon": {
                    "color": {
                      "enabled": "--kcDockColor"
                    },
                    "path": "material/double_arrow",
                    "style": {
                      "width": "0.8em"
                    }
                  },
                  "unselectedIcon": {
                    "path": "material/double_arrow",
                    "style": {
                      "width": "0.8em"
                    }
                  }
                },
                "type": "ia.input.radio-group"
              }
            ],
            "meta": {
              "domId": "flxToggle",
              "name": "flxToggle"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "justify": "center"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "domId": "flxLanguage",
          "name": "flxLanguage"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tself.view.getChild(\u0027root\u0027).getFrameworkInfo()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "lblVersionNumber",
          "name": "lblVersionNumber"
        },
        "position": {
          "display": false,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "session.custom.kanoa.frameworkInfo"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn \u0027Version {}\u0027.format(value[\u0027versionNumber\u0027]) if \u0027versionNumber\u0027 in value else \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "marginTop": "auto"
          },
          "textStyle": {
            "textAlignLast": "right"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcDockBackground",
        "color": "--kcDockColor",
        "gap": 10,
        "padding": 10,
        "paddingTop": 30,
        "position": "relative"
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "getFrameworkInfo",
          "params": [],
          "script": "\tfilePath \u003d \u0027C:\\Program Files\\Inductive Automation\\Ignition\\data\\projects\\KanoaFrameworkInfo.json\u0027\n\tjsonFile \u003d system.file.readFileAsString(filePath)\n\tframeworkInfo \u003d system.util.jsonDecode(jsonFile)\n\tself.session.custom.kanoa.frameworkInfo \u003d frameworkInfo"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": []
    },
    "type": "ia.container.flex"
  }
}