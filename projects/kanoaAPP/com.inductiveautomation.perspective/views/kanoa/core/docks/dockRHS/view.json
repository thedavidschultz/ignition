{
  "custom": {}, 
  "params": {}, 
  "props": {
    "defaultSize": {
      "width": 303, 
      "height": 500
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": 5, 
        "backgroundColor": "--kcSurface", 
        "color": "--kcDockColor", 
        "gap": "5px", 
        "position": "relative"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "flex-end"
        }, 
        "children": [
          {
            "type": "ia.display.icon", 
            "props": {
              "path": "material/close", 
              "style": {
                "classes": "kanoa/button/flatIcon", 
                "position": "relative"
              }
            }, 
            "meta": {
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "20px"
            }, 
            "events": {
              "dom": {
                "onClick": {
                  "type": "dock", 
                  "scope": "C", 
                  "config": {
                    "type": "close", 
                    "id": "options"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxHeader", 
          "name": "flxHeader"
        }, 
        "position": {
          "shrink": 0
        }
      }, 
      {
        "type": "ia.container.tab", 
        "props": {
          "tabs": [
            "Options", 
            "Help"
          ], 
          "menuType": "modern", 
          "currentTabIndex": 1
        }, 
        "children": [
          {
            "type": "ia.container.flex", 
            "props": {
              "style": {
                "padding": "5px", 
                "gap": "5px"
              }, 
              "direction": "column"
            }, 
            "children": [
              {
                "type": "ia.container.flex", 
                "props": {
                  "style": {
                    "gap": 5
                  }, 
                  "direction": "column"
                }, 
                "children": [
                  {
                    "type": "ia.display.label", 
                    "props": {
                      "style": {
                        "fontSize": "1.25em", 
                        "fontWeight": "500"
                      }, 
                      "text": "Themes"
                    }, 
                    "meta": {
                      "domId": "lblHeader", 
                      "name": "lblHeader"
                    }, 
                    "position": {
                      "shrink": 0
                    }
                  }, 
                  {
                    "type": "ia.container.flex", 
                    "props": {
                      "justify": "center"
                    }, 
                    "children": [
                      {
                        "type": "ia.display.icon", 
                        "props": {
                          "path": "material/wb_sunny"
                        }, 
                        "meta": {
                          "domId": "icoLight", 
                          "name": "icoLight"
                        }, 
                        "position": {
                          "shrink": 0, 
                          "basis": "25px"
                        }
                      }, 
                      {
                        "type": "ia.input.toggle-switch", 
                        "meta": {
                          "domId": "ToggleSwitch", 
                          "name": "ToggleSwitch"
                        }, 
                        "position": {
                          "shrink": 0
                        }, 
                        "events": {
                          "component": {
                            "onActionPerformed": {
                              "type": "script", 
                              "scope": "G", 
                              "config": {
                                "script": "\tselected = self.props.selected\n\ttheme = 'dark-kanoa' if selected else 'light-kanoa'\n\tself.session.props.theme = theme"
                              }
                            }
                          }, 
                          "system": {
                            "onStartup": {
                              "type": "script", 
                              "scope": "G", 
                              "config": {
                                "script": "\ttheme = self.session.props.theme\n\tselected = theme == 'dark-kanoa'\n\tself.props.selected = selected"
                              }
                            }
                          }
                        }
                      }, 
                      {
                        "type": "ia.display.icon", 
                        "props": {
                          "path": "material/brightness_3"
                        }, 
                        "meta": {
                          "domId": "icoDark", 
                          "name": "icoDark"
                        }, 
                        "position": {
                          "shrink": 0, 
                          "basis": "25px"
                        }
                      }
                    ], 
                    "meta": {
                      "domId": "flxToggle", 
                      "name": "flxToggle"
                    }, 
                    "position": {
                      "shrink": 0, 
                      "display": false
                    }
                  }, 
                  {
                    "type": "ia.input.dropdown", 
                    "props": {
                      "options": [
                        {
                          "label": "kanoa blue", 
                          "value": "kanoa-light"
                        }, 
                        {
                          "label": "dark", 
                          "value": "kanoa-dark"
                        }, 
                        {
                          "label": "forest", 
                          "value": "kanoa-forest"
                        }, 
                        {
                          "label": "firetruck", 
                          "value": "kanoa-firetruck"
                        }, 
                        {
                          "label": "orange", 
                          "value": "kanoa-orange"
                        }, 
                        {
                          "label": "grape", 
                          "value": "kanoa-grape"
                        }, 
                        {
                          "label": "ignition-dark", 
                          "value": "dark"
                        }
                      ], 
                      "style": {
                        "background-color": "--kcSurface"
                      }
                    }, 
                    "meta": {
                      "domId": "dropdown", 
                      "name": "dropdown"
                    }, 
                    "position": {
                      "basis": "36px"
                    }, 
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "type": "property", 
                          "overlayOptOut": true, 
                          "config": {
                            "bidirectional": true, 
                            "path": "session.props.theme"
                          }
                        }
                      }
                    }
                  }
                ], 
                "meta": {
                  "domId": "flxThemes", 
                  "name": "flxThemes"
                }, 
                "position": {
                  "shrink": 0
                }
              }, 
              {
                "type": "ia.container.flex", 
                "props": {
                  "style": {
                    "gap": 5
                  }, 
                  "direction": "column"
                }, 
                "children": [
                  {
                    "type": "ia.display.label", 
                    "props": {
                      "style": {
                        "fontSize": "1.25em", 
                        "fontWeight": "500"
                      }, 
                      "text": "Languages"
                    }, 
                    "meta": {
                      "domId": "lblHeader-1", 
                      "name": "lblHeader"
                    }, 
                    "position": {
                      "shrink": 0
                    }
                  }, 
                  {
                    "type": "ia.container.flex", 
                    "children": [
                      {
                        "type": "ia.input.radio-group", 
                        "props": {
                          "orientation": "column", 
                          "align": "start", 
                          "radioStyle": {
                            "margin": "-10px 0px", 
                            "fontSize": "0.8em"
                          }, 
                          "selectedIcon": {
                            "color": {
                              "enabled": "--kcDockColor"
                            }, 
                            "path": "material/double_arrow", 
                            "style": {
                              "width": "0.8em"
                            }
                          }, 
                          "radios": [
                            {
                              "text": "English", 
                              "value": "en-US", 
                              "selected": true
                            }, 
                            {
                              "text": "Español", 
                              "value": "es-US", 
                              "selected": false
                            }, 
                            {
                              "text": "Francais", 
                              "value": "fr", 
                              "selected": false
                            }, 
                            {
                              "text": "Deutsch", 
                              "value": "de", 
                              "selected": false
                            }, 
                            {
                              "text": "Italiano", 
                              "value": "it", 
                              "selected": false
                            }, 
                            {
                              "text": "中文 (Chinese)", 
                              "value": "zh-US", 
                              "selected": false
                            }, 
                            {
                              "text": "한국어 (Korean)", 
                              "value": "ko", 
                              "selected": false
                            }
                          ], 
                          "style": {
                            "color": "--kcPrimary"
                          }, 
                          "unselectedIcon": {
                            "path": "material/double_arrow", 
                            "style": {
                              "width": "0.8em"
                            }
                          }
                        }, 
                        "meta": {
                          "domId": "RadioGroup", 
                          "name": "RadioGroup"
                        }, 
                        "position": {
                          "shrink": 0
                        }, 
                        "propConfig": {
                          "props.value": {
                            "binding": {
                              "type": "property", 
                              "config": {
                                "bidirectional": true, 
                                "path": "session.props.locale"
                              }
                            }
                          }
                        }
                      }
                    ], 
                    "meta": {
                      "domId": "flxToggle-1", 
                      "name": "flxToggle"
                    }, 
                    "position": {
                      "shrink": 0
                    }
                  }
                ], 
                "meta": {
                  "domId": "flxLanguage", 
                  "name": "flxLanguage"
                }, 
                "position": {
                  "shrink": 0
                }
              }
            ], 
            "meta": {
              "domId": "flxOptions", 
              "name": "flxOptions"
            }
          }, 
          {
            "type": "ia.container.flex", 
            "children": [
              {
                "type": "ia.display.iframe", 
                "props": {
                  "src": "http://docs.kanoa.ai"
                }, 
                "meta": {
                  "domId": "IFrame", 
                  "name": "IFrame"
                }, 
                "position": {
                  "grow": 1
                }
              }
            ], 
            "meta": {
              "domId": "flxHelp", 
              "name": "flxHelp"
            }, 
            "position": {
              "tabIndex": 1
            }
          }
        ], 
        "meta": {
          "domId": "tabCnt", 
          "name": "tabCnt"
        }, 
        "position": {
          "grow": 1
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [], 
          "script": "\tfilePath = 'C:\\Program Files\\Inductive Automation\\Ignition\\data\\projects\\KanoaFrameworkInfo.json'\n\tjsonFile = system.file.readFileAsString(filePath)\n\tframeworkInfo = system.util.jsonDecode(jsonFile)\n\tself.session.custom.kanoa.frameworkInfo = frameworkInfo", 
          "name": "getFrameworkInfo"
        }
      ], 
      "extensionFunctions": null
    }
  }
}