{
  "custom": {
    "debug": {
      "clear": false,
      "test": {
        "bug": false,
        "failed": false,
        "info": false,
        "normal": false,
        "success": false,
        "warning": false
      }
    },
    "popupTime": 1,
    "show": false,
    "timer": 0,
    "uuid": "3967e95e-2d68-4e57-8146-042890f8a99f"
  },
  "params": {
    "bgColor": "#666666",
    "fgColor": "white",
    "icon": "",
    "message": ""
  },
  "propConfig": {
    "custom.debug": {
      "persistent": true
    },
    "custom.debug.clear": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.message \u003d \u0027\u0027\n\t\tself.params.bgColor \u003d \u0027\u0027\n\t\tself.params.fgColor \u003d \u0027\u0027\n\t\tself.params.icon \u003d \u0027\u0027\n\t\tself.custom.debug.clear \u003d False"
      }
    },
    "custom.debug.test.bug": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showBugToast\u0027, \u0027Error 404: Your brain was not found!\u0027)\n\t\tself.custom.debug.test.bug \u003d False"
      }
    },
    "custom.debug.test.failed": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, \u0027Oh no! It didn\\\u0027t work.\u0027)\n\t\tself.custom.debug.test.failed \u003d False"
      }
    },
    "custom.debug.test.info": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showInfoToast\u0027, u\u0027The weather is sunny with a high of 68°F.\u0027)\n\t\tself.custom.debug.test.info \u003d False"
      }
    },
    "custom.debug.test.normal": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showToast\u0027, \u0027Hello. My name is Frank.\u0027)\n\t\tself.custom.debug.test.normal \u003d False"
      }
    },
    "custom.debug.test.success": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Good Job! You did it.\u0027)\n\t\tself.custom.debug.test.success \u003d False"
      }
    },
    "custom.debug.test.warning": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tsystem.perspective.sendMessage(\u0027showWarningToast\u0027, \u0027Watch out! The monster is right behind you!\u0027)\n\t\tself.custom.debug.test.warning \u003d False"
      }
    },
    "custom.popupTime": {
      "persistent": true
    },
    "custom.show": {
      "binding": {
        "config": {
          "path": "view.custom.uuid"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn True",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.timer": {
      "binding": {
        "config": {
          "expression": "now(1000)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tvalue \u003d float(self.custom.timer or 0)\n\n\tif value \u003c\u003d self.custom.popupTime:\n\t\tself.custom.show \u003d False\n\t\n\tif value \u003e 0:\n\t\treturn value - 1\n\telse:\n#\t\tself.params.message \u003d \u0027\u0027\n\t\treturn 0",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.uuid": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value !\u003d \u0027\u0027:\n\t\tfrom math import ceil\n\t\tmessage \u003d self.params.message\n\t\twordPerMinute \u003d 150\n\t\twordCount \u003d len(message.split(\u0027 \u0027))\n\t\tduration \u003d ceil(wordCount / float(wordPerMinute) * 60.0)\n\t\t\n\t\tpopupTime \u003d self.custom.popupTime or 0\n\t\t\n\t\tself.custom.timer \u003d duration + popupTime * 2"
      },
      "persistent": true
    },
    "params.bgColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.fgColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.message": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 500,
      "width": 500
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "Icon",
              "name": "Icon"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.params.icon"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn (value or None) is not None",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.color": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.fgColor"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.icon"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "aspectRatio": 1,
                "height": 30,
                "width": 20
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "domId": "lblMessage",
              "name": "lblMessage"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.params.message"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "minHeight": 30
              },
              "textStyle": {
                "classes": "kanoa/font/default",
                "whiteSpace": "pre-line"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxDisplay",
          "name": "flxDisplay"
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.bgColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          },
          "props.style.color": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.fgColor"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "flex-start",
          "style": {
            "borderRadius": 5,
            "gap": 5,
            "height": "auto",
            "padding": "5px 10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "propConfig": {
      "custom.debug": {
        "binding": {
          "config": {
            "bidirectional": true,
            "path": "view.custom.debug"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      },
      "custom.show": {
        "binding": {
          "config": {
            "bidirectional": true,
            "path": "view.custom.show"
          },
          "overlayOptOut": true,
          "type": "property"
        }
      },
      "props.style.bottom": {
        "binding": {
          "config": {
            "path": "view.custom.show"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn 25 if value else -10",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.opacity": {
        "binding": {
          "config": {
            "path": "view.custom.show"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn 1 if value else 0",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.position": {
        "binding": {
          "config": {
            "path": "session.props.device.type"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027relative\u0027 if value \u003d\u003d \u0027designer\u0027 else \u0027fixed\u0027\n\tsystem.perspective.print(self.props.style.position)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.transform": {
        "binding": {
          "config": {
            "path": "view.custom.show"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\treturn \u0027translateY(0%)\u0027 if value else \u0027translateY(100%)\u0027",
              "type": "script"
            }
          ],
          "type": "property"
        }
      },
      "props.style.transition": {
        "binding": {
          "config": {
            "path": "view.custom.show"
          },
          "overlayOptOut": true,
          "transforms": [
            {
              "code": "\tpopupTime \u003d self.view.custom.popupTime\n\topacityCurve \u003d \u0027cubic-bezier(%g,%g,%g,%g)\u0027 % ((0.5, 0.5, 0.5, 3) if not value else (0.5, -1, 0.5, 0.5))\n\treturn \u0027opacity %gs %s, transform %gs, bottom %gs ease\u0027 % (popupTime, opacityCurve, popupTime, popupTime)",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "backgroundColor": "transparent",
        "left": "10px",
        "pointerEvents": "none",
        "right": "10px",
        "zIndex": 99999
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "showMessage",
          "params": [
            "message\u003d\u0027\u0027",
            "bgColor\u003d\u0027\u0027",
            "fgColor\u003d\u0027\u0027",
            "icon\u003d\u0027\u0027"
          ],
          "script": "\t\n\tself.view.params.bgColor \u003d bgColor or \u0027#666666\u0027\n\tself.view.params.fgColor \u003d fgColor or \u0027white\u0027\n\tself.view.params.icon \u003d icon or \u0027\u0027\n\tself.view.params.message \u003d message or \u0027\u0027\n\tif message:\tself.view.custom.uuid \u003d str(system.kanoa.utilities.getUUID())"
        },
        {
          "name": "processPayload",
          "params": [
            "payload"
          ],
          "script": "\treturn payload if str(type(payload)) \u003d\u003d \"\u003ctype \u0027dict\u0027\u003e\" else {\u0027message\u0027: payload}"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "showToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "showSuccessfulToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\n\tif not \u0027bgColor\u0027 in payload: payload[\u0027bgColor\u0027] \u003d \u0027forestGreen\u0027\n\tif not \u0027fgColor\u0027 in payload: payload[\u0027fgColor\u0027] \u003d \u0027white\u0027\n\tif not \u0027icon\u0027 in payload: payload[\u0027icon\u0027] \u003d \u0027material/check_circle\u0027\n\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "showFailerToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\n\tif not \u0027bgColor\u0027 in payload: payload[\u0027bgColor\u0027] \u003d \u0027fireBrick\u0027\n\tif not \u0027fgColor\u0027 in payload: payload[\u0027fgColor\u0027] \u003d \u0027white\u0027\n\tif not \u0027icon\u0027 in payload: payload[\u0027icon\u0027] \u003d \u0027material/error\u0027\n\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "showBugToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\n\tif not \u0027bgColor\u0027 in payload: payload[\u0027bgColor\u0027] \u003d \u0027#EE9933\u0027\n\tif not \u0027fgColor\u0027 in payload: payload[\u0027fgColor\u0027] \u003d \u0027white\u0027\n\tif not \u0027icon\u0027 in payload: payload[\u0027icon\u0027] \u003d \u0027material/bug_report\u0027\n\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "showWarningToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\n\tif not \u0027bgColor\u0027 in payload: payload[\u0027bgColor\u0027] \u003d \u0027#AF9E00\u0027\n\tif not \u0027fgColor\u0027 in payload: payload[\u0027fgColor\u0027] \u003d \u0027white\u0027\n\tif not \u0027icon\u0027 in payload: payload[\u0027icon\u0027] \u003d \u0027material/warning\u0027\n\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "showInfoToast",
          "pageScope": true,
          "script": "\tpayload \u003d self.processPayload(payload)\n\t\n\tif not \u0027bgColor\u0027 in payload: payload[\u0027bgColor\u0027] \u003d \u0027#0077AA\u0027\n\tif not \u0027fgColor\u0027 in payload: payload[\u0027fgColor\u0027] \u003d \u0027white\u0027\n\tif not \u0027icon\u0027 in payload: payload[\u0027icon\u0027] \u003d \u0027material/info\u0027\n\t\n\tself.showMessage(**payload)",
          "sessionScope": true,
          "viewScope": true
        },
        {
          "messageType": "closeToast",
          "pageScope": true,
          "script": "\t\"\"\"\n\tForces the toast to close itself immediately\n\t\"\"\"\n\t\n\tself.view.custom.timer \u003d 0\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}