{
  "custom": {
    "current": {
      "index": 0
    },
    "dashboardInfo": [],
    "marqueeInfo": {
      "changedBy": null,
      "changedByUser": null,
      "changedDate": null,
      "createdBy": null,
      "createdByUser": null,
      "createdDate": null,
      "enabled": null,
      "marqueeDescription": null,
      "marqueeId": null,
      "marqueeName": null
    },
    "play": true
  },
  "params": {
    "marqueeId": null
  },
  "propConfig": {
    "custom.current": {
      "persistent": true
    },
    "custom.current.checkTime": {
      "binding": {
        "config": {
          "expression": "now(1000)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif self.params.marqueeId is None or not self.custom.play: return 0\n\tself.custom.current.timer \u003d (self.custom.current.timer or 30) - 1\n\t\n\treturn system.date.format(value, \u0027ss\u0027)",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "custom.current.timer": {
      "binding": {
        "config": {
          "struct": {
            "dashboardInfo": "{view.custom.dashboardInfo}",
            "index": "{view.custom.current.index}",
            "play": "{view.custom.play}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tindex \u003d value.index\n\tdashboardInfo \u003d value.dashboardInfo\n\tif not value.play or self.params.marqueeId is None: return 0\n\t\t\n\tduration \u003d dashboardInfo[index].duration if dashboardInfo else 0\n\t\n\treturn duration if value.play else 0",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\n\tif self.params.marqueeId is None or not self.custom.play: return\n\tif currentValue.value \u003c\u003d 0: self.custom.current.index \u003d (self.custom.current.index + 1) % len(self.custom.dashboardInfo)\n\t\n\treturn"
      }
    },
    "custom.dashboardInfo": {
      "binding": {
        "config": {
          "path": "view.params.marqueeId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tself.custom.current.index \u003d 0\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.dashboard.getMarqueeDashboards({\u0027marqueeId\u0027: int(value or -1)}))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.marqueeInfo": {
      "binding": {
        "config": {
          "path": "view.params.marqueeId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getMarquees({\u0027marqueeId\u0027: int(value or -1)}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.play": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn True",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.marqueeId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 847,
      "width": 1500
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblMarqueeName",
              "name": "lblMarqueeName"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.marqueeInfo.marqueeName"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value or \u0027No Marquee\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "parent.custom.fontSize"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "color": "--kcOnSurface",
                "fontWeight": "bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblDashboardName",
              "name": "lblDashboardName",
              "tooltip": {
                "delay": 0,
                "enabled": true,
                "location": "top",
                "sustain": 0,
                "tail": false
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.current.dashboardId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn \u0027Dashboard Id: {}\u0027.format(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "struct": {
                      "dashboardInfo": "{view.custom.dashboardInfo}",
                      "index": "{view.custom.current.index}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\ttry:\n\t\treturn system.kanoa.utilities.formatPath(value[\u0027dashboardInfo\u0027][value[\u0027index\u0027]][\u0027dashboardPath\u0027], {})\n\texcept:\n\t\treturn \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "parent.custom.fontSize"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "textStyle": {
                "color": "--kcOnSurface",
                "fontWeight": "bold"
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "meta": {
                  "domId": "rptLED",
                  "name": "rptLED"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "config": {
                        "struct": {
                          "dashboardInfo": "{view.custom.dashboardInfo}",
                          "index": "{view.custom.current.index}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\t\n\treturn [{\u0027on\u0027: i \u003d\u003d value[\u0027index\u0027]} for i in range(len(value[\u0027dashboardInfo\u0027]))]\t\t",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
                  }
                },
                "props": {
                  "alignItems": "center",
                  "elementStyle": {
                    "border": "1px solid #888",
                    "borderRadius": 50,
                    "height": 10,
                    "width": 10
                  },
                  "path": "kanoa/core/dbp/marquee/led",
                  "style": {
                    "gap": "3px",
                    "padding": 5
                  },
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false
                },
                "type": "ia.display.flex-repeater"
              },
              {
                "meta": {
                  "domId": "lblTimer",
                  "name": "lblTimer"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "meta.visible": {
                    "binding": {
                      "config": {
                        "path": "view.custom.current.timer"
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\treturn value \u003e 0",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.current.timer"
                      },
                      "overlayOptOut": true,
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "kanoa/button/flatIcon",
                    "textAlign": "center",
                    "width": "45px"
                  },
                  "textStyle": {
                    "color": "--kcOnSurface",
                    "fontSize": "30px",
                    "fontWeight": "bold"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "domId": "flxCount",
              "name": "flxCount"
            },
            "position": {
              "shrink": 0
            },
            "type": "ia.container.flex"
          }
        ],
        "custom": {
          "fontSize": "max(3.5vh, 1.1rem)"
        },
        "meta": {
          "domId": "flxBanner",
          "name": "flxBanner"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "gap": "5px",
            "padding": "3px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "evDashboardViewer",
          "name": "evDashboardViewer"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.params.value.dashboardId": {
            "binding": {
              "config": {
                "struct": {
                  "dashboardInfo": "{view.custom.dashboardInfo}",
                  "index": "{view.custom.current.index}"
                },
                "waitOnAll": true
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\n\ttry:\n\t\treturn value[\u0027dashboardInfo\u0027][value[\u0027index\u0027]][\u0027dashboardId\u0027]\n\texcept:\n\t\treturn null",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "params": {
            "value": {
              "headless": true
            }
          },
          "path": "kanoa/core/dbp/dashboards/dashboardViewer"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "domId": "Label",
          "name": "Label"
        },
        "position": {
          "basis": "32px",
          "display": false
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.marqueeId"
              },
              "transforms": [
                {
                  "code": "\treturn str(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/container"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "domId": "Label_0",
          "name": "Label_0"
        },
        "position": {
          "basis": "32px",
          "display": false
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.marqueeInfo"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\treturn str(value)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/container"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root",
      "tooltip": {
        "tail": false
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden",
        "position": "relative"
      }
    },
    "type": "ia.container.flex"
  }
}