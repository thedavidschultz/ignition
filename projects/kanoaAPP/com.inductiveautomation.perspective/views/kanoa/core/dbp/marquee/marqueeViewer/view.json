  "propConfig": {
    "custom.marquee": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tif value['siteCode'] is None or value['location'] is None or value['screenName'] is None:\n\t\treturn {'marqueeDisplayId': None, 'marqueeId': None, 'msg': None}\n\n\tparamsDict = {'siteCode': value['siteCode'], 'location': value['location'], 'screenName': value['screenName'], 'enabled': True}\n\tmarqueeDisplayInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getMarqueeDisplay(paramsDict),0)\n\t\n\tif marqueeDisplayInfo['marqueeDisplayId'] is None:\n\t\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\t\tmarqueeDisplayInfo = paramsDict\n\t\tmarqueeDisplayInfo['marqueeId'] = None\n\t\tmarqueeDisplayInfo['enabled'] = True\n\t\tmarqueeDisplayInfo['theme'] = self.session.props.theme\n\t\tmarqueeDisplayId, msg = system.kanoa.dashboard.addMarqueeDisplay(marqueeDisplayInfo, userId)\n\t\tmarqueeId = None\n\telse: \n\t\tmarqueeId = marqueeDisplayInfo['marqueeId']\n\t\tmarqueeDisplayId = marqueeDisplayInfo['marqueeDisplayId']\n\t\tif marqueeDisplayInfo['theme']: self.session.props.theme = marqueeDisplayInfo['theme']\n\t\tmsg = None\n\t\n\treturn {'marqueeDisplayId': marqueeDisplayId, 'marqueeId': marqueeId, 'msg': msg}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "siteCode": "{view.params.siteCode}", 
            "screenName": "{view.params.screenName}", 
            "lastUpdated": "{view.custom.lastUpdated}", 
            "location": "{view.params.location}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "params.siteCode": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "params.location": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.lastUpdated": {
      "binding": {
