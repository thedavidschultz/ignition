{
  "custom": {
    "display": {
      "siteCode": "", 
      "screenName": "", 
      "location": ""
    }, 
    "url": "http://dev.kanoa.ai/data/perspective/client/kanoaMarquee/marquee/display///"
  }, 
  "params": {}, 
  "props": {
    "defaultSize": {
      "width": 657, 
      "height": 180
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "padding": "5px", 
        "classes": "kanoa/font/default", 
        "gap": "5px"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.container.flex", 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Site Code"
            }, 
            "meta": {
              "domId": "lbl", 
              "name": "lbl"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "deferUpdates": false
            }, 
            "meta": {
              "domId": "txt", 
              "name": "txt"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "250px"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.display.siteCode"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxSiteCode", 
          "name": "flxSiteCode"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Location"
            }, 
            "meta": {
              "domId": "lbl-1", 
              "name": "lbl"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "deferUpdates": false
            }, 
            "meta": {
              "domId": "txt-1", 
              "name": "txt"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "250px"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.display.location"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxLocation", 
          "name": "flxLocation"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "Screen Name"
            }, 
            "meta": {
              "domId": "lbl-2", 
              "name": "lbl"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.input.text-field", 
            "props": {
              "deferUpdates": false
            }, 
            "meta": {
              "domId": "txt-2", 
              "name": "txt"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "250px"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "bidirectional": true, 
                    "path": "view.custom.display.screenName"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxScreenName", 
          "name": "flxScreenName"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "children": [
          {
            "type": "ia.display.label", 
            "props": {
              "text": "URL"
            }, 
            "meta": {
              "domId": "lbl-3", 
              "name": "lbl"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }
          }, 
          {
            "type": "ia.display.label", 
            "meta": {
              "domId": "lblURL", 
              "name": "lblURL"
            }, 
            "position": {
              "shrink": 0, 
              "basis": "80px"
            }, 
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.custom.url"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxURL", 
          "name": "flxURL"
        }, 
        "position": {
          "basis": "30px"
        }
      }, 
      {
        "type": "ia.container.flex", 
        "props": {
          "justify": "center", 
          "style": {
            "gap": "10px"
          }
        }, 
        "children": [
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "classes": "kanoa/button/filled"
              }, 
              "text": "OK"
            }, 
            "meta": {
              "domId": "btnOK", 
              "name": "btnOK"
            }, 
            "position": {
              "basis": "80px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tparams = {}\n\tsystem.perspective.navigate(url=self.view.custom.url, params=params, newTab=True)\n\tsystem.perspective.sendMessage('refreshMarqueeDisplays', {})\n\tsystem.perspective.closePopup('')\n\n\treturn"
                  }
                }
              }
            }, 
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "transforms": [
                    {
                      "code": "\t\n\treturn value['siteCode'] != '' and value['location'] != '' and value['screenName'] != ''", 
                      "type": "script"
                    }
                  ], 
                  "type": "property", 
                  "overlayOptOut": true, 
                  "config": {
                    "path": "view.custom.display"
                  }
                }
              }
            }
          }, 
          {
            "type": "ia.input.button", 
            "props": {
              "style": {
                "classes": "kanoa/button/outlined"
              }, 
              "text": "Close"
            }, 
            "meta": {
              "domId": "btnClose", 
              "name": "btnClose"
            }, 
            "position": {
              "basis": "80px"
            }, 
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script", 
                  "scope": "G", 
                  "config": {
                    "script": "\t\n\tsystem.perspective.closePopup('')\n\t\n\treturn"
                  }
                }
              }
            }
          }
        ], 
        "meta": {
          "domId": "flxAction", 
          "name": "flxAction"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "30px"
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.display": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn {\"siteCode\": \"\", \"location\": \"\", \"screenName\": \"\"}", 
            "type": "script"
          }
        ], 
        "type": "expr", 
        "overlayOptOut": true, 
        "config": {
          "expression": "now(0)"
        }
      }, 
      "persistent": true
    }, 
    "custom.url": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tgatewayAddress = self.session.props.gateway.address[:-1]\n\treturn \"{}/data/perspective/client/kanoaMarquee/marquee/display/{}/{}/{}\".format(gatewayAddress, value['siteCode'], value['location'], value['screenName'])", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.display"
        }
      }, 
      "persistent": true
    }
  }
}