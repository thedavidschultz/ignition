  "params": {
    "value": {
      "options": [], 
      "value": ""
    }
  }, 
  "props": {
    "defaultSize": {
      "width": 200, 
      "height": 25
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "backgroundColor": "--kcSurface"
      }, 
      "direction": "column"
    }, 
    "children": [
      {
        "type": "ia.input.dropdown", 
        "props": {
          "showClearIcon": true, 
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default"
          }, 
          "style": {
            "classes": "kanoa/font/default"
          }
        }, 
        "meta": {
          "tooltip": {
            "tail": false, 
            "delay": 0, 
            "location": "top"
          }, 
          "domId": "dropdown", 
          "name": "dropdown"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "25px"
        }, 
        "propConfig": {
          "props.options": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.params.value.options"
              }
            }
          }, 
          "props.value": {
            "onChange": {
              "enabled": null, 
              "script": "\n\tif origin == 'Browser':\n\t\tsystem.perspective.sendMessage('marqueeSelected', {'marqueeName': self.props.value})\n\t\t\n\treturn"
            }, 
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.value.value"
              }
            }
          }, 
          "props.enabled": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\treturn value['canUpdate']", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.custom.userAction"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.userAction": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tsecurity = value['security']\n\tcanCreate = False\n\tcanEdit = False\n\tif security['userCRUD'] is not None and security['userId'] is not None:\n\t\tif security['userCRUD']['isGatewayAdmin'] or security['userCRUD']['operateAssets']['enabled']:\n\t\t\tcanCreate = True\n\t\t\tcanEdit = True\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "security": "{view.custom.security}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}