        {
          "viewScope": false, 
          "script": "\n\tself.view.refreshBinding(\"custom.marqueeDashboardData.marqueeDashboards\")\n\t\n\treturn", 
          "messageType": "marqueeDashboardUpdate", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\n\tsystem.perspective.print(\"deleteMarquee() called\")\n\n\tuserId = self.view.custom.security.userId\n\tmarqueDashboardInfo = self.view.custom.marqueeDashboardData.selection.marqueDashboardInfo\n\n\tif marqueDashboardInfo['marqueeDashboardId'] is None: \n\t\tsystem.perspective.sendMessage('showFailerToast', 'No marquee selected')\n\t\treturn\n\t\t\n\tretVal, msg = system.kanoa.dashboard.deleteMarqueeDashboard(marqueDashboardInfo['marqueeDashboardId'], userId)\n\n\tself.view.refreshBinding(\"custom.marqueeDashboardData.marqueeDashboards\")\n\t\n\tif msg:\tsystem.perspective.sendMessage('showFailerToast', msg)\n\telse: system.perspective.sendMessage('showSuccessfulToast', 'Marquee has been deleted')\n\t\n\treturn", 
          "name": "deleteMarqueeDashboard"
        }
      ], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.marqueeDashboardData.marqueeDashboards": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.dashboard.getMarqueeDashboards({'marqueeId': value['marqueeId']}))", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.params.value"
        }
      }
    }, 
    "custom.security": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tsecConfig = system.kanoa.utilities.convertDatasetToDict(system.kanoa.security.getConfig({}), 'configName', 'configValue')\n\tuserId = system.kanoa.security.getIDPUserId(value['user'])\n\tuserCRUD = system.kanoa.security.getUserAssetCRUD(userId)\n\t\n\treturn {\"userId\": userId, \"config\": secConfig, \"userCRUD\": userCRUD}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "user": "{session.props.auth.user}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.marqueeDashboardData.selection.marqueDashboardInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tmarqueeDashboardId = self.custom.marqueeDashboardData.marqueeDashboards[value].marqueeDashboardId if value is not None else -1\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getMarqueeDashboards({'marqueeDashboardId': marqueeDashboardId}),0)", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.marqueeDashboardData.selection.row"
        }
      }
    }, 
    "custom.marqueeDashboardData": {
      "persistent": true
    }, 
    "custom.userAction": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tsecurity = value['security']\n\tcanCreate = False\n\tcanEdit = False\n\tif security['userCRUD'] is not None and security['userId'] is not None:\n\t\tif security['userCRUD']['isGatewayAdmin'] or security['userCRUD']['operateAssets']['enabled']: \n\t\t\tcanCreate = True\n\t\t\tcanEdit = True if (value['marqueeDashboardInfo']['marqueeDashboardId']) is not None else False\n\t\t\t\n\treturn {\"canCreate\": canCreate, \"canDelete\": canEdit, \"canRead\": True, \"canUpdate\": canEdit}", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "marqueeDashboardInfo": "{view.custom.marqueeDashboardData.selection.marqueDashboardInfo}", 
            "security": "{view.custom.security}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
