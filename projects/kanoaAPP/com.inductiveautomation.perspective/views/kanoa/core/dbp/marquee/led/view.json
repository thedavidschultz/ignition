{
  "custom": {}, 
  "params": {
    "on": false
  }, 
  "props": {
    "defaultSize": {
      "width": 30, 
      "height": 30
    }
  }, 
  "root": {
    "type": "ia.container.flex", 
    "props": {
      "style": {
        "overflow": "hidden"
      }, 
      "direction": "column"
    }, 
    "meta": {
      "domId": "root", 
      "name": "root"
    }, 
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "transforms": [
            {
              "code": "\treturn '#90ee90' if value else '#eeeeee'", 
              "type": "script"
            }
          ], 
          "type": "property", 
          "overlayOptOut": true, 
          "config": {
            "path": "view.params.on"
          }
        }
      }
    }
  }, 
  "propConfig": {
    "params.on": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}