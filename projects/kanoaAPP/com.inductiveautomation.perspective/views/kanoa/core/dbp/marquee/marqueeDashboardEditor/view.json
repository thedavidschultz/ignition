        "classes": "kanoa/container kanoa/font/default",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "saveData",
          "params": [],
          "script": "\n\tmarqueeDashboardInfo \u003d dict(self.view.custom.marqueeDashboardInfo)\n\tsystem.perspective.print(\"saveData() called with %s\"%marqueeDashboardInfo)\n\n\tuserId \u003d system.kanoa.security.getIDPUserId(self.session.props.auth.user)\t\n\n\tif marqueeDashboardInfo[\u0027marqueeDashboardId\u0027] is None:\n\t\tmarqueeDashboardInfo[\u0027marqueeId\u0027] \u003d self.view.params.value.marqueeId\n\t\tmarqueeDashboardId, msg \u003d system.kanoa.dashboard.addMarqueeDashboard(marqueeDashboardInfo, userId)\n\telse:\n\t\tretVal, msg \u003d system.kanoa.dashboard.updateMarqueeDashboard(marqueeDashboardInfo, userId)\n\n\tself.view.refreshBinding(\"custom.marqueeDashboardInfo\")\n\t\n\tif msg:\tsystem.perspective.sendMessage(\u0027showFailerToast\u0027, msg)\n\telse: system.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Marquee has been saved\u0027)\n\t\n\timport time\n\ttime.sleep(1)\t#give a chance for the user to see the success popup\n\n\tsystem.perspective.sendMessage(\u0027marqueeDashboardUpdate\u0027, {})\n\treturn\t"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "dashboardSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\u0027dashboardSelected() msg rcvd with %s\u0027%payload)\n\tself.view.custom.marqueeDashboardInfo[\u0027dashboardId\u0027] \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027dashboardId\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 else None\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
