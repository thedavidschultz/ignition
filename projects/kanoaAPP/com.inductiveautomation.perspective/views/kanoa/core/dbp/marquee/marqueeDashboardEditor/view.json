          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tself.view.getChild(\"root\").saveData()\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save Production Order"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.marqueeDashboardInfo.dashboardId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value is not None",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "struct": {
                      "info": "{view.custom.info}",
                      "workOrders": "{view.params.workOrders}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tif len(value.workOrders) \u003e 1: return True\t#This is a bulk edit\n\tif (value.info.workOrderName or None) is None: return False\n\tif value.info.workOrderStatusId is None: return False\n\tif value.info.itemId is None: return False\n\tif value.info.modeId is None: return False\n\n\treturn True",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
