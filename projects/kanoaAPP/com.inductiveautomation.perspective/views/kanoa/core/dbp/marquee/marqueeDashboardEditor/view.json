  "propConfig": {
    "custom.marqueeDashboardInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tmarqueeDashboardId \u003d value[\u0027marqueeDashboardId\u0027]\n\tif marqueeDashboardId is None: marqueeDashboardId \u003d -1\n\n\tmarqueeDashboardInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getMarqueeDashboards({\u0027marqueeDashboardId\u0027: marqueeDashboardId}), 0)\n\t\n\tif value[\u0027marqueeDashboardId\u0027] is None:\n\t\tmarqueeDashboardInfo[\u0027duration\u0027] \u003d 30\n\t\tmarqueeDashboardInfo[\u0027sortOrder\u0027] \u003d 0\n\t\tmarqueeDashboardInfo[\u0027enabled\u0027] \u003d True\n\t\t\n\treturn marqueeDashboardInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 688
    }
  },
