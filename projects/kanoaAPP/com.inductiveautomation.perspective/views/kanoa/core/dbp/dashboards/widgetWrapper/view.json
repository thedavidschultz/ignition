{
  "custom": {
    "widgetInfo": {
      "changedBy": null,
      "changedDate": null,
      "createdBy": null,
      "createdDate": null,
      "dashboardWidgetId": null,
      "enabled": null,
      "path": null,
      "sortOrder": null,
