  "propConfig": {
    "custom.widgetInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027dashboardWidgetId\u0027]:\n\t\tdashboardWidgetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getDashboardWidgets({\u0027dashboardWidgetId\u0027: value[\u0027dashboardWidgetId\u0027] or -1}),0)\n\telse:\n\t\tdashboardWidgetInfo \u003d system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getWidgets({\u0027widgetId\u0027: value[\u0027widgetId\u0027] or -1}),0)\n\t\tdashboardWidgetInfo[\u0027dashboardWidgetId\u0027] \u003d None\n\t\t\n\tdashboardWidgetInfo[\u0027widgetDescription\u0027] \u003d dashboardWidgetInfo[\u0027widgetDescription\u0027]  or \u0027\u0027\n\tdashboardWidgetInfo[\u0027viewParams\u0027] \u003d dashboardWidgetInfo[\u0027viewParams\u0027]  or \u0027\u0027\n\t\n\treturn dashboardWidgetInfo",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.widgetInfo.widget": {
      "binding": {
        "config": {
          "path": "view.params.value.widgetId"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getWidgets({\u0027widgetId\u0027: value or -1}),0)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "params.configuring": {
      "onChange": {
        "enabled": null,
        "script": "\t\n#\tsystem.perspective.print(\"configuring change origin %s\"%(origin))\n\twidgetInfo \u003d dict(self.custom.widgetInfo)\n#\tsystem.perspective.print(\"widgetInfo %s\"%(widgetInfo))\n\tif widgetInfo and widgetInfo[\u0027viewPath\u0027]:\n\t\tparams \u003d {\u0027value\u0027:{\u0027widgetId\u0027: self.params.value.widgetId, \u0027dashboardWidgetId\u0027: self.params.value.dashboardWidgetId}}\n\t\tif currentValue.value:\tsystem.perspective.openPopup(widgetInfo[\u0027viewPath\u0027], \u0027kanoa/core/dbp/dashboards/dashboardWidgetConfigurator\u0027, params, title \u003d \u0027Configure Widget\u0027, overlayDismiss \u003d True, resizable\u003dTrue, showCloseIcon\u003dTrue, draggable\u003dTrue)\t\n\t\telse: system.perspective.closePopup(widgetInfo[\u0027viewPath\u0027])\n\t\n\treturn"
      },
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 471,
      "width": 892
    }
  },
  "root": {
    "children": [
      {
        "children": [
