    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "widgetAssetSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"widgetAssetSelected msg rcvd with %s\"%payload)\n\tassetPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 else None\n\t\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "refreshDashboardWidgetParams",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"refreshDashboardWidgetParams msg rcvd with %s\"%payload)\t\t\n\tif self.view.params.value.dashboardWidgetId \u003d\u003d payload[\u0027dashboardWidgetId\u0027]:\n\t\tsystem.perspective.print(\"refreshing widgetInfo\")\n\t\tself.view.refreshBinding(\"custom.widgetInfo\")\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
