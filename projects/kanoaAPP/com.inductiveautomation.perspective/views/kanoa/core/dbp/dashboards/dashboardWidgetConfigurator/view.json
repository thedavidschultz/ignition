    "scripts": {
      "messageHandlers": [], 
      "customMethods": [
        {
          "params": [], 
          "script": "\n\n\tsystem.perspective.print('validateViewParams() called with')\n\t\n\tviewParams = self.view.custom.dashboardWidgetInfo.viewParams\n\t\n\ttry:\t\n\t\tviewParams.replace('null', 'None')\n\t\tviewParams.replace('true', 'True')\n\t\tviewParams.replace('false', 'False')\n\t\t\n\t\tviewParams = system.util.jsonDecode(viewParams)\n\t\tsystem.perspective.print(\"viewParams are %s\"%viewParams)\n\t\t\n\t\tfor k,v in viewParams.items():\n\t\t\tsystem.perspective.print(\"%s: %s\"%(k,v))\n\t\t\n\t\tsystem.perspective.sendMessage('showSuccessfulToast', 'viewParams are valid')\n\texcept:\n\t\tmsg = 'viewParams are invalid'\n\t\tsystem.perspective.print(msg)\n\t\tsystem.perspective.sendMessage('showFailerToast', msg)\n\t\tviewParams = None\n\t\n\treturn viewParams", 
          "name": "validateViewParams"
        }, 
        {
          "params": [], 
          "script": "\n\tsystem.perspective.print(\"saveDashboardWidgetParams() called\")\n\t\t\n\tuserId = system.kanoa.security.getIDPUserId(self.session.props.auth.user)\n\tdashboardWidgetInfo = self.view.custom.dashboardWidgetInfo\n\tdashboardWidgetId = dashboardWidgetInfo['dashboardWidgetId']\n\t\n\tif dashboardWidgetId: \t# Save the widget\n\t\tsuccess, msg = system.kanoa.dashboard.updateDashboardWidget(dashboardWidgetInfo, userId)\n\t\tsystem.perspective.print('updateDashboardWidget returned %s %s'%(success, msg))\n\t\tself.view.refreshBinding(\"custom.dashboardWidgetInfo\")\n\telse:\n\t\tdashboardWidgetId, msg = system.kanoa.dashboard.addDashboardWidget(dashboardWidgetInfo, userId)\n\t\tsystem.perspective.print('addDashboardWidget returned %s %s'%(dashboardWidgetId, msg))\n\t\tself.view.params.value.dashboardWidgetId = dashboardWidgetId\n\n\tif msg:\tsystem.perspective.sendMessage('showFailerToast', msg)\n\telse: system.perspective.sendMessage('showSuccessfulToast', 'Dashboard Widget has been saved')\n\t\n\tsystem.perspective.sendMessage('refreshDashboardWidgetParams', {'dashboardWidgetId':dashboardWidgetId})\n\t\n\treturn dashboardWidgetId, msg\t\n\t\n\t", 
          "name": "saveDashboardWidgetParams"
        }
      ], 
      "extensionFunctions": null
    }
