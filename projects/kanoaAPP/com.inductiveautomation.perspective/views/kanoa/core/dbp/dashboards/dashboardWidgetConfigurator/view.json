            "code": "\n\tdashboardWidgetInfo = system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.dashboard.getDashboardWidgets({'dashboardWidgetId': value['dashboardWidgetId'] or -1}),0)\n\tdashboardWidgetInfo['widgetDescription'] = dashboardWidgetInfo['widgetDescription']  or ''\n\tdashboardWidgetInfo['viewParams'] = dashboardWidgetInfo['viewParams']  or ''\n\t\n\treturn dashboardWidgetInfo", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.value"
        }
      }, 
      "persistent": true
    }
