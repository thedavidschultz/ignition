    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"widgetAssetSelected msg rcvd with %s\"%payload)\n\tassetPath = payload['selection'][0]['value']['path'] if len(payload['selection']) > 0 else None\n\t\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\t\n\treturn", 
          "messageType": "widgetAssetSelected", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.table": {
      "persistent": true
    }, 
    "custom.data.dtData": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tif value['assetId'] is None: return system.dataset.toPyDataSet(system.dataset.toDataSet([],[]))\n\tparamsDict = {'assetId': value['assetId'], 'startDate': value['dateRange']['startDate'], 'endDate': value['dateRange']['endDate'], 'showDowntimeOnly': True, 'showChanged': None, 'durationSecs': 0}\n#\treturn system.kanoa.event.getAssetStateEvents(paramsDict) if value['downtimeBy'] == 'Events' else system.kanoa.event.getAssetStateEventsSummary(paramsDict)\n\t\n\timport time\t#There may be a bunch of these widgets on a dashboard. We'll attempt here to stagger the calls to prevent concurrent SQL queries\n\ttime.sleep(1.6)\t\n\t\n\tif value['downtimeBy'] == 'Events':\n\t\tsystem.perspective.print(\"assetDowntimeTable widget calling getAssetStateEvents() after 1.6s delay\")\n\t\tdata = system.kanoa.event.getAssetStateEvents(paramsDict)\n\telse:\n\t\ttime.sleep(1.6)\n\t\tsystem.perspective.print(\"assetDowntimeTable widget calling getAssetStateEventsSummary() after 1.6s delay\")\n\t\tdata = system.kanoa.event.getAssetStateEventsSummary(paramsDict)\t\t\n\t\t\n\treturn data\t", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.custom.filters"
        }
      }
    }, 
    "custom.filters": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tsystem.perspective.print(\"assetDowntimeTable filter binding change\")\n\n\tfilters = system.kanoa.dashboard.getWidgetFilters(value['page'], value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('downtimeBy'): filters['downtimeBy'] = 'Reason'\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = False\n\tif not filters.has_key('colorBy'): filters['colorBy'] = 'State'\n\treturn filters", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "sessionCustomProps": "{session.custom.kanoa}", 
            "page": "{page.props.pageId}", 
            "viewParams": "{view.params.value}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.data": {
      "persistent": true
    }, 
    "custom.table.data": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\tif value is None or len(value)<= 0: return None\n\tdowntimeBy = self.custom.filters.downtimeBy\n\tdata = []\n\tdtData = system.kanoa.utilities.convertDatasetToJSON(value)\n\trowStyle = {\"borderBottomRightRadius\": '5px', \"borderTopLeftRadius\": '5px', \"borderTopRightRadius\": '5px', \"borderBottomLeftRadius\": '5px', \"margin\": '4px'}\n\tfor row in dtData:\n\t\tentry = dict(row)\n\t\tentry['durationMins'] = entry['durationSecs'] / 60.0 if downtimeBy == \"Summary\" else entry['stateDurationSecs'] / 60.0\n\t\trowStyle['backgroundColor'] = row[\"stateColor\"] or row[\"stateTypeColor\"]\n\t\trowStyle['color'] = system.kanoa.utilities.getContrastingColor(row[\"stateColor\"] or row[\"stateTypeColor\"])\n\t\tentry['stateName'] = {'value': row['stateName'], 'style': dict(rowStyle)}\n\t\trowStyle['backgroundColor'] = row[\"stateTypeColor\"]\n\t\trowStyle['color'] = system.kanoa.utilities.getContrastingColor(row[\"stateTypeColor\"])\n\t\tentry['stateTypeName'] = {'value': row['stateTypeName'], 'style': dict(rowStyle)}\n\t\trowStyle['backgroundColor'] = None\n\t\trowStyle['color'] = None\n\t\tentry['stateCategoryName'] = {'value': row['stateCategoryName'], 'style': dict(rowStyle)}\t\t\n\t\tdata.append(entry)\n\t\t\n\treturn sorted(data, key=lambda x: x['durationMins'], reverse = True) if downtimeBy == \"Summary\" else sorted(data, key=lambda x: x['startDate'], reverse = False)", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.data.dtData"
        }
      }
    }
  }
