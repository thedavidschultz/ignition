  "propConfig": {
    "custom.filters": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tfilters = system.kanoa.dashboard.getWidgetFilters(value['page'], value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\tif not filters.has_key('showSummarySelector'): filters['showSummarySelector'] = True\n\tif not filters.has_key('showSummary'): filters['showSummary'] = True\n\treturn filters", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "sessionCustomProps": "{session.custom.kanoa}", 
            "page": "{page.props.pageId}", 
            "viewParams": "{view.params.value}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "custom.data.summary": {
      "binding": {
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\n\tif len(value) == 0:\n\t\treturn []\n\t\n\t# Grouping: (Reason, Asset) → total duration\n\tsummaryMap = defaultdict(float)\n\t\n\tfor entry in value:\n\t\treason = entry.get(\"performanceStateName\") or \"Unspecified\"\n\t\tasset = entry.get(\"assetName\") or \"Unspecified\"\n\t\tkey = (reason, asset)\n\t\n\t\tduration = entry.get(\"value\", 0)\n\t\tsummaryMap[key] += duration\n\t\n\t# Format for table output\n\tsummary = []\n\tfor (reason, asset), total in summaryMap.items():\n\t\tsummary.append({\n\t\t\t\"performanceStateName\": reason,\n\t\t\t\"assetName\": asset,\n\t\t\t\"value\": round(total, 3)\n\t\t})\n\t\n\t# Optionally sort descending by duration\n\tsummary.sort(key=lambda x: x[\"value\"], reverse=True)\n\t\n\treturn summary", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.data.perfEvents"
        }
      }
    }, 
    "custom.data.perfEvents": {
      "binding": {
        "transforms": [
          {
            "code": "\tfilter = value\n\n\tif (filter['assetPath'] or None) is None: return []\n\tassetPath = filter['assetPath'] + '%'\n\tstartDate = filter['dateRange']['startDate']\n\tendDate = filter['dateRange']['endDate']\n\tmodeEventId = None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict = {'assetPath': assetPath, 'startDate': startDate, 'endDate': endDate, 'modeEventId': modeEventId}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getPerformanceEvents(paramsDict))", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.filters"
        }
      }
    }, 
