  "propConfig": {
    "custom.chart": {
      "binding": {
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\t\n\tlogger = system.util.getLogger('lossReasonBarchart')\n\t\n\tCAT_COLOR_AVAIL = '#ba1a1a'\n\tCAT_COLOR_PERF  = '#f4b400'\n\tCAT_COLOR_QUAL  = '#489fe2'\n\tFALLBACK_COLOR  = '#9e9e9e'\n\n\tdef toMinutes(valSecs):\n\t\ttry:\n\t\t\treturn round(float(valSecs)/60.0, 4)\n\t\texcept:\n\t\t\treturn 0.0\n\t\n\ttry:\n\t\tif not value:\n\t\t\treturn {\"series\": [], \"colors\": [], \"xLabels\": []}\n\t\n\t\t# Filters\n\t\tfilters = getattr(self.view.custom, 'filters', {}) or {}\n\t\tbarMode = (filters.get('barMode') or 'byReason')\n\t\ttopN = int(filters.get('topN') or 10)\n\t\n\t\t# Global aggregations\n\t\t# reasonTotals[reason] -> {\"Availability\": mins, \"Performance\": mins, \"Quality\": mins, \"category\": bestGuess}\n\t\treasonTotals = defaultdict(lambda: {\"Availability\":0.0,\"Performance\":0.0,\"Quality\":0.0,\"category\":\"\"})\n\t\n\t\tfor evt in value:\n\t\t\t# Skip non-production for loss math; losses reside in summaries\n\t\t\tdurationSecs = float(evt.get('durationSecs') or 0.0)\n\t\t\toutfeedCount = float(evt.get('outfeedCount') or 0.0)\n\t\t\tsecondsPerUnit = (durationSecs / outfeedCount) if outfeedCount > 0 else 0.0\n\t\n\t\t\t# --- Availability (Downtime) ---\n\t\t\tfor dt in (evt.get('downtimeEventSummary') or []):\n\t\t\t\tstateName = (dt.get('stateName') or '').strip() or 'Unspecified'\n\t\t\t\tstateCategoryName = (dt.get('stateCategoryName') or '').strip()\n\t\t\t\tstateTypeName = (dt.get('stateTypeName') or '').strip()\n\t\t\t\tif stateName == 'Running' or stateCategoryName == 'Running' or stateTypeName == 'Running':\n\t\t\t\t\tcontinue\n\t\t\t\tmins = toMinutes(dt.get('durationSecs') or 0)\n\t\t\t\tif mins <= 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec = reasonTotals[stateName]\n\t\t\t\trec[\"Availability\"] += mins\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] = stateCategoryName or stateTypeName or 'Availability'\n\t\n\t\t\t# --- Performance ---\n\t\t\tfor pe in (evt.get('performanceEventSummary') or []):\n\t\t\t\treason = (pe.get('performanceStateName') or '').strip() or 'Unspecified'\n\t\t\t\tpath = (pe.get('performanceStatePath') or '').strip()\n\t\t\t\tcategory = (path.split('\\\\')[0] if '\\\\' in path else path) or 'Performance'\n\t\t\t\tmins = float(pe.get('value') or 0.0)  # assumed minutes\n\t\t\t\tif mins <= 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec = reasonTotals[reason]\n\t\t\t\trec[\"Performance\"] += mins\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] = category\n\t\n\t\t\t# --- Quality (Waste units -> minutes) ---\n\t\t\tfor ce in (evt.get('countEventSummary') or []):\n\t\t\t\tif (ce.get('counterTypeName') or '').lower() != 'waste':\n\t\t\t\t\tcontinue\n\t\t\t\treason = (ce.get('itemStateName') or '').strip() or 'Unspecified'\n\t\t\t\tcategory = (ce.get('itemStateClassName') or '').strip() or 'Quality'\n\t\t\t\tunits = float(ce.get('value') or 0.0)\n\t\t\t\tif units <= 0:\n\t\t\t\t\tcontinue\n\t\t\t\tmins = (units * secondsPerUnit) / 60.0 if secondsPerUnit > 0 else 0.0\n\t\t\t\tif mins <= 0:\n\t\t\t\t\tcontinue\n\t\t\t\trec = reasonTotals[reason]\n\t\t\t\trec[\"Quality\"] += round(mins, 4)\n\t\t\t\tif not rec[\"category\"]:\n\t\t\t\t\trec[\"category\"] = category\n\t\n\t\t# Colors by category (series)\n\t\tseriesColors = [CAT_COLOR_AVAIL, CAT_COLOR_PERF, CAT_COLOR_QUAL]\n\t\n\t\tif barMode == 'byCategory':\n\t\t\t# x-axis: categories; series: reasons (topN per category)\n\t\t\tcatNames = ['Availability','Performance','Quality']\n\t\t\t# Build separate rankings\n\t\t\tcatReasonMaps = {c: [] for c in catNames}\n\t\t\tfor reason, buckets in reasonTotals.items():\n\t\t\t\tfor c in catNames:\n\t\t\t\t\tval = buckets.get(c, 0.0)\n\t\t\t\t\tif val > 0:\n\t\t\t\t\t\tcatReasonMaps[c].append((reason, val))\n\t\n\t\t\t# Pick topN per category\n\t\t\tfor c in catNames:\n\t\t\t\tcatReasonMaps[c].sort(key=lambda t: t[1], reverse=True)\n\t\t\t\tcatReasonMaps[c] = catReasonMaps[c][:topN]\n\t\n\t\t\t# Build union of top reasons across categories as series\n\t\t\treasonSet = set()\n\t\t\tfor c in catNames:\n\t\t\t\tfor r, _ in catReasonMaps[c]:\n\t\t\t\t\treasonSet.add(r)\n\t\t\torderedReasons = sorted(list(reasonSet))\n\t\n\t\t\tseries = []\n\t\t\tfor r in orderedReasons:\n\t\t\t\tdata = []\n\t\t\t\tfor c in catNames:\n\t\t\t\t\tval = 0.0\n\t\t\t\t\tfor rr, v in catReasonMaps[c]:\n\t\t\t\t\t\tif rr == r:\n\t\t\t\t\t\t\tval = v\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\tdata.append({\"x\": c, \"y\": round(val, 2)})\n\t\t\t\tseries.append({\"name\": r, \"data\": data})\n\t\n\t\t\treturn {\"series\": series, \"colors\": None, \"xLabels\": catNames}\n\t\n\t\telse:\n\t\t\t# Default: byReason + TopN support\n\t\t\t# x-axis: reasons (sorted by total minutes desc); series: Availability/Performance/Quality\n\t\t\ttotalByReason = {}\n\t\t\tfor reason, b in reasonTotals.items():\n\t\t\t\ttotal = b[\"Availability\"] + b[\"Performance\"] + b[\"Quality\"]\n\t\t\t\tif total > 0:\n\t\t\t\t\ttotalByReason[reason] = total\n\t\t\n\t\t\t# Sort all reasons by total minutes\n\t\t\tsortedReasons = [r for r, _ in sorted(totalByReason.items(), key=lambda kv: kv[1], reverse=True)]\n\t\t\n\t\t\t# Apply TopN; remainder becomes \"Other\"\n\t\t\tn = int(topN or 10)\n\t\t\tuseTopN = n > 0 and len(sortedReasons) > n\n\t\t\tmainReasons = sortedReasons[:n] if useTopN else sortedReasons\n\t\t\totherReasons = sortedReasons[n:] if useTopN else []\n\t\t\n\t\t\t# Prepare \"Other\" buckets (per category)\n\t\t\totherBuckets = {\"Availability\": 0.0, \"Performance\": 0.0, \"Quality\": 0.0}\n\t\t\tif useTopN:\n\t\t\t\tfor r in otherReasons:\n\t\t\t\t\totherBuckets[\"Availability\"] += reasonTotals[r][\"Availability\"]\n\t\t\t\t\totherBuckets[\"Performance\"]  += reasonTotals[r][\"Performance\"]\n\t\t\t\t\totherBuckets[\"Quality\"]      += reasonTotals[r][\"Quality\"]\n\t\t\n\t\t\t# Final x-labels (append \"Other\" if used)\n\t\t\txLabels = list(mainReasons)\n\t\t\tif useTopN:\n\t\t\t\txLabels.append(\"Other\")\n\t\t\n\t\t\tdef mkSeries(name):\n\t\t\t\tdata = []\n\t\t\t\tfor r in mainReasons:\n\t\t\t\t\tdata.append({\"x\": r, \"y\": round(reasonTotals[r][name], 2)})\n\t\t\t\tif useTopN:\n\t\t\t\t\tdata.append({\"x\": \"Other\", \"y\": round(otherBuckets[name], 2)})\n\t\t\t\treturn {\"name\": name, \"data\": data}\n\t\t\n\t\t\tseries = [\n\t\t\t\tmkSeries(\"Availability\"),\n\t\t\t\tmkSeries(\"Performance\"),\n\t\t\t\tmkSeries(\"Quality\")\n\t\t\t]\n\t\t\n\t\t\treturn {\"series\": series, \"colors\": [CAT_COLOR_AVAIL, CAT_COLOR_PERF, CAT_COLOR_QUAL], \"xLabels\": xLabels}\n\t\n\texcept Exception as ex:\n\t\tlogger.error('lossReasonBarchart transform failed: %s' % ex)\n\t\treturn {\"series\": [], \"colors\": [], \"xLabels\": []}", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.data.productionEvents"
        }
      }, 
