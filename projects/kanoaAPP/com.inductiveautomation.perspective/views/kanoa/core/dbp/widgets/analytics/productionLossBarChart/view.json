        "transforms": [
          {
            "code": "\n\tsystem.perspective.print(\"filter binding change\")\n\n\tpage = self.page.props.pageId\n\n\tfilters = system.kanoa.dashboard.getWidgetFilters(page, value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\t\n\tviewParams = value['viewParams']\n\tif viewParams.has_key('dateRange') and viewParams['dateRange'].has_key('startDate') and viewParams['dateRange'].has_key('endDate'):\n\t\tfilters['dateRange'] = viewParams['dateRange']\n\t\n\treturn filters", 
