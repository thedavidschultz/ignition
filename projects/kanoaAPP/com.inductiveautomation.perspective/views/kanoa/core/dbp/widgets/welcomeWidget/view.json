            "escapeHtml": false
          },
          "source": "\u003chtml\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan id\u003d\"goDash\" style\u003d\"color:#1976d2; cursor:pointer; text-decoration:underline;\"\u003eConfiguring assets\u003c/span\u003e \u003c/li\u003e\n\u003cul\u003e\n\u003c/html\u003e"
        },
