  "propConfig": {
    "custom.chart": {
      "persistent": true
    },
    "custom.chart.series": {
      "binding": {
        "config": {
          "path": "view.custom.data.countEvents"
        },
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\t\n\tif len(value) \u003d\u003d 0:\n\t\treturn []\n\n\tgroupBy \u003d self.view.custom.filters[\u0027groupBy\u0027]        # \"Reason\", \"Category\"\n\t\n\t# Grouping logic\n\tgroupKeyMap \u003d {\n\t\t\"Asset\": \"assetPath\",\n\t\t\"Reason\": \"itemStateName\",\n\t\t\"Category\": \"itemStateClassName\",\n\t}\n\t\n\txKey \u003d groupKeyMap.get(groupBy, \"assetPath\")\n\tstackKey \u003d \"itemStateName\" if xKey !\u003d \"itemStateName\" else \"assetPath\"\n\tvalueKey \u003d \"value\"\n\t\n\tstackedMap \u003d defaultdict(lambda: defaultdict(int))\n\txTotals \u003d defaultdict(int)  # For sorting x labels by total impact\n\t\n\t# Aggregate values\n\tfor entry in value:\n\t\tx \u003d entry.get(xKey) or \"Unspecified\"\n\t\tstack \u003d entry.get(stackKey) or \"Unspecified\"\n\t\tval \u003d entry.get(valueKey, 1) / 60.0 if valueKey else 1\n\t\n\t\tstackedMap[stack][x] +\u003d val\n\t\txTotals[x] +\u003d val\n\t\n\t# Sort x-labels by total descending\n\tsortedXLabels \u003d sorted(xTotals.keys(), key\u003dlambda k: xTotals[k], reverse\u003dTrue)\n\t\n\t# Build series\n\tseries \u003d []\n\tfor stackName, xDict in stackedMap.items():\n\t\tchartData \u003d [{\"x\": x, \"y\": xDict.get(x, 0)} for x in sortedXLabels]\n\t\tseries.append({\n\t\t\t\"name\": stackName,\n\t\t\t\"data\": chartData\n\t\t})\n\t\n\treturn series",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.countEvents": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\tfilter \u003d value\n\n\tif (filter[\u0027assetPath\u0027] or None) is None: return []\n\tassetPath \u003d filter[\u0027assetPath\u0027] + \u0027%\u0027\n\tstartDate \u003d filter[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d filter[\u0027dateRange\u0027][\u0027endDate\u0027]\n\n\tif assetPath is None: return []\n\t\n\tparamsDict \u003d {\u0027assetPath\u0027: assetPath, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate}\n\tif filter.has_key(\u0027counterName\u0027): paramsDict[\u0027counterName\u0027] \u003d filter[\u0027counterName\u0027]\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getCounterEventTotals(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\tif not filters.has_key(\u0027showGroupBySelector\u0027): filters[\u0027showGroupBySelector\u0027] \u003d True\n\tif not filters.has_key(\u0027showMetricSelector\u0027): filters[\u0027showMetricSelector\u0027] \u003d True\n\tif not filters.has_key(\u0027groupBy\u0027): filters[\u0027groupBy\u0027] \u003d \"Reason\"\n\tif not filters.has_key(\u0027metricType\u0027): filters[\u0027metricType\u0027] \u003d \"Duration\"\n\tif not filters.has_key(\u0027stacked\u0027): filters[\u0027stacked\u0027] \u003d False\n\tif not filters.has_key(\u0027showStacked\u0027): filters[\u0027showStacked\u0027] \u003d True\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
