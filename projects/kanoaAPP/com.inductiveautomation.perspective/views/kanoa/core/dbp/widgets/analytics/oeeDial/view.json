      }, 
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.asset.tagPath": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.asset.getAssetTagPath({'assetId': value})", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.filters.assetId"
        }
      }
    }, 
    "custom.dateRangeOEE": {
      "binding": {
        "transforms": [
          {
            "code": "\tif self.custom.filters.ignoreDateRange: \n\t\treturn {}\n\tstartDate = value['dateRange']['startDate']\n\tendDate = value['dateRange']['endDate']\n\tprodModeId = system.kanoa.utilities.getFieldValue('modeId', system.kanoa.asset.getModes({'modeName': 'Production'}))\n\tpeSummary = system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEventsSummary({'assetId': value['assetId'], 'startDate': startDate, 'endDate': endDate, 'modeId': prodModeId, 'strictDates': True}))\n\t\n\toeeData = {'a': 0, 'p': 0, 'q': 0, 'oee': 0}\n\ttotalRuntime = sum(val['runtimeSecs'] for val in peSummary)\n\t\n\tfor pe in peSummary:\n\t\toeeData['a'] += (pe['availability']) * (pe['runtimeSecs'] / totalRuntime) if pe['availability'] > 0 else 0\n\t\toeeData['p'] += (pe['performance']) * (pe['runtimeSecs'] / totalRuntime) if pe['performance'] > 0 else 0\n\t\toeeData['q'] += (pe['quality']) * (pe['runtimeSecs'] / totalRuntime) if pe['quality'] > 0 else 0\n\toeeData['oee'] = oeeData['a'] * oeeData['p'] * oeeData['q']\n\t\n\treturn oeeData", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.filters"
        }
      }, 
      "persistent": true
    }, 
    "custom.filters": {
      "binding": {
        "transforms": [
          {
            "code": "\t#system.perspective.print('loading oeeDial filters {}'.format(value))\n\tfilters = system.kanoa.dashboard.getWidgetFilters(value['page'], value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('ignoreDateRange'):\n\t\tfilters['ignoreDateRange'] = True\n\t\t\n\tif value['viewParams'].has_key('assetPath') and value['viewParams']['assetPath'] is not None:\n\t\tfilters['assetPath'] = value['viewParams']['assetPath']\n\t\t\n\t#system.perspective.print('returning oeeDial filters {}'.format(filters))\n\treturn filters", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "sessionCustomProps": "{session.custom.kanoa}", 
            "page": "{page.props.pageId}", 
            "viewParams": "{view.params.value}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.asset.tagInfo": {
      "binding": {
        "transforms": [
          {
            "code": "\treturn value.OEE", 
            "type": "script"
          }
        ], 
        "type": "tag", 
        "overlayOptOut": true, 
        "config": {
          "references": {
            "1": "{view.custom.asset.tagPath}"
          }, 
          "fallbackDelay": 2.5, 
          "mode": "indirect", 
          "tagPath": "{1}/Line"
        }
      }
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.displayValue": {
      "binding": {
        "transforms": [
          {
            "code": "\n\toeeBy = value['filters']['oeeBy'].lower()\n\tliveDataMode = value['filters']['ignoreDateRange']\n\n\tif value['tagInfo'] is not None:\n\t\ta = (value['tagInfo']['availability'] or 0.0) if liveDataMode else (value['dateRangeOEE']['a'] or 0.0)\n\t\tp = (value['tagInfo']['performance'] or 0.0) if liveDataMode else (value['dateRangeOEE']['p'] or 0.0)\n\t\tq = (value['tagInfo']['quality'] or 0.0) if liveDataMode else (value['dateRangeOEE']['q'] or 0.0)\n\telse:\n\t\ta, p, q = 0.0, 0.0, 0.0\n\tdisplayValue = 0\n\n\tif oeeBy == 'availability' or oeeBy == 'a':\n\t\tdisplayValue = a * 100\n\telif oeeBy == 'performance' or oeeBy == 'p':\n\t\tdisplayValue = p * 100\n\telif oeeBy == 'quality' or oeeBy == 'q':\n\t\tdisplayValue = q * 100\n\telse:\n\t\tdisplayValue = (a * p * q) * 100 if liveDataMode else value['dateRangeOEE']['oee'] * 100\n\n\tmsg = \"oeeDial: asset {} with value {}\".format(value['filters']['assetPath'], displayValue)\n\tsystem.perspective.print(msg)\n\n\treturn max(0.0, min(100.0, displayValue))", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "config": {
          "struct": {
            "filters": "{view.custom.filters}", 
            "tagInfo": "{view.custom.asset.tagInfo}", 
            "dateRangeOEE": "{view.custom.dateRangeOEE}"
          }, 
          "waitOnAll": false
        }
      }, 
      "persistent": true
    }, 
    "custom.asset": {
      "persistent": true
    }
  }
}