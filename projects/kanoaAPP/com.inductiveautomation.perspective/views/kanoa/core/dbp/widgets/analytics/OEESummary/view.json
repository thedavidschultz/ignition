    },
    "custom.data": {
      "persistent": true
    },
    "custom.data.oeeData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getOEESummary({\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027itemId\u0027: value[\u0027itemId\u0027], \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027], \u0027groupByAsset\u0027: value[\u0027groupByAsset\u0027], \u0027groupByItem\u0027: value[\u0027groupByItem\u0027]}))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.oeeSummary": {
      "binding": {
        "config": {
          "path": "view.custom.data.oeeData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tdata \u003d value\n\tdurationSecs \u003d 0\n\truntimeSecs \u003d 0\n\ttotalSecs \u003d 0\n\tinfeedCount \u003d 0\n\ttargetCount \u003d 0\n\twasteCount \u003d 0\n\t\n\tfor item in data:\n\t\truntimeSecs +\u003d item[\u0027runtimeSecs\u0027] or 0\n\t\ttotalSecs +\u003d (item[\u0027runtimeSecs\u0027] or 0) + (item[\u0027unplannedDowntimeSecs\u0027] or 0)\n\t\tinfeedCount +\u003d item[\u0027infeedCount\u0027] or 0\n\t\ttargetCount +\u003d item[\u0027targetCount\u0027] or 0\n\t\twasteCount +\u003d item[\u0027wasteCount\u0027] or 0\n\t\t\t\n\ta \u003d float(runtimeSecs) / float(totalSecs) if totalSecs \u003e 0 else None\n\tp \u003d float(infeedCount) / float(targetCount) if targetCount \u003e 0 else 1\n\tq \u003d float(infeedCount) / (float(infeedCount + wasteCount)) if infeedCount \u003e 0 and wasteCount \u003e 0 else 1\n\t\n\treturn {\u0027a\u0027: a, \u0027p\u0027: p, \u0027q\u0027: q, \u0027oee\u0027: (a or 0) * (p or 0) * (q or 0)}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "pageInfo": "{view.custom.pageInfo}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027pageInfo\u0027][\u0027page\u0027], value[\u0027viewParams\u0027], self.session.custom.kanoa, self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showOEEMetricSelector\u0027): filters[\u0027showOEEMetricSelector\u0027] \u003d False\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d False\n\tif not filters.has_key(\u0027oeeMetric\u0027): filters[\u0027oeeMetric\u0027] \u003d False\n\tif not filters.has_key(\u0027itemId\u0027): filters[\u0027itemId\u0027] \u003d None\n\tif not filters.has_key(\u0027groupByAsset\u0027): filters[\u0027groupByAsset\u0027] \u003d False\n\tif not filters.has_key(\u0027groupByItem\u0027): filters[\u0027groupByItem\u0027] \u003d False\n\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.pageInfo": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturnDict \u003d {\u0027page\u0027: value[\u0027page\u0027], \u0027sessionProps\u0027: {}}\n\n\tif value[\u0027page\u0027] is None or value[\u0027sessionCustomProps\u0027] is None: return returnDict\n\treturnDict[\u0027page\u0027] \u003d value[\u0027page\u0027] if \u0027/\u0027 not in value[\u0027page\u0027] else \u0027designer\u0027\n\t\t\n\tif not value[\u0027sessionCustomProps\u0027].has_key(returnDict[\u0027page\u0027]): return returnDict\n\n\treturnDict[\u0027sessionProps\u0027] \u003d dict(value[\u0027sessionCustomProps\u0027][returnDict[\u0027page\u0027]][\u0027selectors\u0027])\n\treturn returnDict",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.showChart": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn True",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
