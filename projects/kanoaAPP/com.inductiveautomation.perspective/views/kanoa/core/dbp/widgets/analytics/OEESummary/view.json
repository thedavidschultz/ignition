                        "struct": {
                          "filters": "{view.custom.filters}",
                          "oeeData": "{view.custom.data.oeeData}"
                        },
                        "waitOnAll": true
                      },
                      "overlayOptOut": true,
                      "transforms": [
                        {
                          "code": "\n\tmetric \u003d value[\u0027filters\u0027][\u0027oeeMetric\u0027]\t# oee, availability, performance, quality\n\t\n\titemIndex \u003d {}\n\tassetIndex \u003d {}\n\titems \u003d []\n\tassets \u003d []\n\tseriesData \u003d []\t\n\t\n\tfor row in value[\u0027oeeData\u0027]:\n\t\titem \u003d row[\u0027itemName\u0027]\n\t\tasset \u003d row[\u0027assetName\u0027]\n\t\tmetricValue \u003d (row[\u0027availability\u0027] or 0.0) * (row[\u0027quality\u0027] or 0.0) * min(row[\u0027performance\u0027] or 1.0, 1.0) if metric \u003d\u003d \u0027oee\u0027 else row[metric]\n\t\tmetricValue \u003d round((metricValue or 0.0) * 100.0,1)\n\t\n\t\tif item not in itemIndex:\n\t\t\titemIndex[item] \u003d len(items)\n\t\t\titems.append(item)\n\t\n\t\t\t# extend existing asset series\n\t\t\tfor data in seriesData: data.append(None)\n\t\n\t\tif asset not in assetIndex:\n\t\t\tassetIndex[asset] \u003d len(assets)\n\t\t\tassets.append(asset)\n\t\n\t\t\t# create new asset series sized to current item count\n\t\t\tseriesData.append([None] * len(items))\n\t\n\t\ti \u003d itemIndex[item]\n\t\ta \u003d assetIndex[asset]\n\t\n\t\tseriesData[a][i] \u003d metricValue\n\t\n\tseries \u003d []\n\t\n\tfor a in range(len(assets)):\n\t\tseriesName \u003d assets[a] if value[\u0027filters\u0027][\u0027groupByAsset\u0027] else metric #Just showing item values, use selected metric for series name\n\t\tseries.append({\"name\": seriesName, \"data\": seriesData[a]})\n\t\n\tself.props.options.xaxis.categories \u003d items\n\t\n\treturn series",
                          "type": "script"
                        }
                      ],
                      "type": "expr-struct"
                    }
