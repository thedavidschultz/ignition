    },
    "custom.assetOEEThresholds": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetId"
        },
        "transforms": [
          {
            "code": "\treturn system.kanoa.asset.getAssetOEEThresholds({\u0027assetId\u0027: value})",
            "type": "script"
          }
        ],
