  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.filters.assetPath"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: value or \u0027none\u0027}),0)",
            "type": "script"
          }
