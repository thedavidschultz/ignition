  "propConfig": {
    "custom.chart": {
      "persistent": true
    },
    "custom.chart.series": {
      "binding": {
        "config": {
          "path": "view.custom.data"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tfrom collections import defaultdict\n\t\n\tif len(value) \u003d\u003d 0:\n\t\treturn {\"series\": [], \"labels\": []}\n\t\n\tmetricType \u003d self.view.custom.filters[\u0027metricType\u0027]  # \"Duration\" or \"Occurrence\"\n\tgroupBy \u003d self.view.custom.filters[\u0027groupBy\u0027]        # \"Asset\", \"Reason\", \"Work Order\", \"Item\", \"Line\"\n\t\n\t# Define grouping field\n\tgroupKeyMap \u003d {\n\t\t\"Asset\": \"assetPath\",\n\t\t\"Reason\": \"stateName\",\n\t\t\"Line\": \"assetName\"\n\t}\n\t\n\tgroupKey \u003d groupKeyMap.get(groupBy, \"stateName\")\n\tgroupTotals \u003d defaultdict(float) \t# Aggregate values by group\n\t\n\tfor entry in value:\n\t\tkey \u003d entry.get(groupKey) or \"Unspecified\"\n\t\tval \u003d entry.get(\u0027durationSecs\u0027, 60) / 60.0\n\t\tgroupTotals[key] +\u003d val\n\t\n\t# Sort groups by value descending\n\tsortedGroups \u003d sorted(groupTotals.items(), key\u003dlambda x: x[1], reverse\u003dTrue)\n\t\n\t# Build Apex pie chart data\n\tlabels \u003d [k for k, _ in sortedGroups]\n\tseries \u003d [v for _, v in sortedGroups]\n\t\n\treturn {\n\t\t\"labels\": labels,\n\t\t\"series\": series\n\t}",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tparamsDict \u003d {\u0027assetId\u0027: value[\u0027assetId\u0027] or -1, \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027], \u0027downtimeOnly\u0027: True}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEventsSummary(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.data.perfEvents": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\n\tparamsDict \u003d {\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027], \u0027downtimeOnly\u0027: True}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEventsSummary(paramsDict))",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\tif not filters.has_key(\u0027showGroupBySelector\u0027): filters[\u0027showGroupBySelector\u0027] \u003d True\n\tif not filters.has_key(\u0027showMetricSelector\u0027): filters[\u0027showMetricSelector\u0027] \u003d True\n\tif not filters.has_key(\u0027groupBy\u0027): filters[\u0027groupBy\u0027] \u003d \"Reason\"\n\tif not filters.has_key(\u0027metricType\u0027): filters[\u0027metricType\u0027] \u003d \"Duration\"\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
