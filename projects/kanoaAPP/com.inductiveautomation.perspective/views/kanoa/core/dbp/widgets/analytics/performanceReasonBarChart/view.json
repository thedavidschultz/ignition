    "scripts": {
      "messageHandlers": [
        {
          "viewScope": false, 
          "script": "\n\tsystem.perspective.print(\"widgetAssetSelected msg rcvd with %s\"%payload)\n\tassetPath = payload['selection'][0]['value']['path'] if len(payload['selection']) > 0 else None\n\t\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\t\n\treturn", 
          "messageType": "widgetAssetSelected", 
          "sessionScope": false, 
          "pageScope": true
        }
      ], 
      "customMethods": [], 
      "extensionFunctions": null
    }
  }, 
  "propConfig": {
    "custom.chart.series": {
      "binding": {
        "transforms": [
          {
            "code": "\tfrom collections import defaultdict\n\t\n\tif len(value) == 0:\n\t\treturn []\n\t\n\tmetricType = self.view.custom.filters['metricType']  # \"Duration\" or \"Occurrence\"\n\tgroupBy = self.view.custom.filters['groupBy']        # \"Asset\", \"Reason\", \"Work Order\", \"Item\", \"Line\"\n\t\n\t# Grouping logic\n\tgroupKeyMap = {\n\t\t\"Asset\": \"assetPath\",\n\t\t\"Reason\": \"performanceStateName\",\n\t\t\"Work Order\": \"workOrderName\",\n\t\t\"Item\": \"itemName\",\n\t\t\"Line\": \"assetName\"\n\t}\n\t\n\txKey = groupKeyMap.get(groupBy, \"assetPath\")\n\tstackKey = \"performanceStateName\" if xKey != \"performanceStateName\" else \"assetPath\"\n\tvalueKey = \"value\" if metricType == \"Duration\" else None\n\t\n\tstackedMap = defaultdict(lambda: defaultdict(int))\n\txTotals = defaultdict(int)  # For sorting x labels by total impact\n\t\n\t# Aggregate values\n\tfor entry in value:\n\t\tx = entry.get(xKey) or \"Unspecified\"\n\t\tstack = entry.get(stackKey) or \"Unspecified\"\n\t\tval = entry.get(valueKey, 1) if valueKey else 1\n\t\n\t\tstackedMap[stack][x] += val\n\t\txTotals[x] += val\n\t\n\t# Sort x-labels by total descending\n\tsortedXLabels = sorted(xTotals.keys(), key=lambda k: xTotals[k], reverse=True)\n\t\n\t# Build series\n\tseries = []\n\tfor stackName, xDict in stackedMap.items():\n\t\tchartData = [{\"x\": x, \"y\": xDict.get(x, 0)} for x in sortedXLabels]\n\t\tseries.append({\n\t\t\t\"name\": stackName,\n\t\t\t\"data\": chartData\n\t\t})\n\t\n\treturn series", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.data.perfEvents"
        }
      }
    }, 
    "custom.chart": {
      "persistent": true
    }, 
    "custom.filters": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tfilters = system.kanoa.dashboard.getWidgetFilters(value['page'], value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\tif not filters.has_key('showGroupBySelector'): filters['showGroupBySelector'] = True\n\tif not filters.has_key('showMetricSelector'): filters['showMetricSelector'] = True\n\tif not filters.has_key('groupBy'): filters['groupBy'] = \"Reason\"\n\tif not filters.has_key('metricType'): filters['metricType'] = \"Duration\"\n\tif not filters.has_key('stacked'): filters['stacked'] = False\n\tif not filters.has_key('showStacked'): filters['showStacked'] = True\n\treturn filters", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "sessionCustomProps": "{session.custom.kanoa}", 
            "page": "{page.props.pageId}", 
            "viewParams": "{view.params.value}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "custom.data.perfEvents": {
      "binding": {
        "transforms": [
          {
            "code": "\tfilter = value\n\n\tif (filter['assetPath'] or None) is None: return []\n\tassetPath = filter['assetPath'] + '%'\n\tstartDate = filter['dateRange']['startDate']\n\tendDate = filter['dateRange']['endDate']\n\tmodeEventId = None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict = {'assetPath': assetPath, 'startDate': startDate, 'endDate': endDate, 'modeEventId': modeEventId}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getPerformanceEvents(paramsDict))", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.filters"
        }
      }
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.data": {
      "persistent": true
    }
  }
}