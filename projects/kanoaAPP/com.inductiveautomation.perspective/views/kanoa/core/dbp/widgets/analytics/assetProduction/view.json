{
  "custom": {
    "data": {
      "interval": "Hour"
    },
    "filters": null
  },
  "params": {
    "value": {
      "assetPath": null,
      "autoUpdateTimerSeconds": null,
      "selectedRange": "Today",
      "showAssetPath": true
    }
  },
  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.oeeData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tstartDate \u003d value[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d value[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tassetId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027] or -1}))\n\t\n\tnumHours \u003d system.date.hoursBetween(startDate, endDate)\n\tself.custom.data.interval \u003d \u0027Hour\u0027 if numHours \u003c\u003d 60 else \u0027Day\u0027\n\treturn system.kanoa.event.getOEEDataByInterval(assetId, startDate, endDate, self.custom.data.interval)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.oeeSummary": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "transforms": [
          {
            "code": "\t\n\tstartDate \u003d value[\u0027dateRange\u0027][\u0027startDate\u0027]\n\tendDate \u003d value[\u0027dateRange\u0027][\u0027endDate\u0027]\n\tassetId \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: value[\u0027assetPath\u0027] or -1}))\t\n\t\n\treturn system.kanoa.event.getOEESummary({\u0027assetId\u0027:assetId, \u0027startDate\u0027: startDate, \u0027endDate\u0027: endDate})",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d True\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 471,
      "width": 892
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblTitle",
              "name": "lblTitle"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filters"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\toeeMetric \u003d value[\u0027OEE Metric\u0027].upper() if value.has_key(\u0027showOEEMetricSelector\u0027) and not value[\u0027showOEEMetricSelector\u0027] else \u0027\u0027\n\tassetPath \u003d system.kanoa.utilities.formatPath(value[\u0027assetPath\u0027], {}) if value[\u0027showAssetPath\u0027] else \u0027\u0027\n\treturn \u0027%s %s\u0027%(system.kanoa.utilities.formatPath(assetPath, {}), oeeMetric)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "ddOEE",
              "name": "ddOEE"
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "path": "view.custom.filters"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn True if value.has_key(\u0027showOEEMetricSelector\u0027) and value[\u0027showOEEMetricSelector\u0027] else False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "now(0)"
                  },
                  "transforms": [
                    {
                      "code": "\treturn [{\u0027label\u0027: \u0027OEE\u0027, \u0027value\u0027: \u0027oee\u0027}, {\u0027label\u0027: \u0027Availability\u0027, \u0027value\u0027: \u0027availability\u0027}, {\u0027label\u0027: \u0027Performance\u0027, \u0027value\u0027: \u0027performance\u0027}, {\u0027label\u0027: \u0027Quality\u0027, \u0027value\u0027: \u0027quality\u0027}]",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.filters[\u0027oeeMetric\u0027]"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "minWidth": "100px"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "domId": "flxOptions",
          "name": "flxOptions"
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "flxRepeat",
              "name": "flxRepeat"
            },
            "position": {
              "grow": 1
            },
            "type": "ia.display.flex-repeater"
          }
        ],
        "meta": {
          "domId": "flxWidget",
          "name": "flxWidget"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblFilter",
              "name": "lblFilter"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filter"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn str(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "lblFilter_0",
              "name": "lblFilter_0"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn str(value)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxDebug",
          "name": "flxDebug"
        },
        "position": {
          "display": false,
          "grow": 1
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--kcSurface0",
        "gap": 5,
        "overflow": "hidden",
        "padding": 3
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "widgetAssetSelected",
          "pageScope": true,
          "script": "\n\tsystem.perspective.print(\"widgetAssetSelected msg rcvd with %s\"%payload)\n\tassetPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027path\u0027] if len(payload[\u0027selection\u0027]) \u003e 0 else None\n\t\n\tsystem.kanoa.utilities.storeAssetPath(self, assetPath)\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}