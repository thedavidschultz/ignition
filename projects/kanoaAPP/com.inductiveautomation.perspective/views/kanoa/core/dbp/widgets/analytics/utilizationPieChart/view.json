  "propConfig": {
    "custom.chart.series": {
      "binding": {
        "transforms": [
          {
            "code": "\t# Perspective transform for OEE pie (ApexCharts)\n\t# Input:  value -> list[dict] production events (productionEventData.json shape)\n\t# Output: {\"labels\": [...], \"series\": [...], \"colors\": [...]}  (minutes, 2 decimals)\n\t#\n\t# Ordering:\n\t#   1) Non-production modes, most -> least (by duration)\n\t#   2) Good Runtime (if includeProductiveTime)\n\t#   3) Losses: A/P/Q, most -> least\n\t#\n\t# Colors:\n\t#   - Each non-production mode -> its assigned modeColor\n\t#   - Good Runtime -> Production mode color\n\t#   - A/P/Q -> distinct tweakable defaults (constants below)\n\t#\n\t# Notes:\n\t#   - Uses dataset minute totals; skips zero/neg durations\n\t#   - Missing A/P/Q treated as 1.0 (no loss)\n\t#   - Returns minutes for readability\n\t\n\tfrom collections import defaultdict\n\t\n\tlogger = system.util.getLogger('oeePieChart')\n\t\n\t# === Tweakable defaults for OEE slices ===\n\tAPX_COLOR_AVAILABILITY = '#ba1a1a'  # A\n\tAPX_COLOR_PERFORMANCE  = '#f4b400'  # P\n\tAPX_COLOR_QUALITY      = '#489fe2'  # Q\n\tAPX_COLOR_FALLBACK     = '#9e9e9e'  # Any missing mode color\n\t\n\tdef safeRate(raw):\n\t\t\"\"\"Coerce availability/performance/quality into [0,1], default 1.0 when None/invalid.\"\"\"\n\t\ttry:\n\t\t\tval = float(raw)\n\t\texcept:\n\t\t\treturn 1.0\n\t\treturn 0.0 if val < 0 else 1.0 if val > 1 else val\n\t\n\tdef mins(x):\n\t\t\"\"\"Seconds -> minutes, rounded to 2 decimals.\"\"\"\n\t\treturn round((x or 0.0) / 60.0, 2)\n\t\n\tdef getModeColorByName(modeName, cache):\n\t\t\"\"\"\n\t\tReturn the configured color for a given modeName.\n\t\tLookup order:\n\t\t  1) Cache hit\n\t\t  2) Live modes -> getFieldValue('modeColor', system.kanoa.asset.getModes({'modeName': modeName}))\n\t\t  3) Fallback\n\t\t\"\"\"\n\t\tif not modeName:\n\t\t\treturn APX_COLOR_FALLBACK\n\t\n\t\tif modeName in cache:\n\t\t\treturn cache[modeName] or APX_COLOR_FALLBACK\n\t\n\t\ttry:\n\t\t\tmodesDs = system.kanoa.asset.getModes({'modeName': modeName})\n\t\t\tmodeColor = system.kanoa.utilities.getFieldValue('modeColor', modesDs)\n\t\t\tcache[modeName] = modeColor or APX_COLOR_FALLBACK\n\t\texcept Exception as ex:\n\t\t\tlogger.warn('getModeColorByName failed for \"%s\": %s' % (modeName, ex))\n\t\t\tcache[modeName] = APX_COLOR_FALLBACK\n\t\n\t\treturn cache[modeName]\n\t\n\ttry:\n\t\tif not value:\n\t\t\treturn {\"labels\": [], \"series\": [], \"colors\": []}\n\t\n\t\t# Read flags (default True if absent)\n\t\tfilters = getattr(self.view.custom, 'filters', {}) or {}\n\t\tincludeNonProduction = bool(filters.get('includeNonProductionModes', True))\n\t\tincludeProductiveTime = bool(filters.get('includeProductiveTime', True))\n\t\n\t\t# Accumulators (seconds)\n\t\tnonProdByMode = defaultdict(float)\n\t\tavailabilityLossSecs = 0.0\n\t\tperformanceLossSecs = 0.0\n\t\tqualityLossSecs = 0.0\n\t\tgoodRuntimeSecs = 0.0\n\t\n\t\t# Color helpers\n\t\tmodeColorCache = {}\n\t\n\t\t# Also capture a \"production color\" for Good Runtime\n\t\tproductionColor = None\n\t\n\t\tfor row in value:\n\t\t\tdurationSecs = float(row.get('durationSecs') or 0.0)\n\t\t\tif durationSecs <= 0:\n\t\t\t\tcontinue\n\t\n\t\t\tmodeTypeName = row.get('modeTypeName') or ''\n\t\t\tmodeName = row.get('modeName') or 'Unspecified'\n\t\n\t\t\t# Prefer color from row if present; seed the cache to avoid DB calls\n\t\t\trowModeColor = row.get('modeColor') or None\n\t\t\tif rowModeColor and modeName not in modeColorCache:\n\t\t\t\tmodeColorCache[modeName] = rowModeColor\n\t\n\t\t\tif modeTypeName != 'Production':\n\t\t\t\tnonProdByMode[modeName] += durationSecs\n\t\t\t\tcontinue\n\t\n\t\t\t# Production: split A/P/Q/Good\n\t\t\ta = safeRate(row.get('availability'))\n\t\t\tp = safeRate(row.get('performance'))\n\t\t\tq = safeRate(row.get('quality'))\n\t\n\t\t\taLost = durationSecs * (1.0 - a)\n\t\t\tremA = durationSecs - aLost\n\t\n\t\t\tpLost = remA * (1.0 - p)\n\t\t\tremAP = remA - pLost\n\t\n\t\t\tqLost = remAP * (1.0 - q)\n\t\t\tgood = remAP - qLost\n\t\n\t\t\tavailabilityLossSecs += aLost\n\t\t\tperformanceLossSecs += pLost\n\t\t\tqualityLossSecs += qLost\n\t\t\tgoodRuntimeSecs += good\n\t\n\t\t\t# Capture production color once\n\t\t\tif productionColor is None:\n\t\t\t\tproductionColor = getModeColorByName('Production', modeColorCache)\n\t\n\t\t# Default production color if lookup never happened\n\t\tif productionColor is None:\n\t\t\tproductionColor = getModeColorByName('Production', modeColorCache)\n\t\n\t\t# === Build ordered slices ===\n\t\tlabels = []\n\t\tseries = []\n\t\tcolors = []\n\t\n\t\t# 1) Non-production modes, most -> least\n\t\tif includeNonProduction and nonProdByMode:\n\t\t\tfor name, secs in sorted(nonProdByMode.items(), key=lambda kv: kv[1], reverse=True):\n\t\t\t\tlabels.append(name)\n\t\t\t\tseries.append(mins(secs))\n\t\t\t\tcolors.append(getModeColorByName(name, modeColorCache))\n\t\n\t\t# 2) Good Runtime (optional)\n\t\tif includeProductiveTime and goodRuntimeSecs > 0:\n\t\t\tlabels.append('Good Runtime')\n\t\t\tseries.append(mins(goodRuntimeSecs))\n\t\t\tcolors.append(productionColor)\n\t\n\t\t# 3) Losses -> compute mins and order by magnitude\n\t\tlossTriples = [\n\t\t\t('Availability Loss', availabilityLossSecs, APX_COLOR_AVAILABILITY),\n\t\t\t('Performance Loss',  performanceLossSecs,  APX_COLOR_PERFORMANCE),\n\t\t\t('Quality Loss',      qualityLossSecs,      APX_COLOR_QUALITY),\n\t\t]\n\t\t# Filter zeros, sort most -> least\n\t\tlossTriples = [(n, s, c) for (n, s, c) in lossTriples if s > 0]\n\t\tlossTriples.sort(key=lambda t: t[1], reverse=True)\n\t\n\t\tfor name, secs, color in lossTriples:\n\t\t\tlabels.append(name)\n\t\t\tseries.append(mins(secs))\n\t\t\tcolors.append(color or APX_COLOR_FALLBACK)\n\t\n\t\treturn {\"labels\": labels, \"series\": series, \"colors\": colors}\n\t\n\texcept Exception as ex:\n\t\tlogger.error('oeePieChart transform failed: %s' % ex)\n\t\treturn {\"labels\": [], \"series\": [], \"colors\": []}", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.data.productionEvents"
        }
      }
    }, 
    "custom.chart": {
      "persistent": true
    }, 
    "custom.filters": {
      "binding": {
        "transforms": [
          {
            "code": "\n\tfilters = system.kanoa.dashboard.getWidgetFilters(value['page'], value['viewParams'], value['sessionCustomProps'], self.session.props.device.timezone.id)\n\tif not filters.has_key('showAssetPath'): filters['showAssetPath'] = True\n\tif not filters.has_key('includeNonProductionModes'): filters['includeNonProductionModes'] = True\n\tif not filters.has_key('includeProductiveTime'): filters['includeProductiveTime'] = True\n\tif not filters.has_key('donutMode'): filters['donutMode'] = False\n\treturn filters", 
            "type": "script"
          }
        ], 
        "type": "expr-struct", 
        "overlayOptOut": true, 
        "config": {
          "struct": {
            "sessionCustomProps": "{session.custom.kanoa}", 
            "page": "{page.props.pageId}", 
            "viewParams": "{view.params.value}"
          }, 
          "waitOnAll": true
        }
      }, 
      "persistent": true
    }, 
    "params.value": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.data": {
      "persistent": true
    }, 
    "custom.data.productionEvents": {
      "binding": {
        "transforms": [
          {
            "code": "\tfilter = value\n\n\tif (filter['assetPath'] or None) is None: return []\n\tassetPath = filter['assetPath'] + '%'\n\tassetId = filter['assetId']\n\tstartDate = filter['dateRange']['startDate']\n\tendDate = filter['dateRange']['endDate']\n\tmodeEventId = None\n\n\tif assetPath is None: return []\n\t\n\tparamsDict = {'assetId': assetId, 'assetPath': assetPath, 'startDate': startDate, 'endDate': endDate, 'modeEventId': modeEventId}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetProductionEvents(paramsDict))", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.custom.filters"
        }
      }
    }
  }
}