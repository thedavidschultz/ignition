    "data": {},
    "filters": {
      "assetId": 2538,
      "assetPath": "Enterprise 1",
      "colorBy": "State",
      "dateRange": {
        "endDate": {
          "$": [
            "ts",
            0,
            1770069156261
          ],
          "$ts": 1769410800000
        },
        "selectedRange": "Today",
        "startDate": {
          "$": [
            "ts",
            0,
            1770069156261
          ],
          "$ts": 1769324400000
        }
      },
      "downtimeBy": "Occurrence",
      "showAssetPath": false,
      "showDowntimeBySelector": true,
      "showTopXSelector": true,
