                  "transforms": [
                    {
                      "code": "\t\n\tdowntimeBy \u003d value[\u0027downtimeBy\u0027] if value.has_key(\u0027showDowntimeBySelector\u0027) and not value[\u0027showDowntimeBySelector\u0027] else \u0027\u0027\n\treturn \u0027Downtimes By %s\u0027%(downtimeBy)",
                      "type": "script"
