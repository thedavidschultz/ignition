      {
        "children": [
          {
            "meta": {
              "domId": "apexChart",
              "name": "apexChart"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.options.theme.mode": {
                "binding": {
                  "config": {
                    "path": "session.props.theme"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tif \u0027dark\u0027 in value: return \u0027dark\u0027\n\telse: return \u0027light\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.options.xaxis.title.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.filters"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\tdowntimeBy \u003d value[\u0027downtimeBy\u0027]\n\tif downtimeBy \u003d\u003d \"Duration\": downtimeBy \u003d downtimeBy + \" [min]\"\n\tif downtimeBy \u003d\u003d \"Asset \u0026 Occurrence\": downtimeBy \u003d \"Occurrence\"\n\treturn \u0027 %s\u0027%(downtimeBy)",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.series": {
                "binding": {
                  "config": {
                    "path": "view.custom.data.analysis"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\tdata \u003d value\n\tdefaultColors \u003d [\u0027var(--kcChart-01)\u0027,\u0027var(--kcChart-02)\u0027,\u0027var(--kcChart-03)\u0027,\u0027var(--kcChart-04)\u0027,\u0027var(--kcChart-05)\u0027,\u0027var(--kcChart-06)\u0027,\u0027var(--kcChart-07)\u0027,\u0027var(--kcChart-08)\u0027,\u0027var(--kcChart-09)\u0027]\n\tif len(data) \u003d\u003d 0: return []\n\n\tdowntimeBy \u003d self.view.custom.filters[\u0027downtimeBy\u0027]\t\n\tseries \u003d []\t\n\t\n\tif downtimeBy \u003d\u003d \u0027Occurrence\u0027:\n\t\tchartData \u003d []\n\t\tfor entry in data:\n\t\t\tchartData.append({\u0027x\u0027: entry[\u0027stateName\u0027], \u0027y\u0027: entry[\u0027occurrances\u0027]})\n\t\tseries.append({\"name\": \"Occurrances\", \"data\": chartData, \"type\": \"bar\", \u0027color\u0027: \u0027var(--kcBad)\u0027})\n\t\treturn series\n\t\t\n\tif downtimeBy \u003d\u003d \u0027Asset \u0026 Occurrence\u0027:\n\t\tchartData \u003d []\n\t\tfor entry in data:\n\t\t\tchartData.append({\u0027x\u0027: [entry[\u0027assetStateName\u0027].split(\" - \", 1)[0], entry[\u0027assetStateName\u0027].rsplit(\" - \", 1)[-1]], \u0027y\u0027: entry[\u0027occurrances\u0027]})\n\t\tseries.append({\"name\": \"Occurrances\", \"data\": chartData, \"type\": \"bar\", \u0027color\u0027: \u0027var(--kcBad)\u0027})\n\t\treturn series\n\n\tif downtimeBy \u003d\u003d \u0027Duration\u0027:\n\t\tchartData \u003d []\n\t\tfor entry in data:\n\t\t\tchartData.append({\u0027x\u0027: [entry [\u0027assetStateName\u0027],entry[\u0027stateName\u0027]], \u0027y\u0027: round(entry[\u0027durationSecs\u0027] / 60.0, 2)})\n\t\tseries.append({\"name\": \"Duration\", \"data\": chartData, \"type\": \"bar\", \u0027color\u0027: \u0027var(--kcBad)\u0027})\n\t\treturn series",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
