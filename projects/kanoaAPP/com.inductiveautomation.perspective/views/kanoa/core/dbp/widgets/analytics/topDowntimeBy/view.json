  "propConfig": {
    "custom.data": {
      "persistent": true
    },
    "custom.data.analysis": {
      "binding": {
        "config": {
          "path": "view.custom.data.dtData"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\tdata \u003d []\n\tdtData \u003d system.kanoa.utilities.convertDatasetToJSON(value)\n\tif self.custom.filters.downtimeBy \u003d\u003d \"Occurrence\":\n\t\tuniqueStates \u003d list(set(state[\u0027stateName\u0027] for state in dtData))\n\t\tstatesByDuration \u003d []\n\t\tfor state in uniqueStates:\n\t\t\tstatesByDuration.append({\u0027stateName\u0027: state, \u0027occurrances\u0027: sum(1 for entry in dtData if entry[\u0027stateName\u0027] \u003d\u003d state)})\n\t\tdata \u003d sorted(statesByDuration, key\u003dlambda x: x[\u0027occurrances\u0027], reverse \u003d True)\n\t\t\n\tif self.custom.filters.downtimeBy \u003d\u003d \"Asset \u0026 Occurrence\":\n\t\tfor dt in dtData:\n\t\t\tdt[\u0027assetStateName\u0027] \u003d dt[\u0027assetStateName\u0027] + \" - \" + dt[\u0027stateName\u0027]\n\t\tassetStateList \u003d list(set([dt[\u0027assetStateName\u0027] for dt in dtData]))\n\t\t\n\t\tstatesByDuration \u003d []\n\t\tfor assetStateName in assetStateList:\n\t\t\tstatesByDuration.append({\u0027assetStateName\u0027: assetStateName, \u0027occurrances\u0027: sum(1 for dt in dtData if dt[\u0027assetStateName\u0027] \u003d\u003d assetStateName)})\n\t\tdata \u003d sorted(statesByDuration, key\u003dlambda x: x[\u0027occurrances\u0027], reverse \u003d True)\n\t\t\n\telif self.custom.filters.downtimeBy \u003d\u003d \"Duration\":\n\t\tdata \u003d sorted(dtData, key\u003dlambda x: x[\u0027durationSecs\u0027], reverse \u003d True)\n\t\t\n\treturn data[0:self.custom.filters.topX]",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.data.dtData": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027assetId\u0027] is None: return system.dataset.toPyDataSet(system.dataset.toDataSet([],[]))\n\tparamsDict \u003d {\u0027assetId\u0027: value[\u0027assetId\u0027], \u0027startDate\u0027: value[\u0027dateRange\u0027][\u0027startDate\u0027], \u0027endDate\u0027: value[\u0027dateRange\u0027][\u0027endDate\u0027], \u0027showDowntimeOnly\u0027: True, \u0027showChanged\u0027: None, \u0027durationSecs\u0027: 0}\n\t\n\timport time\t#There may be a bunch of these widgets on a dashboard. We\u0027ll attempt here to stagger the calls to prevent concurrent SQL queries\n\tif value[\u0027downtimeBy\u0027] \u003d\u003d \u0027Duration\u0027:\n\t\ttime.sleep(0.4)\n#\t\tsystem.perspective.print(\"topDowntimeBy widget calling getAssetStateEventsSummary() after 0.4s delay\")\n\t\tdata \u003d system.kanoa.event.getAssetStateEventsSummary(paramsDict)\n\telif value[\u0027downtimeBy\u0027] \u003d\u003d \u0027Occurrence\u0027:\n\t\ttime.sleep(0.8)\n#\t\tsystem.perspective.print(\"topDowntimeBy widget calling getAssetStateEvents() after 0.8s delay\")\n\t\tdata \u003d system.kanoa.event.getAssetStateEvents(paramsDict)\n\telse:\n\t\ttime.sleep(1.2)\n#\t\tsystem.perspective.print(\"topDowntimeBy widget calling getAssetStateEvents() after 1.2s delay\")\n\t\tdata \u003d system.kanoa.event.getAssetStateEvents(paramsDict)\n\n\treturn data\n#\treturn system.kanoa.event.getAssetStateEventsSummary(paramsDict) if value[\u0027downtimeBy\u0027] \u003d\u003d \u0027Duration\u0027 else system.kanoa.event.getAssetStateEvents(paramsDict)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)\n\tif not filters.has_key(\u0027downtimeBy\u0027): filters[\u0027downtimeBy\u0027] \u003d \u0027Reason\u0027\n\tif not filters.has_key(\u0027showAssetPath\u0027): filters[\u0027showAssetPath\u0027] \u003d False\n\tif not filters.has_key(\u0027colorBy\u0027): filters[\u0027colorBy\u0027] \u003d \u0027State\u0027\n\tif filters[\u0027assetId\u0027] is None and filters[\u0027assetPath\u0027] is not None: filters[\u0027assetId\u0027] \u003d system.kanoa.utilities.getFieldValue(\u0027assetId\u0027, system.kanoa.asset.getAssets({\u0027assetPath\u0027: filters[\u0027assetPath\u0027]}))\n\treturn filters",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
