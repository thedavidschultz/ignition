            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxHeader",
          "name": "flxHeader"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.filter.showHeader"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "justify": "center",
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "evStateButtons",
              "name": "evStateButtons"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "struct": {
                      "states": "{view.custom.states}",
                      "tagInfo": "{view.custom.asset.tagInfo}",
                      "userAction": "{view.custom.userAction}"
                    },
                    "waitOnAll": true
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\n\tinstances \u003d []\n\tfor state in value[\u0027states\u0027]:\n\t\tstate \u003d dict(state)\n\t\tstate[\u0027tagPath\u0027] \u003d self.view.custom.asset.assetInfo[\u0027tagPath\u0027]\n\t\tstate[\u0027currentState\u0027] \u003d value[\u0027tagInfo\u0027][\u0027stateName\u0027]\n\t\tstate[\u0027parentId\u0027] \u003d self.view.custom.asset.assetInfo[\u0027parentId\u0027]\n\t\tstate[\u0027userEdit\u0027] \u003d value[\u0027userAction\u0027][\u0027canCreate\u0027]\n\t\tinstances.append({\u0027value\u0027: state})\n\n\treturn instances",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "direction": "column",
              "path": "kanoa/core/dbp/widgets/inputs/assetStates/stateButton",
              "style": {
                "gap": 5
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.flex-repeater"
          }
        ],
        "meta": {
          "domId": "flxStates",
          "name": "flxStates"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": 5,
            "padding": 5
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/border",
        "margin": "5px",
        "padding": "5px"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "stateButtonPressed",
          "pageScope": true,
          "script": "\n#\tself.view.custom.asset.inputs.state \u003d payload[\u0027stateCode\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "assetStateSelected",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"assetStateSelected() msg rcvd with %s\"%payload)\n#\t\n#\tif len(payload[\u0027selection\u0027]) \u003e 0: \n#\t\tself.view.custom.asset.inputs.state \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027stateCode\u0027]\n#\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
