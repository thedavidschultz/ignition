          "shrink": 0
        },
        "props": {
          "justify": "space-between"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "domId": "flxRptNotifications",
          "name": "flxRptNotifications"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.notifications"
              },
              "overlayOptOut": true,
              "transforms": [
                {
                  "code": "\t\n\tnotifications \u003d self.view.custom.notifications\n\t\n\ttagInfo \u003d self.view.custom.oeeTagInfo\n\tstartDate \u003d system.date.fromMillis(tagInfo[\u0027shiftStart\u0027]) if tagInfo[\u0027shiftStart\u0027] else system.date.midnight(system.date.now())\t\n\t\n\tinstances \u003d []\n\t\n\tif len(notifications[\u0027downtime\u0027]) \u003e 0:\n\t\tmsg \u003d \"1 Uncoded Downtime Event\" if len(notifications[\u0027downtime\u0027]) \u003d\u003d 1 else \"%s Uncoded Downtime Events\"%len(notifications[\u0027downtime\u0027])\n\t\tnavInfo \u003d {\n\t\t  \t\t\t\"viewPath\": \u0027kanoa/mes/asset/downtime/downtimeTable\u0027,\n\t\t  \t\t\t\"viewName\": \"Downtime Editor\",\n\t\t  \t\t\t\"viewParams\": {\n\t\t\t\t\t\t\t\t\t\"assetId\": self.view.custom.assetInfo.assetId,\n\t\t\t\t\t\t\t\t\t\"assetPath\": self.view.custom.assetInfo.assetPath,\n\t\t\t\t\t\t\t\t\t\"endDate\": system.date.now(),\n\t\t\t\t\t\t\t\t\t\"options\": {\"minDurationMins\": 0, \"showAllStates\": False,\t\"showChanged\": 0, \"showDurationSecs\": False, \"sortDateAsc\": False},\n\t\t\t\t\t\t\t\t\t\"startDate\": startDate\n\t\t\t\t\t\t\t\t\t},\n\t\t  \t\t\t\"popup\": True\n\t\t\t\t}\n\t\t\t\t\n\t\tinstances.append({\u0027value\u0027: {\"bgColor\": \u0027-kcBlue-40\u0027, \"icon\": \"material/warning\", \"iconColor\": \u0027--kcOrange-30\u0027, \"navInfo\": navInfo, \"text\": msg}})\n\telse:\n\t\tinstances.append({\u0027value\u0027: {\"bgColor\": \u0027-kcBlue-40\u0027, \"icon\": \"material/check\", \"iconColor\": \u0027--kcGreen-30\u0027, \"navInfo\": {}, \"text\": \u0027All Downtime Events Coded\u0027 }})\n\n\t\n\tfor k,v in notifications[\u0027qualityChecks\u0027].items():\n\t\tnavInfo \u003d {\n\t\t  \t\t\t\"viewPath\": \u0027kanoa/qds/qdsDashboard\u0027,\n\t\t  \t\t\t\"viewName\": \u0027Scheduled Checks\u0027,\n\t\t  \t\t\t\"viewParams\": { \u0027value\u0027: {\"assetPath\": self.view.custom.assetInfo.assetPath, \"chkShtStates\": [k]}},\n\t\t  \t\t\t\"popup\": False\n\t\t\t\t}\n\t\t\n\t\tif len(v) \u003e 0:\n\t\t\tmsg \u003d \"1 Quality Check %s\"%k if len(v) \u003d\u003d 1 else \"%s Quality Checks %s\"%(len(v), k)\n\t\t\ticon \u003d \u0027material/fact_check\u0027 if k in (\u0027Coming Due\u0027, \u0027Due\u0027) else \"material/warning\"\n\t\t\ticonColor \u003d \u0027--kcRed-30\u0027 if k in (\u0027OverDue\u0027, \u0027Missed\u0027) else \u0027--kcOrange-30\u0027\n\t\t\tinstances.append({\u0027value\u0027: {\"bgColor\": \u0027-kcBlue-40\u0027, \"icon\": icon, \"iconColor\": iconColor, \"navInfo\": navInfo, \"text\": msg}})\t\t\n\t\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
