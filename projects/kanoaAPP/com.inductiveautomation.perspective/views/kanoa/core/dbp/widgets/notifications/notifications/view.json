  "propConfig": {
    "custom.assetInfo": {
      "binding": {
        "config": {
          "path": "view.custom.filters"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tassetPath \u003d value[\u0027assetPath\u0027] if value.has_key(\u0027assetPath\u0027) else None\n\t\n\treturn system.kanoa.utilities.convertDatasetRowToJSON(system.kanoa.asset.getAssets({\u0027assetPath\u0027: assetPath or \u0027none\u0027}), 0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.checkData": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[Kanoa]kanoa/timers/qdsScheduleChecks/data"
        },
        "overlayOptOut": true,
        "type": "tag"
      },
      "persistent": true
    },
    "custom.filters": {
      "binding": {
        "config": {
          "struct": {
            "page": "{page.props.pageId}",
            "sessionCustomProps": "{session.custom.kanoa}",
            "viewParams": "{view.params.value}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\treturn system.kanoa.dashboard.getWidgetFilters(value[\u0027page\u0027], value[\u0027viewParams\u0027], value[\u0027sessionCustomProps\u0027], self.session.props.device.timezone.id)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.notifications": {
      "persistent": true
    },
    "custom.notifications.downtime": {
      "binding": {
        "config": {
          "struct": {
            "oeeTagInfo": "{view.custom.oeeTagInfo}",
            "timeNow": "now(60000)"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tfilters \u003d self.custom.filters\n\tif filters[\u0027assetId\u0027] is None: return []\n\tnotifications \u003d filters[\u0027notifications\u0027]\n\tif not notifications.has_key(\u0027downtime\u0027) or notifications[\u0027downtime\u0027][\u0027enabled\u0027] \u003d\u003d False : return []\n\n\tstartDate \u003d system.date.fromMillis(value[\u0027oeeTagInfo\u0027][\u0027shiftStart\u0027]) if value[\u0027oeeTagInfo\u0027][\u0027shiftStart\u0027] else system.date.midnight(system.date.now())\n\tparamsDict \u003d {\u0027assetId\u0027: self.custom.assetInfo[\u0027assetId\u0027], \u0027durationSecs\u0027: 0, \u0027showChanged\u0027: False, \u0027showDowntimeOnly\u0027: True, \u0027startDate\u0027: startDate, \u0027endDate\u0027: system.date.now()}\n\treturn system.kanoa.utilities.convertDatasetToJSON(system.kanoa.event.getAssetStateEvents(paramsDict))",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.notifications.qualityChecks": {
      "binding": {
        "config": {
          "struct": {
            "checks": "{view.custom.checkData}",
            "filters": "{view.custom.filters}"
          },
          "waitOnAll": true
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\n\tif value[\u0027filters\u0027][\u0027assetId\u0027] is None: return []\n\n\tnotifications \u003d value[\u0027filters\u0027][\u0027notifications\u0027]\n\tif not notifications.has_key(\u0027qualityChecks\u0027) or notifications[\u0027qualityChecks\u0027][\u0027enabled\u0027] \u003d\u003d False : return []\n\n\tchecks \u003d {\u0027Coming Due\u0027: [], \u0027Due\u0027: [], \u0027Overdue\u0027: [], \u0027Missed\u0027: []}\n\n\tfor row in system.kanoa.utilities.convertDatasetToJSON(value[\u0027checks\u0027]):\n\t\tif (row[\u0027assetId\u0027] !\u003d value[\u0027filters\u0027][\u0027assetId\u0027]) or row[\u0027auto\u0027]: continue\n\t\tif row[\u0027chkShtStateName\u0027] in (\u0027Coming Due\u0027, \u0027Due\u0027, \u0027Overdue\u0027, \u0027Missed\u0027):\n\t\t\tchecks[row[\u0027chkShtStateName\u0027]].append(row)\n\t\t\t\n\treturn checks",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.oeeTagInfo": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "1": "{view.custom.assetInfo.tagPath}"
          },
          "tagPath": "{1}/Line"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\treturn value[\u0027OEE\u0027]",
            "type": "script"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
