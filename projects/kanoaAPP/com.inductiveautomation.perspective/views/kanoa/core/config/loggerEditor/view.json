{
  "custom": {
    "display": {
      "lblBasis": "60px"
    },
    "loggerInfo": {
      "assetId": null,
      "assetPath": null,
      "enabled": false,
      "loggerId": null,
      "loggerName": "",
      "userId": null
    }
  },
  "params": {
    "value": {
      "assetId": null,
      "assetPath": null,
      "enabled": false,
      "loggerId": null,
      "loggerName": null,
      "userId": null
    }
  },
  "propConfig": {
    "custom.display": {
      "persistent": true
    },
    "custom.loggerInfo": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "overlayOptOut": true,
        "transforms": [
          {
            "code": "\t\n\tvalue \u003d dict(value)\n\tvalue[\u0027loggerName\u0027] \u003d value[\u0027loggerName\u0027] or \u0027\u0027\n\t\n\treturn value",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 167,
      "width": 720
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "domId": "lblName",
              "name": "lblName"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "path": "view.custom.display.lblBasis"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Logger"
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "system": {
                "onStartup": {
                  "config": {
                    "script": "\t\n\timport time\n\ttime.sleep(0.2)\n\tself.focus()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "txtName",
              "name": "txtName"
            },
            "position": {
              "basis": "150px",
              "grow": 1,
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.loggerInfo.loggerName"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default kanoa/border"
              }
            },
            "type": "ia.input.text-field"
          },
          {
            "meta": {
              "domId": "lblLoggerId",
              "name": "lblLoggerId",
              "tooltip": {
                "enabled": true,
                "text": "debugId"
              }
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.loggerInfo.loggerId"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\treturn value or \u0027\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "domId": "flxName",
          "name": "flxName"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblAsset",
              "name": "lblAsset"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "path": "/root.custom.labelBasis"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Asset"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "selector",
              "name": "evAssetSelector"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.params.assetInfo.assetId": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.loggerInfo.assetId"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.params.assetInfo.assetPath": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.loggerInfo.assetPath"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              },
              "props.params.value.assetPath": {
                "binding": {
                  "config": {
                    "path": "view.params.value.assetPath"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "params": {
                "assetInfo": {
                  "assetGroupColor": null,
                  "assetGroupId": null,
                  "assetGroupName": null,
                  "assetName": null,
                  "assetTypeId": null,
                  "assetTypeName": null,
                  "assetTypePath": null,
                  "displayPath": null,
                  "enabled": null,
                  "iconPath": null,
                  "oeeEnabled": null,
                  "parentId": null,
                  "path": null,
                  "processTypeId": null,
                  "processTypeName": null,
                  "sortOrder": null,
                  "tagPath": null,
                  "timeZone": null
                },
                "value": {
                  "parentPathList": [],
                  "persistent": false,
                  "useSessionValue": false
                }
              },
              "path": "kanoa/core/templates/selectors/assetSelector"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "domId": "flxAsset",
          "name": "flxAsset"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "domId": "lblEnabled",
              "name": "lblEnabled"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "path": "view.custom.display.lblBasis"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "kanoa/font/default",
                "textAlign": "right"
              },
              "text": "Enabled"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "domId": "chkEnabled",
              "name": "chkEnabled"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.selected": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.loggerInfo.enabled"
                  },
                  "overlayOptOut": true,
                  "type": "property"
                }
              }
            },
            "props": {
              "checkedIcon": {
                "color": {
                  "enabled": "--kcGray-60"
                }
              },
              "text": ""
            },
            "type": "ia.input.checkbox"
          }
        ],
        "meta": {
          "domId": "flxEnabled",
          "name": "flxEnabled"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "style": {
            "gap": 5,
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tself.view.getChild(\"root\").save()\n\t\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnSave",
              "name": "btnSave",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Save"
              }
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "path": "view.custom.loggerInfo"
                  },
                  "overlayOptOut": true,
                  "transforms": [
                    {
                      "code": "\t\n\treturn True if (value[\u0027loggerName\u0027] or None) is not None else False",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/save"
                }
              },
              "style": {
                "classes": "kanoa/button/filled"
              },
              "text": "Save"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\n\tsystem.perspective.closePopup(\u0027\u0027)\n\treturn"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "domId": "btnClose",
              "name": "btnClose",
              "tooltip": {
                "enabled": true,
                "location": "bottom-left",
                "text": "Close"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "image": {
                "icon": {
                  "path": "material/exit_to_app"
                }
              },
              "style": {
                "classes": "kanoa/button/outlined",
                "marginLeft": "5px"
              },
              "text": "Close"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "domId": "flxActions",
          "name": "flxActions"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "justify": "center",
          "style": {
            "gap": "5px",
            "overflow": "hidden",
            "padding": "5px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "kanoa/font/default",
        "gap": 5,
        "overflow": "hidden",
        "padding": 5
      }
    },
    "scripts": {
      "customMethods": [
        {
          "name": "save",
          "params": [],
          "script": "\n\tloggerInfo \u003d dict(self.view.custom.loggerInfo)\n\tif loggerInfo[\u0027loggerId\u0027]: \n\t\tretVal, msg \u003d system.kanoa.logger.updateLogger(loggerInfo, loggerInfo[\u0027userId\u0027])\n\telse: loggerId, msg \u003d system.kanoa.logger.addLogger(loggerInfo, loggerInfo[\u0027userId\u0027])\n\t\n\tif msg is None: \n\t\tsystem.perspective.sendMessage(\u0027showSuccessfulToast\u0027, \u0027Logger saved\u0027)\n\t\tsystem.perspective.closePopup(\u0027\u0027)\n\telse: system.perspective.sendMessage(\u0027showFailerToast\u0027, \"Couldn\u0027t save this Logger. \\n%s\"%msg)\n\t\t\n\tsystem.perspective.sendMessage(\u0027updateLoggers\u0027, {})\n\t\n\treturn"
        }
      ],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "updateSelection",
          "pageScope": true,
          "script": "\n#\tsystem.perspective.print(\"updateSelection msg rcvd with %s\"%payload)\n\t\n\tif payload[\u0027msgHandler\u0027] \u003d\u003d \u0027assetSelected\u0027:\n\t\tself.view.custom.loggerInfo.assetId \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027assetId\u0027]\n\t\tself.view.custom.loggerInfo.assetPath \u003d payload[\u0027selection\u0027][0][\u0027value\u0027][\u0027assetPath\u0027]\n\t\n\treturn",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}