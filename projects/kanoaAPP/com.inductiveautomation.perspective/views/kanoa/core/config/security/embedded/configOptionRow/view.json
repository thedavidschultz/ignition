  "root": {
    "type": "ia.container.flex", 
    "props": {
      "alignItems": "center", 
      "style": {
        "padding": "5px", 
        "classes": "kanoa/container kanoa/font/default", 
        "gap": "5px"
      }
    }, 
    "children": [
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "textAlign": "center", 
            "fontWeight": "bold"
          }, 
          "textStyle": {
            "textAlign": "left"
          }
        }, 
        "meta": {
          "domId": "lblFieldName", 
          "name": "lblFieldName"
        }, 
        "position": {
          "shrink": 0, 
          "basis": "150px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\t\n\treturn value['configLabel'] or value['configName']", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.custom.values"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "meta": {
          "domId": "lblDataType", 
          "name": "lblDataType"
        }, 
        "position": {
          "display": false, 
          "basis": "150px"
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn \"Data Type: \" + value if value else ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "config": {
                "path": "view.params.values.configDataType"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.input.dropdown", 
        "props": {
          "dropdownOptionStyle": {
            "classes": "kanoa/font/default"
          }, 
          "style": {
            "classes": "kanoa/font/default", 
            "minWidth": "250px", 
            "height": "30px"
          }
        }, 
        "meta": {
          "domId": "ddConfigValue", 
          "name": "ddConfigValue"
        }, 
        "position": {
          "shrink": 0
        }, 
        "propConfig": {
          "props.options": {
            "binding": {
              "type": "property", 
              "config": {
                "path": "view.custom.options"
              }
            }
          }, 
          "props.multiSelect": {
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.params.configOptions.multiSelect"
              }
            }
          }, 
          "props.value": {
            "onChange": {
              "enabled": null, 
              "script": "\tif currentValue.value is None:\n\t\tsystem.perspective.sendMessage('showFailerToast', \"Cannot have empty value for multi selection\")\n\t\tself.props.value = [previousValue.value[0]]\n#\tpass"
            }, 
            "binding": {
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "bidirectional": true, 
                "path": "view.custom.values.configValue"
              }
            }
          }
        }
      }, 
      {
        "type": "ia.display.label", 
        "props": {
          "style": {
            "marginRight": "5px", 
            "height": "30px"
          }, 
          "textStyle": {
            "fontWeight": "normal"
          }
        }, 
        "meta": {
          "domId": "lblDescription", 
          "name": "lblDescription"
        }, 
        "position": {
          "grow": 1
        }, 
        "propConfig": {
          "props.text": {
            "binding": {
              "transforms": [
                {
                  "code": "\treturn value or ''", 
                  "type": "script"
                }
              ], 
              "type": "property", 
              "overlayOptOut": true, 
              "config": {
                "path": "view.custom.values.configDescription"
              }
            }
          }
        }
      }
    ], 
    "meta": {
      "domId": "root", 
      "name": "root"
    }
  }, 
  "propConfig": {
    "custom.options": {
      "binding": {
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
          "path": "view.params.configOptions.options"
        }
      }, 
      "persistent": true
    }, 
    "params.configOptions": {
      "paramDirection": "input", 
      "persistent": true
    }, 
    "custom.values": {
      "binding": {
        "transforms": [
          {
            "code": "\tconfigValues = self.params.values\n\tconfigValue = configValues['configValue']\n\tif '[' in configValue and ']' in configValue:\n\t\tconfigValue = system.util.jsonDecode(configValue)\n\t\tconfigValues['configValue'] = configValue\n\treturn configValues", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "config": {
          "path": "view.params.values"
        }
      }, 
      "persistent": true
    }, 
    "custom.values.configValue": {
      "onChange": {
        "enabled": null, 
        "script": "\timport java.lang\n\t\t\n\tif origin in ('Script', 'BindingWriteback') and currentValue.value is not None and previousValue.value is not None:\n\t\t\n\t\tconfigValue = self.custom.values.configValue\n\t\tif configValue is not None:\n\t\t\tconfigValueStr = str(configValue)\n\t\t\t\n\t\t\tif '[' in configValueStr and ']' in configValueStr:\n\t\t\t\tconfigValue = system.util.jsonEncode(configValue)\n\t\t\tretVal, msg = system.kanoa.security.updateConfigField(self.custom.values.configId, 'configValue', configValue, system.kanoa.security.getIDPUserId(self.session.props.auth.user))\n\t\t\tif retVal: system.perspective.sendMessage('showSuccessfulToast', \"Configuration updated\")\n\t\t\telse: system.perspective.sendMessage('showFailerToast', \"Couldn't update configuration: %s\"%msg)\n\t\t\tsystem.perspective.sendMessage('updateConfig', {})\n\t\n\treturn"
      }, 
      "persistent": true
    }, 
    "params.values": {
      "paramDirection": "input", 
      "persistent": true
    }
  }
}