    "custom.timerTag": {
      "binding": {
        "transforms": [
          {
            "code": "\t\n\ttags = system.tag.browse(value)\n\ttagValues = {}\n\tfor tag in tags:\n\t\ttagValues[str(tag['fullPath']).split('/')[-1]] = tag['value']\n\t\t\n\treturn tagValues", 
            "type": "script"
          }
        ], 
        "type": "property", 
        "overlayOptOut": true, 
        "config": {
