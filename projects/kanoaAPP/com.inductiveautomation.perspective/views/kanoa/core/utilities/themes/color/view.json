{
  "custom": {},
  "params": {
    "value": {
      "color": "--kcPrimary-30",
      "label": "--kcPrimary-30"
    }
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 25,
      "width": 120
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "domId": "label",
          "name": "label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value.label"
              },
              "transforms": [
                {
                  "code": "\treturn value or \u0027\u0027",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/font/default",
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t\n\tsystem.perspective.openPopup(\"Color Picker\", \"kanoa/core/templates/colorPicker/main\", {}, overlayDismiss\u003dTrue)\n\t\n\treturn"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "domId": "lblColor",
          "name": "lblColor"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.value.color"
              },
              "overlayOptOut": true,
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "kanoa/input"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "domId": "root",
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "--kcSurface",
        "gap": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}