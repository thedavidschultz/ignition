            "code": "\t\n\tqty \u003d max(0, (value[\u0027reqdQty\u0027] or 0.0) - (value[\u0027schedQty\u0027] or 0.0) - (value[\u0027actualQty\u0027] or 0.0))\n\tself.custom.eventInfo.selectedQty \u003d qty\n\t\n\treturn qty",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.validation": {
