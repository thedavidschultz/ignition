        "transforms": [
          {
            "code": "\n\tif value[\u0027selectedQty\u0027] \u003c\u003d 0: return {\u0027valid\u0027: False, \u0027msg\u0027: \u0027Need to schedule a quantity greater than %s\u0027%value[\u0027selectedQty\u0027]}\n\tif value[\u0027selectedQty\u0027] \u003e self.custom.remainingQty: return {\u0027valid\u0027: True, \u0027msg\u0027: \u0027Quantity scheduled is greater than what is required\u0027}\n\t\n\treturn {\u0027valid\u0027: True, \u0027msg\u0027: \u0027\u0027}",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
